<Application x:Class="DocMgr.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DocMgr"
             xmlns:config="clr-namespace:DocMgr.Config"
             xmlns:viewShared="clr-namespace:DocMgr.Views.Shared">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/Shared/FormResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <Style x:Key="ButtonBaseStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter x:Name="ButtonContent"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E5E7EB"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#CBD5E1"/>
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="1"/>
                                <Setter TargetName="ButtonContent" Property="TextElement.Foreground" Value="#FF8C8585"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ButtonNormalStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Background" Value="#607D8B"/>
            <Setter Property="BorderBrush" Value="#546E7A"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="ButtonCautionStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Background" Value="#A86B6B"/>
            <Setter Property="BorderBrush" Value="#8F5555"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="ButtonSecondaryStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Background" Value="#607D8B"/>
            <Setter Property="BorderBrush" Value="#546E7A"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="FormInlineButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonNormalStyle}">
            <Setter Property="Height" Value="{StaticResource FormControlHeight}"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PageCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonSecondaryStyle}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DialogCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonSecondaryStyle}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="DialogSecondaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonSecondaryStyle}">
            <Setter Property="Width" Value="96"/>
            <Setter Property="Height" Value="{StaticResource DialogFormControlHeight}"/>
        </Style>

        <Style x:Key="DialogPrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonNormalStyle}">
            <Setter Property="Width" Value="96"/>
            <Setter Property="Height" Value="{StaticResource DialogFormControlHeight}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DialogDangerActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonCautionStyle}">
            <Setter Property="Width" Value="96"/>
            <Setter Property="Height" Value="{StaticResource DialogFormControlHeight}"/>
        </Style>

        <Style x:Key="ToolbarActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonNormalStyle}">
            <Setter Property="Height" Value="{StaticResource ToolbarControlHeight}"/>
            <Setter Property="MinWidth" Value="88"/>
        </Style>

        <Style x:Key="ToolbarDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonCautionStyle}">
            <Setter Property="Height" Value="{StaticResource ToolbarControlHeight}"/>
            <Setter Property="MinWidth" Value="88"/>
        </Style>

        <Style x:Key="ToolbarCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style TargetType="{x:Type Window}">
            <Setter Property="Title" Value="{x:Static config:DocMgrBranding.ApplicationTitle}"/>
            <Setter Property="MaxWidth" Value="1400"/>
            <Setter Property="MaxHeight" Value="900"/>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="CanContentScroll" Value="False"/>
            <Setter Property="IsDeferredScrollingEnabled" Value="False"/>
            <Setter Property="PanningMode" Value="VerticalOnly"/>
        </Style>

        <Style x:Key="StandardDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F5EDCF"/>
                    <Setter Property="Foreground" Value="#212121"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="Selector.IsSelectionActive" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#FAF3E0"/>
                    <Setter Property="Foreground" Value="#212121"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StandardDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F5EDCF"/>
                    <Setter Property="Foreground" Value="#212121"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="Selector.IsSelectionActive" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#FAF3E0"/>
                    <Setter Property="Foreground" Value="#212121"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
            <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="RowStyle" Value="{StaticResource StandardDataGridRowStyle}"/>
            <Setter Property="CellStyle" Value="{StaticResource StandardDataGridCellStyle}"/>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
        </Style>

        <Style TargetType="Page">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Page">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="Transparent" Padding="12,8,12,0">
                                <Grid>
                                    <Button Content="关闭"
                                            Command="{x:Static viewShared:ViewCommands.CloseCurrentView}"
                                            Style="{StaticResource PageCloseButtonStyle}"/>
                                </Grid>
                            </Border>

                            <ContentPresenter Grid.Row="1" ContentSource="Content"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource ButtonNormalStyle}"/>

        <!-- 垂直分隔线样式 (VerticalSeparatorStyle) -->
        <Style x:Key="VerticalSeparatorStyle" TargetType="Separator">
            <Setter Property="Background" Value="#E8E8E8"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Width" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}" 
                                Width="{TemplateBinding Width}" 
                                VerticalAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- [New] DataGrid Header Style for Global Use -->
        <Style TargetType="DataGridColumnHeader" x:Key="DataGridHeaderStyle">
            <Setter Property="Background" Value="#FF397E7A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="Label" BasedOn="{StaticResource FormLabelStyle}"/>

        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource FormComboBoxStyle}"/>

        <Style TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}"/>

        <Style TargetType="DatePicker" BasedOn="{StaticResource FormDatePickerStyle}"/>

        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="{StaticResource FormControlHeight}"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
