<Page x:Class="DocMgr.Views.SystemSettings.DeptSettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:DocMgr.Views.SystemSettings"
      xmlns:vm="clr-namespace:DocMgr.ViewModels.SystemSettings"
      mc:Ignorable="d" 
      Title="DeptSettingPage" Background="White"
      d:DataContext="{d:DesignInstance Type=vm:DeptSettingViewModel}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarCardBorderStyle}" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,20">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <Button Content="新增部门" Command="{Binding AddCommand}" Width="100" Margin="0,0,10,0" Style="{StaticResource ToolbarActionButtonStyle}"/>
                    <Button Content="编辑部门" Command="{Binding EditCommand}" Width="100" Margin="0,0,10,0" Style="{StaticResource ToolbarActionButtonStyle}"/>
                    <Button Content="删除选中" Command="{Binding DeleteCommand}" Width="100" Margin="0,0,10,0" Style="{StaticResource ToolbarDangerButtonStyle}"/>
                    <Button Content="刷新列表" Command="{Binding RefreshCommand}" Width="100" Style="{StaticResource ToolbarActionButtonStyle}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 数据表格 -->
        <DataGrid x:Name="DgDepartments" Grid.Row="1" AutoGenerateColumns="False" 
                  CanUserAddRows="False" IsReadOnly="True"
                  SelectionMode="Single"
                  BorderThickness="1" BorderBrush="#E0E0E0"
                  RowHeight="35" ColumnHeaderHeight="40"
                  ItemsSource="{Binding Departments}" SelectedItem="{Binding SelectedDepartment}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                <DataGridTextColumn Header="部门名称" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="部门说明" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
