<Page x:Class="DocMgr.Views.SystemSettings.UserManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d" 
      Title="用户管理" Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarCardBorderStyle}" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,20">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <!-- 绑定 Command -->
                    <Button Content="刷新列表" Command="{Binding RefreshCommand}" Width="100" Margin="0,0,10,0" Style="{StaticResource ToolbarActionButtonStyle}"/>
                    <Button Content="新增用户" Command="{Binding AddCommand}" Width="100" Margin="0,0,10,0" Style="{StaticResource ToolbarActionButtonStyle}"/>
                    <Button Content="编辑选中" Command="{Binding EditCommand}" Width="100" Margin="0,0,10,0" Style="{StaticResource ToolbarActionButtonStyle}"/>
                    <Button Content="删除选中" Command="{Binding DeleteCommand}" Width="100" Margin="0,0,10,0" Style="{StaticResource ToolbarDangerButtonStyle}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 数据表格 -->
        <DataGrid x:Name="DgUsers" Grid.Row="1" AutoGenerateColumns="False" 
                  ItemsSource="{Binding Users}"
                  SelectedItem="{Binding SelectedUser}"
                  CanUserAddRows="False" IsReadOnly="True"
                  SelectionMode="Single"
                  BorderThickness="1" BorderBrush="#E0E0E0"
                  RowHeight="35" ColumnHeaderHeight="40">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="登录账号" Binding="{Binding LoginName}" Width="150"/>
                <DataGridTextColumn Header="真实姓名" Binding="{Binding RealName}" Width="150"/>
                <DataGridTextColumn Header="所属部门" Binding="{Binding Department}" Width="150"/>
                <DataGridTextColumn Header="用户角色" Binding="{Binding Role}" Width="150"/>
                <DataGridTextColumn Header="开通日期" Binding="{Binding CreatedDate, StringFormat={}{0:yyyy-MM-dd}}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>