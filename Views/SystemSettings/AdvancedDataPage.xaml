<Page x:Class="DocMgr.Views.SystemSettings.AdvancedDataPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="高级数据管理" Background="White">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style TargetType="DataGridColumnHeader" x:Key="AdvancedDataGridHeaderStyle" BasedOn="{StaticResource DataGridHeaderStyle}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFEBEE" BorderBrush="#FFCDD2" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,20">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚠️" FontSize="20" Margin="0,0,10,0"/>
                    <TextBlock Text="高级数据管理 (危险区域)" FontSize="18" FontWeight="Bold" Foreground="#D32F2F" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="此功能允许管理员直接删除数据库记录。操作不可逆，请谨慎使用！" Foreground="#B71C1C" Margin="34,5,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource ToolbarCardBorderStyle}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="选择数据表：" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                <ComboBox Width="400" Margin="10,0,0,0"
                          ItemsSource="{Binding Tables}"
                          DisplayMemberPath="TableName"
                          SelectedItem="{Binding SelectedTable, Mode=TwoWay}"/>
                <Button Content="📤 导出到 Excel" Command="{Binding ExportToExcelCommand}" Margin="10,0,0,0" Padding="10,0" Style="{StaticResource ToolbarActionButtonStyle}"/>
                <Button Content="🔄 刷新数据" Command="{Binding RefreshCommand}" Margin="10,0,0,0" Padding="10,0" Style="{StaticResource ToolbarActionButtonStyle}"/>

                <Border Margin="15,0,0,0"
                        MinWidth="360"
                        Width="Auto"
                        Background="#F7F9FC"
                        BorderBrush="#D0D7DE"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12,8"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasTableBrowseInfo, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel DataContext="{Binding TableBrowseInfo}">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4">
                            <Run Text="表名：" FontWeight="Bold" Foreground="#37474F"/>
                            <Run Text="{Binding TableName, Mode=OneWay}" Foreground="#263238"/>
                            <Run Text="　中文：" FontWeight="Bold" Foreground="#37474F"/>
                            <Run Text="{Binding ChineseName, Mode=OneWay}" Foreground="#263238"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4">
                            <Run Text="说明：" FontWeight="Bold" Foreground="#37474F"/>
                            <Run Text="{Binding Description, Mode=OneWay}" Foreground="#455A64"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4">
                            <Run Text="关联：" FontWeight="Bold" Foreground="#37474F"/>
                            <Run Text="{Binding Relationships, Mode=OneWay}" Foreground="#455A64"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" FontSize="12">
                            <Run Text="维护：" FontWeight="Bold" Foreground="#37474F"/>
                            <Run Text="{Binding MaintenanceNotes, Mode=OneWay}" Foreground="#6A1B9A"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Background="#F3F8FF"
                BorderBrush="#BBDEFB"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="数据字典维护（SchemaDictionary.yaml）"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#1565C0"
                           Margin="0,0,0,6"/>
                <TextBlock Text="{Binding DictionaryPathText}"
                           FontSize="11"
                           Foreground="#546E7A"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4"/>
                <TextBlock Text="{Binding DictionaryStatusText}"
                           FontSize="11"
                           Foreground="#455A64"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
                <WrapPanel>
                    <Button Content="🔄 同步 EF 模型到字典"
                            Command="{Binding SyncModelToDictionaryCommand}"
                            Margin="0,0,8,0"
                            Padding="10,4"
                            Style="{StaticResource ToolbarActionButtonStyle}"/>
                    <Button Content="⬆ 导出 DB 显示名到字典"
                            Command="{Binding ExportDisplayNamesToDictionaryCommand}"
                            Margin="0,0,8,0"
                            Padding="10,4"
                            Style="{StaticResource ToolbarActionButtonStyle}"/>
                    <Button Content="⬇ 从字典重置 DB 显示名"
                            Command="{Binding ApplyDictionaryToDatabaseCommand}"
                            Padding="10,4"
                            Style="{StaticResource ToolbarActionButtonStyle}"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Background="#FAFAFA"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="字段显示名：" VerticalAlignment="Center" FontWeight="Bold"/>
                <ComboBox Width="220"
                         
                          Margin="8,0,0,0"
                          ItemsSource="{Binding TableFields}"
                          DisplayMemberPath="FieldName"
                          SelectedItem="{Binding SelectedField, Mode=TwoWay}"/>
                <TextBlock Text="中文显示名：" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="Bold"/>
                <TextBox Width="180"
                        
                         Margin="8,0,0,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding FieldDisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="💾 保存显示名并写回字典"
                        Command="{Binding SaveFieldDisplayNameCommand}"
                        Margin="10,0,0,0"
                        Padding="10,4"
                        Style="{StaticResource ToolbarActionButtonStyle}"/>
            </StackPanel>
        </Border>

        <DataGrid x:Name="RecordsDataGrid"
                  Grid.Row="4"
                  ItemsSource="{Binding RecordsView}"
                  SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                  AutoGenerateColumns="True"
                  AutoGeneratingColumn="RecordsDataGrid_OnAutoGeneratingColumn"
                  AutoGeneratedColumns="RecordsDataGrid_OnAutoGeneratedColumns"
                  ColumnHeaderHeight="72"
                  ColumnHeaderStyle="{StaticResource AdvancedDataGridHeaderStyle}"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  BorderThickness="1"
                  BorderBrush="#DDD"
                  SelectionMode="Single">
            <DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="删除选中行" Command="{Binding DeleteSelectedCommand}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <Border Grid.Row="5"
                Background="#FAFAFA"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,8"
                Margin="0,10,0,0"
                Visibility="{Binding HasSelectedTable, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="每页条数：" VerticalAlignment="Center" FontWeight="Bold"/>
                    <ComboBox Width="80"
                              Height="28"
                              Margin="8,0,16,0"
                              ItemsSource="{Binding PageSizeOptions}"
                              SelectedItem="{Binding PageSize, Mode=TwoWay}"/>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="#546E7A"
                               Text="{Binding PageInfo}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="首页"
                            Width="64"
                            Margin="0,0,6,0"
                            Padding="8,2"
                            Style="{StaticResource ToolbarActionButtonStyle}"
                            Command="{Binding FirstPageCommand}"/>
                    <Button Content="上一页"
                            Width="72"
                            Margin="0,0,6,0"
                            Padding="8,2"
                            Style="{StaticResource ToolbarActionButtonStyle}"
                            Command="{Binding PreviousPageCommand}"/>
                    <Button Content="下一页"
                            Width="72"
                            Margin="0,0,6,0"
                            Padding="8,2"
                            Style="{StaticResource ToolbarActionButtonStyle}"
                            Command="{Binding NextPageCommand}"/>
                    <Button Content="末页"
                            Width="64"
                            Margin="0,0,12,0"
                            Padding="8,2"
                            Style="{StaticResource ToolbarActionButtonStyle}"
                            Command="{Binding LastPageCommand}"/>
                    <TextBlock Text="跳至" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Width="48"
                             Height="28"
                             VerticalContentAlignment="Center"
                             TextAlignment="Center"
                             Text="{Binding GoToPageText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="页" VerticalAlignment="Center" Margin="6,0,8,0"/>
                    <Button Content="跳转"
                            Width="64"
                            Padding="8,2"
                            Style="{StaticResource ToolbarActionButtonStyle}"
                            Command="{Binding GoToPageCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="6" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="Gray"/>

                <Button Content="🗑 删除选中记录"
                        Command="{Binding DeleteSelectedCommand}"
                        Width="140"
                        Style="{StaticResource ToolbarDangerButtonStyle}"
                        Margin="0,0,10,0"/>

                <Button Content="☢️ 清空当前表"
                        Command="{Binding ClearTableCommand}"
                        Width="140"
                        Style="{StaticResource ToolbarDangerButtonStyle}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>