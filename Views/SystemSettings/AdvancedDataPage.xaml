<Page x:Class="DocMgr.Views.SystemSettings.AdvancedDataPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="高级数据管理" Background="White">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style TargetType="DataGridColumnHeader" x:Key="AdvancedDataGridHeaderStyle" BasedOn="{StaticResource DataGridHeaderStyle}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 统一顶栏：同一页面，按角色显示权限说明 -->
        <Border Grid.Row="0"
                Background="#E3F2FD"
                BorderBrush="#90CAF9"
                BorderThickness="1"
                CornerRadius="4"
                Padding="15"
                Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🗄" FontSize="20" Margin="0,0,10,0"/>
                    <TextBlock Text="高级数据管理"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#1565C0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding RolePermissionHintText, Mode=OneWay}"
                           Foreground="#37474F"
                           Margin="34,6,0,0"
                           TextWrapping="Wrap"/>
                <TextBlock Text="浏览与导出：所有登录用户。备份、还原、字典维护、删除、清空：界面全员可见，仅系统管理员可执行（其余角色按钮灰显）。"
                           Foreground="#546E7A"
                           FontSize="12"
                           Margin="34,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource ToolbarCardBorderStyle}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="选择数据表：" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                    <ComboBox Width="400" Margin="10,0,0,0"
                              ItemsSource="{Binding Tables}"
                              DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding SelectedTable, Mode=TwoWay}"/>
                    <Button Content="📤 导出到 Excel"
                            Command="{Binding ExportToExcelCommand}"
                            Margin="10,0,0,0"
                            Padding="10,0"
                            Style="{StaticResource ToolbarActionButtonStyle}"/>
                    <Button Content="🔄 刷新数据"
                            Command="{Binding RefreshCommand}"
                            Margin="10,0,0,0"
                            Padding="10,0"
                            Style="{StaticResource ToolbarActionButtonStyle}"/>

                    <Border Margin="15,0,0,0"
                            MinWidth="360"
                            Width="Auto"
                            Background="#F7F9FC"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12,8"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasTableBrowseInfo, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel DataContext="{Binding TableBrowseInfo}">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4">
                                <Run Text="表名：" FontWeight="Bold" Foreground="#37474F"/>
                                <Run Text="{Binding TableName, Mode=OneWay}" Foreground="#263238"/>
                                <Run Text="　中文：" FontWeight="Bold" Foreground="#37474F"/>
                                <Run Text="{Binding ChineseName, Mode=OneWay}" Foreground="#263238"/>
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4">
                                <Run Text="说明：" FontWeight="Bold" Foreground="#37474F"/>
                                <Run Text="{Binding Description, Mode=OneWay}" Foreground="#455A64"/>
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4">
                                <Run Text="关联：" FontWeight="Bold" Foreground="#37474F"/>
                                <Run Text="{Binding Relationships, Mode=OneWay}" Foreground="#455A64"/>
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="12">
                                <Run Text="维护：" FontWeight="Bold" Foreground="#37474F"/>
                                <Run Text="{Binding MaintenanceNotes, Mode=OneWay}" Foreground="#6A1B9A"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 备份/还原：同一区块；按钮按角色启用（无权限时灰显） -->
        <Border Grid.Row="2"
                Background="#F3F8FF"
                BorderBrush="#BBDEFB"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="数据库备份与还原"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#1565C0"
                           Margin="0,0,0,4"/>
                <TextBlock Text="{Binding DatabasePathText, Mode=OneWay}"
                           FontSize="11"
                           Foreground="#546E7A"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4"/>
                <TextBlock Text="{Binding DatabaseBackupHintText, Mode=OneWay}"
                           FontSize="11"
                           Foreground="#455A64"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
                <WrapPanel>
                    <Button Content="💾 备份当前库"
                            Command="{Binding BackupDatabaseCommand}"
                            Margin="0,0,8,0"
                            Padding="10,4"
                            Style="{StaticResource ToolbarActionButtonStyle}"
                            ToolTip="仅系统管理员可执行"/>
                    <Button Content="♻ 从备份还原"
                            Command="{Binding RestoreDatabaseCommand}"
                            Padding="10,4"
                            Style="{StaticResource ToolbarDangerButtonStyle}"
                            ToolTip="仅系统管理员可执行"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Background="#F3F8FF"
                BorderBrush="#BBDEFB"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="数据字典维护（SchemaDictionary.yaml）"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#1565C0"
                           Margin="0,0,0,6"/>
                <TextBlock Text="{Binding DictionaryPathText, Mode=OneWay}"
                           FontSize="11"
                           Foreground="#546E7A"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4"/>
                <TextBlock Text="{Binding DictionaryStatusText, Mode=OneWay}"
                           FontSize="11"
                           Foreground="#455A64"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
                <WrapPanel>
                    <Button Content="🔄 同步 EF 模型到字典"
                            Command="{Binding SyncModelToDictionaryCommand}"
                            Margin="0,0,8,0"
                            Padding="10,4"
                            Style="{StaticResource ToolbarActionButtonStyle}"
                            ToolTip="仅系统管理员可执行"/>
                    <Button Content="⬆ 导出 DB 显示名到字典"
                            Command="{Binding ExportDisplayNamesToDictionaryCommand}"
                            Margin="0,0,8,0"
                            Padding="10,4"
                            Style="{StaticResource ToolbarActionButtonStyle}"
                            ToolTip="仅系统管理员可执行"/>
                    <Button Content="⬇ 从字典重置 DB 显示名"
                            Command="{Binding ApplyDictionaryToDatabaseCommand}"
                            Padding="10,4"
                            Style="{StaticResource ToolbarActionButtonStyle}"
                            ToolTip="仅系统管理员可执行"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="4"
                Background="#FAFAFA"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,10">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="字段显示名：" VerticalAlignment="Center" FontWeight="Bold"/>
                    <ComboBox Width="220"
                              Margin="8,0,0,0"
                              ItemsSource="{Binding TableFields}"
                              DisplayMemberPath="FieldName"
                              SelectedItem="{Binding SelectedField, Mode=TwoWay}"/>
                    <TextBlock Text="中文显示名：" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="Bold"/>
                    <TextBox Width="180"
                             Margin="8,0,0,0"
                             VerticalContentAlignment="Center"
                             IsEnabled="{Binding CanEditFieldDisplayName}"
                             Text="{Binding FieldDisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="💾 保存显示名并写回字典"
                            Command="{Binding SaveFieldDisplayNameCommand}"
                            Margin="10,0,0,0"
                            Padding="10,4"
                            Style="{StaticResource ToolbarActionButtonStyle}"
                            ToolTip="仅系统管理员可执行"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 多列表浏览：关闭列虚拟化，避免 ScrollViewer.ExtentWidth 低估导致水平滚动不到末列；
             显式 Auto 水平滚动；表头按内容量度（见 code-behind），防止列被压进视口后滚动条消失。 -->
        <DataGrid x:Name="RecordsDataGrid"
                  Grid.Row="5"
                  ItemsSource="{Binding RecordsView}"
                  SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                  AutoGenerateColumns="True"
                  AutoGeneratingColumn="RecordsDataGrid_OnAutoGeneratingColumn"
                  AutoGeneratedColumns="RecordsDataGrid_OnAutoGeneratedColumns"
                  ColumnHeaderHeight="72"
                  ColumnHeaderStyle="{StaticResource AdvancedDataGridHeaderStyle}"
                  EnableColumnVirtualization="False"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.CanContentScroll="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  BorderThickness="1"
                  BorderBrush="#DDD"
                  SelectionMode="Single">
            <DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="删除选中行" Command="{Binding DeleteSelectedCommand}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <Border Grid.Row="6"
                Background="#FAFAFA"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,8"
                Margin="0,10,0,0"
                Visibility="{Binding HasSelectedTable, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="每页条数：" VerticalAlignment="Center" FontWeight="Bold"/>
                    <ComboBox Width="80"
                              Height="28"
                              Margin="8,0,16,0"
                              ItemsSource="{Binding PageSizeOptions}"
                              SelectedItem="{Binding PageSize, Mode=TwoWay}"/>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="#546E7A"
                               Margin="0,0,24,0"
                               Text="{Binding PageInfo, Mode=OneWay}"/>
                    <Button Content="首页"
                            Width="64"
                            Margin="0,0,6,0"
                            Padding="8,2"
                            Style="{StaticResource ToolbarActionButtonStyle}"
                            Command="{Binding FirstPageCommand}"/>
                    <Button Content="上一页"
                            Width="72"
                            Margin="0,0,6,0"
                            Padding="8,2"
                            Style="{StaticResource ToolbarActionButtonStyle}"
                            Command="{Binding PreviousPageCommand}"/>
                    <Button Content="下一页"
                            Width="72"
                            Margin="0,0,6,0"
                            Padding="8,2"
                            Style="{StaticResource ToolbarActionButtonStyle}"
                            Command="{Binding NextPageCommand}"/>
                    <Button Content="末页"
                            Width="64"
                            Margin="0,0,12,0"
                            Padding="8,2"
                            Style="{StaticResource ToolbarActionButtonStyle}"
                            Command="{Binding LastPageCommand}"/>
                    <TextBlock Text="跳至：" VerticalAlignment="Center"/>
                    <TextBox Width="48"
                             Height="28"
                             VerticalContentAlignment="Center"
                             TextAlignment="Center"
                             Text="{Binding GoToPageText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="页" VerticalAlignment="Center" Margin="6,0,8,0"/>
                    <Button Content="跳转"
                            Width="64"
                            Padding="8,2"
                            Style="{StaticResource ToolbarActionButtonStyle}"
                            Command="{Binding GoToPageCommand}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <ScrollViewer Grid.Row="7"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0"
                           Foreground="Gray"/>

                <Button Content="🗑 删除选中记录"
                        Command="{Binding DeleteSelectedCommand}"
                        Width="140"
                        Style="{StaticResource ToolbarDangerButtonStyle}"
                        Margin="0,0,10,0"
                        ToolTip="仅系统管理员可执行"/>

                <Button Content="☢️ 清空当前表"
                        Command="{Binding ClearTableCommand}"
                        Width="140"
                        Style="{StaticResource ToolbarDangerButtonStyle}"
                        ToolTip="仅系统管理员可执行"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
