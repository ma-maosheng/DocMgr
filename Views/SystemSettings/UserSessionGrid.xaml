<local:LedgerGridHost x:Class="DocMgr.Views.SystemSettings.UserSessionGrid"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:local="clr-namespace:DocMgr.Views.Shared"
                      xmlns:settings="clr-namespace:DocMgr.Views.SystemSettings">
    <local:LedgerGridHost.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:BindingProxy x:Key="SelfProxy"/>
    </local:LedgerGridHost.Resources>
    <DataGrid ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=settings:UserSessionGrid}}"
              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
              SelectionMode="Single" BorderThickness="1" BorderBrush="#E0E0E0"
              RowHeight="35" ColumnHeaderHeight="40"
              VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <DataGrid.Columns>
            <DataGridTextColumn Header="登录账号" Binding="{Binding LoginName, Mode=OneWay}" Width="120"/>
            <DataGridTextColumn Header="真实姓名" Binding="{Binding RealName, Mode=OneWay}" Width="100"/>
            <DataGridTextColumn Header="部门" Binding="{Binding Department, Mode=OneWay}" Width="140"/>
            <DataGridTextColumn Header="角色" Binding="{Binding Role, Mode=OneWay}" Width="120"/>
            <DataGridTextColumn Header="终端" Binding="{Binding TerminalName, Mode=OneWay}" Width="140"/>
            <DataGridTextColumn Header="登录时间" Binding="{Binding LoginTime, Mode=OneWay, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150"/>
            <DataGridTextColumn Header="最近心跳" Binding="{Binding LastHeartbeatTime, Mode=OneWay, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150"/>
            <DataGridTextColumn Header="结束时间" Binding="{Binding LogoutTime, Mode=OneWay, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150">
                <DataGridTextColumn.Visibility>
                    <Binding Path="Data.ShowEndTime" Source="{StaticResource SelfProxy}" Converter="{StaticResource BooleanToVisibilityConverter}"/>
                </DataGridTextColumn.Visibility>
            </DataGridTextColumn>
            <DataGridTextColumn Header="状态" Binding="{Binding StatusDisplay, Mode=OneWay}" Width="*"/>
        </DataGrid.Columns>
    </DataGrid>
</local:LedgerGridHost>
