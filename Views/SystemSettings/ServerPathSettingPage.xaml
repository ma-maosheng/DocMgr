<Page x:Class="DocMgr.Views.SystemSettings.ServerPathSettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:vm="clr-namespace:DocMgr.ViewModels.SystemSettings"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      Title="服务器路径设置" Background="White"
      d:DataContext="{d:DesignInstance Type=vm:ServerPathSettingViewModel}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource ToolbarCardBorderStyle}"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="0,0,0,10"
                Margin="0,0,0,20">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <Button Content="新增路径"
                            Command="{Binding AddCommand}"
                            Width="100"
                            Margin="0,0,10,0"
                            Style="{StaticResource ToolbarActionButtonStyle}"/>
                    <Button Content="编辑路径"
                            Command="{Binding EditCommand}"
                            Width="100"
                            Margin="0,0,10,0"
                            Style="{StaticResource ToolbarActionButtonStyle}"/>
                    <Button Content="删除选中"
                            Command="{Binding DeleteCommand}"
                            Width="100"
                            Margin="0,0,10,0"
                            Style="{StaticResource ToolbarDangerButtonStyle}"/>
                    <Button Content="刷新列表"
                            Command="{Binding RefreshCommand}"
                            Width="100"
                            Style="{StaticResource ToolbarActionButtonStyle}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <DataGrid Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  ItemsSource="{Binding Settings}"
                  SelectedItem="{Binding SelectedSetting}"
                  BorderThickness="1"
                  BorderBrush="#E0E0E0"
                  RowHeight="35"
                  ColumnHeaderHeight="40">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                <DataGridTextColumn Header="部门" Binding="{Binding DepartmentName}" Width="160"/>
                <DataGridTextColumn Header="路径名称" Binding="{Binding PathName}" Width="180"/>
                <DataGridTextColumn Header="物理地址" Binding="{Binding PhysicalPath}" Width="*"/>
                <DataGridTextColumn Header="权限" Binding="{Binding Permission}" Width="100"/>
                <DataGridTextColumn Header="容量(TB)" Binding="{Binding CapacityTb}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
