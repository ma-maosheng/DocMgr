<Page x:Class="DocMgr.Views.SystemSettings.TestPreparationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:DocMgr.ViewModels.SystemSettings"
      mc:Ignorable="d"
      Title="TestPreparationPage"
      Background="White"
      d:DataContext="{d:DesignInstance Type=vm:TestPreparationPageViewModel}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="测试准备"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#263238"/>
            <TextBlock Margin="0,8,0,0"
                       Foreground="#546E7A"
                       TextWrapping="Wrap"
                       Text="用于在删除数据库后快速填入测试数据。系统会从解决方案目录下的“测试数据”文件夹读取预置工作簿，并调用现有导入功能完成入库。"/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,18,0,18"
                Padding="14"
                Background="#F7FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="4">
            <StackPanel>
                <TextBlock Text="执行状态"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#2D3748"/>
                <TextBlock Margin="0,8,0,0"
                           Text="{Binding StatusText}"
                           TextWrapping="Wrap"
                           Foreground="#4A5568"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2">
            <Border Padding="18" Margin="0,0,0,14" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="历史存档资料表（地形图）" FontSize="16" FontWeight="Bold" Foreground="#263238"/>
                        <TextBlock Margin="0,8,0,0" Foreground="#546E7A" TextWrapping="Wrap"
                                   Text="读取“测试数据\历史存档地形图台账.xlsx”，按工作簿中的各表数据导入历史存档地形图表。"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="220"
                            Height="36"
                            VerticalAlignment="Center"
                            Content="填入历史存档资料表（地形图）"
                            Command="{Binding ImportTopoMapsCommand}"
                            Style="{StaticResource ButtonNormalStyle}"/>
                </Grid>
            </Border>

            <Border Padding="18" Margin="0,0,0,14" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="历史存档资料表（航摄影像）" FontSize="16" FontWeight="Bold" Foreground="#263238"/>
                        <TextBlock Margin="0,8,0,0" Foreground="#546E7A" TextWrapping="Wrap"
                                   Text="读取“测试数据\历史存档航片台账.xlsx”，按工作簿中的各表数据导入历史存档航摄影像表。"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="220"
                            Height="36"
                            VerticalAlignment="Center"
                            Content="填入历史存档资料表（航摄影像）"
                            Command="{Binding ImportAerialPhotosCommand}"
                            Style="{StaticResource ButtonNormalStyle}"/>
                </Grid>
            </Border>

            <Border Padding="18" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="硬盘（无数据）" FontSize="16" FontWeight="Bold" Foreground="#263238"/>
                        <TextBlock Margin="0,8,0,0" Foreground="#546E7A" TextWrapping="Wrap"
                                   Text="读取“测试数据\硬盘工作簿.xlsx”中的“无数据硬盘”工作表，并使用现有硬盘登记导入逻辑填充硬盘台账。"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="220"
                            Height="36"
                            VerticalAlignment="Center"
                            Content="填入硬盘（无数据）"
                            Command="{Binding ImportBlankHardDisksCommand}"
                            Style="{StaticResource ButtonNormalStyle}"/>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Page>
