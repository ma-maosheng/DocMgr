<Page x:Class="DocMgr.Views.SystemSettings.ToDoOverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:viewShared="clr-namespace:DocMgr.Views.Shared"
      Title="待办事项总览"
      Background="White">
    <Page.Resources>
        <viewShared:InverseBoolToVisConverter x:Key="InverseBoolToVisConverter"/>
    </Page.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding AccessDeniedText}"
                   Foreground="#C62828"
                   Margin="0,0,0,12"
                   Visibility="{Binding CanView, Converter={StaticResource InverseBoolToVisConverter}}"
                   TextWrapping="Wrap"/>

        <Border Grid.Row="1"
                Style="{StaticResource ToolbarCardBorderStyle}"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="0,0,0,10"
                Margin="0,0,0,8"
                IsEnabled="{Binding CanView}">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="关键词："
                               VerticalAlignment="Center"
                               Style="{StaticResource ToolbarFilterLabelStyle}"/>
                    <TextBox Width="220"
                             Height="{StaticResource FormControlHeight}"
                             Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"/>
                    <Button Content="刷新"
                            Command="{Binding RefreshCommand}"
                            Width="90"
                            Margin="12,0,0,0"
                            Style="{StaticResource ToolbarActionButtonStyle}"/>
                    <Button Content="打开办理"
                            Command="{Binding OpenCommand}"
                            Width="100"
                            Margin="8,0,0,0"
                            Style="{StaticResource ToolbarActionButtonStyle}"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           Foreground="#666"
                           FontSize="12"/>
            </DockPanel>
        </Border>

        <DataGrid Grid.Row="2"
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  IsEnabled="{Binding CanView}"
                  BorderThickness="1"
                  BorderBrush="#E0E0E0"
                  RowHeight="35"
                  ColumnHeaderHeight="40"
                  MouseDoubleClick="DgItems_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="优先级" Binding="{Binding Priority}" Width="70"/>
                <DataGridTextColumn Header="阶段" Binding="{Binding Stage}" Width="160"/>
                <DataGridTextColumn Header="单号" Binding="{Binding BizNo}" Width="140"/>
                <DataGridTextColumn Header="待办标题" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="业务类型" Binding="{Binding BizType}" Width="160"/>
                <DataGridTextColumn Header="时间" Binding="{Binding CreatedTime, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
