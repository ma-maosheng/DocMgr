<Page x:Class="DocMgr.Views.SystemSettings.HelpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="帮助文档"
      Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="帮助文档"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#333"/>

        <StackPanel Grid.Row="1" Margin="0,12,0,12">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="程序版本：" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding VersionDisplay, Mode=OneWay}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="当前数据库：" FontWeight="Bold" VerticalAlignment="Top"/>
                <TextBlock Text="{Binding DatabasePathText, Mode=OneWay}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Top"/>
            </StackPanel>
            <TextBlock Text="{Binding DatabaseKindText, Mode=OneWay}"
                       Foreground="#546E7A"
                       FontSize="12"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="2"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12">
            <!-- Style={x:Null} 避开全局 FormTextBoxStyle 的 Height=28，否则长文只露一行。 -->
            <TextBox Text="{Binding GuideText, Mode=OneWay}"
                     Style="{x:Null}"
                     IsReadOnly="True"
                     BorderThickness="0"
                     TextWrapping="Wrap"
                     FontSize="13"
                     AcceptsReturn="True"
                     Background="Transparent"
                     VerticalAlignment="Stretch"
                     HorizontalAlignment="Stretch"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     Padding="4,0"/>
        </Border>
    </Grid>
</Page>
