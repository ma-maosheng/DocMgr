<Page x:Class="DocMgr.Views.SystemSettings.HelpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="操作手册"
      Background="#F3F6F7">

    <Page.Resources>
        <LinearGradientBrush x:Key="HelpHeroBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F6B63" Offset="0"/>
            <GradientStop Color="#2C8F84" Offset="0.55"/>
            <GradientStop Color="#8CCDC3" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="HelpTocItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemChrome"
                                CornerRadius="10"
                                Padding="10,8"
                                Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#E7F4F2"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#0F6B63"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HelpTocTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HelpTocIndexBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Background" Value="#E0F2F1"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Background" Value="#1AFFFFFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HelpTocIndexTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F6B63"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="14,8,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource HelpHeroBrush}"
                CornerRadius="14"
                Padding="18,14"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="操作手册"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="按目录查阅办理步骤。无权限菜单为灰色；先处理右上角待办，再进入对应页面。"
                               Foreground="#E8FFFB"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,6,24,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="220">
                    <Border Background="#22FFFFFF" CornerRadius="8" Padding="10,6" Margin="0,0,0,6">
                        <TextBlock Text="{Binding VersionDisplay, Mode=OneWay}"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>
                    </Border>
                    <Border Background="#18FFFFFF" CornerRadius="8" Padding="10,6">
                        <StackPanel>
                            <TextBlock Text="{Binding DatabaseKindText, Mode=OneWay}"
                                       Foreground="#F0FFFC"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding DatabasePathText, Mode=OneWay}"
                                       Foreground="#D6FFF8"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="White"
                    BorderBrush="#E4E8EC"
                    BorderThickness="1"
                    CornerRadius="14">
                <Border.Effect>
                    <DropShadowEffect Color="#14000000" BlurRadius="16" ShadowDepth="2" Opacity="0.16"/>
                </Border.Effect>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="目录"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="#0F172A"
                               Margin="16,14,16,8"/>
                    <ListBox ItemsSource="{Binding Sections}"
                             SelectedItem="{Binding SelectedSection}"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="4,0,4,10"
                             ItemContainerStyle="{StaticResource HelpTocItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Left"
                                            Style="{StaticResource HelpTocIndexBorderStyle}">
                                        <TextBlock Text="{Binding IndexText, Mode=OneWay}"
                                                   Style="{StaticResource HelpTocIndexTextStyle}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Title, Mode=OneWay}"
                                               Style="{StaticResource HelpTocTitleStyle}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#E4E8EC"
                    BorderThickness="1"
                    CornerRadius="14">
                <Border.Effect>
                    <DropShadowEffect Color="#14000000" BlurRadius="16" ShadowDepth="2" Opacity="0.16"/>
                </Border.Effect>
                <FlowDocumentScrollViewer x:Name="ManualViewer"
                                          IsToolBarVisible="False"
                                          Zoom="100"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="18,12,8,12"
                                          BorderThickness="0"/>
            </Border>
        </Grid>
    </Grid>
</Page>
