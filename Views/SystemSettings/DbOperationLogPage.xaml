<Page x:Class="DocMgr.Views.SystemSettings.DbOperationLogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="数据库操作日志"
      Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource ToolbarCardBorderStyle}"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="0,0,0,10"
                Margin="0,0,0,12">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="开始：" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding StartTime, Mode=TwoWay}" Width="130" Margin="0,0,12,0"/>
                    <TextBlock Text="结束：" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding EndTime, Mode=TwoWay}" Width="130" Margin="0,0,12,0"/>
                    <TextBlock Text="表名：" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="180"
                              ItemsSource="{Binding TableNameOptions}"
                              SelectedItem="{Binding SelectedTableName, Mode=TwoWay}"
                              Margin="0,0,12,0"/>
                    <TextBlock Text="操作：" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="110"
                              ItemsSource="{Binding OperationOptions}"
                              SelectedItem="{Binding SelectedOperation, Mode=TwoWay}"
                              Margin="0,0,12,0"/>
                    <TextBlock Text="关键字：" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Width="180"
                             Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,12,0"/>
                    <Button Content="查询"
                            Command="{Binding RefreshCommand}"
                            Width="90"
                            Margin="0,0,10,0"
                            Style="{StaticResource ToolbarActionButtonStyle}"/>
                    <Button Content="查看详情"
                            Command="{Binding ViewDetailCommand}"
                            Width="100"
                            Margin="0,0,10,0"
                            Style="{StaticResource ToolbarActionButtonStyle}"/>
                    <Button Content="清除所有日志"
                            Command="{Binding ClearAllCommand}"
                            Width="110"
                            Margin="0,0,10,0"
                            Style="{StaticResource ToolbarDangerButtonStyle}"/>
                    <Button Content="停止记录"
                            Command="{Binding StopRecordingCommand}"
                            Width="90"
                            Margin="0,0,10,0"
                            Style="{StaticResource ToolbarActionButtonStyle}"/>
                    <Button Content="启动记录"
                            Command="{Binding StartRecordingCommand}"
                            Width="90"
                            Style="{StaticResource ToolbarActionButtonStyle}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusText}"
                   Foreground="#666"
                   Margin="0,0,0,8"/>

        <DataGrid Grid.Row="2"
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding Logs}"
                  SelectedItem="{Binding SelectedLog}"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  BorderThickness="1"
                  BorderBrush="#E0E0E0"
                  RowHeight="35"
                  ColumnHeaderHeight="40"
                  MouseDoubleClick="DgLogs_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="时间" Binding="{Binding OperationTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150"/>
                <DataGridTextColumn Header="操作人" Binding="{Binding UserName}" Width="90"/>
                <DataGridTextColumn Header="来源页面" Binding="{Binding SourcePage}" Width="180"/>
                <DataGridTextColumn Header="来源按钮" Binding="{Binding SourceButton}" Width="120"/>
                <DataGridTextColumn Header="操作" Binding="{Binding Operation}" Width="80"/>
                <DataGridTextColumn Header="表名" Binding="{Binding TableName}" Width="180"/>
                <DataGridTextColumn Header="实体" Binding="{Binding EntityType}" Width="160"/>
                <DataGridTextColumn Header="主键/标识" Binding="{Binding EntityKey}" Width="160"/>
                <DataGridTextColumn Header="摘要" Binding="{Binding Summary}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
