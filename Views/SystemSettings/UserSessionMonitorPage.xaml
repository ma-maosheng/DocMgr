<Page x:Class="DocMgr.Views.SystemSettings.UserSessionMonitorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:viewShared="clr-namespace:DocMgr.Views.Shared"
      xmlns:local="clr-namespace:DocMgr.Views.SystemSettings"
      mc:Ignorable="d"
      Title="在线用户与登录记录"
      Background="White">
    <Page.Resources>
        <viewShared:InverseBoolToVisConverter x:Key="InverseBoolToVisConverter"/>
    </Page.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding AccessDeniedText}"
                   Foreground="#C62828"
                   Margin="0,0,0,12"
                   Visibility="{Binding CanView, Converter={StaticResource InverseBoolToVisConverter}}"
                   TextWrapping="Wrap"/>

        <TabControl Grid.Row="1" IsEnabled="{Binding CanView}">
            <TabItem Header="当前在线">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Style="{StaticResource ToolbarCardBorderStyle}"
                            BorderBrush="#E0E0E0"
                            BorderThickness="0,0,0,1"
                            Padding="0,0,0,10"
                            Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="刷新"
                                    Command="{Binding RefreshOnlineCommand}"
                                    Width="90"
                                    Style="{StaticResource ToolbarActionButtonStyle}"/>
                            <TextBlock Text="单点登录下同一账号仅保留一个活跃会话；客户端约每分钟心跳一次。"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       Foreground="#666"
                                       FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="1"
                               Text="{Binding OnlineStatusText}"
                               Foreground="#666"
                               Margin="0,0,0,8"/>

                    <local:UserSessionGrid Grid.Row="2" ItemsSource="{Binding OnlineUsers}"/>
                </Grid>
            </TabItem>

            <TabItem Header="登录记录">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Style="{StaticResource ToolbarCardBorderStyle}"
                            BorderBrush="#E0E0E0"
                            BorderThickness="0,0,0,1"
                            Padding="0,0,0,10"
                            Margin="0,0,0,8">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="开始：" VerticalAlignment="Center"/>
                                <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}" Width="130" Margin="0,0,12,0"/>
                                <TextBlock Text="结束：" VerticalAlignment="Center"/>
                                <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}" Width="130" Margin="0,0,12,0"/>
                                <TextBlock Text="关键字：" VerticalAlignment="Center"/>
                                <TextBox Width="180"
                                         Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,12,0"
                                         ToolTip="登录账号、姓名、部门、角色、终端"/>
                                <Button Content="查询"
                                        Command="{Binding RefreshLoginRecordsCommand}"
                                        Width="90"
                                        Style="{StaticResource ToolbarActionButtonStyle}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Grid.Row="1"
                               Text="{Binding LoginRecordStatusText}"
                               Foreground="#666"
                               Margin="0,0,0,8"/>

                    <local:UserSessionGrid Grid.Row="2"
                                          ItemsSource="{Binding LoginRecords}"
                                          ShowEndTime="True"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
