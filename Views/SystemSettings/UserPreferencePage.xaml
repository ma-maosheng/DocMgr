<Page x:Class="DocMgr.Views.SystemSettings.UserPreferencePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="个人设置" Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="个人通知偏好" FontSize="20" FontWeight="Bold" Foreground="#333"/>

        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <CheckBox Content="登录后显示待办弹窗"
                      IsChecked="{Binding EnableToDoPopup}"
                      Margin="0,0,0,12"/>
            <CheckBox Content="主界面显示待办角标"
                      IsChecked="{Binding EnableToDoBadge}"
                      Margin="0,0,0,12"/>
            <CheckBox Content="点击“知道了”后将当前待办标记为已读"
                      IsChecked="{Binding MarkAllAsReadOnAcknowledge}"
                      Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="待办刷新频率(秒)：" Width="150" VerticalAlignment="Center"/>
                <TextBox Width="120"
                         Text="{Binding ToDoRefreshSeconds, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="待办展示条数：" Width="150" VerticalAlignment="Center"/>
                <TextBox Width="120"
                         Text="{Binding ToDoTopN, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="恢复默认"
                    Width="100"
                    Height="32"
                    Margin="0,0,10,0"
                    Command="{Binding ResetDefaultCommand}"/>
            <Button Content="保存设置"
                    Width="100"
                    Height="32"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Page>