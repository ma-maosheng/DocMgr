<Window x:Class="DocMgr.Views.SystemSettings.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewShared="clr-namespace:DocMgr.Views.Shared"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#F5F5F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button Content="关闭"
                Command="{x:Static viewShared:ViewCommands.CloseCurrentView}"
                Style="{StaticResource DialogCloseButtonStyle}"
                HorizontalAlignment="Right"/>

        <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="18" FontWeight="Bold"
                   Margin="0,0,120,10" Foreground="#333"/>

        <TextBlock Grid.Row="1" Text="{Binding HintText, Mode=OneWay}"
                   TextWrapping="Wrap" FontSize="12" Foreground="#666" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="当前密码 *" Foreground="#666" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PwdCurrent" Padding="5,0" PasswordChanged="PwdCurrent_PasswordChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="新密码 *" Foreground="#666" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PwdNew" Padding="5,0" PasswordChanged="PwdNew_PasswordChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,18">
            <TextBlock Text="确认新密码 *" Foreground="#666" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PwdConfirm" Padding="5,0" PasswordChanged="PwdConfirm_PasswordChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Margin="0,0,10,0"
                    Cursor="Hand"
                    Style="{StaticResource DialogSecondaryActionButtonStyle}"
                    Command="{Binding CancelCommand}"/>
            <Button Content="确定"
                    Cursor="Hand"
                    Style="{StaticResource DialogPrimaryActionButtonStyle}"
                    Command="{Binding ConfirmCommand}"/>
        </StackPanel>
    </Grid>
</Window>
