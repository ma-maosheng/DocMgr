<Page x:Class="DocMgr.Views.SystemSettings.ApprovalWorkflowSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:DocMgr.ViewModels.SystemSettings"
      mc:Ignorable="d"
      Title="审核审批"
      Background="White"
      d:DataContext="{d:DesignInstance Type=vm:ApprovalWorkflowSettingsViewModel}">

    <Page.Resources>
        <Style x:Key="ApprovalSettingsActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Page.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel LastChildFill="False" Margin="0,0,0,10">
            <TextBlock Text="审核审批"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#333"
                       VerticalAlignment="Center"/>
            <TextBlock DockPanel.Dock="Right"
                       Text="配置仅影响未办结单据；已办结单据沿用当时签字快照。"
                       Foreground="#666"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="业务类型" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ListBox ItemsSource="{Binding BusinessTypes}"
                             SelectedItem="{Binding SelectedBusinessType}"
                             IsEnabled="{Binding IsListEnabled}"
                             DisplayMemberPath="DisplayName"
                             BorderThickness="0"/>
                </DockPanel>
            </Border>

            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="新增" Width="72" Margin="0,0,6,0"
                            Style="{StaticResource ApprovalSettingsActionButtonStyle}"
                            Command="{Binding AddRuleCommand}"/>
                    <Button Content="编辑" Width="72" Margin="0,0,6,0"
                            Style="{StaticResource ApprovalSettingsActionButtonStyle}"
                            Command="{Binding EditRuleCommand}"/>
                    <Button Content="删除" Width="72" Margin="0,0,6,0"
                            Style="{StaticResource ApprovalSettingsActionButtonStyle}"
                            Command="{Binding DeleteRuleCommand}"/>
                    <Button Content="上移" Width="64" Margin="0,0,6,0"
                            Style="{StaticResource ApprovalSettingsActionButtonStyle}"
                            Command="{Binding MoveUpCommand}"/>
                    <Button Content="下移" Width="64" Margin="0,0,6,0"
                            Style="{StaticResource ApprovalSettingsActionButtonStyle}"
                            Command="{Binding MoveDownCommand}"/>
                    <Button Content="刷新" Width="64"
                            Style="{StaticResource ApprovalSettingsActionButtonStyle}"
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Rules}"
                          SelectedItem="{Binding SelectedRule}"
                          IsEnabled="{Binding IsListEnabled}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#FAFAFA">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="优先级" Binding="{Binding Priority}" Width="60"/>
                        <DataGridTextColumn Header="规则名称" Binding="{Binding RuleName}" Width="140"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding EnabledDisplay}" Width="50"/>
                        <DataGridTextColumn Header="条件" Binding="{Binding ConditionSummary}" Width="*"/>
                        <DataGridTextColumn Header="签批节点" Binding="{Binding NodesSummary}" Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <Border Grid.Column="4" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel IsEnabled="{Binding IsEditing}">
                        <TextBlock Text="规则编辑" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="规则名称" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditRuleName, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,8"/>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="优先级（越小越优先）" VerticalAlignment="Center" Width="140"/>
                            <TextBox Text="{Binding EditPriority, UpdateSourceTrigger=PropertyChanged}" Height="28" Width="80" HorizontalAlignment="Left"/>
                        </DockPanel>
                        <CheckBox Content="启用本规则" IsChecked="{Binding EditIsEnabled}" Margin="0,0,0,10"/>

                        <TextBlock Text="匹配条件（最多 2 个）" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="条件1字段" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding ConditionFieldOptions}"
                                  SelectedItem="{Binding EditCondition1Field}"
                                  DisplayMemberPath="DisplayName"
                                  Height="28"
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="条件1取值" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding Condition1ValueOptions}"
                                  SelectedItem="{Binding EditCondition1Value}"
                                  IsEditable="True"
                                  Height="28"
                                  Margin="0,0,0,8"/>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="逻辑" Width="40" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding ConditionLogicOptions}"
                                      SelectedValue="{Binding EditConditionLogic}"
                                      SelectedValuePath="Code"
                                      DisplayMemberPath="Label"
                                      Height="28"/>
                        </DockPanel>
                        <TextBlock Text="条件2字段" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding ConditionFieldOptions}"
                                  SelectedItem="{Binding EditCondition2Field}"
                                  DisplayMemberPath="DisplayName"
                                  Height="28"
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="条件2取值" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding Condition2ValueOptions}"
                                  SelectedItem="{Binding EditCondition2Value}"
                                  IsEditable="True"
                                  Height="28"
                                  Margin="0,0,0,10"/>

                        <TextBlock Text="一级 · 部门审核" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <CheckBox Content="启用部门审核" IsChecked="{Binding EditEnableDeptHead}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding UserOptions}"
                                  SelectedItem="{Binding EditDeptHeadUser}"
                                  DisplayMemberPath="DisplayName"
                                  Height="28"
                                  Margin="0,0,0,8"/>

                        <TextBlock Text="二级 · 职能部门审核" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <CheckBox Content="启用资料室签字" IsChecked="{Binding EditEnableArchiveRoomHead}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding UserOptions}"
                                  SelectedItem="{Binding EditArchiveRoomHeadUser}"
                                  DisplayMemberPath="DisplayName"
                                  Height="28"
                                  Margin="0,0,0,6"/>
                        <CheckBox Content="启用生产科签字" IsChecked="{Binding EditEnableProductionHead}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding UserOptions}"
                                  SelectedItem="{Binding EditProductionHeadUser}"
                                  DisplayMemberPath="DisplayName"
                                  Height="28"
                                  Margin="0,0,0,8"/>

                        <TextBlock Text="三级 · 院级审批" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <CheckBox Content="启用分管资料院长签字" IsChecked="{Binding EditEnableArchiveDeputyPresident}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding UserOptions}"
                                  SelectedItem="{Binding EditArchiveDeputyPresidentUser}"
                                  DisplayMemberPath="DisplayName"
                                  Height="28"
                                  Margin="0,0,0,6"/>
                        <CheckBox Content="启用分管生产院长签字" IsChecked="{Binding EditEnableProductionVicePresident}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding UserOptions}"
                                  SelectedItem="{Binding EditProductionVicePresidentUser}"
                                  DisplayMemberPath="DisplayName"
                                  Height="28"
                                  Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="取消" Width="72" Margin="0,0,8,0"
                                    Style="{StaticResource ApprovalSettingsActionButtonStyle}"
                                    Command="{Binding CancelEditCommand}"/>
                            <Button Content="保存规则" Width="88"
                                    Style="{StaticResource ApprovalSettingsActionButtonStyle}"
                                    Command="{Binding SaveRuleCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right"
                    Content="恢复全部默认规则"
                    Width="140"
                    Style="{StaticResource ApprovalSettingsActionButtonStyle}"
                    Command="{Binding ResetDefaultsCommand}"/>
            <Button DockPanel.Dock="Right"
                    Content="覆盖导入"
                    Width="88"
                    Margin="0,0,8,0"
                    Style="{StaticResource ApprovalSettingsActionButtonStyle}"
                    Command="{Binding ImportRulesCommand}"/>
            <Button DockPanel.Dock="Right"
                    Content="导出 JSON"
                    Width="88"
                    Margin="0,0,8,0"
                    Style="{StaticResource ApprovalSettingsActionButtonStyle}"
                    Command="{Binding ExportRulesCommand}"/>
        </DockPanel>
    </Grid>
</Page>
