<Window x:Class="DocMgr.Views.SystemSettings.UserEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewShared="clr-namespace:DocMgr.Views.Shared"
        Title="{Binding Title, Mode=OneWay}"
        MinWidth="450"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F5F5F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,15" LastChildFill="True">
            <Button DockPanel.Dock="Right"
                    Content="关闭"
                    Command="{x:Static viewShared:ViewCommands.CloseCurrentView}"
                    Style="{StaticResource DialogCloseButtonStyle}"
                    VerticalAlignment="Top"/>
            <TextBlock Text="{Binding Title, Mode=OneWay}"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#333"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="登录账号 *：" Foreground="#666" Margin="0,0,0,5"/>
                <TextBox Height="{StaticResource DialogFormControlHeight}"
                         Padding="5,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding LoginName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="真实姓名 *：" Foreground="#666" Margin="0,0,0,5"/>
                <TextBox Height="{StaticResource DialogFormControlHeight}"
                         Padding="5,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding RealName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="所属部门：" Foreground="#666" Margin="0,0,0,5"/>
                <ComboBox Height="{StaticResource DialogFormControlHeight}"
                          Padding="5,0"
                          VerticalContentAlignment="Center"
                          ItemsSource="{Binding DepartmentOptions}"
                          SelectedItem="{Binding SelectedDepartment, Mode=TwoWay}"
                          IsEditable="True"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="用户角色：" Foreground="#666" Margin="0,0,0,5"/>
                <ComboBox Height="{StaticResource DialogFormControlHeight}"
                          Padding="5,0"
                          VerticalContentAlignment="Center"
                          ItemsSource="{Binding RoleOptions}"
                          SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                          IsEditable="True"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,0,0,16">
            <TextBlock Text="登录密码：" Foreground="#666" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PwdBox"
                         Height="{StaticResource DialogFormControlHeight}"
                         Padding="5,0"
                         VerticalContentAlignment="Center"
                         PasswordChanged="PwdBox_PasswordChanged"/>
            <TextBlock Text="确认密码：" Foreground="#666" Margin="0,8,0,5"/>
            <PasswordBox x:Name="PwdConfirmBox"
                         Height="{StaticResource DialogFormControlHeight}"
                         Padding="5,0"
                         VerticalContentAlignment="Center"
                         PasswordChanged="PwdConfirmBox_PasswordChanged"/>
            <TextBlock Text="{Binding PasswordHint, Mode=OneWay}"
                       FontSize="11"
                       Foreground="#999"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消"
                    Margin="0,0,10,0"
                    Cursor="Hand"
                    Style="{StaticResource DialogSecondaryActionButtonStyle}"
                    Command="{Binding CancelCommand}"/>
            <Button Content="确定"
                    Cursor="Hand"
                    Style="{StaticResource DialogPrimaryActionButtonStyle}"
                    Command="{Binding ConfirmCommand}"/>
        </StackPanel>
    </Grid>
</Window>
