<Window x:Class="DocMgr.Views.SystemSettings.ServerPathSettingEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewShared="clr-namespace:DocMgr.Views.Shared"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F5F5F5">

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button Content="关闭"
                    Command="{x:Static viewShared:ViewCommands.CloseCurrentView}"
                    Style="{StaticResource DialogCloseButtonStyle}"
                    HorizontalAlignment="Right"/>

            <TextBlock Text="{Binding TitleText}"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,120,15"
                       Foreground="#333"/>

            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock Text="部门 *" Foreground="#666" Margin="0,0,0,5"/>
                <ComboBox Padding="5,0"
                          FontSize="14"
                          ItemsSource="{Binding DepartmentOptions}"
                          SelectedItem="{Binding SelectedDepartment, Mode=TwoWay}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <TextBlock Text="路径名称 *" Foreground="#666" Margin="0,0,0,5"/>
                <TextBox Padding="5,0"
                         FontSize="14"
                         BorderBrush="#CCC"
                         Text="{Binding PathName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,12">
                <TextBlock Text="物理地址 *" Foreground="#666" Margin="0,0,0,5"/>
                <TextBox Padding="5,0"
                         FontSize="14"
                         BorderBrush="#CCC"
                         Text="{Binding PhysicalPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,0,0,12">
                <TextBlock Text="权限 *" Foreground="#666" Margin="0,0,0,5"/>
                <ComboBox Padding="5,0"
                          FontSize="14"
                          ItemsSource="{Binding PermissionOptions}"
                          SelectedItem="{Binding SelectedPermission, Mode=TwoWay}"/>
            </StackPanel>

            <StackPanel Grid.Row="5" Margin="0,0,0,25">
                <TextBlock Text="容量(TB) *" Foreground="#666" Margin="0,0,0,5"/>
                <TextBox Padding="5,0"
                         FontSize="14"
                         BorderBrush="#CCC"
                         Text="{Binding CapacityTbText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="取消"
                        Margin="0,0,10,0"
                        Cursor="Hand"
                        Style="{StaticResource DialogSecondaryActionButtonStyle}"
                        Command="{Binding CancelCommand}"/>
                <Button Content="确定"
                        Cursor="Hand"
                        Style="{StaticResource DialogPrimaryActionButtonStyle}"
                        Command="{Binding ConfirmCommand}"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
