<Window x:Class="DocMgr.Views.YearlyArchive.StockTextArchiveExcelImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="存档文本直办 · Excel 导入预览"
        Width="1280"
        Height="620"
        MinWidth="960"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Background="#F5F7FA">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
            <CheckBox DockPanel.Dock="Right"
                      Content="按档案盒展开"
                      VerticalAlignment="Top"
                      Margin="12,0,0,0"
                      IsChecked="{Binding ExpandByBox, Mode=TwoWay}"
                      ToolTip="勾选：一盒一行（子项字段汇总）；不勾选：按资料子项逐行展开"/>
            <TextBlock FontSize="12"
                       Foreground="#546E7A"
                       TextWrapping="Wrap"
                       Text="{Binding SummaryText, Mode=OneWay}"/>
        </DockPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  RowHeight="28"
                  ColumnHeaderHeight="32"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="1"
                  BorderBrush="#E0E0E0"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="序号" Binding="{Binding SequenceNo, Mode=OneWay}" Width="44"/>
                <DataGridTextColumn Header="年度" Binding="{Binding Year, Mode=OneWay}" Width="56"/>
                <DataGridTextColumn Header="项目名称" Binding="{Binding ProjectName, Mode=OneWay}" Width="140" MinWidth="100"/>
                <DataGridTextColumn Header="项目编号" Binding="{Binding ProjectCode, Mode=OneWay}" Width="100"/>
                <DataGridTextColumn Header="资料名称" Binding="{Binding MaterialName, Mode=OneWay}" Width="100"/>
                <DataGridTextColumn Header="来源" Binding="{Binding SourceType, Mode=OneWay}" Width="56"/>
                <DataGridTextColumn Header="提供单位" Binding="{Binding ProvideUnit, Mode=OneWay}" Width="88"/>
                <DataGridTextColumn Header="库管模式" Binding="{Binding ArchivePurpose, Mode=OneWay}" Width="140"/>
                <DataGridTextColumn Header="载体类型" Binding="{Binding MediaType, Mode=OneWay}" Width="80"/>
                <DataGridTextColumn Header="盒数" Binding="{Binding BoxCountText, Mode=OneWay}" Width="44"/>
                <DataGridTextColumn Header="档案盒编号" Binding="{Binding BoxLocation, Mode=OneWay}" Width="110"/>
                <DataGridTextColumn Header="档案盒规格" Binding="{Binding BoxSpecification, Mode=OneWay}" Width="92"/>
                <DataGridTextColumn Header="盒备注" Binding="{Binding BoxRemarks, Mode=OneWay}" Width="88"/>
                <DataGridTextColumn Header="子项名称" Binding="{Binding ItemName, Mode=OneWay}" Width="140" MinWidth="100"/>
                <DataGridTextColumn Header="份数" Binding="{Binding CopyCountText, Mode=OneWay}" Width="44"/>
                <DataGridTextColumn Header="密级" Binding="{Binding ConfidentialLevel, Mode=OneWay}" Width="56"/>
                <DataGridTextColumn Header="资料类型" Binding="{Binding MaterialCategory, Mode=OneWay}" Width="72"/>
                <DataGridTextColumn Header="所属子类" Binding="{Binding SubCategory, Mode=OneWay}" Width="100"/>
                <DataGridTextColumn Header="组织形式" Binding="{Binding OrganizationForm, Mode=OneWay}" Width="72"/>
                <DataGridTextColumn Header="子项备注" Binding="{Binding ItemNote, Mode=OneWay}" Width="100"/>
                <DataGridTextColumn Header="状态" Binding="{Binding StatusText, Mode=OneWay}" Width="72"/>
                <DataGridTextColumn Header="校验" Binding="{Binding ErrorText, Mode=OneWay}" Width="220" MinWidth="140">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding ErrorText, Mode=OneWay}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right"
                    Content="确认整批导入"
                    Command="{Binding ConfirmCommand}"
                    Padding="14,4"
                    MinHeight="28"
                    FontWeight="SemiBold"
                    ToolTip="全部档案盒通过逻辑校验后才可导入"/>
            <Button DockPanel.Dock="Right"
                    Content="取消"
                    Command="{Binding CancelCommand}"
                    Margin="0,0,8,0"
                    Padding="14,4"
                    MinHeight="28"/>
        </DockPanel>

        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <DockPanel LastChildFill="True" Margin="0,0,0,4">
                <TextBlock DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#78909C"
                           MinWidth="56"
                           TextAlignment="Right"
                           Text="{Binding ImportProgressPercentText, Mode=OneWay}"/>
                <TextBlock VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#546E7A"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding ImportProgressStatus, Mode=OneWay}"/>
            </DockPanel>
            <Grid Height="24">
                <ProgressBar Minimum="0"
                             Maximum="100"
                             IsIndeterminate="True">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ImportProgressIsIndeterminate, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <ProgressBar Minimum="0"
                             Maximum="100"
                             IsIndeterminate="False"
                             Value="{Binding ImportProgressValue, Mode=OneWay}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ImportProgressIsIndeterminate, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
