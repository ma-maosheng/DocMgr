<Window x:Class="DocMgr.Views.YearlyArchive.StockTextArchiveExcelImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="存档文本直办 · Excel 导入预览"
        Width="980"
        Height="560"
        MinWidth="800"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Background="#F5F7FA">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,8"
                   FontSize="12"
                   Foreground="#546E7A"
                   TextWrapping="Wrap"
                   Text="{Binding SummaryText, Mode=OneWay}"/>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  RowHeight="28"
                  ColumnHeaderHeight="32"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="1"
                  BorderBrush="#E0E0E0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="序号" Binding="{Binding SequenceNo, Mode=OneWay}" Width="44"/>
                <DataGridTextColumn Header="年度" Binding="{Binding Year, Mode=OneWay}" Width="56"/>
                <DataGridTextColumn Header="项目名称" Binding="{Binding ProjectName, Mode=OneWay}" Width="*"/>
                <DataGridTextColumn Header="资料名称" Binding="{Binding MaterialName, Mode=OneWay}" Width="88"/>
                <DataGridTextColumn Header="规格" Binding="{Binding BoxSpecification, Mode=OneWay}" Width="92"/>
                <DataGridTextColumn Header="物理位置" Binding="{Binding Location, Mode=OneWay}" Width="120"/>
                <DataGridTextColumn Header="子项" Binding="{Binding ItemCount, Mode=OneWay}" Width="48"/>
                <DataGridTextColumn Header="状态" Binding="{Binding StatusText, Mode=OneWay}" Width="72"/>
                <DataGridTextColumn Header="校验" Binding="{Binding ErrorText, Mode=OneWay}" Width="220">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding ErrorText, Mode=OneWay}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right"
                    Content="导入可立档盒"
                    Command="{Binding ConfirmCommand}"
                    Padding="14,4"
                    MinHeight="28"
                    FontWeight="SemiBold"/>
            <Button DockPanel.Dock="Right"
                    Content="取消"
                    Command="{Binding CancelCommand}"
                    Margin="0,0,8,0"
                    Padding="14,4"
                    MinHeight="28"/>
        </DockPanel>
    </Grid>
</Window>
