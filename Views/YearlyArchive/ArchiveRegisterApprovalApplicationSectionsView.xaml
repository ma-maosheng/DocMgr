<UserControl x:Class="DocMgr.Views.YearlyArchive.ArchiveRegisterApprovalApplicationSectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ArchiveRegisterResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <Border Margin="0,0,0,8" Padding="8,6" Background="#EEF3F8" BorderBrush="#C5D3E0" BorderThickness="1">
            <TextBlock Text="以下为申请人提交信息（只读）。审批人可在「审批通过」前根据线下审批结果编辑各资料子项密级；其余申请内容不可修改。"
                       Foreground="#475569" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <GroupBox Header="1. 申请信息" Style="{StaticResource Level1GroupBoxStyle}">
            <StackPanel>
                <!-- 第1行：申请人信息 + 库管模式 + 证明材料（组间距 YaRegInlineFieldGroupMargin=右12） -->
                <WrapPanel Margin="{StaticResource YaRegFormRowMargin}" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="{StaticResource YaRegInlineFieldGroupMargin}">
                        <TextBlock Text="申请人信息：" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                        <TextBlock Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}">
                            <Run Text="{Binding CurrentRecord.ApplicantName, Mode=OneWay}"/>
                            <Run Text="  ·  "/>
                            <Run Text="{Binding CurrentRecord.ApplicantDept, Mode=OneWay}"/>
                            <Run Text="  ·  "/>
                            <Run Text="{Binding CurrentRecord.ApplicantDate, Mode=OneWay, StringFormat=yyyy-MM-dd}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="{StaticResource YaRegInlineFieldGroupMargin}">
                        <TextBlock Text="库管模式：" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                        <TextBlock Text="{Binding CurrentRecord.ArchivePurpose}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="{StaticResource YaRegFormRowMargin}">
                        <TextBlock Text="证明材料：" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                        <TextBlock Text="{Binding ProofMaterialDisplay, Mode=OneWay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                    </StackPanel>
                </WrapPanel>

                <!-- 第2行：其他要求 -->
                <DockPanel Margin="{StaticResource YaRegFormRowMargin}" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Text="其他要求：" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                    <TextBlock Text="{Binding CurrentRecord.OtherRequests}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                </DockPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="2. 资料信息" Style="{StaticResource Level1GroupBoxStyle}">
            <StackPanel>
                <!-- 资料名称与资料来源紧挨横排（组间距 YaRegInlineFieldGroupMargin=右12） -->
                <WrapPanel Margin="{StaticResource YaRegFormRowMargin}" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="{StaticResource YaRegInlineFieldGroupMargin}">
                        <TextBlock Text="资料名称：" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                        <TextBlock Text="{Binding MaterialNameDisplay, Mode=OneWay}"
                                   Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="{StaticResource YaRegFormRowMargin}">
                        <TextBlock Text="资料来源：" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                        <TextBlock Text="{Binding SourceProvideUnitDisplay, Mode=OneWay}"
                                   Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </WrapPanel>

                <ItemsControl ItemsSource="{Binding DataElectronicMediaView}" ItemTemplate="{StaticResource MediaEntryReadOnlyTemplate_DataElectronic}"/>
                <ItemsControl ItemsSource="{Binding DataSimulatedMediaView}" ItemTemplate="{StaticResource MediaEntryReadOnlyTemplate_DataSimulated}"/>
            </StackPanel>
        </GroupBox>

    </StackPanel>
</UserControl>
