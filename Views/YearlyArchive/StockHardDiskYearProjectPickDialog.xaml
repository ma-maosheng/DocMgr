<Window x:Class="DocMgr.Views.YearlyArchive.StockHardDiskYearProjectPickDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title, Mode=OneWay}"
        Width="680"
        Height="380"
        MinWidth="520"
        MinHeight="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F8FAFC">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding HintText, Mode=OneWay}"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="#334155"
                   Margin="0,0,0,8"/>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Projects}"
                  SelectedItem="{Binding SelectedProject}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  MouseDoubleClick="OnGridMouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="项目名称" Binding="{Binding ProjectName}" Width="*"/>
                <DataGridTextColumn Header="项目编号" Binding="{Binding ProjectCode}" Width="140"/>
                <DataGridTextColumn Header="实施年度" Binding="{Binding ImplementYear}" Width="80"/>
                <DataGridTextColumn Header="资金管理部门" Binding="{Binding CapitalMgrDept}" Width="140"/>
                <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="采用所选项目" Width="112" Margin="0,0,8,0" IsDefault="True"
                    Click="OnConfirmClick" Style="{StaticResource FormInlineButtonStyle}"/>
            <Button Content="关闭" Width="88" IsCancel="True" Style="{StaticResource FormInlineButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
