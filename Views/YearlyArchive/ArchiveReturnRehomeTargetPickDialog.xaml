<Window x:Class="DocMgr.Views.YearlyArchive.ArchiveReturnRehomeTargetPickDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="420" Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F8FAFC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="原档案盒已失效，请选择一个在用档案盒作为归还入库目标："
                   TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#334155"/>
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Options}"
                 SelectedItem="{Binding SelectedOption}"
                 DisplayMemberPath="DisplayText"
                 BorderBrush="#CBD5E1"
                 BorderThickness="1"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Width="88" Margin="0,0,8,0" IsDefault="True" Click="OnConfirmClick"
                    Style="{StaticResource FormInlineButtonStyle}"/>
            <Button Content="取消" Width="88" IsCancel="True"
                    Style="{StaticResource FormInlineButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
