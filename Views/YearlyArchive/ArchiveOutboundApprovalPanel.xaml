<UserControl x:Class="DocMgr.Views.YearlyArchive.ArchiveOutboundApprovalPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DocMgr.Models.Shared"
             xmlns:viewShared="clr-namespace:DocMgr.Views.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ArchiveRegisterResources.xaml"/>
                <ResourceDictionary Source="ArchiveOutboundDetailCardResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <Style x:Key="OutboundApprovalInfoInlineLabelStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource ArchiveRegisterApprovalInlineLabelStyle}">
                <Setter Property="Width" Value="72"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
            </Style>
            <Style x:Key="OutboundApprovalInfoInlineValueStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Foreground" Value="#1E293B"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <viewShared:ApprovalHandoverWorkspaceShell
        ShellKind="{x:Static models:ApprovalWorkflowShellKind.ApplicationHandover}"
        ShowTitleChrome="False"
        ShowFooterChrome="True">
        <viewShared:ApprovalHandoverWorkspaceShell.HeaderContent>
            <StackPanel>
                <DockPanel Margin="0,0,0,8" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                               Text="{Binding WindowTitle, Mode=OneWay}"/>
                    <TextBlock Text="{Binding StatusDisplay, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right"
                               Foreground="#B45309" FontWeight="SemiBold" Margin="12,0,0,0"/>
                </DockPanel>
                <TextBlock Text="{Binding ApprovalWorkspaceBannerText, Mode=OneWay}" Foreground="#64748B" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                <Border Background="#EEF3F8" BorderBrush="#C5D3E0" BorderThickness="1" Padding="8,6" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="申请信息" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,4" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Left" Text="申请人" Style="{StaticResource OutboundApprovalInfoInlineLabelStyle}"/>
                                <TextBlock Text="{Binding Record.ApplicantName, Mode=OneWay}" Style="{StaticResource OutboundApprovalInfoInlineValueStyle}"/>
                            </DockPanel>
                            <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,4" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Left" Text="申请部门" Style="{StaticResource OutboundApprovalInfoInlineLabelStyle}"/>
                                <TextBlock Text="{Binding Record.ApplicantDept, Mode=OneWay}" Style="{StaticResource OutboundApprovalInfoInlineValueStyle}"/>
                            </DockPanel>
                            <DockPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,4" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Left" Text="资料去向" Style="{StaticResource OutboundApprovalInfoInlineLabelStyle}"/>
                                <TextBlock Text="{Binding DestinationDisplayText, Mode=OneWay}" Style="{StaticResource OutboundApprovalInfoInlineValueStyle}"/>
                            </DockPanel>
                            <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,4" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Left" Text="证明材料" Style="{StaticResource OutboundApprovalInfoInlineLabelStyle}"/>
                                <TextBlock Text="{Binding ProofMaterialDisplay, Mode=OneWay}" Style="{StaticResource OutboundApprovalInfoInlineValueStyle}"/>
                            </DockPanel>
                            <DockPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Left" Text="申请原由" Style="{StaticResource OutboundApprovalInfoInlineLabelStyle}"/>
                                <TextBlock Text="{Binding Record.Reason, Mode=OneWay}" Style="{StaticResource OutboundApprovalInfoInlineValueStyle}"/>
                            </DockPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Expander Margin="0,0,0,0" IsExpanded="False"
                          BorderBrush="#D0DAE4" BorderThickness="1" Background="#FFFFFF"
                          Padding="8,4">
                    <Expander.Header>
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="出库明细" FontWeight="SemiBold" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ContainerUnitsSummary, Mode=OneWay}" Foreground="#64748B" FontSize="11"
                                       VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Expander.Header>
                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                        <ItemsControl ItemsSource="{Binding ContainerUnits}"
                                      ItemTemplate="{StaticResource OutboundReadOnlyDetailCardTemplate}"/>
                    </ScrollViewer>
                </Expander>
            </StackPanel>
        </viewShared:ApprovalHandoverWorkspaceShell.HeaderContent>

        <viewShared:ApprovalHandoverWorkspaceShell.SignatureContent>
            <viewShared:ApprovalSignatureCardsControl
                ShowApprovalOpinion="False"
                SignatureHintText="各节点仅需签字人与日期，无需签署具体意见。"/>
        </viewShared:ApprovalHandoverWorkspaceShell.SignatureContent>

        <viewShared:ApprovalHandoverWorkspaceShell.SignatureExtraContent>
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="业务助手"
                        Command="{Binding OpenBusinessAssistantCommand}"
                        Padding="10,4"
                        ToolTip="打开资料出库业务助手，辅助办理交接"/>
            </DockPanel>
        </viewShared:ApprovalHandoverWorkspaceShell.SignatureExtraContent>

        <viewShared:ApprovalHandoverWorkspaceShell.MidStepExtraContent>
            <Border Style="{StaticResource ArchiveRegisterApprovalCompactStepCardStyle}"
                    IsEnabled="{Binding CanEditHandoverRemark}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Text="交接备注" Style="{StaticResource ArchiveRegisterApprovalCompactStepTitleStyle}"/>
                    <TextBox Text="{Binding HandoverRemark, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="36" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalContentAlignment="Top"
                             ToolTip="{Binding HandoverRemarkHint, Mode=OneWay}"/>
                </DockPanel>
            </Border>
        </viewShared:ApprovalHandoverWorkspaceShell.MidStepExtraContent>
    </viewShared:ApprovalHandoverWorkspaceShell>
</UserControl>
