    <Style x:Key="ArchiveRegisterApprovalReadOnlyValueStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="#1E293B"/>
    </Style>

