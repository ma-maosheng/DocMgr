                        <DataTemplate>
                            <Border Style="{StaticResource ArchiveRegisterMediaItemBorderStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource YaRegLabelColumn}"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="{StaticResource YaRegFieldGutterColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegLabelColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegConfidentialColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegFieldGutterColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegLabelColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegCountColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegTightGutterColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegDeleteButtonColumn}"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="子项名称：" Style="{StaticResource ArchiveRegisterMediaItemLabelStyle}"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding ContentDesc}" Style="{StaticResource ArchiveRegisterCompactTextBoxStyle}" ToolTip="资料子项名称或内容"/>
                                        <TextBlock Grid.Column="3" Text="密级：" Style="{StaticResource ArchiveRegisterMediaItemLabelStyle}"/>
                                        <ComboBox Grid.Column="4"
                                                  Style="{StaticResource ArchiveRegisterConfidentialLevelComboBoxStyle}"
                                                  ItemsSource="{Binding DataContext.ConfidentialLevelOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding ConfidentialLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="6" Text="份数：" Style="{StaticResource ArchiveRegisterMediaItemLabelStyle}"/>
                                        <TextBox Grid.Column="7"
                                                 Text="{Binding ContentCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ArchiveRegisterCompactTextBoxStyle}"
                                                 ToolTip="资料子项份数，默认为 1"/>
                                        <Button Grid.Column="9"
                                                Style="{StaticResource ArchiveRegisterRemoveMediaItemButtonStyle}"
                                                Content="×"
                                                ToolTip="删除本子项"
                                                Command="{Binding DataContext.RemoveMediaItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource YaRegLabelColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegMaterialCategoryColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegFieldGutterColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegLabelColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegSubCategoryColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegFieldGutterColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegLabelColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegSimulatedOrganizationFormColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegFieldGutterColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegLabelColumn}"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="资料类型：" Style="{StaticResource ArchiveRegisterMediaItemLabelStyle}"/>
                                        <ComboBox Grid.Column="1" Width="{StaticResource YaRegMaterialCategoryWidth}"
                                                  Style="{StaticResource ArchiveRegisterCompactComboBoxStyle}"
                                                  ItemsSource="{Binding DataContext.SimulatedMaterialCategoryOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding MaterialCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="3" Text="所属子类：" Style="{StaticResource ArchiveRegisterMediaItemLabelStyle}"/>
                                        <ComboBox Grid.Column="4" Width="{StaticResource YaRegSubCategoryWidth}"
                                                  Style="{StaticResource ArchiveRegisterCompactComboBoxStyle}"
                                                  ItemsSource="{Binding AvailableSubCategories}"
                                                  SelectedItem="{Binding SubCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="6" Text="组织形式：" Style="{StaticResource ArchiveRegisterMediaItemLabelStyle}"/>
                                        <ComboBox Grid.Column="7" Width="{StaticResource YaRegSimulatedOrganizationFormWidth}"
                                                  Style="{StaticResource ArchiveRegisterCompactComboBoxStyle}"
                                                  ItemsSource="{Binding DataContext.SimulatedOrganizationFormOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding OrganizationForm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="9" Text="备注：" Style="{StaticResource ArchiveRegisterMediaItemLabelStyle}"/>
                                        <TextBox Grid.Column="10"
                                                 Text="{Binding Note}" Style="{StaticResource ArchiveRegisterCompactTextBoxStyle}" ToolTip="备注"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <viewShared:ItemDetailsPanelPaginationBar DataContext="{Binding ItemDetailsPanel}"/>
            </StackPanel>
        </GroupBox>
    </DataTemplate>

    <DataTemplate x:Key="MediaEntryTemplate_ProofSimulated">
        <GroupBox Style="{StaticResource ArchiveRegisterMediaEntryGroupBoxStyle}">
            <GroupBox.Header>
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource ArchiveRegisterRemoveMediaEntryButtonStyle}"
                            Content="删除"
                            ToolTip="删除本组材料"
                            Command="{Binding DataContext.RemoveMediaEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Margin="8,0,0,0"/>
                    <TextBlock Text="材料明细"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               FontWeight="SemiBold"
                               Foreground="#555"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </GroupBox.Header>
            <StackPanel>
                <Grid Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="介质：" Style="{StaticResource ArchiveRegisterFormLabelStyle}" HorizontalAlignment="Left"/>
                    <ComboBox Grid.Column="1"
                              Style="{StaticResource ArchiveRegisterCompactComboBoxStyle}"
                              ItemsSource="{Binding DataContext.SimulatedMediaKindOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedItem="{Binding MediaKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Column="2" Text="类型：" Style="{StaticResource ArchiveRegisterFormLabelStyle}"/>
                    <ComboBox Grid.Column="3"
                              Style="{StaticResource ArchiveRegisterCompactComboBoxStyle}"
                              ItemsSource="{Binding DataContext.ProofSimulatedMediaTypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedItem="{Binding MediaType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Column="4" Text="其他：" Style="{StaticResource ArchiveRegisterFormLabelStyle}"/>
                    <TextBox Grid.Column="5" Text="{Binding OtherDesc}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource ArchiveRegisterCompactTextBoxStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MediaType}" Value="其他">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <TextBlock Grid.Column="6" Text="数量：" Style="{StaticResource ArchiveRegisterFormLabelStyle}"/>
                    <TextBox Grid.Column="7"
                             Text="{Binding MediaCount, Mode=OneWay}"
                             Style="{StaticResource ArchiveRegisterReadOnlyTextBoxStyle}"
                             ToolTip="系统按资料子项数量自动计算"/>

                    <TextBlock Grid.Column="8" Text="处置：" Style="{StaticResource ArchiveRegisterFormLabelStyle}" Visibility="Collapsed"/>
                    <ComboBox Grid.Column="9" Style="{StaticResource ArchiveRegisterCompactComboBoxStyle}" Visibility="Collapsed"/>
                </Grid>

                <DockPanel Margin="0,0,0,4" LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource ArchiveRegisterAddSubItemButtonStyle}"
                            Content="+ 添加材料子项"
                            Command="{Binding DataContext.AddMediaItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                </DockPanel>

                <viewShared:ItemDetailsPanelHeader DataContext="{Binding ItemDetailsPanel}" Margin="0,6,0,4"/>
                <ItemsControl ItemsSource="{Binding ItemDetailsPanel.PageItems}" Style="{StaticResource ItemDetailsPanelItemsControlStyle}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ArchiveRegisterMediaItemBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="材料名称：" Style="{StaticResource ArchiveRegisterFormLabelStyle}"/>
                                    <TextBox Grid.Column="1" Text="{Binding ContentDesc}" Style="{StaticResource ArchiveRegisterCompactTextBoxStyle}" ToolTip="证明材料名称"/>
                                    <TextBlock Grid.Column="2" Text="密级：" Style="{StaticResource ArchiveRegisterFormLabelStyle}"/>
                                    <ComboBox Grid.Column="3"
                                              Style="{StaticResource ArchiveRegisterConfidentialLevelComboBoxStyle}"
                                              ItemsSource="{Binding DataContext.ConfidentialLevelOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding ConfidentialLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="4" Text="份数：" Style="{StaticResource ArchiveRegisterFormLabelStyle}"/>
                                    <TextBox Grid.Column="5"
                                             Text="{Binding ContentCount, Mode=OneWay}"
                                             Style="{StaticResource ArchiveRegisterReadOnlyTextBoxStyle}"
                                             ToolTip="系统固定为 1 份/子项"/>
                                    <TextBlock Grid.Column="6" Text="备注：" Style="{StaticResource ArchiveRegisterFormLabelStyle}"/>
                                    <TextBox Grid.Column="7" Text="{Binding Note}" Style="{StaticResource ArchiveRegisterCompactTextBoxStyle}" ToolTip="备注"/>
                                    <Button Grid.Column="8"
                                            Style="{StaticResource ArchiveRegisterRemoveMediaItemButtonStyle}"
                                            Content="×"
                                            ToolTip="删除本子项"
                                            Command="{Binding DataContext.RemoveMediaItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <viewShared:ItemDetailsPanelPaginationBar DataContext="{Binding ItemDetailsPanel}"/>
            </StackPanel>
        </GroupBox>
    </DataTemplate>

    <Style x:Key="ArchiveRegisterApprovalReadOnlyLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#64748B"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="Width" Value="64"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
