                    </StackPanel>
                    <StackPanel Grid.Column="2" Style="{StaticResource ArchiveRegisterApprovalFieldPanelStyle}">
                        <TextBlock Text="资料类型" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}" Width="72"/>
                        <TextBlock Text="{Binding MaterialCategory, TargetNullValue=—}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Style="{StaticResource ArchiveRegisterApprovalFieldPanelStyle}">
                        <TextBlock Text="所属子类" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}" Width="72"/>
                        <TextBlock Text="{Binding SubCategory, TargetNullValue=—}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="组织形式" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}" Width="72"/>
                        <TextBlock Text="{Binding DataOrganizationForm, TargetNullValue=—}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                    </StackPanel>
                </Grid>
                <Border Margin="0,2,0,0" Padding="6,4" Background="#F0F7F6" BorderBrush="#D5E8E4" BorderThickness="1" CornerRadius="3">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Content="查看明细…"
                                Margin="12,0,0,0"
                                Padding="8,2"
                                VerticalAlignment="Center"
                                Style="{StaticResource ButtonNormalStyle}"
                                Command="{Binding DataContext.ViewElectronicContentEntriesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="#00695C"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Text="{Binding ContentScanSummaryText, TargetNullValue=暂无目录/文件明细摘要}"/>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="MediaEntryReadOnlyTemplate_DataElectronic">
        <Border Style="{StaticResource ArchiveRegisterApprovalMediaEntryCardStyle}">
            <StackPanel>
                <TextBlock Text="资料介质（电子）" Style="{StaticResource ArchiveRegisterApprovalMediaEntryTitleStyle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <StackPanel Style="{StaticResource ArchiveRegisterApprovalFieldPanelStyle}">
                        <TextBlock Text="类型" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}" Width="40"/>
                        <TextBlock Text="{Binding MediaType, TargetNullValue=—}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource ArchiveRegisterApprovalFieldPanelStyle}">
                        <TextBlock Text="数量" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}" Width="40"/>
                        <TextBlock Text="{Binding MediaCount}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource ArchiveRegisterApprovalFieldPanelStyle}">
                        <TextBlock Text="处置" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}" Width="40"/>
                        <TextBlock Text="{Binding Disposition, TargetNullValue=—}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowBorrowedHardDiskRegistrationUi}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="借出硬盘" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}" Width="72"/>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}">
                                    <Setter Property="Text" Value="否"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBorrowedHardDisk}" Value="True">
                                            <Setter Property="Text" Value="{Binding BorrowedHardDiskCode}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <Border Style="{StaticResource ArchiveRegisterApprovalSubItemSectionStyle}">
                    <StackPanel>
                        <viewShared:ItemDetailsPanelHeader DataContext="{Binding ItemDetailsPanel}" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding ItemDetailsPanel.PageItems}"
                                      ItemTemplate="{StaticResource MediaItemReadOnlyTemplate_Electronic}"
                                      Style="{StaticResource ItemDetailsPanelItemsControlStyle}"/>
                        <viewShared:ItemDetailsPanelPaginationBar DataContext="{Binding ItemDetailsPanel}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>

