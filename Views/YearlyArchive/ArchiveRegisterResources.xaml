        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#00796B"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Width" Value="78"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style x:Key="ArchiveRegisterApprovalInlineLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#64748B"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
    </Style>

    <Style x:Key="ArchiveRegisterApprovalCompactTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}">
        <Setter Property="Height" Value="{StaticResource FormControlHeight}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
