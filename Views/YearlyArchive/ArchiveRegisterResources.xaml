<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:models="clr-namespace:DocMgr.Models.YearlyArchive"
                    xmlns:viewShared="clr-namespace:DocMgr.Views.Shared">
    <viewShared:InverseBoolRadioConverter x:Key="InverseBoolRadioConverter"/>

    <!-- 建档编辑各卡片共用排版令牌：控件 Width 用 Double；Grid 列宽必须用 GridLength -->
    <sys:Double x:Key="YaRegLabelWidth">110</sys:Double>
    <sys:Double x:Key="YaRegFieldGutter">12</sys:Double>
    <sys:Double x:Key="YaRegCountWidth">48</sys:Double>
    <sys:Double x:Key="YaRegConfidentialWidth">72</sys:Double>
    <sys:Double x:Key="YaRegYearWidth">72</sys:Double>
    <sys:Double x:Key="YaRegMediaKindWidth">56</sys:Double>
    <sys:Double x:Key="YaRegMediaTypeWidth">108</sys:Double>
    <sys:Double x:Key="YaRegDispositionWidth">108</sys:Double>
    <sys:Double x:Key="YaRegMaterialCategoryWidth">88</sys:Double>
    <sys:Double x:Key="YaRegSubCategoryWidth">132</sys:Double>
    <sys:Double x:Key="YaRegOrganizationFormWidth">88</sys:Double>
    <sys:Double x:Key="YaRegSourceTypeWidth">108</sys:Double>
    <sys:Double x:Key="YaRegArchivePurposeWidth">168</sys:Double>
    <sys:Double x:Key="YaRegPersonNameWidth">80</sys:Double>
    <sys:Double x:Key="YaRegDepartmentWidth">120</sys:Double>
    <sys:Double x:Key="YaRegDateWidth">124</sys:Double>
    <sys:Double x:Key="YaRegProvideUnitWidth">160</sys:Double>
    <sys:Double x:Key="YaRegDiskCodeWidth">140</sys:Double>
    <sys:Double x:Key="YaRegDataSizeWidth">56</sys:Double>
    <sys:Double x:Key="YaRegDeleteButtonWidth">32</sys:Double>
    <sys:Double x:Key="YaRegTightGutter">8</sys:Double>
    <sys:Double x:Key="YaRegSimulatedOrganizationFormWidth">72</sys:Double>
    <sys:Double x:Key="YaRegActionButtonWidth">108</sys:Double>
    <GridLength x:Key="YaRegLabelColumn">110</GridLength>
    <GridLength x:Key="YaRegFieldGutterColumn">12</GridLength>
    <GridLength x:Key="YaRegCountColumn">48</GridLength>
    <GridLength x:Key="YaRegConfidentialColumn">72</GridLength>
    <GridLength x:Key="YaRegMediaKindColumn">56</GridLength>
    <GridLength x:Key="YaRegMediaTypeColumn">108</GridLength>
    <GridLength x:Key="YaRegDispositionColumn">108</GridLength>
    <GridLength x:Key="YaRegMaterialCategoryColumn">88</GridLength>
    <GridLength x:Key="YaRegSubCategoryColumn">132</GridLength>
    <GridLength x:Key="YaRegOrganizationFormColumn">88</GridLength>
    <GridLength x:Key="YaRegSimulatedOrganizationFormColumn">72</GridLength>
    <GridLength x:Key="YaRegDeleteButtonColumn">32</GridLength>
    <GridLength x:Key="YaRegTightGutterColumn">8</GridLength>
    <Thickness x:Key="YaRegFormRowMargin">0,2</Thickness>
    <Thickness x:Key="YaRegFieldTrailingMargin">0,0,12,0</Thickness>
    <Thickness x:Key="YaRegFieldLeadingMargin">12,0,0,0</Thickness>
    <Thickness x:Key="YaRegHintIndentMargin">110,0,0,2</Thickness>
    <Style x:Key="ItemDetailsPanelItemsControlStyle" TargetType="ItemsControl">
        <Style.Triggers>
            <DataTrigger Binding="{Binding ItemDetailsPanel.IsExpanded}" Value="False">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- GroupBox 分级样式（资料登记表单共享） -->
    <Style x:Key="GroupBoxBaseStyle" TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="#D0D0D0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontWeight="Bold" Foreground="#00796B"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Level1GroupBoxStyle" TargetType="GroupBox" BasedOn="{StaticResource GroupBoxBaseStyle}">
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="#BDBDBD"/>
    </Style>

    <Style x:Key="Level2GroupBoxStyle" TargetType="GroupBox" BasedOn="{StaticResource GroupBoxBaseStyle}">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#DDDDDD"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="Padding" Value="8"/>
    </Style>

    <Style x:Key="ArchiveRegisterMediaEntryGroupBoxStyle" TargetType="GroupBox" BasedOn="{StaticResource Level2GroupBoxStyle}">
        <Setter Property="HeaderTemplate" Value="{x:Null}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Padding" Value="8"/>
    </Style>

    <Style TargetType="GroupBox" BasedOn="{StaticResource Level2GroupBoxStyle}"/>

    <!-- 删除整组介质：带边框与悬停反馈，区别于纯符号 -->
    <Style x:Key="ArchiveRegisterRemoveMediaEntryButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="MinWidth" Value="52"/>
        <Setter Property="Background" Value="#FFF5F5"/>
        <Setter Property="BorderBrush" Value="#E57373"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="#B71C1C"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFEBEE"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#EF5350"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFCDD2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 删除单个子项：小型方块按钮 -->
    <Style x:Key="ArchiveRegisterRemoveMediaItemButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Margin" Value="4,2"/>
        <Setter Property="Background" Value="#FFF5F5"/>
        <Setter Property="BorderBrush" Value="#E57373"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="#B71C1C"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFEBEE"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#EF5350"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFCDD2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ArchiveRegisterFormLabelStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="Width" Value="{StaticResource YaRegLabelWidth}"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <Style x:Key="ArchiveRegisterCardLabelStyle" TargetType="Label" BasedOn="{StaticResource FormLabelStyle}">
        <Setter Property="Width" Value="{StaticResource YaRegLabelWidth}"/>
    </Style>

    <Style x:Key="ArchiveRegisterInlineLabelStyle" TargetType="Label" BasedOn="{StaticResource FormLabelStyle}">
        <Setter Property="Margin" Value="{StaticResource YaRegFieldTrailingMargin}"/>
    </Style>

    <!-- 与主表单标签列同宽，保证各卡片控件左缘对齐 -->
    <Style x:Key="ArchiveRegisterMediaToolbarLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource ArchiveRegisterFormLabelStyle}"/>

    <Style x:Key="ArchiveRegisterMediaItemLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource ArchiveRegisterFormLabelStyle}"/>

    <Style x:Key="ArchiveRegisterCompactTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}">
        <Setter Property="Margin" Value="0"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.CanEditForm, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="Background" Value="#F5F5F5"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ArchiveRegisterReadOnlyTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource ArchiveRegisterCompactTextBoxStyle}">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="Background" Value="#F5F5F5"/>
    </Style>

    <Style x:Key="ArchiveRegisterCompactComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource FormComboBoxStyle}">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.CanEditForm, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                <Setter Property="IsEnabled" Value="False"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ArchiveRegisterConfidentialLevelComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource FormComboBoxStyle}">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Width" Value="{StaticResource YaRegConfidentialWidth}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.CanEditItemConfidentialLevel, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                <Setter Property="IsEnabled" Value="False"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 入网审批：资料室资料管理员补录路径（不受 CanEditForm 约束） -->
    <Style x:Key="NetworkInboundApprovalPathTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding CanEditApprovalPaths}" Value="False">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="Background" Value="#F5F5F5"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NetworkInboundApprovalPathComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource FormComboBoxStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding CanEditApprovalPaths}" Value="False">
                <Setter Property="IsEnabled" Value="False"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ArchiveRegisterFormTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.CanEditForm, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="Background" Value="#F5F5F5"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ArchiveRegisterFormComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource FormComboBoxStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.CanEditForm, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                <Setter Property="IsEnabled" Value="False"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ArchiveRegisterFormDatePickerStyle" TargetType="DatePicker" BasedOn="{StaticResource FormDatePickerStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.CanEditForm, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                <Setter Property="IsEnabled" Value="False"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ArchiveRegisterFormRadioButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource FormRadioButtonStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.CanEditForm, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                <Setter Property="IsEnabled" Value="False"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ArchiveRegisterAddSubItemButtonStyle" TargetType="Button">
        <Setter Property="Content" Value="+ 添加子项"/>
        <Setter Property="Width" Value="{StaticResource YaRegActionButtonWidth}"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <Style x:Key="ArchiveRegisterMediaItemBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="#F0F0F0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Margin" Value="0,2"/>
    </Style>

    <DataTemplate x:Key="MediaEntryTemplate_DataElectronic">
        <GroupBox Style="{StaticResource ArchiveRegisterMediaEntryGroupBoxStyle}">
            <GroupBox.Header>
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource ArchiveRegisterRemoveMediaEntryButtonStyle}"
                            Content="删除"
                            ToolTip="删除本组介质"
                            Command="{Binding DataContext.RemoveMediaEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Margin="8,0,0,0"/>
                    <TextBlock Text="资料明细"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               FontWeight="SemiBold"
                               Foreground="#555"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </GroupBox.Header>
            <StackPanel>
                <DockPanel Margin="{StaticResource YaRegFormRowMargin}" LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource ArchiveRegisterAddSubItemButtonStyle}"
                            Content="+ 添加资料子项"
                            Command="{Binding DataContext.AddMediaItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BorrowedHardDiskRegistrationRowVisibility}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.RestrictRetainedHardDiskToBorrowedOnly, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="借出硬盘：" Style="{StaticResource ArchiveRegisterMediaItemLabelStyle}"/>
                            <StackPanel Orientation="Horizontal" Style="{StaticResource FormInlineRadioGroupStyle}">
                                <RadioButton Content="是"
                                             GroupName="{Binding BorrowedHardDiskRadioGroup}"
                                             Style="{StaticResource ArchiveRegisterFormRadioButtonStyle}"
                                             IsChecked="{Binding IsBorrowedHardDisk, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <RadioButton Content="否"
                                             GroupName="{Binding BorrowedHardDiskRadioGroup}"
                                             Style="{StaticResource ArchiveRegisterFormRadioButtonStyle}"
                                             IsChecked="{Binding IsBorrowedHardDisk, Converter={StaticResource InverseBoolRadioConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <TextBlock VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ArchiveRegisterMediaItemLabelStyle}">
                                        <Setter Property="Text" Value="介质编号："/>
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BorrowedHardDiskDetailsVisibility}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ComboBox Width="{StaticResource YaRegDiskCodeWidth}"
                                      IsEditable="False"
                                      ItemsSource="{Binding DataContext.UserBorrowedHardDiskCodes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedItem="{Binding BorrowedHardDiskCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="当前登记人名下借出且尚未归还的硬盘编号">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource ArchiveRegisterCompactComboBoxStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BorrowedHardDiskDetailsVisibility}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.RestrictRetainedHardDiskToBorrowedOnly, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="借出硬盘编号：" Style="{StaticResource ArchiveRegisterMediaItemLabelStyle}"/>
                            <ComboBox Width="{StaticResource YaRegDiskCodeWidth}"
                                      IsEditable="False"
                                      ItemsSource="{Binding DataContext.UserBorrowedHardDiskCodes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedItem="{Binding BorrowedHardDiskCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="硬盘介质留存须选择资料室借出硬盘编号"
                                      Style="{StaticResource ArchiveRegisterCompactComboBoxStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <StackPanel Margin="0,0,0,4">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding DataContext.ShowOutboundExternalHardDiskRequisitionFields, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                        <Condition Binding="{Binding IsExternalOfflineReturnedHardDiskScenario}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4" VerticalAlignment="Center">
                            <TextBlock Text="使用库内空盘：" Style="{StaticResource ArchiveRegisterMediaItemLabelStyle}"/>
                            <StackPanel Orientation="Horizontal" Style="{StaticResource FormInlineRadioGroupStyle}">
                                <RadioButton Content="是"
                                             GroupName="{Binding UseInStockBlankHardDiskRadioGroup}"
                                             Style="{StaticResource ArchiveRegisterFormRadioButtonStyle}"
                                             IsChecked="{Binding UseInStockBlankHardDisk, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <RadioButton Content="否"
                                             GroupName="{Binding UseInStockBlankHardDiskRadioGroup}"
                                             Style="{StaticResource ArchiveRegisterFormRadioButtonStyle}"
                                             IsChecked="{Binding UseInStockBlankHardDisk, Converter={StaticResource InverseBoolRadioConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OutboundBlankHardDiskFieldsVisibility}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="库内空盘：" Style="{StaticResource ArchiveRegisterMediaItemLabelStyle}"/>
                            <TextBox Width="{StaticResource YaRegDiskCodeWidth}" Text="{Binding RequisitionedHardDiskCode, Mode=OneWay}" IsReadOnly="True"
                                     Style="{StaticResource ArchiveRegisterCompactTextBoxStyle}" Background="#F8FAFC"/>
                            <Button Content="选择" Margin="6,0,0,0" Padding="8,2"
                                    Command="{Binding DataContext.PickOutboundBlankHardDiskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OutboundRequisitionedDiskNeedReturnVisibility}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="硬盘是否归还：" Style="{StaticResource ArchiveRegisterMediaItemLabelStyle}"/>
                            <StackPanel Orientation="Horizontal" Style="{StaticResource FormInlineRadioGroupStyle}">
                                <RadioButton Content="是"
                                             GroupName="{Binding RequisitionedDiskNeedReturnRadioGroup}"
                                             Style="{StaticResource ArchiveRegisterFormRadioButtonStyle}"
                                             IsChecked="{Binding RequisitionedDiskNeedReturn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <RadioButton Content="否"
                                             GroupName="{Binding RequisitionedDiskNeedReturnRadioGroup}"
                                             Style="{StaticResource ArchiveRegisterFormRadioButtonStyle}"
                                             IsChecked="{Binding RequisitionedDiskNeedReturn, Converter={StaticResource InverseBoolRadioConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RequiresExpectedReturnDate}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="预计归还日期：" Style="{StaticResource ArchiveRegisterMediaItemLabelStyle}"/>
                            <DatePicker Width="{StaticResource YaRegDateWidth}" SelectedDate="{Binding ExpectedReturnDate, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource ArchiveRegisterFormDatePickerStyle}"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>

                <viewShared:ItemDetailsPanelHeader DataContext="{Binding ItemDetailsPanel}" Margin="0,4,0,2"/>
                <ItemsControl ItemsSource="{Binding ItemDetailsPanel.PageItems}" Style="{StaticResource ItemDetailsPanelItemsControlStyle}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ArchiveRegisterMediaItemBorderStyle}">
                                <StackPanel>
                                    <!-- 子项名称（长文本）/ 密级（2字）/ 份数（1–2位） -->
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource YaRegLabelColumn}"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="{StaticResource YaRegFieldGutterColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegLabelColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegConfidentialColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegFieldGutterColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegLabelColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegCountColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegTightGutterColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegDeleteButtonColumn}"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="子项名称：" Style="{StaticResource ArchiveRegisterMediaItemLabelStyle}"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding ContentDesc, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ArchiveRegisterCompactTextBoxStyle}"
                                                 ToolTip="电子资料子项名称"/>
                                        <TextBlock Grid.Column="3" Text="密级：" Style="{StaticResource ArchiveRegisterMediaItemLabelStyle}"/>
                                        <ComboBox Grid.Column="4"
                                                  Style="{StaticResource ArchiveRegisterConfidentialLevelComboBoxStyle}"
                                                  ItemsSource="{Binding DataContext.ConfidentialLevelOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding ConfidentialLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="6" Text="份数：" Style="{StaticResource ArchiveRegisterMediaItemLabelStyle}"/>
                                        <TextBox Grid.Column="7"
                                                 Text="{Binding ContentCount, Mode=OneWay}"
                                                 Style="{StaticResource ArchiveRegisterReadOnlyTextBoxStyle}"
                                                 ToolTip="电子资料子项份数通常为 1，与下方扫描的目录/文件个数无关"/>
                                        <Button Grid.Column="9"
                                                Style="{StaticResource ArchiveRegisterRemoveMediaItemButtonStyle}"
                                                Content="×"
                                                ToolTip="删除本子项"
                                                Command="{Binding DataContext.RemoveMediaItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource YaRegLabelColumn}"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding StoragePathLabel, Mode=OneWay}"
                                                   Style="{StaticResource ArchiveRegisterMediaItemLabelStyle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding StoragePathLabel, Mode=OneWay}"/>
                                        <DockPanel Grid.Column="1" LastChildFill="True">
                                            <Button DockPanel.Dock="Right"
                                                    Margin="8,0,0,0"
                                                    Padding="8,2"
                                                    Content="填写合规目录"
                                                    ToolTip="按当前年度、项目、资料名称与子项名称强制填入合规存储目录"
                                                    Command="{Binding DataContext.FillDefaultOutboundStoragePathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStoragePathEditable}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <TextBox Text="{Binding StoragePath, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource ArchiveRegisterCompactTextBoxStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStoragePathEditable}" Value="False">
                                                                <Setter Property="IsReadOnly" Value="True"/>
                                                                <Setter Property="Background" Value="#F5F5F5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                                <TextBox.ToolTip>
                                                    <ToolTip MaxWidth="360">
                                                        <StackPanel>
                                                            <TextBlock Text="一个资料子项对应一个存储目录。" TextWrapping="Wrap"/>
                                                            <TextBlock Margin="0,4,0,0"
                                                                       Text="{x:Static models:ElectronicMediaItemSupport.RegistrationStoragePathFormatDescription}"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Margin="0,2,0,0"
                                                                       Text="{x:Static models:ElectronicMediaItemSupport.RegistrationStoragePathFormatExamples}"
                                                                       Foreground="#666"
                                                                       TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </TextBox.ToolTip>
                                            </TextBox>
                                        </DockPanel>
                                    </Grid>

                                    <TextBlock Margin="{StaticResource YaRegHintIndentMargin}" FontSize="11" Foreground="#888" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowOutboundStoragePathHint}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="{x:Static models:ElectronicMediaItemSupport.RegistrationStoragePathFormatDescription}"/>
                                        <Run Text=" "/>
                                        <Run Text="{x:Static models:ElectronicMediaItemSupport.RegistrationStoragePathFormatExamples}"/>
                                    </TextBlock>
                                    <TextBlock Margin="{StaticResource YaRegHintIndentMargin}" FontSize="11" Foreground="#475569" TextWrapping="Wrap"
                                               Text="{Binding OutboundServerFullPathHint, Mode=OneWay}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowOutboundStoragePathHint}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- 资料类型/子类/组织形式 + 数据量与扫描操作同一行 -->
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource YaRegLabelColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegMaterialCategoryColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegFieldGutterColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegLabelColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegSubCategoryColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegFieldGutterColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegLabelColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegOrganizationFormColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegFieldGutterColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegLabelColumn}"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="资料类型：" Style="{StaticResource ArchiveRegisterMediaItemLabelStyle}"/>
                                        <ComboBox Grid.Column="1" Width="{StaticResource YaRegMaterialCategoryWidth}"
                                                  Style="{StaticResource ArchiveRegisterCompactComboBoxStyle}"
                                                  ItemsSource="{Binding DataContext.ElectronicMaterialCategoryOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding MaterialCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="3" Text="所属子类：" Style="{StaticResource ArchiveRegisterMediaItemLabelStyle}"/>
                                        <ComboBox Grid.Column="4" Width="{StaticResource YaRegSubCategoryWidth}"
                                                  Style="{StaticResource ArchiveRegisterCompactComboBoxStyle}"
                                                  ItemsSource="{Binding AvailableSubCategories}"
                                                  SelectedItem="{Binding SubCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="6" Text="组织形式：" Style="{StaticResource ArchiveRegisterMediaItemLabelStyle}"/>
                                        <ComboBox Grid.Column="7" Width="{StaticResource YaRegOrganizationFormWidth}"
                                                  Style="{StaticResource ArchiveRegisterCompactComboBoxStyle}"
                                                  ItemsSource="{Binding DataContext.ElectronicDataOrganizationFormOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding DataOrganizationForm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="9" Text="数据量：" Style="{StaticResource ArchiveRegisterMediaItemLabelStyle}"/>
                                        <StackPanel Grid.Column="10" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox Width="{StaticResource YaRegDataSizeWidth}" Text="{Binding DataSizeMb}" ToolTip="由扫描自动计算，可按需微调">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource ArchiveRegisterCompactTextBoxStyle}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TreatContentMetricsAsUnknown}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <TextBox Width="{StaticResource YaRegDataSizeWidth}" Text="{Binding DataSizeMbDisplay, Mode=OneWay}" IsReadOnly="True" IsEnabled="False"
                                                     ToolTip="申请阶段尚不能读取具体文件或目录">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource ArchiveRegisterCompactTextBoxStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TreatContentMetricsAsUnknown}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <TextBlock VerticalAlignment="Center" Margin="4,0,10,0" Foreground="#666" Text="MB"/>
                                            <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#666" Text="{Binding ScannedEntryCountDisplay}"/>
                                            <Button Content="选择父目录…" Width="96" Margin="0,0,4,0" Padding="4,2"
                                                    ToolTip="选择子项所在文件夹，扫描其下文件与一级子目录"
                                                    Command="{Binding DataContext.PickFolderAndScanElectronicContentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="选择文件…" Width="84" Margin="0,0,4,0" Padding="4,2"
                                                    Command="{Binding DataContext.PickFilesAndScanElectronicContentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="重新扫描" Width="68" Margin="0,0,4,0" Padding="4,2"
                                                    Command="{Binding DataContext.RescanElectronicContentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="清空明细" Width="68" Margin="0,0,4,0" Padding="4,2"
                                                    Command="{Binding DataContext.ClearElectronicContentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="查看明细…" Width="84" Padding="4,2"
                                                    Command="{Binding DataContext.ViewElectronicContentEntriesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Margin="{StaticResource YaRegHintIndentMargin}"
                                               Foreground="#00695C" FontSize="12" TextWrapping="Wrap"
                                               Text="{Binding ContentScanSummaryText}"/>

                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource YaRegLabelColumn}"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="备注：" Style="{StaticResource ArchiveRegisterMediaItemLabelStyle}"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding Note}" Style="{StaticResource ArchiveRegisterCompactTextBoxStyle}" ToolTip="备注"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <viewShared:ItemDetailsPanelPaginationBar DataContext="{Binding ItemDetailsPanel}"/>
            </StackPanel>
        </GroupBox>
    </DataTemplate>

    <DataTemplate x:Key="MediaEntryTemplate_DataSimulated">
        <GroupBox Style="{StaticResource ArchiveRegisterMediaEntryGroupBoxStyle}">
            <GroupBox.Header>
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource ArchiveRegisterRemoveMediaEntryButtonStyle}"
                            Content="删除"
                            ToolTip="删除本组介质"
                            Command="{Binding DataContext.RemoveMediaEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Margin="8,0,0,0"/>
                    <TextBlock Text="资料明细"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               FontWeight="SemiBold"
                               Foreground="#555"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </GroupBox.Header>
            <StackPanel>
                <DockPanel Margin="{StaticResource YaRegFormRowMargin}" LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource ArchiveRegisterAddSubItemButtonStyle}"
                            Content="+ 添加资料子项"
