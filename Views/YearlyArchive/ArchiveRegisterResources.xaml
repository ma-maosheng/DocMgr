    <Style x:Key="ArchiveRegisterApprovalCompactDatePickerStyle" TargetType="DatePicker" BasedOn="{StaticResource FormDatePickerStyle}">
        <Setter Property="Height" Value="{StaticResource FormControlHeight}"/>
