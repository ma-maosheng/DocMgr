<Window x:Class="DocMgr.Views.YearlyArchive.ArchiveRegisterEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DocMgr.Views.YearlyArchive"
        xmlns:shared="clr-namespace:DocMgr.Views.Shared"
        Width="1200"
        Height="820"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ArchiveRegisterResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <DataTemplate x:Key="ApplicantSectionsTemplate">
                <UserControl>
                <StackPanel Orientation="Vertical">
                    <shared:ApplicationRequestHeaderSectionView DataContext="{Binding RequestHeader}">
                        <shared:ApplicationRequestHeaderSectionView.IdentityContent>
                            <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                <WrapPanel Margin="{StaticResource YaRegFormRowMargin}" Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,2">
                                        <TextBlock Style="{StaticResource ArchiveRegisterCardLabelStyle}" Text="资料名称 *："/>
                                        <ComboBox Width="{StaticResource YaRegYearWidth}"
                                                  Style="{StaticResource ArchiveRegisterFormComboBoxStyle}"
                                                  ItemsSource="{Binding ProjectYears}"
                                                  SelectedItem="{Binding SelectedProjectYear}"
                                                  ToolTip="实施年度"/>
                                        <TextBlock Text="."
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Margin="4,0"/>
                                        <ComboBox Width="{StaticResource YaRegProjectWidth}"
                                                  Margin="{StaticResource YaRegFieldTrailingMargin}"
                                                  Style="{StaticResource ArchiveRegisterFormComboBoxStyle}"
                                                  ItemsSource="{Binding Projects}"
                                                  DisplayMemberPath="ProjectName"
                                                  SelectedItem="{Binding SelectedProject}"
                                                  ToolTip="所属项目"/>
                                        <TextBlock Style="{StaticResource ArchiveRegisterInlineLabelStyle}" Text="资料来源："/>
                                        <TextBlock Text="{Binding SourceProvideUnitDisplay, Mode=OneWay}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="#333"
                                                   ToolTip="由各介质子项的资料来源与提供单位汇总"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,2">
                                        <TextBlock Style="{StaticResource ArchiveRegisterCardLabelStyle}" Text="库管模式 *："/>
                                        <ComboBox Width="{StaticResource YaRegArchivePurposeWidth}"
                                                  Margin="{StaticResource YaRegFieldTrailingMargin}"
                                                  Style="{StaticResource ArchiveRegisterFormComboBoxStyle}"
                                                  ItemsSource="{Binding ArchivePurposeOptions}"
                                                  SelectedItem="{Binding SelectedArchivePurpose}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsArchivePurposeOtherSelected}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Style="{StaticResource ArchiveRegisterInlineLabelStyle}" Text="说明："/>
                                            <TextBox Width="160"
                                                     Margin="{StaticResource YaRegFieldTrailingMargin}"
                                                     Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                                                     Text="{Binding CurrentRecord.ArchivePurposeNote, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="库管模式为「其他」时的补充说明"/>
                                        </StackPanel>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </shared:ApplicationRequestHeaderSectionView.IdentityContent>
                    </shared:ApplicationRequestHeaderSectionView>
                    <GroupBox Header="2. 资料信息" Style="{StaticResource Level1GroupBoxStyle}">
                        <StackPanel Orientation="Vertical" Grid.IsSharedSizeScope="True">
                            <local:DataElectronicMediaSectionView />

                            <GroupBox Header="资料介质（模拟） *" Style="{StaticResource Level2GroupBoxStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource YaRegLabelColumn}" SharedSizeGroup="YaRegMediaTbLabel"/>
                                            <ColumnDefinition Width="{StaticResource YaRegMediaKindColumn}" SharedSizeGroup="YaRegMediaTbKind"/>
                                            <ColumnDefinition Width="{StaticResource YaRegFieldGutterColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegLabelColumn}" SharedSizeGroup="YaRegMediaTbLabel"/>
                                            <ColumnDefinition Width="{StaticResource YaRegMediaTypeColumn}" SharedSizeGroup="YaRegMediaTbType"/>
                                            <ColumnDefinition Width="{StaticResource YaRegFieldGutterColumn}"/>
                                            <ColumnDefinition Width="{StaticResource YaRegLabelColumn}" SharedSizeGroup="YaRegMediaTbLabel"/>
                                            <ColumnDefinition Width="{StaticResource YaRegCountColumn}" SharedSizeGroup="YaRegMediaTbCount"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="介质：" Style="{StaticResource ArchiveRegisterMediaToolbarLabelStyle}"/>
                                        <TextBox Grid.Column="1" Text="模拟" IsReadOnly="True" Background="#F5F5F5"
                                                 Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"/>
                                        <TextBlock Grid.Column="3" Text="类型：" Style="{StaticResource ArchiveRegisterMediaToolbarLabelStyle}"/>
                                        <ComboBox Grid.Column="4"
                                                  Style="{StaticResource ArchiveRegisterFormComboBoxStyle}"
                                                  ItemsSource="{Binding DataSimulatedMediaTypeOptions}"
                                                  SelectedItem="{Binding SelectedSimulatedMediaType}"/>
                                        <TextBlock Grid.Column="6" Text="数量：" Style="{StaticResource ArchiveRegisterMediaToolbarLabelStyle}"/>
                                        <TextBox Grid.Column="7" Text="{Binding DataSimulatedMediaCount, Mode=OneWay}" IsReadOnly="True" Background="#F5F5F5"
                                                 Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"/>
                                        <Button Grid.Column="8"
                                                Content="+ 添加资料介质（模拟）"
                                                Command="{Binding AddDataSimulatedMediaEntryCommand}"
                                                Padding="8,2"
                                                Margin="{StaticResource YaRegFieldLeadingMargin}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding DataSimulatedMediaView}" ItemTemplate="{StaticResource MediaEntryTemplate_DataSimulated}"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
                </UserControl>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="{Binding WindowTitle}" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="{Binding RegisterWorkspaceBannerText}"
                       Margin="0,4,0,0" Foreground="#666" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>

        <!-- 申请态：外层白卡 + 可编辑表单 -->
        <Border Grid.Row="1" BorderBrush="#D8E2EC" BorderThickness="1" CornerRadius="4" Background="White">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowApprovalWorkflowPanel}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ScrollViewer x:Name="FormScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="8">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ApplicantSectionsTemplate}"/>
            </ScrollViewer>
        </Border>

        <!-- 审批态：壳自带白卡；打印/办结/关闭底栏固定在白卡外（对齐独立办理窗） -->
        <local:ArchiveRegisterApprovalSectionsView Grid.Row="1">
            <local:ArchiveRegisterApprovalSectionsView.Style>
                <Style TargetType="local:ArchiveRegisterApprovalSectionsView">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowApprovalWorkflowPanel}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </local:ArchiveRegisterApprovalSectionsView.Style>
        </local:ArchiveRegisterApprovalSectionsView>

        <Border Grid.Row="2" Margin="0,8,0,0" Padding="10,8" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Background="#FAFBFC">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowApprovalWorkflowPanel}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowApplicationSubmitActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Content="保存草稿" Command="{Binding SaveDraftCommand}" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Content="提交申请" Command="{Binding SubmitApplicationsCommand}" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Content="打印申请" Command="{Binding PrintApplicationsCommand}" Margin="0,0,8,0" Padding="12,6"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Content="关闭" Command="{Binding CloseCommand}" Padding="16,6"/>
            </Grid>
        </Border>
    </Grid>
</Window>
