<Window x:Class="DocMgr.Views.YearlyArchive.ArchiveRegisterEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DocMgr.Views.YearlyArchive"
        Width="1200"
        Height="820"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ArchiveRegisterResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <DataTemplate x:Key="ApplicantSectionsTemplate">
                <UserControl>
                <StackPanel Orientation="Vertical">
                    <GroupBox Header="1. 资料信息" Style="{StaticResource Level1GroupBoxStyle}" Padding="8">
                        <StackPanel Orientation="Vertical" Grid.IsSharedSizeScope="True">
                            <DockPanel Margin="0,2" LastChildFill="True">
                                <Label DockPanel.Dock="Left" Width="110" Style="{StaticResource FormLabelStyle}" Content="资料名称 *："/>
                                <TextBox Text="{Binding CurrentRecord.MaterialName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"/>
                            </DockPanel>

                            <DockPanel Margin="0,2" LastChildFill="True">
                                <Label DockPanel.Dock="Left" Width="110" Style="{StaticResource FormLabelStyle}" Content="所属项目 *："/>
                                <ComboBox DockPanel.Dock="Left" Width="100" Style="{StaticResource ArchiveRegisterFormComboBoxStyle}" Margin="0,0,6,0"
                                          ItemsSource="{Binding ProjectYears}"
                                          SelectedItem="{Binding SelectedProjectYear}"/>
                                <ComboBox Style="{StaticResource ArchiveRegisterFormComboBoxStyle}"
                                          ItemsSource="{Binding Projects}"
                                          DisplayMemberPath="ProjectName"
                                          SelectedItem="{Binding SelectedProject}"/>
                            </DockPanel>

                            <DockPanel Margin="0,2" LastChildFill="True">
                                <Label DockPanel.Dock="Left" Width="110" Style="{StaticResource FormLabelStyle}" Content="资料来源 *："/>
                                <ComboBox DockPanel.Dock="Left" Width="100" Margin="0,0,12,0"
                                          ItemsSource="{Binding SourceTypeOptions}" SelectedItem="{Binding SelectedSourceType}">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource ArchiveRegisterFormComboBoxStyle}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSourceTypeEditable}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>
                                <TextBox DockPanel.Dock="Left" Width="100" Margin="0,0,12,0"
                                         Text="{Binding SelectedSourceType, Mode=OneWay}" IsReadOnly="True"
                                         Background="#F5F5F5">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource ArchiveRegisterFormTextBoxStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSourceTypeEditable}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <Label DockPanel.Dock="Left" Width="120" Style="{StaticResource FormLabelStyle}"
                                       Content="提供部门(单位) *：" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding Departments}" DisplayMemberPath="Name" SelectedValuePath="Name"
                                          SelectedValue="{Binding CurrentRecord.ProvideUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource ArchiveRegisterFormComboBoxStyle}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExternalSource}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>
                                <TextBox Text="{Binding CurrentRecord.ProvideUnit, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource ArchiveRegisterFormTextBoxStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExternalSource}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </DockPanel>

                            <GroupBox Header="资料介质（电子） *" Margin="0,6,0,0" BorderBrush="#DDD" Padding="6">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="YaRegMediaTbLabel"/>
                                            <ColumnDefinition Width="72" SharedSizeGroup="YaRegMediaTbKind"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="YaRegMediaTbLabel"/>
                                            <ColumnDefinition Width="120" SharedSizeGroup="YaRegMediaTbType"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="YaRegMediaTbLabel"/>
                                            <ColumnDefinition Width="56" SharedSizeGroup="YaRegMediaTbCount"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="YaRegMediaTbLabel"/>
                                            <ColumnDefinition Width="120" SharedSizeGroup="YaRegMediaTbDisp"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="介质：" Style="{StaticResource ArchiveRegisterMediaToolbarLabelStyle}"/>
                                        <TextBox Grid.Column="1" Text="电子" IsReadOnly="True" Background="#F5F5F5"
                                                 Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"/>
                                        <TextBlock Grid.Column="3" Text="类型：" Style="{StaticResource ArchiveRegisterMediaToolbarLabelStyle}"/>
                                        <ComboBox Grid.Column="4"
                                                  ItemsSource="{Binding DataElectronicMediaTypeOptions}"
                                                  SelectedItem="{Binding SelectedElectronicMediaType}">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox" BasedOn="{StaticResource ArchiveRegisterFormComboBoxStyle}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsElectronicMediaTypeEditable}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>
                                        <TextBox Grid.Column="4"
                                                 Text="{Binding SelectedElectronicMediaType, Mode=OneWay}" IsReadOnly="True" Background="#F5F5F5">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource ArchiveRegisterFormTextBoxStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsElectronicMediaTypeEditable}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <TextBlock Grid.Column="6" Text="数量：" Style="{StaticResource ArchiveRegisterMediaToolbarLabelStyle}"/>
                                        <TextBox Grid.Column="7" Text="{Binding DataElectronicMediaCount, Mode=OneWay}" IsReadOnly="True" Background="#F5F5F5"
                                                 Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"/>
                                        <TextBlock Grid.Column="9" Text="处置：" Style="{StaticResource ArchiveRegisterMediaToolbarLabelStyle}"/>
                                        <ComboBox Grid.Column="10"
                                                  ItemsSource="{Binding DataElectronicDispositionOptions}"
                                                  SelectedItem="{Binding SelectedElectronicDisposition}">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox" BasedOn="{StaticResource ArchiveRegisterFormComboBoxStyle}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsElectronicDispositionEditable}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>
                                        <TextBox Grid.Column="10"
                                                 Text="{Binding SelectedElectronicDisposition, Mode=OneWay}" IsReadOnly="True" Background="#F5F5F5">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource ArchiveRegisterFormTextBoxStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsElectronicDispositionEditable}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <Button Grid.Column="11"
                                                Content="+ 添加资料介质（电子）"
                                                Command="{Binding AddDataElectronicMediaEntryCommand}"
                                                Padding="8,2"
                                                Margin="12,0,0,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Margin="2,0,0,4" Foreground="#00695C" TextWrapping="Wrap"
                                               Text="{Binding NetworkOutboundTransferHint, Mode=OneWay}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNetworkOutboundTransferRegister}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding DataElectronicMediaView}" ItemTemplate="{StaticResource MediaEntryTemplate_DataElectronic}"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="资料介质（模拟） *" Margin="0,6,0,0" BorderBrush="#DDD" Padding="6">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="YaRegMediaTbLabel"/>
                                            <ColumnDefinition Width="72" SharedSizeGroup="YaRegMediaTbKind"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="YaRegMediaTbLabel"/>
                                            <ColumnDefinition Width="120" SharedSizeGroup="YaRegMediaTbType"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="YaRegMediaTbLabel"/>
                                            <ColumnDefinition Width="56" SharedSizeGroup="YaRegMediaTbCount"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="YaRegMediaTbLabel"/>
                                            <ColumnDefinition Width="120" SharedSizeGroup="YaRegMediaTbDisp"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="介质：" Style="{StaticResource ArchiveRegisterMediaToolbarLabelStyle}"/>
                                        <TextBox Grid.Column="1" Text="模拟" IsReadOnly="True" Background="#F5F5F5"
                                                 Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"/>
                                        <TextBlock Grid.Column="3" Text="类型：" Style="{StaticResource ArchiveRegisterMediaToolbarLabelStyle}"/>
                                        <ComboBox Grid.Column="4"
                                                  Style="{StaticResource ArchiveRegisterFormComboBoxStyle}"
                                                  ItemsSource="{Binding DataSimulatedMediaTypeOptions}"
                                                  SelectedItem="{Binding SelectedSimulatedMediaType}"/>
                                        <TextBlock Grid.Column="6" Text="数量：" Style="{StaticResource ArchiveRegisterMediaToolbarLabelStyle}"/>
                                        <TextBox Grid.Column="7" Text="{Binding DataSimulatedMediaCount, Mode=OneWay}" IsReadOnly="True" Background="#F5F5F5"
                                                 Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"/>
                                        <Button Grid.Column="11"
                                                Content="+ 添加资料介质（模拟）"
                                                Command="{Binding AddDataSimulatedMediaEntryCommand}"
                                                Padding="8,2"
                                                Margin="12,0,0,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding DataSimulatedMediaView}" ItemTemplate="{StaticResource MediaEntryTemplate_DataSimulated}"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="2. 申请信息" Style="{StaticResource Level1GroupBoxStyle}" Padding="8">
                        <StackPanel>
                            <!-- 归档目的：左标签列宽统一 110；「其他」时横排补充说明 -->
                            <DockPanel Margin="0,2" LastChildFill="True">
                                <Label DockPanel.Dock="Left"
                                       Width="110"
                                       Style="{StaticResource FormLabelStyle}"
                                       Content="归档目的 *："/>
                                <ComboBox DockPanel.Dock="Left"
                                          Width="150"
                                          Margin="0,0,12,0"
                                          Style="{StaticResource ArchiveRegisterFormComboBoxStyle}"
                                          ItemsSource="{Binding ArchivePurposeOptions}"
                                          SelectedItem="{Binding SelectedArchivePurpose}"/>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsArchivePurposeOtherSelected}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Label Style="{StaticResource FormLabelStyle}" Content="说明：" Margin="0,0,6,0"/>
                                    <TextBox MinWidth="240"
                                             Width="360"
                                             Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                                             Text="{Binding CurrentRecord.OtherRequests, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="当目的为‘其他’时可在此补充说明"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- 证明材料：是/否 + 名称同行（与借出硬盘行内单选同构） -->
                            <DockPanel Margin="0,2" LastChildFill="True">
                                <Label DockPanel.Dock="Left"
                                       Width="110"
                                       Style="{StaticResource FormLabelStyle}"
                                       Content="附有证明材料："/>
                                <StackPanel DockPanel.Dock="Left"
                                            Orientation="Horizontal"
                                            Style="{StaticResource FormInlineRadioGroupStyle}"
                                            Margin="0,0,8,0">
                                    <RadioButton Content="是"
                                                 GroupName="RegisterProofMaterialHas"
                                                 Style="{StaticResource ArchiveRegisterFormRadioButtonStyle}"
                                                 IsChecked="{Binding HasProofMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <RadioButton Content="否"
                                                 GroupName="RegisterProofMaterialHas"
                                                 Style="{StaticResource ArchiveRegisterFormRadioButtonStyle}"
                                                 IsChecked="{Binding HasProofMaterial, Converter={StaticResource InverseBoolRadioConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <DockPanel LastChildFill="True">
                                    <DockPanel.Style>
                                        <Style TargetType="DockPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasProofMaterial}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DockPanel.Style>
                                    <Label DockPanel.Dock="Left"
                                           Style="{StaticResource FormLabelStyle}"
                                           Content="名称："
                                           Margin="0,0,6,0"/>
                                    <TextBox Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                                             Text="{Binding ProofMaterialName, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="填写证明材料名称；审批环节由资料管理员上传扫描件"/>
                                </DockPanel>
                            </DockPanel>

                            <DockPanel Margin="0,2" LastChildFill="True">
                                <Label DockPanel.Dock="Left"
                                       Width="110"
                                       Style="{StaticResource FormLabelStyle}"
                                       Content="其他要求："/>
                                <TextBox Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                                         Text="{Binding CurrentRecord.OtherRequests, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>

                            <DockPanel Margin="0,2" LastChildFill="True">
                                <Label DockPanel.Dock="Left"
                                       Width="110"
                                       Style="{StaticResource FormLabelStyle}"
                                       Content="申请人 *："/>
                                <TextBox DockPanel.Dock="Left"
                                         Width="88"
                                         Margin="0,0,12,0"
                                         Text="{Binding CurrentRecord.ApplicantName}"
                                         IsReadOnly="True"
                                         Background="#F5F5F5"
                                         Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"/>
                                <Label DockPanel.Dock="Left"
                                       Style="{StaticResource FormLabelStyle}"
                                       Content="部门 *："
                                       Margin="0,0,6,0"/>
                                <TextBox DockPanel.Dock="Left"
                                         Width="150"
                                         Margin="0,0,12,0"
                                         Text="{Binding CurrentRecord.ApplicantDept}"
                                         IsReadOnly="True"
                                         Background="#F5F5F5"
                                         Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"/>
                                <Label DockPanel.Dock="Left"
                                       Style="{StaticResource FormLabelStyle}"
                                       Content="日期 *："
                                       Margin="0,0,6,0"/>
                                <DatePicker DockPanel.Dock="Left"
                                            Width="120"
                                            SelectedDate="{Binding CurrentRecord.ApplicantDate}"
                                            Style="{StaticResource ArchiveRegisterFormDatePickerStyle}"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding ShowApplicationSubmitActions}" Value="True"/>
                                                            <Condition Binding="{Binding ShowEmbeddedActionButtons}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Button Content="💾 保存草稿" Command="{Binding SaveDraftCommand}"
                                                Padding="10,0" FontSize="12" FontWeight="Bold" Cursor="Hand" Margin="0,0,8,0" Width="100" Style="{StaticResource ButtonNormalStyle}"/>
                                        <Button Content="💾 提交申请" Command="{Binding SubmitApplicationsCommand}"
                                                Padding="10,0" FontSize="12" FontWeight="Bold" Cursor="Hand" Width="100" Style="{StaticResource ButtonNormalStyle}"/>
                                    </StackPanel>
                                    <Button Content="💾 打印申请" Command="{Binding PrintApplicationsCommand}"
                                            Padding="10,0" FontSize="12" FontWeight="Bold" Cursor="Hand" Width="100">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ButtonNormalStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding ShowApplicationSubmitActions}" Value="True"/>
                                                            <Condition Binding="{Binding ShowEmbeddedActionButtons}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
                </UserControl>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="{Binding WindowTitle}" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="{Binding RegisterWorkspaceBannerText}"
                       Margin="0,4,0,0" Foreground="#666" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#D8E2EC" BorderThickness="1" CornerRadius="4" Background="White">
            <ScrollViewer x:Name="FormScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="8">
                <StackPanel Margin="8" Orientation="Vertical">
                    <ContentControl Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource ApplicantSectionsTemplate}"/>
                                <Style.Triggers>
                                    <!-- 审批态改用只读分区；隐藏本控件，避免 ContentTemplate 为空时显示 ViewModel 类型名 -->
                                    <DataTrigger Binding="{Binding ShowApprovalWorkflowPanel}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                    <local:ArchiveRegisterApprovalApplicationSectionsView>
                        <local:ArchiveRegisterApprovalApplicationSectionsView.Style>
                            <Style TargetType="local:ArchiveRegisterApprovalApplicationSectionsView">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowApprovalWorkflowPanel}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:ArchiveRegisterApprovalApplicationSectionsView.Style>
                    </local:ArchiveRegisterApprovalApplicationSectionsView>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowApprovalWorkflowPanel}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <local:ArchiveRegisterApprovalSectionsView/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Margin="0,8,0,0" Padding="10,8,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Background="#FAFBFC">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowApplicationSubmitActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Content="保存草稿" Command="{Binding SaveDraftCommand}" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Content="提交申请" Command="{Binding SubmitApplicationsCommand}" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Content="打印申请" Command="{Binding PrintApplicationsCommand}" Margin="0,0,8,0" Padding="12,6"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowApprovalWorkflowPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Content="审批通过" Command="{Binding SaveApprovalCommand}" ToolTip="{Binding ApproveHintText}" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Content="确认实物交接" Command="{Binding ConfirmPhysicalHandoverCommand}" ToolTip="{Binding ConfirmHandoverHintText}" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Content="确认办结" Command="{Binding CompleteCommand}" ToolTip="{Binding CompleteHintText}" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Content="打印交接单" Command="{Binding PrintApprovalCommand}" ToolTip="{Binding PrintHintText}" Margin="0,0,8,0" Padding="12,6"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Content="关闭" Command="{Binding CloseCommand}" Padding="16,6"/>
            </Grid>
        </Border>
    </Grid>
</Window>
