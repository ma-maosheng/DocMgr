<Window x:Class="DocMgr.Views.YearlyArchive.ArchiveRegisterEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DocMgr.Views.YearlyArchive"
        Width="1200"
        Height="820"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ArchiveRegisterResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <DataTemplate x:Key="ApplicantSectionsTemplate">
                <UserControl>
                <StackPanel Orientation="Vertical" Cursor="">
                    <GroupBox Header="1. 资料信息" Style="{StaticResource Level1GroupBoxStyle}" Padding="10">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Label Width="110" VerticalAlignment="Center">资料名称 *：</Label>
                                <TextBox Text="{Binding CurrentRecord.MaterialName, UpdateSourceTrigger=PropertyChanged}" Width="500" Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Label Width="110" VerticalAlignment="Center">所属项目 *：</Label>
                                <ComboBox Width="100" Style="{StaticResource ArchiveRegisterFormComboBoxStyle}" Margin="0,0,5,0"
                                          ItemsSource="{Binding ProjectYears}"
                                          SelectedItem="{Binding SelectedProjectYear}"/>
                                <ComboBox Width="395" Style="{StaticResource ArchiveRegisterFormComboBoxStyle}"
                                          ItemsSource="{Binding Projects}"
                                          DisplayMemberPath="ProjectName"
                                          SelectedItem="{Binding SelectedProject}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4" VerticalAlignment="Center">
                                <Label Width="110" VerticalAlignment="Center">资料来源 *：</Label>
                                <ComboBox Width="98" Style="{StaticResource ArchiveRegisterFormComboBoxStyle}" ItemsSource="{Binding SourceTypeOptions}" SelectedItem="{Binding SelectedSourceType}"/>
                                <Label Width="140" VerticalAlignment="Center" Content="        提供部门(单位) *："/>
                                <ComboBox Width="260"
                                          ItemsSource="{Binding Departments}" DisplayMemberPath="Name" SelectedValuePath="Name"
                                          SelectedValue="{Binding CurrentRecord.ProvideUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource ArchiveRegisterFormComboBoxStyle}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExternalSource}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>
                                <TextBox Width="500"
                                         Text="{Binding CurrentRecord.ProvideUnit, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource ArchiveRegisterFormTextBoxStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExternalSource}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </StackPanel>

                            <GroupBox Header="资料介质（电子） *" Margin="0,8,0,0" BorderBrush="#DDD" Padding="6">
                                <StackPanel Margin="4">
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="介质：" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="电子" Height="26" Margin="2,0" VerticalContentAlignment="Center" IsReadOnly="True" Background="#F5F5F5"/>
                                        <TextBlock Grid.Column="2" Text="类型：" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                        <ComboBox Grid.Column="3" Style="{StaticResource ArchiveRegisterFormComboBoxStyle}" Margin="2,0" VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding DataElectronicMediaTypeOptions}"
                                                  SelectedItem="{Binding SelectedElectronicMediaType}"/>
                                        <TextBlock Grid.Column="4" Text="数量：" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="5" Text="{Binding DataElectronicMediaCount, Mode=OneWay}" Height="26" Margin="2,0" VerticalContentAlignment="Center" IsReadOnly="True" Background="#F5F5F5"/>
                                        <TextBlock Grid.Column="6" Text="处置：" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                        <ComboBox Grid.Column="7" Style="{StaticResource ArchiveRegisterFormComboBoxStyle}" Margin="2,0" VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding DataElectronicDispositionOptions}"
                                                  SelectedItem="{Binding SelectedElectronicDisposition}"/>
                                        <Button Grid.Column="8"
                                                Content="+ 添加资料介质（电子）"
                                                Command="{Binding AddDataElectronicMediaEntryCommand}"
                                                Padding="8,2"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding DataElectronicMediaView}" ItemTemplate="{StaticResource MediaEntryTemplate_DataElectronic}"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="资料介质（模拟） *" Margin="0,8,0,0" BorderBrush="#DDD" Padding="6">
                                <StackPanel Margin="4">
                                    <DockPanel Margin="0,0,0,4" LastChildFill="True">
                                        <Button DockPanel.Dock="Right"
                                                Content="+ 添加资料介质（模拟）"
                                                Command="{Binding AddDataSimulatedMediaEntryCommand}"
                                                Padding="8,2"/>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding DataSimulatedMediaView}" ItemTemplate="{StaticResource MediaEntryTemplate_DataSimulated}"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="证明材料介质（模拟） *" Margin="0,8,0,0" BorderBrush="#DDD" Padding="6">
                                <StackPanel Margin="4">
                                    <DockPanel Margin="0,0,0,4" LastChildFill="True">
                                        <Button DockPanel.Dock="Right"
                                                Content="+ 添加证明材料介质（模拟）"
                                                Command="{Binding AddProofSimulatedMediaEntryCommand}"
                                                Padding="8,2"/>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding ProofSimulatedMediaView}" ItemTemplate="{StaticResource MediaEntryTemplate_ProofSimulated}"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="2. 申请信息" Style="{StaticResource Level1GroupBoxStyle}" Padding="10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4" Height="30">
                                <Label Width="110">归档目的 *：</Label>
                                <ComboBox Width="150" Style="{StaticResource ArchiveRegisterFormComboBoxStyle}"
                                          ItemsSource="{Binding ArchivePurposeOptions}"
                                          SelectedItem="{Binding SelectedArchivePurpose}"/>
                                <TextBlock Text="说明：" VerticalAlignment="Center" Margin="10,0,5,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsArchivePurposeOtherSelected}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Width="363" Margin="10,0,0,0" Text="{Binding CurrentRecord.OtherRequests, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="当目的为‘其他’时可在此补充说明">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource ArchiveRegisterFormTextBoxStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsArchivePurposeOtherSelected}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </StackPanel>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Width="110" Content="其他要求："/>
                                <TextBox Grid.Column="1" Margin="0,0,10,0" Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                                         Text="{Binding CurrentRecord.OtherRequests, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Label Width="110">申请人*：</Label>
                                <TextBox Width="85" Text="{Binding CurrentRecord.ApplicantName}" IsReadOnly="True" Background="#F5F5F5" Margin="0,0,10,0" Height="28" VerticalContentAlignment="Center"/>
                                <Label>部门*：</Label>
                                <TextBox Width="150" Text="{Binding CurrentRecord.ApplicantDept}" IsReadOnly="True" Background="#F5F5F5" Height="28" VerticalContentAlignment="Center"/>
                                <Label>日期*：</Label>
                                <DatePicker SelectedDate="{Binding CurrentRecord.ApplicantDate}" Width="100" Style="{StaticResource ArchiveRegisterFormDatePickerStyle}"/>

                                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ShowApplicationSubmitActions}" Value="True"/>
                                                        <Condition Binding="{Binding ShowEmbeddedActionButtons}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Button Content="💾 保存草稿" Command="{Binding SaveDraftCommand}"
                                            Padding="10,0" FontSize="12" FontWeight="Bold" Cursor="Hand" Margin="0,0,10,0" Width="100" Style="{StaticResource ButtonNormalStyle}"/>
                                    <Button Content="💾 提交申请" Command="{Binding SubmitApplicationsCommand}"
                                            Padding="10,0" FontSize="12" FontWeight="Bold" Cursor="Hand" Width="100" Style="{StaticResource ButtonNormalStyle}"/>
                                </StackPanel>

                                <Button Content="💾 打印申请" Command="{Binding PrintApplicationsCommand}"
                                        Padding="10,0" FontSize="12" FontWeight="Bold" Cursor="Hand" Margin="10,0,0,0" Width="100">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ButtonNormalStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ShowApplicationSubmitActions}" Value="True"/>
                                                        <Condition Binding="{Binding ShowEmbeddedActionButtons}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
                </UserControl>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding WindowTitle}" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="{Binding RegisterWorkspaceBannerText}"
                       Margin="0,6,0,0" Foreground="#666" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#D8E2EC" BorderThickness="1" CornerRadius="4" Background="White">
            <ScrollViewer x:Name="FormScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="10">
                <StackPanel Margin="12" Orientation="Vertical">
                    <ContentControl Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource ApplicantSectionsTemplate}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowApprovalWorkflowPanel}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{x:Null}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                    <local:ArchiveRegisterApprovalApplicationSectionsView>
                        <local:ArchiveRegisterApprovalApplicationSectionsView.Style>
                            <Style TargetType="local:ArchiveRegisterApprovalApplicationSectionsView">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowApprovalWorkflowPanel}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:ArchiveRegisterApprovalApplicationSectionsView.Style>
                    </local:ArchiveRegisterApprovalApplicationSectionsView>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowApprovalWorkflowPanel}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <local:ArchiveRegisterApprovalSectionsView/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,10,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Background="#FAFBFC">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowApplicationSubmitActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Content="保存草稿" Command="{Binding SaveDraftCommand}" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Content="提交申请" Command="{Binding SubmitApplicationsCommand}" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Content="打印申请" Command="{Binding PrintApplicationsCommand}" Margin="0,0,8,0" Padding="12,6"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowApprovalWorkflowPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Content="审批通过" Command="{Binding SaveApprovalCommand}" ToolTip="{Binding ApproveHintText}" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Content="上传签字件" Command="{Binding UploadAttachmentCommand}" ToolTip="{Binding UploadHintText}" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Content="确认办结" Command="{Binding CompleteCommand}" ToolTip="{Binding CompleteHintText}" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Content="打印交接单" Command="{Binding PrintApprovalCommand}" ToolTip="{Binding PrintHintText}" Margin="0,0,8,0" Padding="12,6"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Content="关闭" Command="{Binding CloseCommand}" Padding="16,6"/>
            </Grid>
        </Border>
    </Grid>
</Window>
