<Page x:Class="DocMgr.Views.YearlyArchive.ArchiveRegisterApplicationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="800"
      d:DesignWidth="1200"
      Title="资料登记（申请）"
      Background="#F0F2F5">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCardBorderStyle}" Margin="0" CornerRadius="0" Padding="16,12">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Button Content="{Binding AddActionText}" Command="{Binding AddCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="96" Margin="0,0,10,0"/>
                        <Button Content="{Binding OpenActionText}" Command="{Binding OpenCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="96" Margin="0,0,10,0"/>
                        <Button Content="{Binding DestructiveActionText}" Command="{Binding DestructiveCommand}" Style="{StaticResource ToolbarDangerButtonStyle}" Width="130" Margin="0,0,10,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="状态:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="180"
                                  Style="{StaticResource ToolbarFilterComboBoxStyle}"
                                  ItemsSource="{Binding StatusFilterOptions}"
                                  SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="Label"
                                  ToolTip="可按状态筛选；选【全部】列出各状态申请（含未提交）"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="申请年度:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="100"
                                  Style="{StaticResource ToolbarFilterComboBoxStyle}"
                                  ItemsSource="{Binding YearOptions}"
                                  SelectedItem="{Binding SelectedYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <Button Grid.Column="3"
                            Content="刷新列表"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource ToolbarActionButtonStyle}"
                            Width="96"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1"
                Margin="0,12,0,12"
                Padding="0"
                Background="#FFFDF7"
                BorderBrush="#E2C98F"
                BorderThickness="1"
                CornerRadius="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#B98A2E"/>
                <TextBlock Grid.Row="1"
                           Text="{Binding PageTitle}"
                           Margin="0,12,0,4"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#6F4A00"
                           HorizontalAlignment="Center"
                           TextDecorations="Underline"/>
                <TextBlock Grid.Row="2"
                           Text="{Binding PageSubtitle}"
                           Margin="0,0,0,10"
                           FontSize="12"
                           Foreground="#9A7B3F"
                           HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="0" Padding="10" Margin="0">
            <DataGrid x:Name="DgRecords"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      RowHeight="38"
                      ColumnHeaderHeight="40"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      ItemsSource="{Binding Records}"
                      SelectedItem="{Binding SelectedRecord}"
                      MouseDoubleClick="DgRecords_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="申请单编号" Binding="{Binding FormNo}" Width="160"/>
                    <DataGridTextColumn Header="资料名称" Binding="{Binding MaterialName}" Width="220"/>
                    <DataGridTextColumn Header="所属项目" Binding="{Binding ProjectName}" Width="180"/>
                    <DataGridTextColumn Header="提供单位" Binding="{Binding ProvideUnit}" Width="140"/>
                    <DataGridTextColumn Header="申请人" Binding="{Binding ApplicantName}" Width="90"/>
                    <DataGridTextColumn Header="申请部门" Binding="{Binding ApplicantDept}" Width="120"/>
                    <DataGridTextColumn Header="申请日期" Binding="{Binding ApplicantDate, StringFormat=yyyy-MM-dd}" Width="110"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusStr}" Width="110"/>
                    <DataGridTextColumn Header="归档盒/编号" Binding="{Binding ArchiveBoxNos}" Width="220"/>
                    <DataGridTextColumn Header="归档位置" Binding="{Binding ArchiveBoxLocations}" Width="220"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
