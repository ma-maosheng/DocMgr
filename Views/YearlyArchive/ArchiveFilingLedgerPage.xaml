<Page x:Class="DocMgr.Views.YearlyArchive.ArchiveFilingLedgerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:DocMgr.Views.YearlyArchive"
      xmlns:viewShared="clr-namespace:DocMgr.Views.Shared"
      mc:Ignorable="d"
      d:DesignHeight="900"
      d:DesignWidth="1400"
      Title="ArchiveFilingLedgerPage"
      Background="#F0F2F5">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:InverseBoolToVisConverter x:Key="InverseBoolToVisConverter"/>

        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#004D40"/>
        </Style>

        <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#37474F"/>
        </Style>

        <Style x:Key="SectionHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CompactToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarActionButtonStyle}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>

        <Style x:Key="ContentCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SectionHeaderBarStyle" TargetType="Border">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>

        <Style x:Key="SummaryBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#ECFDF5"/>
            <Setter Property="BorderBrush" Value="#A7F3D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <Style x:Key="DetailGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="SemiBold" Foreground="#00695C" FontSize="13"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="FieldValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,16,12"/>
        </Style>

        <Style x:Key="DetailSummaryBannerStyle" TargetType="Border">
            <Setter Property="Background" Value="#F0FDF4"/>
            <Setter Property="BorderBrush" Value="#BBF7D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="EmptyStateTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DetailSubSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="DetailSubSectionPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="CurrentFieldValueStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldValueStyle}">
            <Setter Property="Foreground" Value="#1B5E20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="StorageUnchangedHintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="LedgerPaneGridSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Height" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
            <Setter Property="ResizeDirection" Value="Rows"/>
            <Setter Property="ShowsPreview" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="SizeNS"/>
            <Setter Property="ToolTip" Value="拖动以调整列表与详情区域高度"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Margin="0,1">
                            <Border Background="#D1D5DB" Margin="0,0,0,1"/>

                            <Border BorderThickness="0,1,0,1">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#9CA3AF" Offset="0"/>
                                        <GradientStop Color="#F9FAFB" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Border x:Name="SplitterGroove"
                                        Margin="0,1,0,1"
                                        Background="#E5E7EB">
                                    <Border x:Name="SplitterHandle"
                                            Height="8"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            MinWidth="72"
                                            MaxWidth="160"
                                            Margin="24,0"
                                            CornerRadius="3"
                                            BorderThickness="1">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#F9FAFB" Offset="0"/>
                                                <GradientStop Color="#D1D5DB" Offset="0.55"/>
                                                <GradientStop Color="#9CA3AF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                                <GradientStop Color="#6B7280" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <StackPanel Orientation="Vertical"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                            <Rectangle Width="24" Height="2" RadiusX="1" RadiusY="1" Fill="#6B7280" Margin="0,1"/>
                                            <Rectangle Width="24" Height="2" RadiusX="1" RadiusY="1" Fill="#6B7280" Margin="0,1"/>
                                            <Rectangle Width="24" Height="2" RadiusX="1" RadiusY="1" Fill="#6B7280" Margin="0,1"/>
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SplitterGroove" Property="Background" Value="#ECEFF1"/>
                                <Setter TargetName="SplitterHandle" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFFFFF" Offset="0"/>
                                            <GradientStop Color="#E5E7EB" Offset="0.55"/>
                                            <GradientStop Color="#9CA3AF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="SplitterHandle" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#D1D5DB" Offset="0"/>
                                            <GradientStop Color="#9CA3AF" Offset="0.55"/>
                                            <GradientStop Color="#6B7280" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DetailSectionExpanderStyle" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="SemiBold" Foreground="#00695C" FontSize="13"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProcessNodeHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#92400E"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Page.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.6*" MinHeight="140"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*" MinHeight="120"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="立档台账" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                       Text="按立档编号中的档案年度浏览已立档资料，支持多条件筛选、详情查看与台账导出（资料室管理员）。"/>
        </StackPanel>

        <!-- 筛选区 -->
        <Border Grid.Row="1" Style="{StaticResource ToolbarCardBorderStyle}" Padding="10,8" Margin="0,0,0,8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid MinHeight="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="68"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="128"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="68"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="68"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="108"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="108"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140" MinWidth="100"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="筛选条件" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" Margin="0"/>

                    <TextBlock Grid.Column="2" Text="档案年度" Style="{StaticResource FilterLabelStyle}"/>
                    <ComboBox Grid.Column="3" Style="{StaticResource FilterInputStyle}"
                              ItemsSource="{Binding Years}"
                              SelectedItem="{Binding SelectedYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Column="5" Text="项目" Style="{StaticResource FilterLabelStyle}"/>
                    <ComboBox Grid.Column="6" Style="{StaticResource FilterInputStyle}"
                              ItemsSource="{Binding ProjectOptions}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedProjectId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Column="8" Text="介质" Style="{StaticResource FilterLabelStyle}"/>
                    <ComboBox Grid.Column="9" Style="{StaticResource FilterInputStyle}"
                              ItemsSource="{Binding MediaKindOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedMediaKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Column="11" Text="状态" Style="{StaticResource FilterLabelStyle}"/>
                    <ComboBox Grid.Column="12" Style="{StaticResource FilterInputStyle}"
                              ItemsSource="{Binding LifecycleStatusOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedLifecycleStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Column="14" Text="副本" Style="{StaticResource FilterLabelStyle}"/>
                    <ComboBox Grid.Column="15" Style="{StaticResource FilterInputStyle}"
                              ItemsSource="{Binding ArchiveCopyRoleOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedArchiveCopyRole, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Column="17" Text="立档自" Style="{StaticResource FilterLabelStyle}"/>
                    <DatePicker Grid.Column="18" Style="{StaticResource FilterDatePickerStyle}"
                                SelectedDate="{Binding FiledFrom, Mode=TwoWay}"/>

                    <TextBlock Grid.Column="20" Text="立档至" Style="{StaticResource FilterLabelStyle}"/>
                    <DatePicker Grid.Column="21" Style="{StaticResource FilterDatePickerStyle}"
                                SelectedDate="{Binding FiledTo, Mode=TwoWay}"/>

                    <TextBlock Grid.Column="23" Text="关键词" Style="{StaticResource FilterLabelStyle}"/>
                    <TextBox Grid.Column="24" Style="{StaticResource SearchTextBoxStyle}"
                             Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="立档编号、表单号、资料/子项名称、容器编号、位置、介质编号等">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <StackPanel Grid.Column="26" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="查询" Style="{StaticResource CompactToolbarButtonStyle}" Command="{Binding SearchCommand}"/>
                        <Button Content="重置" Margin="4,0,0,0" Style="{StaticResource CompactToolbarButtonStyle}" Command="{Binding ResetCommand}"/>
                        <Button Content="导出" Margin="6,0,0,0" Style="{StaticResource CompactToolbarButtonStyle}" Command="{Binding ExportCommand}" ToolTip="导出台账"/>
                        <Button Content="刷新" Margin="4,0,0,0" Style="{StaticResource CompactToolbarButtonStyle}" Command="{Binding RefreshCommand}"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- 统计摘要 -->
        <Border Grid.Row="2" Style="{StaticResource SummaryBadgeStyle}" Margin="0,0,0,10">
            <TextBlock Text="{Binding SummaryText}" Foreground="#065F46" FontWeight="SemiBold" FontSize="13"/>
        </Border>

        <!-- 列表区 -->
        <Border Grid.Row="3" Style="{StaticResource ContentCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource SectionHeaderBarStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="立档记录列表" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="点击行可在下方查看完整立档信息" Style="{StaticResource SectionHintStyle}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="查看建档详情" Padding="12,5"
                                Style="{StaticResource ButtonNormalStyle}"
                                Command="{Binding ViewRegisterDetailCommand}"/>
                    </Grid>
                </Border>

                <DataGrid Grid.Row="1"
                          Margin="8"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          RowHeight="36"
                          ColumnHeaderHeight="38"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          ItemsSource="{Binding LedgerRows}"
                          SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="立档编号" Binding="{Binding FilingFactNo, Mode=OneWay}" Width="130"/>
                        <DataGridTextColumn Header="介质" Binding="{Binding MediaKind, Mode=OneWay}" Width="56"/>
                        <DataGridTextColumn Header="介质类型" Binding="{Binding RegisterMediaType, Mode=OneWay}" Width="72"/>
                        <DataGridTextColumn Header="资料类型" Binding="{Binding MaterialCategory, Mode=OneWay}" Width="72"/>
                        <DataGridTextColumn Header="所属子类" Binding="{Binding SubCategory, Mode=OneWay}" Width="80"/>
                        <DataGridTextColumn Header="组织形式" Binding="{Binding DataOrganizationForm, Mode=OneWay}" Width="72"/>
                        <DataGridTextColumn Header="表单号" Binding="{Binding FormNo, Mode=OneWay}" Width="118"/>
                        <DataGridTextColumn Header="资料名称" Binding="{Binding MaterialName, Mode=OneWay}" Width="150"/>
                        <DataGridTextColumn Header="库管模式" Binding="{Binding ArchivePurpose, Mode=OneWay}" Width="80"/>
                        <DataGridTextColumn Header="子项名称" Binding="{Binding ItemName, Mode=OneWay}" Width="130"/>
                        <DataGridTextColumn Header="项目" Binding="{Binding ProjectName, Mode=OneWay}" Width="110"/>
                        <DataGridTextColumn Header="容器编号" Binding="{Binding CurrentContainerCode, Mode=OneWay}" Width="125"/>
                        <DataGridTextColumn Header="当前位置" Binding="{Binding CurrentStorageLocation, Mode=OneWay}" Width="110"/>
                        <DataGridTextColumn Header="立档时间" Binding="{Binding FiledAtDisplay, Mode=OneWay}" Width="128"/>
                        <DataGridTextColumn Header="份数" Binding="{Binding CopyCountStatusDisplay, Mode=OneWay}" Width="90"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding LifecycleStatusDisplay, Mode=OneWay}" Width="68"/>
                        <DataGridTextColumn Header="副本" Binding="{Binding ArchiveCopyRoleDisplay, Mode=OneWay}" Width="56"/>
                        <DataGridTextColumn Header="提供单位" Binding="{Binding ProvideUnit, Mode=OneWay}" Width="100"/>
                        <DataGridTextColumn Header="借出提示" Binding="{Binding BorrowHintDisplay, Mode=OneWay}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="4" Style="{StaticResource LedgerPaneGridSplitterStyle}"/>

        <!-- 详情区 -->
        <Border Grid.Row="5" Style="{StaticResource ContentCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource SectionHeaderBarStyle}">
                    <TextBlock Text="选中记录详情" Style="{StaticResource SectionTitleStyle}"/>
                </Border>

                <!-- 未选中提示 -->
                <TextBlock Grid.Row="1"
                           Style="{StaticResource EmptyStateTextStyle}"
                           Text="请在上方列表中选择一条立档记录，&#x0a;查看建档、存放、生命周期等完整信息。"
                           Visibility="{Binding HasSelectedRow, Converter={StaticResource InverseBoolToVisConverter}}"/>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Padding="14,12"
                              Visibility="{Binding HasSelectedRow, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel DataContext="{Binding SelectedRow}">
                        <Border Style="{StaticResource DetailSummaryBannerStyle}">
                            <TextBlock Text="{Binding DataContext.DetailSummary, RelativeSource={RelativeSource AncestorType=Page}}"
                                       TextWrapping="Wrap" Foreground="#14532D" FontSize="13"/>
                        </Border>

                        <Expander Style="{StaticResource DetailSectionExpanderStyle}"
                                  Header="建档与资料信息"
                                  IsExpanded="{Binding DataContext.IsFilingInfoExpanded, RelativeSource={RelativeSource AncestorType=Page}, Mode=TwoWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="立档事实编号"/>
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding FilingFactNo, Mode=OneWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="表单号"/>
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding FormNo, Mode=OneWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="密级"/>
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding ConfidentialLevel, Mode=OneWay}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="资料名称"/>
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding MaterialName, Mode=OneWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="子项名称"/>
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding ItemName, Mode=OneWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="库管模式"/>
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding ArchivePurpose, Mode=OneWay}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="子项类型"/>
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding ItemType, Mode=OneWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="项目名称"/>
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding ProjectName, Mode=OneWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="提供单位"/>
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding ProvideUnit, Mode=OneWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="申请人 / 内容数量"/>
                                    <TextBlock Style="{StaticResource FieldValueStyle}">
                                        <Run Text="{Binding ApplicantName, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding ContentCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="1"
                                            Visibility="{Binding IsSimulatedMedia, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="库内/立档（灭失）"/>
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding CopyCountStatusDisplay, Mode=OneWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="2"
                                            Visibility="{Binding IsSimulatedMedia, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="介质类型"/>
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding RegisterMediaType, Mode=OneWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="2"
                                            Visibility="{Binding IsElectronicMedia, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="资料类型"/>
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding MaterialCategory, Mode=OneWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="0"
                                            Visibility="{Binding IsElectronicMedia, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="所属子类 / 组织形式"/>
                                    <TextBlock Style="{StaticResource FieldValueStyle}" TextWrapping="Wrap">
                                        <Run Text="{Binding SubCategory, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding DataOrganizationForm, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Expander>

                        <Expander Style="{StaticResource DetailSectionExpanderStyle}"
                                  Header="存放与容器"
                                  IsExpanded="{Binding DataContext.IsStorageExpanded, RelativeSource={RelativeSource AncestorType=Page}, Mode=TwoWay}">
                            <StackPanel>
                                <!-- 立档时快照 -->
                                <Border Style="{StaticResource DetailSubSectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource DetailSubSectionTitleStyle}"
                                                   Text="立档时（立档成功时的快照，不再变更）"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="容器类型"/>
                                                <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding ContainerKindDisplay, Mode=OneWay}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="立档容器编号"/>
                                                <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding ContainerCode, Mode=OneWay}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="立档存放位置"/>
                                                <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding StorageLocation, Mode=OneWay}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="0"
                                                        Visibility="{Binding IsSimulatedMedia, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="档案柜"/>
                                                <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding CabinetName, Mode=OneWay}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1"
                                                        Visibility="{Binding IsSimulatedMedia, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="盒规格"/>
                                                <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding BoxSpecs, Mode=OneWay}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="2"
                                                        Visibility="{Binding ShowDistinctBoxLocationCode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="盒位置编码"/>
                                                <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding BoxLocationCode, Mode=OneWay}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Grid.Column="0"
                                                        Visibility="{Binding IsElectronicMedia, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="存储载体"/>
                                                <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding StorageCarrierType, Mode=OneWay}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="1"
                                                        Visibility="{Binding IsElectronicMedia, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="介质编号"/>
                                                <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding MediumCode, Mode=OneWay}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 当前现状 -->
                                <Border Style="{StaticResource DetailSubSectionPanelStyle}" Margin="0,0,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource DetailSubSectionTitleStyle}"
                                                   Text="当前（随迁档、借还等生命周期更新）"/>

                                        <TextBlock Style="{StaticResource StorageUnchangedHintStyle}"
                                                   Text="{Binding CurrentStorageUnchangedHint, Mode=OneWay}"
                                                   Visibility="{Binding HasCurrentStorageChanged, Converter={StaticResource InverseBoolToVisConverter}}"/>

                                        <Grid Visibility="{Binding HasCurrentStorageChanged, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="当前容器编号"/>
                                                <TextBlock Style="{StaticResource CurrentFieldValueStyle}" Text="{Binding CurrentContainerCode, Mode=OneWay}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="当前存放位置"/>
                                                <TextBlock Style="{StaticResource CurrentFieldValueStyle}" Text="{Binding CurrentStorageLocation, Mode=OneWay}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource DetailSectionExpanderStyle}"
                                  Header="立档与生命周期"
                                  IsExpanded="{Binding DataContext.IsLifecycleExpanded, RelativeSource={RelativeSource AncestorType=Page}, Mode=TwoWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="立档时间"/>
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding FiledAtDisplay, Mode=OneWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="立档人"/>
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding FiledBy, Mode=OneWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="数据量"/>
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding DataSizeDisplay, Mode=OneWay}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="生命周期状态"/>
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding LifecycleStatusDisplay, Mode=OneWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="原件 / 备份"/>
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding ArchiveCopyRoleDisplay, Mode=OneWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="借出提示"/>
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding BorrowHintDisplay, Mode=OneWay}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="立档存储路径"/>
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding FilingStoragePath, Mode=OneWay}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="处置说明"/>
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding Disposition, Mode=OneWay}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="生命周期备注"/>
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding LifecycleRemark, Mode=OneWay}"/>
                                </StackPanel>
                            </Grid>
                        </Expander>

                        <Expander Style="{StaticResource DetailSectionExpanderStyle}"
                                  Header="{Binding DataContext.MaterialTransactionsExpanderHeader, RelativeSource={RelativeSource AncestorType=Page}}"
                                  IsExpanded="{Binding DataContext.IsMaterialTransactionsExpanded, RelativeSource={RelativeSource AncestorType=Page}, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="按时间倒序展示立档、迁档、出库办结、归还等实物/台账变化；出库申请预订与撤回见下方「关联出库单 / 流程节点」。"
                                           Margin="0,0,0,8"/>
                                <TextBlock Style="{StaticResource EmptyStateTextStyle}"
                                           Text="暂无流转记录。"
                                           Visibility="{Binding DataContext.HasSelectedMaterialTransactions, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBoolToVisConverter}}"/>
                                <DataGrid AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          RowHeight="32"
                                          ColumnHeaderHeight="34"
                                          GridLinesVisibility="Horizontal"
                                          BorderThickness="0"
                                          MaxHeight="220"
                                          Visibility="{Binding DataContext.HasSelectedMaterialTransactions, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          ItemsSource="{Binding DataContext.SelectedMaterialTransactions, RelativeSource={RelativeSource AncestorType=Page}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="时间" Binding="{Binding OperatedAtDisplay, Mode=OneWay}" Width="128"/>
                                        <DataGridTextColumn Header="业务" Binding="{Binding TransactionTypeDisplay, Mode=OneWay}" Width="72"/>
                                        <DataGridTextColumn Header="单号" Binding="{Binding BusinessNo, Mode=OneWay}" Width="130"/>
                                        <DataGridTextColumn Header="摘要" Binding="{Binding Summary, Mode=OneWay}" Width="220"/>
                                        <DataGridTextColumn Header="位置变化" Binding="{Binding LocationChangeDisplay, Mode=OneWay}" Width="160"/>
                                        <DataGridTextColumn Header="状态变化" Binding="{Binding LifecycleChangeDisplay, Mode=OneWay}" Width="100"/>
                                        <DataGridTextColumn Header="经办人" Binding="{Binding OperatorName, Mode=OneWay}" Width="72"/>
                                        <DataGridTextColumn Header="备注" Binding="{Binding Remark, Mode=OneWay}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource DetailSectionExpanderStyle}"
                                  Header="{Binding DataContext.OutboundProcessNodesExpanderHeader, RelativeSource={RelativeSource AncestorType=Page}}"
                                  IsExpanded="{Binding DataContext.IsOutboundProcessNodesExpanded, RelativeSource={RelativeSource AncestorType=Page}, Mode=TwoWay}"
                                  Visibility="{Binding DataContext.HasSelectedOutboundProcessNodes, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource ProcessNodeHintStyle}" Margin="0"
                                               Text="以下为出库申请流程中的预订与同步节点，不代表资料已实物离库；实物交接请见上方「流转履历」。"/>
                                </Border>
                                <DataGrid AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          RowHeight="32"
                                          ColumnHeaderHeight="34"
                                          GridLinesVisibility="Horizontal"
                                          BorderThickness="0"
                                          MaxHeight="200"
                                          ItemsSource="{Binding DataContext.SelectedOutboundProcessNodes, RelativeSource={RelativeSource AncestorType=Page}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="时间" Binding="{Binding OperatedAtDisplay, Mode=OneWay}" Width="128"/>
                                        <DataGridTextColumn Header="出库单号" Binding="{Binding OutboundNo, Mode=OneWay}" Width="130"/>
                                        <DataGridTextColumn Header="单证状态" Binding="{Binding OutboundStatusDisplay, Mode=OneWay}" Width="88"/>
                                        <DataGridTextColumn Header="节点类别" Binding="{Binding NodeCategoryDisplay, Mode=OneWay}" Width="72"/>
                                        <DataGridTextColumn Header="流程节点" Binding="{Binding ProcessNodeDisplay, Mode=OneWay}" Width="180"/>
                                        <DataGridTextColumn Header="用途" Binding="{Binding UsageModeDisplay, Mode=OneWay}" Width="56"/>
                                        <DataGridTextColumn Header="申请人" Binding="{Binding ApplicantName, Mode=OneWay}" Width="72"/>
                                        <DataGridTextColumn Header="经办人" Binding="{Binding OperatorName, Mode=OneWay}" Width="72"/>
                                        <DataGridTextColumn Header="备注" Binding="{Binding Remark, Mode=OneWay}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource DetailSectionExpanderStyle}"
                                  Header="{Binding DataContext.ContentEntriesExpanderHeader, RelativeSource={RelativeSource AncestorType=Page}}"
                                  IsExpanded="{Binding DataContext.IsContentEntriesExpanded, RelativeSource={RelativeSource AncestorType=Page}, Mode=TwoWay}"
                                  Visibility="{Binding DataContext.HasSelectedContentEntries, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <viewShared:ItemDetailsPanelHeader DataContext="{Binding DataContext.ContentEntriesPanel, RelativeSource={RelativeSource AncestorType=Page}}" Margin="0,0,0,6"/>
                                <DataGrid AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      RowHeight="32"
                                      ColumnHeaderHeight="34"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0"
                                      MaxHeight="200"
                                      ItemsSource="{Binding DataContext.ContentEntriesPanel.PageItems, RelativeSource={RelativeSource AncestorType=Page}}">
                                    <DataGrid.Style>
                                        <Style TargetType="DataGrid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.ContentEntriesPanel.IsExpanded, RelativeSource={RelativeSource AncestorType=Page}}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Style>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="类型" Binding="{Binding EntryKind, Mode=OneWay}" Width="80"/>
                                    <DataGridTextColumn Header="名称" Binding="{Binding EntryName, Mode=OneWay}" Width="200"/>
                                    <DataGridTextColumn Header="立档路径" Binding="{Binding FilingPath, Mode=OneWay}" Width="*"/>
                                    <DataGridTextColumn Header="创建日期" Binding="{Binding CreatedDateText, Mode=OneWay}" Width="130"/>
                                    <DataGridTextColumn Header="修改日期" Binding="{Binding ModifiedDateText, Mode=OneWay}" Width="130"/>
                                    <DataGridTextColumn Header="大小" Binding="{Binding SizeText, Mode=OneWay}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                                <viewShared:ItemDetailsPanelPaginationBar DataContext="{Binding DataContext.ContentEntriesPanel, RelativeSource={RelativeSource AncestorType=Page}}"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
