<Page x:Class="DocMgr.Views.YearlyArchive.ArchiveDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:DocMgr.Views.YearlyArchive"
      xmlns:viewShared="clr-namespace:DocMgr.Views.Shared"
      mc:Ignorable="d"
      d:DesignHeight="900"
      d:DesignWidth="1400"
      Title="ArchiveDetailPage"
      Background="#F0F2F5">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="ItemDetailsPanelItemsControlStyle" TargetType="ItemsControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ItemDetailsPanel.IsExpanded}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="Bold" Foreground="#00695C"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="FieldValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,12,8"/>
        </Style>

        <Style x:Key="BoundedListScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="CanContentScroll" Value="False"/>
            <Setter Property="IsDeferredScrollingEnabled" Value="False"/>
        </Style>

        <Style x:Key="AdaptiveBoundedListScrollViewerStyle" TargetType="ScrollViewer" BasedOn="{StaticResource BoundedListScrollViewerStyle}">
            <Setter Property="CanContentScroll" Value="False"/>
        </Style>

        <Style x:Key="SearchHighlightMediaCardBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSearchHighlighted}" Value="True">
                    <Setter Property="BorderBrush" Value="#00897B"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Background" Value="#E8F5E9"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchHighlightItemSurfaceStyle" TargetType="Border">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#EFEFEF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSearchHighlighted}" Value="True">
                    <Setter Property="Background" Value="#E0F2F1"/>
                    <Setter Property="BorderBrush" Value="#00897B"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchHighlightExpanderStyle" TargetType="Expander">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#EFEFEF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSearchHighlighted}" Value="True">
                    <Setter Property="Background" Value="#E0F2F1"/>
                    <Setter Property="BorderBrush" Value="#00897B"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ElectronicContentEntryDataGridHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridHeaderStyle}">
            <Setter Property="Padding" Value="6,8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="ElectronicContentEntryDataGridCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource StandardDataGridCellStyle}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <Style x:Key="ElectronicContentEntryCellTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ElectronicContentEntryKindCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ElectronicContentEntryCellTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#00695C"/>
        </Style>

        <Style x:Key="ElectronicContentEntryDataGridRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource StandardDataGridRowStyle}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSearchHighlighted}" Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#E0F2F1"/>
                    <Setter Property="BorderBrush" Value="#00897B"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ElectronicContentEntryDataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="Cell"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource ElectronicContentEntryDataGridHeaderStyle}"/>
            <Setter Property="CellStyle" Value="{StaticResource ElectronicContentEntryDataGridCellStyle}"/>
            <Setter Property="RowStyle" Value="{StaticResource ElectronicContentEntryDataGridRowStyle}"/>
        </Style>

        <Style x:Key="SearchHighlightFilingExpanderStyle" TargetType="Expander" BasedOn="{StaticResource SearchHighlightExpanderStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSearchHighlighted}" Value="True">
                    <Setter Property="Background" Value="#E8F5E9"/>
                    <Setter Property="BorderBrush" Value="#00897B"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchHitBadgeBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#00897B"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSearchHighlighted}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="15">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource ToolbarCardBorderStyle}" Background="#F5F7FA" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📘" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="资料查看详情" FontSize="16" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>
                            <Border Background="#E0F2F1" CornerRadius="10" Padding="10,3" Margin="12,0,0,0">
                                <TextBlock Text="{Binding Record.StatusStr}" Foreground="{Binding Record.StatusColor}" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="该页面用于独立查看申请记录、附件材料与立档结果，便于后续维护与扩展。"
                                   Foreground="#666" Margin="30,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="#FFF8E1" BorderBrush="#FFB300" BorderThickness="1" CornerRadius="4"
                        Padding="12,8" Margin="0,0,0,12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSearchHighlight}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding SearchHighlightSummary}" Foreground="#E65100" TextWrapping="Wrap"/>
                </Border>

                <Border Background="#E8F5E9" CornerRadius="4" Padding="10,8" Margin="0,0,0,12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFilterSelectionMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="加入筛选池"
                                Style="{StaticResource ToolbarActionButtonStyle}"
                                Command="{Binding AddSelectedToFilterPoolCommand}"/>
                        <TextBlock Text="{Binding FilterPoolSummary}"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="#1B5E20"/>
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="#666"
                                   Margin="16,0,0,0"
                                   TextWrapping="Wrap"
                                   Text="在五、立档结果 · 电子介质袋中勾选资料子项或目录/文件，加入当前检索筛选池。"/>
                    </DockPanel>
                </Border>

                <GroupBox Header="一、申请基本信息" Style="{StaticResource SectionGroupBoxStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="表单编号" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Record.FormNo, TargetNullValue=-}" Style="{StaticResource FieldValueStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="申请日期" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Record.CreatedDate, StringFormat=yyyy-MM-dd HH:mm}" Style="{StaticResource FieldValueStyle}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="资料名称" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Record.MaterialName, TargetNullValue=-}" Style="{StaticResource FieldValueStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="所属项目" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Record.ProjectName, TargetNullValue=-}" Style="{StaticResource FieldValueStyle}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="资料来源" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Record.SourceType, TargetNullValue=-}" Style="{StaticResource FieldValueStyle}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="提供单位" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Record.ProvideUnit, TargetNullValue=-}" Style="{StaticResource FieldValueStyle}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="申请人" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Record.ApplicantName, TargetNullValue=-}" Style="{StaticResource FieldValueStyle}"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="申请部门" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding Record.ApplicantDept, TargetNullValue=-}" Style="{StaticResource FieldValueStyle}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="库管模式" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Record.ArchivePurpose, TargetNullValue=-}" Style="{StaticResource FieldValueStyle}"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="其他要求" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding Record.OtherRequests, TargetNullValue=-}" Style="{StaticResource FieldValueStyle}"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="二、资料介质与内容" Style="{StaticResource SectionGroupBoxStyle}">
                    <StackPanel>
                        <GroupBox Header="电子资料介质" Style="{StaticResource SectionGroupBoxStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasElectronicSubItems}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Button Content="全部展开"
                                            Style="{StaticResource ButtonNormalStyle}"
                                            Command="{Binding ExpandAllElectronicMediaItemsCommand}"
                                            Padding="12,4"/>
                                    <Button Content="全部折叠"
                                            Style="{StaticResource ButtonNormalStyle}"
                                            Command="{Binding CollapseAllElectronicMediaItemsCommand}"
                                            Margin="8,0,0,0"
                                            Padding="12,4"/>
                                    <TextBlock Text="资料子项默认折叠，摘要字段始终可见；展开后可查看分类信息与文件/目录明细。"
                                               Foreground="#888"
                                               VerticalAlignment="Center"
                                               Margin="16,0,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Text="暂无电子资料介质。" Foreground="#888">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElectronicMediaEntries.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding ElectronicMediaEntries}">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElectronicMediaEntries.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SearchHighlightMediaCardBorderStyle}" Padding="10" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <WrapPanel Margin="0,0,0,8">
                                                        <TextBlock Text="介质类型：" Style="{StaticResource FieldLabelStyle}"/>
                                                        <TextBlock Text="{Binding MediaType}" Style="{StaticResource FieldValueStyle}" Margin="0,0,16,8"/>
                                                        <TextBlock Text="数量：" Style="{StaticResource FieldLabelStyle}"/>
                                                        <TextBlock Text="{Binding MediaCountText}" Style="{StaticResource FieldValueStyle}" Margin="0,0,16,8"/>
                                                        <TextBlock Text="处置方式：" Style="{StaticResource FieldLabelStyle}"/>
                                                        <TextBlock Text="{Binding Disposition}" Style="{StaticResource FieldValueStyle}" Margin="0,0,16,8"/>
                                                        <TextBlock Text="存储路径汇总：" Style="{StaticResource FieldLabelStyle}"/>
                                                        <TextBlock Text="{Binding StoragePath}" Style="{StaticResource FieldValueStyle}"/>
                                                        <Border Style="{StaticResource SearchHitBadgeBorderStyle}">
                                                            <TextBlock Text="检索命中" Foreground="White" FontSize="11"/>
                                                        </Border>
                                                    </WrapPanel>
                                                    <viewShared:ItemDetailsPanelHeader DataContext="{Binding ItemDetailsPanel}" Margin="0,4,0,4"/>
                                                    <ScrollViewer MaxHeight="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=ElectronicMediaItemsViewportHeight}"
                                                                  Style="{StaticResource AdaptiveBoundedListScrollViewerStyle}">
                                                        <ItemsControl ItemsSource="{Binding ItemDetailsPanel.PageItems}"
                                                                      Style="{StaticResource ItemDetailsPanelItemsControlStyle}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Expander IsExpanded="{Binding IsDetailsExpanded, Mode=TwoWay}"
                                                                              Margin="0,0,0,6"
                                                                              Style="{StaticResource SearchHighlightExpanderStyle}">
                                                                        <Expander.Header>
                                                                            <WrapPanel>
                                                                                <TextBlock Text="{Binding ItemType}" FontWeight="SemiBold" Foreground="#00695C" Margin="0,0,12,2"/>
                                                                                <TextBlock Text="子项资料名称：" Style="{StaticResource FieldLabelStyle}"/>
                                                                                <TextBlock Text="{Binding ContentDesc}" Style="{StaticResource FieldValueStyle}" Margin="0,0,12,2"/>
                                                                                <TextBlock Text="密级：" Style="{StaticResource FieldLabelStyle}"/>
                                                                                <TextBlock Text="{Binding ConfidentialLevel}" Style="{StaticResource FieldValueStyle}" Margin="0,0,12,2"/>
                                                                                <TextBlock Text="份数：" Style="{StaticResource FieldLabelStyle}"/>
                                                                                <TextBlock Text="{Binding ContentCountText}" Style="{StaticResource FieldValueStyle}" Margin="0,0,12,2"/>
                                                                                <TextBlock Text="存储目录：" Style="{StaticResource FieldLabelStyle}"/>
                                                                                <TextBlock Text="{Binding StoragePath}" Style="{StaticResource FieldValueStyle}" Margin="0,0,12,2"/>
                                                                                <TextBlock Text="目录/文件：" Style="{StaticResource FieldLabelStyle}"/>
                                                                                <TextBlock Text="{Binding ContentEntryBreakdownText}" Style="{StaticResource FieldValueStyle}"/>
                                                                                <TextBlock Text="资料类型：" Style="{StaticResource FieldLabelStyle}"/>
                                                                                <TextBlock Text="{Binding MaterialCategory}" Style="{StaticResource FieldValueStyle}" Margin="0,0,12,2"/>
                                                                                <TextBlock Text="所属子类：" Style="{StaticResource FieldLabelStyle}"/>
                                                                                <TextBlock Text="{Binding SubCategory}" Style="{StaticResource FieldValueStyle}" Margin="0,0,12,2"/>
                                                                                <TextBlock Text="组织形式：" Style="{StaticResource FieldLabelStyle}"/>
                                                                                <TextBlock Text="{Binding DataOrganizationForm}" Style="{StaticResource FieldValueStyle}" Margin="0,0,12,2"/>
                                                                                <Border Style="{StaticResource SearchHitBadgeBorderStyle}">
                                                                                    <TextBlock Text="检索命中" Foreground="White" FontSize="11"/>
                                                                                </Border>
                                                                            </WrapPanel>
                                                                        </Expander.Header>
                                                                        <StackPanel Margin="8,4,8,8">
                                                                            <WrapPanel Margin="0,0,0,6">
                                                                                <TextBlock Text="资料类型：" Style="{StaticResource FieldLabelStyle}"/>
                                                                                <TextBlock Text="{Binding MaterialCategory}" Style="{StaticResource FieldValueStyle}" Margin="0,0,12,4"/>
                                                                                <TextBlock Text="所属子类：" Style="{StaticResource FieldLabelStyle}"/>
                                                                                <TextBlock Text="{Binding SubCategory}" Style="{StaticResource FieldValueStyle}" Margin="0,0,12,4"/>
                                                                                <TextBlock Text="组织形式：" Style="{StaticResource FieldLabelStyle}"/>
                                                                                <TextBlock Text="{Binding DataOrganizationForm}" Style="{StaticResource FieldValueStyle}" Margin="0,0,12,4"/>
                                                                                <TextBlock Text="数据量：" Style="{StaticResource FieldLabelStyle}"/>
                                                                                <TextBlock Text="{Binding DataSizeText}" Style="{StaticResource FieldValueStyle}" Margin="0,0,12,4"/>
                                                                                <TextBlock Text="备注：" Style="{StaticResource FieldLabelStyle}"/>
                                                                                <TextBlock Text="{Binding Note}" Style="{StaticResource FieldValueStyle}"/>
                                                                            </WrapPanel>
                                                                            <TextBlock Text="目录/文件明细" FontWeight="Bold" Margin="0,4,0,6">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding DataContext.IsFilterSelectionMode, RelativeSource={RelativeSource AncestorType=Page}}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <StackPanel>
                                                                                <StackPanel.Style>
                                                                                    <Style TargetType="StackPanel">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding DataContext.IsFilterSelectionMode, RelativeSource={RelativeSource AncestorType=Page}}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </StackPanel.Style>
                                                                            <TextBlock Text="暂无文件或目录明细。" Foreground="#888" Margin="0,0,0,4">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding HasContentEntries}" Value="False">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <Border>
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding HasContentEntries}" Value="False">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <DataGrid ItemsSource="{Binding ContentEntries}"
                                                                                          Style="{StaticResource ElectronicContentEntryDataGridStyle}"
                                                                                          MaxHeight="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=ElectronicContentEntriesViewportHeight}">
                                                                                    <DataGrid.Columns>
                                                                                        <DataGridTextColumn Header="类型"
                                                                                                            Binding="{Binding EntryKind}"
                                                                                                            Width="56"
                                                                                                            MinWidth="40">
                                                                                            <DataGridTextColumn.ElementStyle>
                                                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource ElectronicContentEntryKindCellTextStyle}"/>
                                                                                            </DataGridTextColumn.ElementStyle>
                                                                                        </DataGridTextColumn>
                                                                                        <DataGridTextColumn Header="名称/路径"
                                                                                                            Binding="{Binding EntryDisplayName}"
                                                                                                            Width="*"
                                                                                                            MinWidth="120">
                                                                                            <DataGridTextColumn.ElementStyle>
                                                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource ElectronicContentEntryCellTextStyle}"/>
                                                                                            </DataGridTextColumn.ElementStyle>
                                                                                        </DataGridTextColumn>
                                                                                        <DataGridTextColumn Header="创建日期"
                                                                                                            Binding="{Binding CreatedDateText}"
                                                                                                            Width="130"
                                                                                                            MinWidth="100"/>
                                                                                        <DataGridTextColumn Header="修改日期"
                                                                                                            Binding="{Binding ModifiedDateText}"
                                                                                                            Width="130"
                                                                                                            MinWidth="100"/>
                                                                                        <DataGridTextColumn Header="大小"
                                                                                                            Binding="{Binding SizeText}"
                                                                                                            Width="90"
                                                                                                            MinWidth="60"/>
                                                                                    </DataGrid.Columns>
                                                                                </DataGrid>
                                                                            </Border>
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </Expander>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                    <viewShared:ItemDetailsPanelPaginationBar DataContext="{Binding ItemDetailsPanel}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="模拟资料介质" Style="{StaticResource SectionGroupBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="暂无模拟资料介质。" Foreground="#888">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
