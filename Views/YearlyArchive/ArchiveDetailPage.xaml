                                                                            <TextBlock Text="{Binding ItemName}" Style="{StaticResource FieldValueStyle}" Margin="0,0,12,2"/>
                                                                            <TextBlock Text="来源介质：" Style="{StaticResource FieldLabelStyle}"/>
                                                                            <TextBlock Text="{Binding RegisterMediaType}" Style="{StaticResource FieldValueStyle}" Margin="0,0,12,2"/>
                                                                            <TextBlock Text="资料类型：" Style="{StaticResource FieldLabelStyle}"/>
                                                                            <TextBlock Text="{Binding MaterialCategory}" Style="{StaticResource FieldValueStyle}" Margin="0,0,12,2"/>
                                                                            <TextBlock Text="密级：" Style="{StaticResource FieldLabelStyle}"/>
                                                                            <TextBlock Text="{Binding ConfidentialLevel}" Style="{StaticResource FieldValueStyle}" Margin="0,0,12,2"/>
                                                                            <TextBlock Text="目录/文件：" Style="{StaticResource FieldLabelStyle}"/>
                                                                            <TextBlock Text="{Binding ContentEntryBreakdownText}" Style="{StaticResource FieldValueStyle}" Margin="0,0,12,2"/>
                                                                            <TextBlock Text="数据量：" Style="{StaticResource FieldLabelStyle}"/>
                                                                            <TextBlock Text="{Binding DataSizeText}" Style="{StaticResource FieldValueStyle}"/>
                                                                            <Border Style="{StaticResource SearchHitBadgeBorderStyle}">
                                                                                <TextBlock Text="检索命中" Foreground="White" FontSize="11"/>
                                                                            </Border>
                                                                        </WrapPanel>
                                                                    </Expander.Header>
                                                                    <StackPanel Margin="8,4,8,8">
                                                                        <WrapPanel Margin="0,0,0,8">
                                                                            <TextBlock Text="库管模式：" Style="{StaticResource FieldLabelStyle}"/>
                                                                            <TextBlock Text="{Binding DataContext.Record.ArchivePurpose, RelativeSource={RelativeSource AncestorType=Page}, TargetNullValue=-}"
                                                                                       Style="{StaticResource FieldValueStyle}" Margin="0,0,12,4"/>
                                                                            <TextBlock Text="来源介质：" Style="{StaticResource FieldLabelStyle}"/>
                                                                            <TextBlock Text="{Binding RegisterMediaType}" Style="{StaticResource FieldValueStyle}" Margin="0,0,12,4"/>
                                                                            <TextBlock Text="资料类型：" Style="{StaticResource FieldLabelStyle}"/>
                                                                            <TextBlock Text="{Binding MaterialCategory}" Style="{StaticResource FieldValueStyle}" Margin="0,0,12,4"/>
                                                                            <TextBlock Text="所属子类：" Style="{StaticResource FieldLabelStyle}"/>
                                                                            <TextBlock Text="{Binding SubCategory}" Style="{StaticResource FieldValueStyle}" Margin="0,0,12,4"/>
                                                                            <TextBlock Text="组织形式：" Style="{StaticResource FieldLabelStyle}"/>
                                                                            <TextBlock Text="{Binding DataOrganizationForm}" Style="{StaticResource FieldValueStyle}" Margin="0,0,12,4"/>
                                                                        </WrapPanel>
                                                                        <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" Style="{StaticResource FieldValueStyle}" Margin="0,0,0,8"/>
                                                                        <TextBlock Text="目录/文件明细" FontWeight="Bold" Margin="0,4,0,6"/>
                                                                        <TextBlock Text="暂无文件或目录明细。" Foreground="#888" Margin="0,0,0,4">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasContentEntries}" Value="False">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <Border>
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasContentEntries}" Value="False">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <DataGrid ItemsSource="{Binding ContentEntries}"
                                                                                      Style="{StaticResource ElectronicContentEntryDataGridStyle}"
                                                                                      MaxHeight="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=ElectronicContentEntriesViewportHeight}">
                                                                                <DataGrid.Columns>
                                                                                    <DataGridTemplateColumn Header="选" Width="40">
                                                                                        <DataGridTemplateColumn.CellTemplate>
                                                                                            <DataTemplate>
                                                                                                <CheckBox HorizontalAlignment="Center"
                                                                                                          VerticalAlignment="Center"
                                                                                                          IsChecked="{Binding IsFilterSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                                                                    <CheckBox.Style>
                                                                                                        <Style TargetType="CheckBox">
                                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                            <Style.Triggers>
                                                                                                                <MultiDataTrigger>
                                                                                                                    <MultiDataTrigger.Conditions>
                                                                                                                        <Condition Binding="{Binding DataContext.IsFilterSelectionMode, RelativeSource={RelativeSource AncestorType=Page}}" Value="True"/>
                                                                                                                        <Condition Binding="{Binding DataContext.CanFilterSelect, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True"/>
                                                                                                                    </MultiDataTrigger.Conditions>
                                                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                                                </MultiDataTrigger>
                                                                                                            </Style.Triggers>
                                                                                                        </Style>
                                                                                                    </CheckBox.Style>
                                                                                                </CheckBox>
                                                                                            </DataTemplate>
                                                                                        </DataGridTemplateColumn.CellTemplate>
                                                                                    </DataGridTemplateColumn>
                                                                                    <DataGridTextColumn Header="类型" Binding="{Binding EntryKind}" Width="56" MinWidth="40"/>
                                                                                    <DataGridTextColumn Header="名称/路径" Binding="{Binding EntryDisplayName}" Width="*" MinWidth="120"/>
                                                                                    <DataGridTextColumn Header="创建日期" Binding="{Binding CreatedDateText}" Width="130" MinWidth="100"/>
                                                                                    <DataGridTextColumn Header="修改日期" Binding="{Binding ModifiedDateText}" Width="130" MinWidth="100"/>
                                                                                    <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="90" MinWidth="60"/>
                                                                                </DataGrid.Columns>
                                                                            </DataGrid>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </Expander>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <viewShared:ItemDetailsPanelPaginationBar DataContext="{Binding ItemDetailsPanel}"/>
                                                </StackPanel>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
