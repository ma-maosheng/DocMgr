<local:LedgerGridHost x:Class="DocMgr.Views.YearlyArchive.ElectronicContentEntryGrid"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:local="clr-namespace:DocMgr.Views.Shared"
                      xmlns:ya="clr-namespace:DocMgr.Views.YearlyArchive">
    <local:LedgerGridHost.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:BindingProxy x:Key="SelfProxy"/>
        <Style x:Key="EntryHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridHeaderStyle}">
            <Setter Property="Padding" Value="6,8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="EntryCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource StandardDataGridCellStyle}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style x:Key="EntryCellTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="EntryKindCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource EntryCellTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#00695C"/>
        </Style>
        <Style x:Key="EntryRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource StandardDataGridRowStyle}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSearchHighlighted}" Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#E0F2F1"/>
                    <Setter Property="BorderBrush" Value="#00897B"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </local:LedgerGridHost.Resources>
    <DataGrid ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=ya:ElectronicContentEntryGrid}}"
              MaxHeight="{Binding MaxHeight, RelativeSource={RelativeSource AncestorType=ya:ElectronicContentEntryGrid}}"
              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
              CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="False"
              HeadersVisibility="Column" HorizontalScrollBarVisibility="Auto" IsReadOnly="True"
              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7EB"
              BorderBrush="#D0D7DE" BorderThickness="1" Background="White"
              RowBackground="White" AlternatingRowBackground="#FAFAFA"
              SelectionMode="Single" SelectionUnit="Cell"
              ColumnHeaderStyle="{StaticResource EntryHeaderStyle}"
              CellStyle="{StaticResource EntryCellStyle}"
              RowStyle="{StaticResource EntryRowStyle}"
              VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <DataGrid.Columns>
            <DataGridTemplateColumn Header="选" Width="40">
                <DataGridTemplateColumn.Visibility>
                    <Binding Path="Data.ShowFilterSelection" Source="{StaticResource SelfProxy}" Converter="{StaticResource BooleanToVisibilityConverter}"/>
                </DataGridTemplateColumn.Visibility>
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                  IsChecked="{Binding IsFilterSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding DataContext.IsFilterSelectionMode, RelativeSource={RelativeSource AncestorType=Page}}" Value="True"/>
                                                <Condition Binding="{Binding DataContext.CanFilterSelect, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="类型" Binding="{Binding EntryKind, Mode=OneWay}" Width="56" MinWidth="40"
                                ElementStyle="{StaticResource EntryKindCellTextStyle}"/>
            <DataGridTextColumn Header="名称/路径" Binding="{Binding EntryDisplayName, Mode=OneWay}" Width="*" MinWidth="120"
                                ElementStyle="{StaticResource EntryCellTextStyle}"/>
            <DataGridTextColumn Header="创建日期" Binding="{Binding CreatedDateText, Mode=OneWay}" Width="130" MinWidth="100"/>
            <DataGridTextColumn Header="修改日期" Binding="{Binding ModifiedDateText, Mode=OneWay}" Width="130" MinWidth="100"/>
            <DataGridTextColumn Header="大小" Binding="{Binding SizeText, Mode=OneWay}" Width="90" MinWidth="60"/>
        </DataGrid.Columns>
    </DataGrid>
</local:LedgerGridHost>
