<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BooleanToVisibilityConverter x:Key="OutboundDetailCardBooleanToVisibilityConverter"/>

    <Style x:Key="OutboundDetailCardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#0F172A"/>
    </Style>

    <Style x:Key="OutboundDetailCardMetaStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#64748B"/>
    </Style>

    <Style x:Key="OutboundDetailCardSettingLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#64748B"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

    <Style x:Key="OutboundDetailCardSettingValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#1E293B"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="OutboundDetailCardSettingSlotStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Vertical"/>
        <Setter Property="Margin" Value="0,0,16,0"/>
        <Setter Property="MinWidth" Value="88"/>
    </Style>

    <DataTemplate x:Key="OutboundReadOnlyDetailCardTemplate">
        <Border Margin="0,0,0,10" Background="White"
                BorderBrush="#D0DAE4" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <Border Background="#F8FAFC" Padding="10,8" BorderBrush="#E8EDF3" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding DisplayTitle}" Style="{StaticResource OutboundDetailCardTitleStyle}"/>
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource OutboundDetailCardMetaStyle}">
                                <Run Text="介质："/>
                                <Run Text="{Binding MediaTypeSummary, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text="  ·  "/>
                                <Run Text="{Binding ItemCountDisplay, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" MaxWidth="280">
                            <TextBlock Text="当前位置" Style="{StaticResource OutboundDetailCardSettingLabelStyle}" TextAlignment="Right"/>
                            <TextBlock Text="{Binding LocationDisplay}" Style="{StaticResource OutboundDetailCardSettingValueStyle}"
                                       FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="4" Padding="10,8" Margin="10,10,10,0">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Style="{StaticResource OutboundDetailCardSettingSlotStyle}">
                            <TextBlock Text="领用方式" Style="{StaticResource OutboundDetailCardSettingLabelStyle}"/>
                            <TextBlock Text="{Binding UsageModeDisplay}" Style="{StaticResource OutboundDetailCardSettingValueStyle}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource OutboundDetailCardSettingSlotStyle}"
                                    Visibility="{Binding ShowNeedReturnFields, Converter={StaticResource OutboundDetailCardBooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding NeedReturnFieldLabel, Mode=OneWay}" Style="{StaticResource OutboundDetailCardSettingLabelStyle}"/>
                            <TextBlock Text="{Binding NeedReturnDisplay}" Style="{StaticResource OutboundDetailCardSettingValueStyle}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource OutboundDetailCardSettingSlotStyle}"
                                    Visibility="{Binding ShowDuplicateSettings, Converter={StaticResource OutboundDetailCardBooleanToVisibilityConverter}}">
                            <TextBlock Text="是否库内空盘" Style="{StaticResource OutboundDetailCardSettingLabelStyle}"/>
                            <TextBlock Text="{Binding UseInStockBlankDiskDisplay}" Style="{StaticResource OutboundDetailCardSettingValueStyle}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource OutboundDetailCardSettingSlotStyle}"
                                    Visibility="{Binding ShowSelfProvidedDuplicateMedium, Converter={StaticResource OutboundDetailCardBooleanToVisibilityConverter}}">
                            <TextBlock Text="拷贝目标介质" Style="{StaticResource OutboundDetailCardSettingLabelStyle}"/>
                            <TextBlock Text="{Binding DuplicateMediumKindDisplay}" Style="{StaticResource OutboundDetailCardSettingValueStyle}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource OutboundDetailCardSettingSlotStyle}"
                                    Visibility="{Binding ShowBlankDiskFields, Converter={StaticResource OutboundDetailCardBooleanToVisibilityConverter}}">
                            <TextBlock Text="库内空盘" Style="{StaticResource OutboundDetailCardSettingLabelStyle}"/>
                            <TextBlock Text="{Binding RequisitionedDiskCode}" Style="{StaticResource OutboundDetailCardSettingValueStyle}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource OutboundDetailCardSettingSlotStyle}"
                                    Visibility="{Binding ShowRequisitionedDiskNeedReturn, Converter={StaticResource OutboundDetailCardBooleanToVisibilityConverter}}">
                            <TextBlock Text="硬盘是否归还" Style="{StaticResource OutboundDetailCardSettingLabelStyle}"/>
                            <TextBlock Text="{Binding RequisitionedDiskNeedReturnDisplay}" Style="{StaticResource OutboundDetailCardSettingValueStyle}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource OutboundDetailCardSettingSlotStyle}" Margin="0"
                                    Visibility="{Binding RequiresExpectedReturnDate, Converter={StaticResource OutboundDetailCardBooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding ExpectedReturnDateFieldLabel, Mode=OneWay}" Style="{StaticResource OutboundDetailCardSettingLabelStyle}"/>
                            <TextBlock Text="{Binding ExpectedReturnDateDisplay}" Style="{StaticResource OutboundDetailCardSettingValueStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1"
                        CornerRadius="4" Padding="10,8" Margin="10,8,10,0"
                        Visibility="{Binding HasHardDiskTransfer, Converter={StaticResource OutboundDetailCardBooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="硬盘流转" FontSize="11" FontWeight="SemiBold" Foreground="#C2410C" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding HardDiskTransferDisplay, Mode=OneWay}"
                                   FontSize="12" Foreground="#9A3412" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <DataGrid ItemsSource="{Binding ItemRows}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserResizeRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          MaxHeight="160"
                          Margin="10,8,10,10"
                          Background="#FAFBFC"
                          BorderBrush="#E2E8F0"
                          BorderThickness="1"
                          HorizontalGridLinesBrush="#EEF2F6"
                          RowHeight="26"
                          ColumnHeaderHeight="26">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="资料名称" Binding="{Binding MaterialName}" MinWidth="140" Width="*"/>
                        <DataGridTextColumn Header="明细名称" Binding="{Binding ItemName}" Width="120"/>
                        <DataGridTextColumn Header="密级" Binding="{Binding ConfidentialLevel}" Width="56"/>
                        <DataGridTextColumn Header="领用方式" Binding="{Binding UsageModeDisplay}" Width="70"/>
                        <DataGridTextColumn Header="份数" Binding="{Binding CopyCount}" Width="48"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
