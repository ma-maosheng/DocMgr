<UserControl x:Class="DocMgr.Views.YearlyArchive.ArchiveRegisterApprovalSectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ArchiveRegisterResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <GroupBox Header="4. 审批流程" Style="{StaticResource Level1GroupBoxStyle}" Padding="10">
            <StackPanel>
                <Grid Margin="0,5" IsEnabled="{Binding CanApproveProd}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="部门审核"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Label Content="负责人签字："/>
                        <TextBox Width="100" Text="{Binding CurrentRecord.DeptLeader}"/>
                        <Label Content="日期：" Margin="10,0,0,0"/>
                        <DatePicker SelectedDate="{Binding CurrentRecord.DeptDate}" Width="120"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,5" IsEnabled="{Binding CanApproveProd}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="生产管理科"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Label Content="意见：" HorizontalAlignment="Left"  />
                        <ComboBox Width="100"
                                  ItemsSource="{Binding ProdOpinionOptions}"
                                  SelectedItem="{Binding CurrentRecord.ProdDeptOpinion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Label Content="负责人签字：" Margin="10,0,0,0"/>
                        <TextBox Width="100" Text="{Binding CurrentRecord.ProdLeader}"/>
                        <Label Content="日期：" Margin="10,0,0,0"/>
                        <DatePicker SelectedDate="{Binding CurrentRecord.ProdDate}" Width="120"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,5" IsEnabled="{Binding CanApproveRnd}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="科研开发室"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Label Content="意见："/>
                        <ComboBox Width="100"
                                  ItemsSource="{Binding RndOpinionOptions}"
                                  SelectedItem="{Binding CurrentRecord.RndDeptOpinion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Label Content="负责人签字：" Margin="10,0,0,0"/>
                        <TextBox Width="100" Text="{Binding CurrentRecord.RndLeader}"/>
                        <Label Content="日期：" Margin="10,0,0,0"/>
                        <DatePicker SelectedDate="{Binding CurrentRecord.RndDate}" Width="120"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,5" IsEnabled="{Binding CanApproveDeputy}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="分管领导"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Label Content="意见："/>
                        <ComboBox Width="100"
                                  ItemsSource="{Binding DeputyOpinionOptions}"
                                  SelectedItem="{Binding CurrentRecord.DeputyOpinion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Label Content="负责人签字：" Margin="10,0,0,0"/>
                        <TextBox Width="100" Text="{Binding CurrentRecord.DeputyLeader}"/>
                        <Label Content="日期：" Margin="10,0,0,0"/>
                        <DatePicker SelectedDate="{Binding CurrentRecord.DeputyDate}" Width="120"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,5" IsEnabled="{Binding CanConfirmDeliver}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="资料交接"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Label Content="移交人签字：" Padding="0,5,5,5" Foreground="#666"/>
                        <TextBox Width="100" Text="{Binding CurrentRecord.Deliverer}"/>
                        <Label Content="日期：" Margin="10,0,0,0"/>
                        <DatePicker SelectedDate="{Binding CurrentRecord.DeliverDate}" Width="120"/>
                        <Label Content="资料室资料员签字：" Margin="20,0,0,0" Foreground="#666"/>
                        <TextBox Width="100" Text="{Binding CurrentRecord.Administrator}"/>
                        <Label Content="日期：" Margin="10,0,0,0"/>
                        <DatePicker SelectedDate="{Binding CurrentRecord.AdminDate}" Width="120"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="附件材料" Style="{StaticResource Level1GroupBoxStyle}" Padding="10">
            <StackPanel>
                <ListView ItemsSource="{Binding Attachments}" Height="120" BorderBrush="#EEE" BorderThickness="1">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="文件名" Width="250" DisplayMemberBinding="{Binding FileName}"/>
                            <GridViewColumn Header="上传时间" Width="140" DisplayMemberBinding="{Binding UploadTime, StringFormat='yyyy-MM-dd HH:mm'}"/>
                            <GridViewColumn Header="大小 (B)" Width="80" DisplayMemberBinding="{Binding FileSize}"/>
                            <GridViewColumn Header="操作" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="查看" Style="{StaticResource ButtonNormalStyle}" Margin="0,0,5,0"
                                                    Command="{Binding DataContext.ViewAttachmentCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="删除" Style="{StaticResource ButtonCautionStyle}"
                                                    Command="{Binding DataContext.DeleteAttachmentCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock Text="{Binding AttachmentRequirementHint}"
                           Margin="0,6,0,0"
                           Foreground="#B45309"
                           TextWrapping="Wrap"
                           FontSize="11"/>
            </StackPanel>
        </GroupBox>

        <WrapPanel Orientation="Horizontal" Margin="0,-5,0,20" ItemHeight="40">
            <WrapPanel.Style>
                <Style TargetType="WrapPanel">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowEmbeddedActionButtons}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </WrapPanel.Style>
            <Button Content="审批通过"
                Command="{Binding SaveApprovalCommand}"
                ToolTip="{Binding ApproveHintText}"
                MinWidth="120" Height="40" Padding="20,0"
                FontSize="16" FontWeight="Bold" Cursor="Hand" Margin="0,0,20,0" Style="{StaticResource ButtonNormalStyle}"/>
            <Button Content="上传签字件" Command="{Binding UploadAttachmentCommand}"
                ToolTip="{Binding UploadHintText}"
                MinWidth="120" Height="40" Padding="20,0" FontSize="16" FontWeight="Bold" Cursor="Hand" Margin="0,0,20,0" Style="{StaticResource ButtonNormalStyle}"/>
            <Button Content="确认办结" Command="{Binding CompleteCommand}"
                ToolTip="{Binding CompleteHintText}"
                MinWidth="120" Height="40" Padding="20,0" FontSize="16" FontWeight="Bold" Cursor="Hand" Margin="0,0,20,0" Style="{StaticResource ButtonNormalStyle}"/>
            <Button Content="打印交接单" Command="{Binding PrintApprovalCommand}"
                ToolTip="{Binding PrintHintText}"
                 MinWidth="140" Height="40" Padding="20,0" FontSize="16" FontWeight="Bold" Cursor="Hand" Style="{StaticResource ButtonNormalStyle}"/>
        </WrapPanel>
    </StackPanel>
</UserControl>
