<UserControl x:Class="DocMgr.Views.YearlyArchive.ArchiveRegisterApprovalSectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ArchiveRegisterResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <GroupBox Header="4. 审批流程" Style="{StaticResource Level1GroupBoxStyle}" Padding="8">
            <StackPanel>
                <TextBlock Text="各节点仅需签字人与日期，无需签署具体意见。"
                           Foreground="#64748B"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"/>

                <!-- 双列紧凑：4 个审批节点约占原纵向一半 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0"
                            Style="{StaticResource ArchiveRegisterApprovalCompactStepCardStyle}"
                            IsEnabled="{Binding CanApproveProd}">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="部门审核" Style="{StaticResource ArchiveRegisterApprovalCompactStepTitleStyle}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="签字" Style="{StaticResource ArchiveRegisterApprovalInlineLabelStyle}"/>
                                <TextBox Width="90"
                                         Style="{StaticResource ArchiveRegisterApprovalCompactTextBoxStyle}"
                                         Text="{Binding CurrentRecord.DeptLeader, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="日期" Style="{StaticResource ArchiveRegisterApprovalInlineLabelStyle}" Margin="10,0,4,0"/>
                                <DatePicker Style="{StaticResource ArchiveRegisterApprovalCompactDatePickerStyle}"
                                            SelectedDate="{Binding CurrentRecord.DeptDate}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="2"
                            Style="{StaticResource ArchiveRegisterApprovalCompactStepCardStyle}"
                            IsEnabled="{Binding CanApproveProd}">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="生产管理科" Style="{StaticResource ArchiveRegisterApprovalCompactStepTitleStyle}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="签字" Style="{StaticResource ArchiveRegisterApprovalInlineLabelStyle}"/>
                                <TextBox Width="90"
                                         Style="{StaticResource ArchiveRegisterApprovalCompactTextBoxStyle}"
                                         Text="{Binding CurrentRecord.ProdLeader, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="日期" Style="{StaticResource ArchiveRegisterApprovalInlineLabelStyle}" Margin="10,0,4,0"/>
                                <DatePicker Style="{StaticResource ArchiveRegisterApprovalCompactDatePickerStyle}"
                                            SelectedDate="{Binding CurrentRecord.ProdDate}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0"
                            Style="{StaticResource ArchiveRegisterApprovalCompactStepCardStyle}"
                            IsEnabled="{Binding CanApproveRnd}">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="科研开发室" Style="{StaticResource ArchiveRegisterApprovalCompactStepTitleStyle}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="签字" Style="{StaticResource ArchiveRegisterApprovalInlineLabelStyle}"/>
                                <TextBox Width="90"
                                         Style="{StaticResource ArchiveRegisterApprovalCompactTextBoxStyle}"
                                         Text="{Binding CurrentRecord.RndLeader, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="日期" Style="{StaticResource ArchiveRegisterApprovalInlineLabelStyle}" Margin="10,0,4,0"/>
                                <DatePicker Style="{StaticResource ArchiveRegisterApprovalCompactDatePickerStyle}"
                                            SelectedDate="{Binding CurrentRecord.RndDate}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="2"
                            Style="{StaticResource ArchiveRegisterApprovalCompactStepCardStyle}"
                            IsEnabled="{Binding CanApproveDeputy}">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="分管领导" Style="{StaticResource ArchiveRegisterApprovalCompactStepTitleStyle}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="签字" Style="{StaticResource ArchiveRegisterApprovalInlineLabelStyle}"/>
                                <TextBox Width="90"
                                         Style="{StaticResource ArchiveRegisterApprovalCompactTextBoxStyle}"
                                         Text="{Binding CurrentRecord.DeputyLeader, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="日期" Style="{StaticResource ArchiveRegisterApprovalInlineLabelStyle}" Margin="10,0,4,0"/>
                                <DatePicker Style="{StaticResource ArchiveRegisterApprovalCompactDatePickerStyle}"
                                            SelectedDate="{Binding CurrentRecord.DeputyDate}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource ArchiveRegisterApprovalCompactStepCardStyle}"
                        Margin="0"
                        IsEnabled="{Binding CanConfirmPhysicalHandover}">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" Text="资料交接" Style="{StaticResource ArchiveRegisterApprovalCompactStepTitleStyle}"/>
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <TextBlock Text="移交人" Style="{StaticResource ArchiveRegisterApprovalInlineLabelStyle}"/>
                                <TextBox Width="90"
                                         Style="{StaticResource ArchiveRegisterApprovalCompactTextBoxStyle}"
                                         Text="{Binding CurrentRecord.Deliverer, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="日期" Style="{StaticResource ArchiveRegisterApprovalInlineLabelStyle}" Margin="8,0,4,0"/>
                                <DatePicker Style="{StaticResource ArchiveRegisterApprovalCompactDatePickerStyle}"
                                            SelectedDate="{Binding CurrentRecord.DeliverDate}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="资料员" Style="{StaticResource ArchiveRegisterApprovalInlineLabelStyle}"/>
                                <TextBox Width="90"
                                         Style="{StaticResource ArchiveRegisterApprovalCompactTextBoxStyle}"
                                         Text="{Binding CurrentRecord.Administrator, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="日期" Style="{StaticResource ArchiveRegisterApprovalInlineLabelStyle}" Margin="8,0,4,0"/>
                                <DatePicker Style="{StaticResource ArchiveRegisterApprovalCompactDatePickerStyle}"
                                            SelectedDate="{Binding CurrentRecord.AdminDate}"/>
                            </StackPanel>
                        </WrapPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="附件材料" Style="{StaticResource Level1GroupBoxStyle}" Padding="10">
            <StackPanel>
                <ListView ItemsSource="{Binding Attachments}" Height="120" BorderBrush="#EEE" BorderThickness="1">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="文件名" Width="250" DisplayMemberBinding="{Binding FileName}"/>
                            <GridViewColumn Header="上传时间" Width="140" DisplayMemberBinding="{Binding UploadTime, StringFormat='yyyy-MM-dd HH:mm'}"/>
                            <GridViewColumn Header="大小 (B)" Width="80" DisplayMemberBinding="{Binding FileSize}"/>
                            <GridViewColumn Header="操作" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="查看" Style="{StaticResource ButtonNormalStyle}" Margin="0,0,5,0"
                                                    Command="{Binding DataContext.ViewAttachmentCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="删除" Style="{StaticResource ButtonCautionStyle}"
                                                    Command="{Binding DataContext.DeleteAttachmentCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock Text="{Binding AttachmentRequirementHint}"
                           Margin="0,6,0,0"
                           Foreground="#B45309"
                           TextWrapping="Wrap"
                           FontSize="11"/>
            </StackPanel>
        </GroupBox>

        <WrapPanel Orientation="Horizontal" Margin="0,-5,0,20" ItemHeight="40">
            <WrapPanel.Style>
                <Style TargetType="WrapPanel">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowEmbeddedActionButtons}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </WrapPanel.Style>
            <Button Content="审批通过"
                Command="{Binding SaveApprovalCommand}"
                ToolTip="{Binding ApproveHintText}"
                MinWidth="120" Height="40" Padding="20,0"
                FontSize="16" FontWeight="Bold" Cursor="Hand" Margin="0,0,20,0" Style="{StaticResource ButtonNormalStyle}"/>
            <Button Content="确认实物交接"
                Command="{Binding ConfirmPhysicalHandoverCommand}"
                ToolTip="{Binding ConfirmHandoverHintText}"
                MinWidth="140" Height="40" Padding="20,0"
                FontSize="16" FontWeight="Bold" Cursor="Hand" Margin="0,0,20,0" Style="{StaticResource ButtonNormalStyle}"/>
            <Button Content="上传签批交接单和资料照片" Command="{Binding UploadAttachmentCommand}"
                ToolTip="{Binding UploadHintText}"
                MinWidth="220" Height="40" Padding="20,0" FontSize="16" FontWeight="Bold" Cursor="Hand" Margin="0,0,20,0" Style="{StaticResource ButtonNormalStyle}"/>
            <Button Content="确认办结" Command="{Binding CompleteCommand}"
                ToolTip="{Binding CompleteHintText}"
                MinWidth="120" Height="40" Padding="20,0" FontSize="16" FontWeight="Bold" Cursor="Hand" Margin="0,0,20,0" Style="{StaticResource ButtonNormalStyle}"/>
            <Button Content="打印交接单" Command="{Binding PrintApprovalCommand}"
                ToolTip="{Binding PrintHintText}"
                 MinWidth="140" Height="40" Padding="20,0" FontSize="16" FontWeight="Bold" Cursor="Hand" Style="{StaticResource ButtonNormalStyle}"/>
        </WrapPanel>
    </StackPanel>
</UserControl>
