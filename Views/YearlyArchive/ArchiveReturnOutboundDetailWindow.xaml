<Window x:Class="DocMgr.Views.YearlyArchive.ArchiveReturnOutboundDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="980"
        Height="680"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="14" Background="White" BorderBrush="#C8E6C9" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="{Binding WindowTitle}" FontSize="18" FontWeight="Bold" Foreground="#1B5E20"/>
                <TextBlock Text="{Binding HeaderText}" Margin="0,6,0,0" FontSize="14" Foreground="#2E7D32"/>
                <TextBlock Text="{Binding SubHeaderText}" Margin="0,4,0,0" Foreground="#666" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ProjectText}" Margin="0,4,0,0" Foreground="#666" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SummaryText}" Margin="0,4,0,0" Foreground="#555" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ExpectedReturnText}" Margin="0,4,0,0" Foreground="#555"/>
                <TextBlock Text="{Binding ReasonText}" Margin="0,4,0,0" Foreground="#555" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="0,12,0,12" Padding="10" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="待归还明细" FontWeight="SemiBold" Foreground="#37474F" Margin="0,0,0,8"/>
                <DataGrid Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          ItemsSource="{Binding Items}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="序号" Binding="{Binding SortOrder}" Width="50"/>
                        <DataGridTextColumn Header="年度" Binding="{Binding ItemArchiveYear}" Width="56"/>
                        <DataGridTextColumn Header="介质" Binding="{Binding MediaKind}" Width="56"/>
                        <DataGridTextColumn Header="载体类型" Binding="{Binding MediaType}" Width="72"/>
                        <DataGridTextColumn Header="用途" Binding="{Binding UsageModeDisplay}" Width="72"/>
                        <DataGridTextColumn Header="资料名称" Binding="{Binding MaterialName}" Width="*"/>
                        <DataGridTextColumn Header="子项" Binding="{Binding ItemName}" Width="100"/>
                        <DataGridTextColumn Header="范围" Binding="{Binding SelectionScopeDisplay}" Width="120"/>
                        <DataGridTextColumn Header="盒/袋号" Binding="{Binding ContainerCode}" Width="80"/>
                        <DataGridTextColumn Header="原存位置" Binding="{Binding StorageLocation}" Width="100"/>
                        <DataGridTextColumn Header="份数" Binding="{Binding CopyCount}" Width="50"/>
                        <DataGridTextColumn Header="密级" Binding="{Binding ConfidentialLevel}" Width="56"/>
                        <DataGridTextColumn Header="库内空盘" Binding="{Binding RequisitionedDiskCode}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="打印详单" Command="{Binding PrintCommand}" Padding="16,8" Margin="0,0,8,0"/>
            <Button Content="关闭" Command="{Binding CloseCommand}" Padding="16,8"/>
        </StackPanel>
    </Grid>
</Window>
