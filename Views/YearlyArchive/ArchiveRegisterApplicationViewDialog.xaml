<Window x:Class="DocMgr.Views.YearlyArchive.ArchiveRegisterApplicationViewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1100"
        Height="780"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F7FA">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ArchiveRegisterResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding WindowTitle}" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="{Binding WorkspaceBannerText}"
                       Margin="0,6,0,0" Foreground="#666" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#D8E2EC" BorderThickness="1" CornerRadius="4" Background="White">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="10">
                <StackPanel Margin="12">
                    <GroupBox Header="1. 资料信息" Style="{StaticResource Level1GroupBoxStyle}" Padding="10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,6">
                                    <TextBlock Text="资料名称" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding MaterialName}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,6">
                                    <TextBlock Text="所属项目" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding ProjectName}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="资料来源" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding SourceType}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="提供部门(单位)" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding ProvideUnit}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="库管模式" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding ArchivePurpose}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="其他要求" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding OtherRequests}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="2. 申请信息" Style="{StaticResource Level1GroupBoxStyle}" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,6">
                                <TextBlock Text="表单编号" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                <TextBlock Text="{Binding FormNo}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,6">
                                <TextBlock Text="当前状态" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                <TextBlock Text="{Binding StatusDisplay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,6">
                                <TextBlock Text="申请人" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                <TextBlock Text="{Binding ApplicantName}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,6">
                                <TextBlock Text="申请部门" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                <TextBlock Text="{Binding ApplicantDept}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="申请日期" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                <TextBlock Text="{Binding ApplicantDateDisplay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="3. 审批流程" Style="{StaticResource Level1GroupBoxStyle}" Padding="10">
                        <StackPanel>
                            <Border Style="{StaticResource ArchiveRegisterApprovalStepCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="部门审核" Style="{StaticResource ArchiveRegisterApprovalStepTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="负责人签字" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                            <TextBlock Text="{Binding DeptLeader, Mode=OneWay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="审核日期" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                            <TextBlock Text="{Binding DeptDateDisplay, Mode=OneWay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ArchiveRegisterApprovalStepCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="生产管理科" Style="{StaticResource ArchiveRegisterApprovalStepTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="负责人签字" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                            <TextBlock Text="{Binding ProdLeader, Mode=OneWay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="日期" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                            <TextBlock Text="{Binding ProdDateDisplay, Mode=OneWay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ArchiveRegisterApprovalStepCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="科研开发室" Style="{StaticResource ArchiveRegisterApprovalStepTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="负责人签字" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                            <TextBlock Text="{Binding RndLeader, Mode=OneWay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="日期" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                            <TextBlock Text="{Binding RndDateDisplay, Mode=OneWay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ArchiveRegisterApprovalStepCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="分管领导" Style="{StaticResource ArchiveRegisterApprovalStepTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="签字" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                            <TextBlock Text="{Binding DeputyLeader, Mode=OneWay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="日期" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                            <TextBlock Text="{Binding DeputyDateDisplay, Mode=OneWay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ArchiveRegisterApprovalStepCardStyle}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="资料交接" Style="{StaticResource ArchiveRegisterApprovalStepTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,8">
                                            <TextBlock Text="移交人签字" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                            <TextBlock Text="{Binding Deliverer, Mode=OneWay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                            <TextBlock Text="移交日期" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                            <TextBlock Text="{Binding DeliverDateDisplay, Mode=OneWay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="资料室资料员签字" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                            <TextBlock Text="{Binding Administrator, Mode=OneWay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                            <TextBlock Text="资料员日期" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                            <TextBlock Text="{Binding AdminDateDisplay, Mode=OneWay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="附件材料" Style="{StaticResource Level1GroupBoxStyle}" Padding="10">
                        <StackPanel>
                            <ListView ItemsSource="{Binding Attachments}" Height="120" BorderBrush="#EEE" BorderThickness="1">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="文件名" Width="280" DisplayMemberBinding="{Binding FileName}"/>
                                        <GridViewColumn Header="上传时间" Width="140" DisplayMemberBinding="{Binding UploadTime, StringFormat='yyyy-MM-dd HH:mm'}"/>
                                        <GridViewColumn Header="上传人" Width="100" DisplayMemberBinding="{Binding UploaderName}"/>
                                        <GridViewColumn Header="操作" Width="80">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="查看" Style="{StaticResource ButtonNormalStyle}"
                                                            Command="{Binding DataContext.ViewAttachmentCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,10,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Background="#FAFBFC">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="打印" Command="{Binding PrintCommand}" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="关闭" Command="{Binding CloseCommand}" Padding="16,6"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
