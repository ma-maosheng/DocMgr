<Page x:Class="DocMgr.Views.YearlyArchive.ArchiveElectronicRelocationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:viewShared="clr-namespace:DocMgr.Views.Shared"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="1300"
      Title="ArchiveElectronicRelocationPage" Background="#F0F2F5">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="SectionGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="Bold" Foreground="#00695C"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FormFieldCaptionStyle}">
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding PageTitle, Mode=OneWay}"
                       FontSize="18" FontWeight="Bold"
                       Foreground="#004D40"/>
            <TextBlock Text="{Binding PageSubtitle, Mode=OneWay}"
                       Margin="0,4,0,0"
                       Foreground="#666"
                       TextWrapping="Wrap"
                       FontSize="12"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <GroupBox Header="1. 迁档模式" Style="{StaticResource SectionGroupBoxStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="迁入其他档口" GroupName="ElectronicRelocationMode"
                                     IsChecked="{Binding IsPhysicalMoveModeSelected, Mode=TwoWay}"
                                     VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <RadioButton Content="迁入空白硬盘" GroupName="ElectronicRelocationMode"
                                     IsChecked="{Binding IsMoveToBlankHardDiskModeSelected, Mode=TwoWay}"
                                     VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <RadioButton Content="迁入空白光盘" GroupName="ElectronicRelocationMode"
                                     IsChecked="{Binding IsMoveToBlankOpticalDiscModeSelected, Mode=TwoWay}"
                                     VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <RadioButton Content="并入同项目硬盘" GroupName="ElectronicRelocationMode"
                                     IsChecked="{Binding IsMergeToExistingModeSelected, Mode=TwoWay}"
                                     VerticalAlignment="Center"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="2. 拟迁档对象" Style="{StaticResource SectionGroupBoxStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="年度：" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="项目：" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="源电子袋：" Style="{StaticResource FieldLabelStyle}"/>

                        <ComboBox Grid.Row="1" Grid.Column="0" Style="{StaticResource FormComboBoxStyle}" Margin="0,0,12,0"
                                  ItemsSource="{Binding Years}"
                                  SelectedItem="{Binding SelectedYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormComboBoxStyle}" Margin="0,0,12,0"
                                  ItemsSource="{Binding ProjectOptions}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedProjectId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <ComboBox Grid.Row="1" Grid.Column="2" Style="{StaticResource FormComboBoxStyle}"
                                  ItemsSource="{Binding SourceOptions}"
                                  DisplayMemberPath="DisplayText"
                                  SelectedItem="{Binding SelectedSourceOption, Mode=TwoWay}"/>

                        <Border Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0" Padding="10,8"
                                Background="#F6FFFD" BorderBrush="#B2DFDB" BorderThickness="1" CornerRadius="4"
                                Visibility="{Binding HasSource, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding SourceSummaryText, Mode=OneWay}" TextWrapping="Wrap" Foreground="#37474F"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                            Visibility="{Binding ShowSourceCurrentLocation, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="当前位置：" Foreground="#666" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SourceCurrentLocation, Mode=OneWay}"
                                               FontWeight="SemiBold" Foreground="#00695C" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="硬盘编号：" Foreground="#666" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SourceLinkedMediumCodesDisplayText, Mode=OneWay}"
                                               FontWeight="SemiBold" Foreground="#00695C" VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="关联资料：" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Text="{Binding SourceItemsDescriptionText, Mode=OneWay}"
                                               TextWrapping="Wrap" Margin="0,2,0,0"
                                               Foreground="#37474F" LineHeight="22"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </GroupBox>

                <GroupBox Header="3. 迁档目标" Style="{StaticResource SectionGroupBoxStyle}">
                    <StackPanel>
                        <StackPanel Visibility="{Binding IsMoveToBlankHardDiskMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="拟迁入空白硬盘：" Style="{StaticResource FieldLabelStyle}"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource ToolbarFilterTextBoxStyle}" VerticalContentAlignment="Center"
                                         IsReadOnly="True" Background="#F9FAFB"
                                         Text="{Binding SelectedBlankHardDiskCode, Mode=OneWay}"/>
                                <Button Grid.Column="1" Content="空盘选择" Margin="12,0,0,0"
                                        Style="{StaticResource ToolbarActionButtonStyle}"
                                        Command="{Binding SelectBlankHardDiskCommand}"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock Margin="0,0,0,12" Foreground="#666" TextWrapping="Wrap"
                                   Visibility="{Binding IsMoveToBlankOpticalDiscMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Text="拟迁入空白光盘：系统不管理空白光盘库存；确认迁档后将按立档规则自动登记数据光盘并写入目标档口。"/>

                        <StackPanel Visibility="{Binding ShowTargetSlotSelector, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding TargetLocationPanelTitle, Mode=OneWay}" Style="{StaticResource FieldLabelStyle}"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Style="{StaticResource FormComboBoxStyle}"
                                          ItemsSource="{Binding TargetSlotLocationOptions}"
                                          SelectedItem="{Binding SelectedTargetSlotLocationOption, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayText"
                                          ToolTip="{Binding TargetSlotRecommendHintText, Mode=OneWay}"/>
                                <Button Grid.Column="1" Content="推荐档口" Margin="12,0,0,0"
                                        Style="{StaticResource ToolbarActionButtonStyle}"
                                        Command="{Binding RecommendTargetSlotCommand}"
                                        ToolTip="{Binding TargetSlotRecommendHintText, Mode=OneWay}"/>
                                <Button Grid.Column="2" Content="档口快照" Margin="12,0,0,0"
                                        Style="{StaticResource ToolbarActionButtonStyle}"
                                        Command="{Binding ShowTargetSlotSnapshotCommand}"
                                        IsEnabled="{Binding CanShowTargetSlotSnapshot}"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="目标位置：" Foreground="#666" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TargetFullLocation, Mode=OneWay}" FontWeight="Bold"
                                           Foreground="#E91E63" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding TargetCellOccupancyText, Mode=OneWay}" Foreground="Gray" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding TargetSlotValidationMessage, Mode=OneWay}" Foreground="#C62828" Margin="0,0,0,8"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsMergeMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="目标电子袋：" Style="{StaticResource FieldLabelStyle}"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Style="{StaticResource FormComboBoxStyle}"
                                          ItemsSource="{Binding TargetOptions}"
                                          DisplayMemberPath="DisplayText"
                                          SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"/>
                                <Button Grid.Column="1" Content="刷新" Margin="12,0,0,0"
                                        Style="{StaticResource ToolbarActionButtonStyle}"
                                        Command="{Binding RefreshTargetsCommand}"/>
                            </Grid>

                            <Border Margin="0,12,0,0" Padding="10,8"
                                    Background="#F6FFFD" BorderBrush="#B2DFDB" BorderThickness="1" CornerRadius="4"
                                    Visibility="{Binding ShowTargetDescription, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding TargetSummaryText, Mode=OneWay}" TextWrapping="Wrap" Foreground="#37474F"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="硬盘编号：" Foreground="#666" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TargetLinkedMediumCodesDisplayText, Mode=OneWay}"
                                                   FontWeight="SemiBold" Foreground="#00695C" VerticalAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="关联资料：" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock Text="{Binding TargetItemsDescriptionText, Mode=OneWay}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Foreground="#37474F" LineHeight="22"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding SupportsBackupMechanism, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="原件处理方式：" Style="{StaticResource FieldLabelStyle}"/>
                            <StackPanel Orientation="Vertical" Margin="0,4,0,0">
                                <RadioButton Content="迁档并处置原介质（换盘/并档后格式化或销毁）"
                                             GroupName="ElectronicRelocationOriginalDisposition"
                                             IsChecked="{Binding IsRelocateWithDispositionSelected, Mode=TwoWay}"
                                             VerticalAlignment="Center"/>
                                <RadioButton Margin="0,8,0,0"
                                             Content="保留原件，仅登记备份副本（目标介质生成可检索备份）"
                                             GroupName="ElectronicRelocationOriginalDisposition"
                                             IsChecked="{Binding IsBackupMechanismSelected, Mode=TwoWay}"
                                             VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Margin="0,6,0,0" Foreground="#666" TextWrapping="Wrap"
                                       Text="选择「保留原件」时源袋与原介质不动；系统只登记逻辑备份并写入新立档事实，物理拷贝由人工完成。选择「迁档并处置」时须完成下方处置确认。"/>
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding RequiresHardDiskReturnLocation, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="原硬盘放回位置：" Style="{StaticResource FieldLabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Style="{StaticResource FormComboBoxStyle}"
                                          ItemsSource="{Binding SourceHardDiskReturnLocationOptions}"
                                          DisplayMemberPath="DisplayText"
                                          SelectedItem="{Binding SelectedSourceHardDiskReturnLocationOption, Mode=TwoWay}"/>
                                <Button Grid.Column="1" Content="档口快照" Margin="12,0,0,0"
                                        Style="{StaticResource ToolbarActionButtonStyle}"
                                        Command="{Binding ShowSourceHardDiskReturnSlotSnapshotCommand}"
                                        IsEnabled="{Binding CanShowSourceHardDiskReturnSlotSnapshot}"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding ShowDispositionConfirmations, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <CheckBox Visibility="{Binding RequiresHardDiskConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Content="已确认原硬盘已格式化，后续按空盘管理"
                                      IsChecked="{Binding ConfirmHardDiskFormatted, Mode=TwoWay}"/>
                            <CheckBox Margin="0,8,0,0"
                                      Visibility="{Binding RequiresOpticalDiscConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Content="已确认原光盘已物理销毁"
                                      IsChecked="{Binding ConfirmOpticalDiscDestroyed, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="备注：" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Style="{StaticResource ToolbarFilterTextBoxStyle}" VerticalContentAlignment="Center"
                                     Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{Binding ItemsSectionHeader}" Style="{StaticResource SectionGroupBoxStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding ItemsEmptyHintText, Mode=OneWay}"
                                   Foreground="#666" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding ShowItemsEmptyHint, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <viewShared:ItemDetailsPanelHeader DataContext="{Binding ItemDetailsPanel}" Margin="0,0,0,6"/>
                        <DataGrid ItemsSource="{Binding ItemDetailsPanel.PageItems}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                              MinHeight="160" MaxHeight="280">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ItemDetailsPanel.IsExpanded}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="表单号" Binding="{Binding FormNo, Mode=OneWay}" Width="120"/>
                            <DataGridTextColumn Header="年度" Binding="{Binding Year, Mode=OneWay}" Width="70"/>
                            <DataGridTextColumn Header="项目" Binding="{Binding ProjectName, Mode=OneWay}" Width="140"/>
                            <DataGridTextColumn Header="资料名称" Binding="{Binding MaterialName, Mode=OneWay}" Width="160"/>
                            <DataGridTextColumn Header="子项名称" Binding="{Binding ItemName, Mode=OneWay}" Width="*"/>
                            <DataGridTextColumn Header="迁档前编号" Binding="{Binding BeforeStorageLocation, Mode=OneWay}" Width="140"/>
                            <DataGridTextColumn Header="迁档后编号" Binding="{Binding AfterStorageLocation, Mode=OneWay}" Width="140"/>
                        </DataGrid.Columns>
                        </DataGrid>
                        <viewShared:ItemDetailsPanelPaginationBar DataContext="{Binding ItemDetailsPanel}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="5. 预览与确认" Style="{StaticResource SectionGroupBoxStyle}">
                    <StackPanel>
                        <TextBox Text="{Binding PreviewText, Mode=OneWay}" TextWrapping="Wrap" MinHeight="72"
                                 IsReadOnly="True" Background="#FAFAFA" BorderBrush="#E0E0E0" Padding="8"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="生成预览" Style="{StaticResource ToolbarActionButtonStyle}"
                                    Command="{Binding PreviewCommand}"/>
                            <Button Content="确认迁档" Margin="12,0,0,0" Style="{StaticResource ToolbarActionButtonStyle}"
                                    Command="{Binding ExecuteCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
