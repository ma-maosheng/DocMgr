<Page x:Class="DocMgr.Views.YearlyArchive.ArchiveOutboundApprovalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:DocMgr.Views.YearlyArchive"
      Title="审批出库"
      Background="#F0F2F5">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="OutboundApprovalPaneGridSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Width" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
            <Setter Property="ResizeDirection" Value="Columns"/>
            <Setter Property="ShowsPreview" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="ToolTip" Value="左右拖动以调整申请单列表与办理区宽度"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" Margin="2,8">
                            <Border Width="3" Height="48" CornerRadius="1.5"
                                    Background="#94A3B8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCardBorderStyle}" Margin="0" CornerRadius="0" Padding="16,12">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Button Content="申请-&gt;查看" Command="{Binding ViewCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="120" Margin="0,0,10,0"/>
                        <Button Content="打开办理" Command="{Binding ApproveCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="100" Margin="0,0,10,0"/>
                        <Button Content="{Binding DestructiveActionText}" Command="{Binding DestructiveCommand}" Style="{StaticResource ToolbarDangerButtonStyle}" Width="110" Margin="0,0,10,0"/>
                        <Button Content="关闭办理" Command="{Binding CloseEditingCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="96"
                                Visibility="{Binding HasEditingViewModel, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="状态:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="140"
                                  Style="{StaticResource ToolbarFilterComboBoxStyle}"
                                  ItemsSource="{Binding StatusFilterOptions}"
                                  SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="Label"
                                  ToolTip="{Binding StatusFilterTooltipTitle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="申请年度:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="100"
                                  Style="{StaticResource ToolbarFilterComboBoxStyle}"
                                  ItemsSource="{Binding YearOptions}"
                                  SelectedItem="{Binding SelectedYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="申请人:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Grid>
                            <ToggleButton x:Name="ApplicantFilterButton"
                                          Width="180"
                                          Height="32"
                                          IsChecked="{Binding IsApplicantPopupOpen, Mode=TwoWay}">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="{Binding SelectedApplicantSummary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="▼" Margin="8,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Right"/>
                                </DockPanel>
                            </ToggleButton>
                            <Popup PlacementTarget="{Binding ElementName=ApplicantFilterButton}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   IsOpen="{Binding IsApplicantPopupOpen, Mode=TwoWay}">
                                <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="10" MinWidth="180">
                                    <StackPanel>
                                        <CheckBox Content="全部"
                                                  IsChecked="{Binding IsAllApplicantsSelected, Mode=TwoWay}"/>
                                        <Separator Margin="0,6,0,6"/>
                                        <ItemsControl ItemsSource="{Binding ApplicantOptions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Label}"
                                                              Margin="0,2,0,0"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>

                    <Button Grid.Column="4"
                            Content="刷新列表"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource ToolbarActionButtonStyle}"
                            Width="96"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1"
                Margin="0,8,0,8"
                Padding="0"
                Background="#FFFDF7"
                BorderBrush="#E2C98F"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#B98A2E"/>
                <TextBlock Grid.Row="1"
                           Text="{Binding PageTitle}"
                           Margin="0,8,0,2"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#6F4A00"
                           HorizontalAlignment="Center"
                           TextDecorations="Underline"/>
                <TextBlock Grid.Row="2"
                           Text="{Binding PageSubtitle}"
                           Margin="0,0,0,8"
                           FontSize="11"
                           Foreground="#9A7B3F"
                           HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 左列表 | 分隔条 | 右办理区 -->
        <Grid x:Name="ContentSplitGrid" Grid.Row="2" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumnDefinition" Width="*" MinWidth="220"/>
                <ColumnDefinition x:Name="SplitterColumnDefinition" Width="0"/>
                <ColumnDefinition x:Name="DetailColumnDefinition" Width="0" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" Padding="8" Margin="0">
                <DataGrid AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          RowHeight="36"
                          ColumnHeaderHeight="36"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          ItemsSource="{Binding Records}"
                          SelectedItem="{Binding SelectedRecord}"
                          MouseDoubleClick="DgRecords_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="申请单号" Binding="{Binding OutboundNo}" Width="130"/>
                        <DataGridTextColumn Header="资料摘要" Binding="{Binding MaterialSummary}" Width="*" MinWidth="80"/>
                        <DataGridTextColumn Header="申请人" Binding="{Binding ApplicantName}" Width="70"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding StatusStr}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <GridSplitter x:Name="ListDetailSplitter"
                          Grid.Column="1"
                          Style="{StaticResource OutboundApprovalPaneGridSplitterStyle}"
                          Visibility="Collapsed"/>

            <Border x:Name="DetailPaneBorder"
                    Grid.Column="2"
                    Margin="0"
                    Padding="0"
                    Visibility="Collapsed">
                <local:ArchiveOutboundApprovalPanel DataContext="{Binding EditingViewModel}"/>
            </Border>
        </Grid>
    </Grid>
</Page>
