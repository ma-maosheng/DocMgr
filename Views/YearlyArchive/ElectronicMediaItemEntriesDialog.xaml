<Window x:Class="DocMgr.Views.YearlyArchive.ElectronicMediaItemEntriesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewShared="clr-namespace:DocMgr.Views.Shared"
        Width="980"
        Height="620"
        MinWidth="760"
        MinHeight="480"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F7FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button Content="关闭"
                Command="{x:Static viewShared:ViewCommands.CloseCurrentView}"
                Style="{StaticResource DialogCloseButtonStyle}"
                HorizontalAlignment="Right"/>

        <StackPanel Grid.Row="0" Margin="0,0,120,0">
            <TextBlock Text="{Binding Title}"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="#333"/>
            <TextBlock Margin="0,8,0,0"
                       Foreground="#4B5563"
                       TextWrapping="Wrap"
                       Text="{Binding SummaryText}"/>
        </StackPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding PageEntries}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  IsReadOnly="True"
                  Margin="0,16,0,0"
                  ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="类型" Binding="{Binding EntryKind}" Width="70"/>
                <DataGridTextColumn Header="名称" Binding="{Binding EntryName}" Width="200"/>
                <DataGridTextColumn Header="创建日期" Binding="{Binding CreatedDateText}" Width="150"/>
                <DataGridTextColumn Header="修改日期" Binding="{Binding ModifiedDateText}" Width="150"/>
                <DataGridTextColumn Header="大小(MB)" Binding="{Binding SizeMb}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Foreground="#666"
                       Text="{Binding PageInfo}"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="首页" Width="64" Margin="0,0,6,0" Command="{Binding FirstPageCommand}"/>
                <Button Content="上一页" Width="72" Margin="0,0,6,0" Command="{Binding PreviousPageCommand}"/>
                <Button Content="下一页" Width="72" Margin="0,0,6,0" Command="{Binding NextPageCommand}"/>
                <Button Content="末页" Width="64" Command="{Binding LastPageCommand}"/>
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="关闭"
                    Width="96"
                    Style="{StaticResource DialogPrimaryActionButtonStyle}"
                    Command="{Binding CloseCommand}"/>
        </StackPanel>
    </Grid>
</Window>
