<Window x:Class="DocMgr.Views.YearlyArchive.ElectronicMediaItemEntriesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title, Mode=OneWay}"
        Width="920"
        Height="540"
        MinWidth="720"
        MinHeight="400"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F7FA">
    <Window.Resources>
        <Style x:Key="ElectronicMediaItemEntriesDataGridHeaderStyle"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource DataGridHeaderStyle}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,6"
                   Text="{Binding Title, Mode=OneWay}"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#333"/>

        <TextBlock Grid.Row="1"
                   Margin="0,0,0,8"
                   FontSize="12"
                   Foreground="#64748B"
                   TextWrapping="Wrap"
                   Text="{Binding SummaryText, Mode=OneWay}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSummaryText}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8">
            <DataGrid ItemsSource="{Binding PageEntries}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      RowHeight="{StaticResource FormControlHeight}"
                      ColumnHeaderHeight="36"
                      ColumnHeaderStyle="{StaticResource ElectronicMediaItemEntriesDataGridHeaderStyle}"
                      RowStyle="{StaticResource StandardDataGridRowStyle}"
                      CellStyle="{StaticResource StandardDataGridCellStyle}"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="类型" Binding="{Binding EntryKind, Mode=OneWay}" Width="64"/>
                    <DataGridTextColumn Header="名称" Binding="{Binding EntryName, Mode=OneWay}" Width="*"/>
                    <DataGridTextColumn Header="创建日期" Binding="{Binding CreatedDateText, Mode=OneWay}" Width="128"/>
                    <DataGridTextColumn Header="修改日期" Binding="{Binding ModifiedDateText, Mode=OneWay}" Width="128"/>
                    <DataGridTextColumn Header="大小(MB)" Binding="{Binding SizeMbText, Mode=OneWay}" Width="88"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right"
                    Content="关闭"
                    Style="{StaticResource DialogPrimaryActionButtonStyle}"
                    Command="{Binding CloseCommand}"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,10,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowPagination}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button Content="首页" Width="64" Margin="0,0,6,0" Command="{Binding FirstPageCommand}"/>
                <Button Content="上一页" Width="72" Margin="0,0,6,0" Command="{Binding PreviousPageCommand}"/>
                <Button Content="下一页" Width="72" Margin="0,0,6,0" Command="{Binding NextPageCommand}"/>
                <Button Content="末页" Width="64" Command="{Binding LastPageCommand}"/>
            </StackPanel>
            <TextBlock VerticalAlignment="Center"
                       Foreground="#64748B"
                       FontSize="12"
                       Text="{Binding PageInfo, Mode=OneWay}"/>
        </DockPanel>
    </Grid>
</Window>
