<Window x:Class="DocMgr.Views.YearlyArchive.ElectronicArchiveInventoryRegisterEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DocMgr.Models.Shared"
        xmlns:viewShared="clr-namespace:DocMgr.Views.Shared"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="1200"
        Height="820"
        MinWidth="1040"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F0F2F5">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ArchiveRegisterResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="DisposalSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#1E293B"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
      </Style>
      <Style x:Key="DisposalCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E0E0E0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
      </Style>
      <Style x:Key="InvTransferButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarActionButtonStyle}">
        <Setter Property="Width" Value="82"/>
        <Setter Property="Height" Value="{StaticResource DialogFormControlHeight}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <viewShared:ApprovalHandoverWorkspaceShell Margin="12"
                                             ShellKind="{x:Static models:ApprovalWorkflowShellKind.DisposalUnlockUpload}"
                                             SubmitButtonText="{x:Static models:ApprovalWorkflowShellCopySupport.SubmitInventoryRegisterButtonText}"
                                             ConfirmMidStepButtonTextOverride="{x:Static models:ApprovalWorkflowShellCopySupport.ConfirmUploadAttachmentInfoButtonText}">
    <viewShared:ApprovalHandoverWorkspaceShell.HeaderContent>
      <Grid VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource DisposalCardBorderStyle}">
          <StackPanel>
            <TextBlock Text="基本信息" Style="{StaticResource DisposalSectionTitleStyle}"/>
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto" MinWidth="140"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="登记单号："
                         Style="{StaticResource ArchiveRegisterFormLabelStyle}"
                         Width="{StaticResource FormLabelColumnWidth}"/>
              <TextBox Grid.Column="1"
                       Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                       Height="{StaticResource DialogFormControlHeight}"
                       VerticalContentAlignment="Center"
                       Text="{Binding RegisterNo, Mode=OneWay}" IsReadOnly="True" Background="#F5F5F5"/>
              <TextBlock Grid.Column="3" Text="业务状态："
                         Style="{StaticResource ArchiveRegisterFormLabelStyle}"
                         Width="{StaticResource FormLabelColumnWidth}"/>
              <TextBlock Grid.Column="4" Text="{Binding StatusDisplay, Mode=OneWay}"
                         VerticalAlignment="Center" Foreground="#1E293B"/>
            </Grid>
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="登记说明："
                         Style="{StaticResource ArchiveRegisterFormLabelStyle}"
                         Width="{StaticResource FormLabelColumnWidth}"/>
              <TextBox Grid.Column="1"
                       Height="{StaticResource DialogFormControlHeight}"
                       MaxLines="1" AcceptsReturn="False" TextWrapping="NoWrap"
                       VerticalContentAlignment="Center"
                       Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                       Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                       IsEnabled="{Binding CanEditHeader}"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="备注："
                         Style="{StaticResource ArchiveRegisterFormLabelStyle}"
                         Width="{StaticResource FormLabelColumnWidth}"/>
              <TextBox Grid.Column="1"
                       Height="{StaticResource DialogFormControlHeight}"
                       MaxLines="1" AcceptsReturn="False" TextWrapping="NoWrap"
                       VerticalContentAlignment="Center"
                       Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                       Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                       IsEnabled="{Binding CanEditHeader}"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- 双列表：共享行对齐（对标硬盘盘库） -->
        <Border Grid.Row="1" Style="{StaticResource DisposalCardBorderStyle}" Margin="0">
          <Grid viewShared:InventoryRegisterTransferAutoHeight.IsEnabled="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="96"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Grid.Row="0"
                       Text="{Binding AvailableTitle, Mode=OneWay}"
                       FontWeight="SemiBold" Foreground="#00796B" Margin="0,0,0,8"/>
            <TextBlock Grid.Column="2" Grid.Row="0"
                       Text="{Binding RegisterTitle, Mode=OneWay}"
                       FontWeight="SemiBold" Foreground="#00796B" Margin="0,0,0,8"/>

            <DockPanel Grid.Column="0" Grid.Row="1"
                       Margin="0,0,0,8"
                       LastChildFill="True"
                       IsEnabled="{Binding CanEditHeader}">
              <TextBlock Text="档口：" Style="{StaticResource FormLabelTextBlockStyle}" DockPanel.Dock="Left"/>
              <ComboBox Width="140" Margin="0,0,12,0" DockPanel.Dock="Left"
                        Height="{StaticResource DialogFormControlHeight}"
                        ItemsSource="{Binding SlotOptions}"
                        SelectedItem="{Binding SelectedSlot}"/>
              <TextBlock Text="筛选：" Style="{StaticResource FormLabelTextBlockStyle}" DockPanel.Dock="Left"/>
              <TextBox Text="{Binding FilterKeyword, UpdateSourceTrigger=PropertyChanged}"
                       Height="{StaticResource DialogFormControlHeight}"
                       ToolTip="项目、年度、介质编号、电子袋号、状态、档口"/>
            </DockPanel>

            <DockPanel Grid.Column="2" Grid.Row="1"
                       Margin="0,0,0,8"
                       LastChildFill="False">
              <TextBlock Text="登记类型：" Style="{StaticResource FormLabelTextBlockStyle}" DockPanel.Dock="Left"/>
              <ComboBox Width="160" DockPanel.Dock="Left"
                        Style="{StaticResource ArchiveRegisterFormComboBoxStyle}"
                        Height="{StaticResource DialogFormControlHeight}"
                        ItemsSource="{Binding RegisterKindOptions}"
                        SelectedItem="{Binding RegisterKind}"
                        IsEnabled="{Binding CanEditRegisterKind}"
                        ToolTip="整单登记类型，作用于右侧全部待登记介质"/>
            </DockPanel>

            <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="3"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
              <Button Content="加入 →" Command="{Binding MoveToRegisterCommand}" Style="{StaticResource InvTransferButtonStyle}"
                      ToolTip="将左侧勾选介质移入登记明细"/>
              <Button Content="← 移除" Command="{Binding MoveToAvailableCommand}" Style="{StaticResource InvTransferButtonStyle}"
                      ToolTip="将右侧勾选明细移回可选列表"/>
            </StackPanel>

            <DataGrid Grid.Column="0" Grid.Row="2"
                      ItemsSource="{Binding AvailableCandidates}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="False"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="1"
                      BorderBrush="#E0E0E0"
                      RowHeight="36"
                      VerticalScrollBarVisibility="Auto"
                      IsEnabled="{Binding CanEditHeader}">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="选" Width="40">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="所属项目" Binding="{Binding ProjectName}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="项目年度" Binding="{Binding Year}" Width="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="介质" Binding="{Binding MediumKind}" Width="60" IsReadOnly="True"/>
                <DataGridTextColumn Header="介质编号" Binding="{Binding MediumCodeDisplay, Mode=OneWay}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="电子袋" Binding="{Binding ElectronicArchiveNo}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="状态" Binding="{Binding MediaStatus}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="档口" Binding="{Binding StorageLocation}" Width="*" IsReadOnly="True"/>
              </DataGrid.Columns>
            </DataGrid>

            <DataGrid Grid.Column="2" Grid.Row="2"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="False"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="1"
                      BorderBrush="#E0E0E0"
                      RowHeight="36"
                      VerticalScrollBarVisibility="Auto">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="选" Width="40">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="所属项目" Binding="{Binding ProjectName}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="项目年度" Binding="{Binding Year}" Width="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="介质" Binding="{Binding MediumKind}" Width="60" IsReadOnly="True"/>
                <DataGridTextColumn Header="介质编号" Binding="{Binding MediumCodeDisplay, Mode=OneWay}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="电子袋" Binding="{Binding ElectronicArchiveNo}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="状态" Binding="{Binding BeforeMediaStatus}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="档口" Binding="{Binding BeforeStorageLocation}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="登记类型" Binding="{Binding DataContext.RegisterKind, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Width="*" IsReadOnly="True"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
      </Grid>
    </viewShared:ApprovalHandoverWorkspaceShell.HeaderContent>

    <viewShared:ApprovalHandoverWorkspaceShell.SignatureContent>
      <viewShared:ApprovalSignatureCardsControl ShowApprovalOpinion="False"/>
    </viewShared:ApprovalHandoverWorkspaceShell.SignatureContent>
  </viewShared:ApprovalHandoverWorkspaceShell>
</Window>
