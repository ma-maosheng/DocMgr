<Page x:Class="DocMgr.Views.YearlyArchive.StockTextArchiveDirectFilingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="存档文本资料直办立档"
      Background="#F0F2F5">
    <Page.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="72"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="#37474F"/>
        </Style>
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="78,2,0,0"/>
        </Style>
        <Style x:Key="InlineActionButtonStyle" TargetType="Button" BasedOn="{StaticResource FormInlineButtonStyle}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="16,14"
                Margin="0,0,0,8"
                ToolTip="存档文本直办：档案盒编号中的年度取自「实施年度」，确认写入前仅为预览、不占用号段。">
            <StackPanel>
                <TextBlock Text="{Binding PageTitle, Mode=OneWay}"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#37474F"/>
                <TextBlock Text="以档案盒为单位手工登记纸基模拟资料，由资料室资料管理员直接完成建档与模拟立档，无需申请审批。载体类型为打印纸、绘图纸、打印相纸、感光胶片或感光相纸；子项需填写资料类型、所属子类与组织形式。"
                           Margin="0,6,0,0"
                           FontSize="12"
                           Foreground="#546E7A"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="确认立档" Command="{Binding ConfirmCommand}" Padding="16,6" MinHeight="28" FontWeight="SemiBold"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 1. 年度 / 项目 -->
                <GroupBox Header="1. 年度 / 项目" Padding="8,5" Margin="0,0,0,4">
                    <StackPanel>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="实施年度" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding YearOptions}"
                                      IsEditable="True"
                                      Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}"
                                      Height="{StaticResource FormControlHeight}" Margin="0,0,12,0"
                                      ToolTip="开放域：列出项目信息、模拟盒、电子袋中已有年度；也可手输新年度"/>
                            <TextBlock Grid.Column="2" Text="项目名称" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Grid.Column="3"
                                      ItemsSource="{Binding ProjectNameOptions}"
                                      IsEditable="True"
                                      Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                                      Height="{StaticResource FormControlHeight}" Margin="0,0,12,0"
                                      ToolTip="开放域：列出当前年度下已登记项目名称（含模拟/电子立档）；也可手输新项目"/>
                            <TextBlock Grid.Column="4" Text="项目编号" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Column="5" Text="{Binding ProjectCode, UpdateSourceTrigger=PropertyChanged}"
                                     Height="{StaticResource FormControlHeight}"/>
                            <Button Grid.Column="6" Content="查看年度已有项目" Command="{Binding ViewYearProjectsCommand}"
                                    Style="{StaticResource InlineActionButtonStyle}"
                                    ToolTip="{Binding YearProjectHint, Mode=OneWay}"/>
                        </Grid>
                        <TextBlock Text="{Binding YearProjectHint, Mode=OneWay}" Style="{StaticResource HintStyle}" Foreground="#546E7A"/>
                        <TextBlock Text="{Binding ProjectHint, Mode=OneWay}" Style="{StaticResource HintStyle}" Foreground="#00695C"/>
                    </StackPanel>
                </GroupBox>

                <!-- 2. 立档默认值 -->
                <GroupBox Header="2. 立档默认值" Padding="8,5" Margin="0,0,0,4">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="资料名称" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding MaterialName, UpdateSourceTrigger=PropertyChanged}"
                                     Height="{StaticResource FormControlHeight}" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="2" Text="来源" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Column="3" Text="{Binding SourceType, Mode=OneWay}" IsReadOnly="True"
                                     Height="{StaticResource FormControlHeight}" Margin="0,0,12,0" Background="#F9F9F9"/>
                            <TextBlock Grid.Column="4" Text="提供单位" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Column="5" Text="{Binding ProvideUnit, Mode=OneWay}" IsReadOnly="True"
                                     Height="{StaticResource FormControlHeight}" Background="#F9F9F9"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="库管模式" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ArchivePurposeOptions}" SelectedItem="{Binding ArchivePurpose}"
                                      Height="{StaticResource FormControlHeight}" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="2" Text="默认密级" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Grid.Column="3" ItemsSource="{Binding ConfidentialLevelOptions}" SelectedItem="{Binding ConfidentialLevel}"
                                      Height="{StaticResource FormControlHeight}" Margin="0,0,12,0"
                                      ToolTip="新建资料子项时带入，子项仍可单独修改"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- 3. 资料介质（模拟） -->
                <GroupBox Header="3. 资料介质（模拟）*" Padding="8,5" Margin="0,0,0,4">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right"
                                    Content="+ 添加资料介质"
                                    Command="{Binding AddMediaGroupCommand}"
                                    Style="{StaticResource InlineActionButtonStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="介质：" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="模拟" IsReadOnly="True" IsTabStop="False"
                                         Height="{StaticResource FormControlHeight}" Background="#F9F9F9" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="2" Text="类型：" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="3"
                                          ItemsSource="{Binding MediaTypeOptions}"
                                          SelectedItem="{Binding SelectedSimulatedMediaType}"
                                          Height="{StaticResource FormControlHeight}" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="4" Text="数量：" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="5" Text="{Binding DataSimulatedMediaCount, Mode=OneWay}" IsReadOnly="True"
                                         Height="{StaticResource FormControlHeight}" Background="#F9F9F9" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="6" Text="{Binding MediaSummary, Mode=OneWay}"
                                           VerticalAlignment="Center" FontSize="12" Foreground="#546E7A"/>
                            </Grid>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding MediaGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <GroupBox BorderBrush="#E0E0E0" BorderThickness="1" Padding="6" Margin="0,0,0,6">
                                        <GroupBox.Header>
                                            <DockPanel LastChildFill="True">
                                                <Button DockPanel.Dock="Right"
                                                        Content="删除"
                                                        Command="{Binding DataContext.RemoveMediaGroupCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource InlineActionButtonStyle}"
                                                        Margin="8,0,0,0"/>
                                                <TextBlock Text="资料明细" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </GroupBox.Header>
                                        <StackPanel>
                                            <Grid Margin="0,2,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="56"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="介质：" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding MediaKind, Mode=OneWay}" IsReadOnly="True"
                                                         Height="{StaticResource FormControlHeight}" Background="#F9F9F9" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="2" Text="数量：" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="3" Text="{Binding MediaCount, Mode=OneWay}" IsReadOnly="True"
                                                         Height="{StaticResource FormControlHeight}" Background="#F9F9F9"
                                                         ToolTip="系统按资料子项数量自动计算"/>
                                            </Grid>
                                            <DockPanel Margin="0,0,0,4" LastChildFill="True">
                                                <Button DockPanel.Dock="Right"
                                                        Content="+ 添加资料子项"
                                                        Command="{Binding DataContext.AddMediaItemCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource InlineActionButtonStyle}"/>
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#EEEEEE" BorderThickness="1" Padding="6" Margin="0,0,0,4" Background="#FAFAFA">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="72"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="40"/>
                                                                        <ColumnDefinition Width="80"/>
                                                                        <ColumnDefinition Width="40"/>
                                                                        <ColumnDefinition Width="48"/>
                                                                        <ColumnDefinition Width="36"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="子项名称：" VerticalAlignment="Center"/>
                                                                    <TextBox Grid.Column="1" Text="{Binding ContentDesc, UpdateSourceTrigger=PropertyChanged}"
                                                                             Height="{StaticResource FormControlHeight}" Margin="0,0,6,0"/>
                                                                    <TextBlock Grid.Column="2" Text="密级：" VerticalAlignment="Center"/>
                                                                    <ComboBox Grid.Column="3"
                                                                              ItemsSource="{Binding Owner.ConfidentialLevelOptions}"
                                                                              SelectedItem="{Binding ConfidentialLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              Height="{StaticResource FormControlHeight}" Margin="0,0,6,0"/>
                                                                    <TextBlock Grid.Column="4" Text="份数：" VerticalAlignment="Center"/>
                                                                    <TextBox Grid.Column="5" Text="{Binding ContentCount, UpdateSourceTrigger=PropertyChanged}"
                                                                             Height="{StaticResource FormControlHeight}" Margin="0,0,6,0"/>
                                                                    <Button Grid.Column="6" Content="×"
                                                                            Command="{Binding DataContext.RemoveMediaItemCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip="删除本子项"
                                                                            MinWidth="28" MinHeight="28"/>
                                                                </Grid>
                                                                <Grid Margin="0,4,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="72"/>
                                                                        <ColumnDefinition Width="110"/>
                                                                        <ColumnDefinition Width="72"/>
                                                                        <ColumnDefinition Width="150"/>
                                                                        <ColumnDefinition Width="72"/>
                                                                        <ColumnDefinition Width="90"/>
                                                                        <ColumnDefinition Width="40"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="资料类型：" VerticalAlignment="Center"/>
                                                                    <ComboBox Grid.Column="1"
                                                                              ItemsSource="{Binding Owner.MaterialCategoryOptions}"
                                                                              SelectedItem="{Binding MaterialCategory}"
                                                                              Height="{StaticResource FormControlHeight}" Margin="0,0,6,0"/>
                                                                    <TextBlock Grid.Column="2" Text="所属子类：" VerticalAlignment="Center"/>
                                                                    <ComboBox Grid.Column="3"
                                                                              ItemsSource="{Binding AvailableSubCategories}"
                                                                              SelectedItem="{Binding SubCategory}"
                                                                              Height="{StaticResource FormControlHeight}" Margin="0,0,6,0"/>
                                                                    <TextBlock Grid.Column="4" Text="组织形式：" VerticalAlignment="Center"/>
                                                                    <ComboBox Grid.Column="5"
                                                                              ItemsSource="{Binding Owner.OrganizationFormOptions}"
                                                                              SelectedItem="{Binding OrganizationForm}"
                                                                              Height="{StaticResource FormControlHeight}" Margin="0,0,6,0"/>
                                                                    <TextBlock Grid.Column="6" Text="备注：" VerticalAlignment="Center"/>
                                                                    <TextBox Grid.Column="7" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                                                             Height="{StaticResource FormControlHeight}"/>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </GroupBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </GroupBox>

                <!-- 4. 档案盒与落位 -->
                <GroupBox Header="4. 档案盒与落位" Padding="8,5">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="档案盒编号" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding PreviewArchiveSequenceNo, Mode=OneWay}" IsReadOnly="True"
                                     Height="{StaticResource FormControlHeight}" Margin="0,0,12,0" Background="#F9F9F9"
                                     ToolTip="确认写入前预览，不占用号段"/>
                            <TextBlock Grid.Column="2" Text="盒规格" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Grid.Column="3" ItemsSource="{Binding Specs}" SelectedItem="{Binding SelectedSpec}"
                                      Height="{StaticResource FormControlHeight}"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="资料档口" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding SlotOptions}" SelectedItem="{Binding SelectedSlotOption}"
                                      DisplayMemberPath="DisplayText" Height="{StaticResource FormControlHeight}" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="刷新档口" Command="{Binding RefreshSlotOptionsCommand}"
                                    Style="{StaticResource InlineActionButtonStyle}"/>
                            <Button Grid.Column="3" Content="推荐空位" Command="{Binding RecommendSlotCommand}"
                                    Style="{StaticResource InlineActionButtonStyle}"/>
                            <Button Grid.Column="4" Content="档口快照" Command="{Binding ShowSlotSnapshotCommand}"
                                    Style="{StaticResource InlineActionButtonStyle}"/>
                        </Grid>
                        <TextBlock Text="{Binding BoxLocationPreview, Mode=OneWay}" Style="{StaticResource HintStyle}" Foreground="#00695C"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="盒备注" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                                     Height="{StaticResource FormControlHeight}"/>
                        </Grid>
                        <TextBlock Text="{Binding BusinessNumberHint, Mode=OneWay}" Style="{StaticResource HintStyle}" Foreground="#546E7A"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Page>
