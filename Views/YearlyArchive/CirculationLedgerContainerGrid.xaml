<local:LedgerGridHost x:Class="DocMgr.Views.YearlyArchive.CirculationLedgerContainerGrid"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:local="clr-namespace:DocMgr.Views.Shared"
                      xmlns:ya="clr-namespace:DocMgr.Views.YearlyArchive"
                      xmlns:shared="clr-namespace:DocMgr.Views.Shared">
    <local:LedgerGridHost.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CirculationLedgerGridResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <shared:BindingProxy x:Key="SelfProxy"/>
        </ResourceDictionary>
    </local:LedgerGridHost.Resources>
    <DataGrid               ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=ya:CirculationLedgerContainerGrid}}"
              SelectedItem="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ya:CirculationLedgerContainerGrid}, Mode=TwoWay}"
              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
              SelectionMode="Single" RowHeight="34" ColumnHeaderHeight="34"
              GridLinesVisibility="Horizontal" BorderThickness="0"
              RowStyle="{StaticResource CirculationLossHighlightRowStyle}"
              VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <DataGrid.Columns>
            <DataGridTextColumn Header="标记" Binding="{Binding LossMarkerDisplay, Mode=OneWay}" Width="64"
                                ElementStyle="{StaticResource CirculationLossMarkerTextStyle}"/>
            <DataGridTextColumn Width="120" Binding="{Binding ContainerCode, Mode=OneWay}"
                                Header="{Binding Data.CodeColumnHeader, Source={StaticResource SelfProxy}}"/>
            <DataGridTextColumn Header="年度" Binding="{Binding Year, Mode=OneWay}" Width="56"/>
            <DataGridTextColumn Header="项目" Binding="{Binding ProjectName, Mode=OneWay}" Width="140"/>
            <DataGridTextColumn Width="120" Binding="{Binding LocationDisplay, Mode=OneWay}"
                                Header="{Binding Data.LocationColumnHeader, Source={StaticResource SelfProxy}}"/>
            <DataGridTextColumn Header="容器状态" Binding="{Binding ContainerStatusDisplay, Mode=OneWay}" Width="72"/>
            <DataGridTextColumn Header="流转概况" Binding="{Binding ActivitySummary, Mode=OneWay}" Width="160"/>
            <DataGridTextColumn Header="最近活动" Binding="{Binding LatestOperatedAtDisplay, Mode=OneWay}" Width="128"/>
            <DataGridTextColumn Header="最近摘要" Binding="{Binding LatestTransactionTypeDisplay, Mode=OneWay}" Width="*"/>
        </DataGrid.Columns>
    </DataGrid>
</local:LedgerGridHost>
