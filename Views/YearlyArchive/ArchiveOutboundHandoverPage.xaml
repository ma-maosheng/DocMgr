<Page x:Class="DocMgr.Views.YearlyArchive.ArchiveOutboundHandoverPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:DocMgr.Views.YearlyArchive"
      Title="????"
      Background="#F0F2F5">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCardBorderStyle}" Margin="0" CornerRadius="0" Padding="16,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="????????????????????????"
                           Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Content="????" Command="{Binding ApproveCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="100" Margin="0,0,10,0"/>
                <Button Content="????" Command="{Binding RefreshCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="96"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="0,12,0,12" Padding="12" Background="#FFFDF7" BorderBrush="#E2C98F" BorderThickness="1">
            <TextBlock Text="{Binding PageTitle}" FontSize="20" FontWeight="Bold" Foreground="#6F4A00" HorizontalAlignment="Center"/>
        </Border>

        <Border Grid.Row="2" Background="White" Padding="10">
            <DataGrid AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      RowHeight="38"
                      ColumnHeaderHeight="40"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      ItemsSource="{Binding Records}"
                      SelectedItem="{Binding SelectedRecord}"
                      MouseDoubleClick="DgRecords_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="????" Binding="{Binding OutboundNo}" Width="160"/>
                    <DataGridTextColumn Header="????" Binding="{Binding MaterialSummary}" Width="*"/>
                    <DataGridTextColumn Header="???" Binding="{Binding ApplicantName}" Width="90"/>
                    <DataGridTextColumn Header="??" Binding="{Binding StatusStr}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Margin="0,8,0,0"
                Visibility="{Binding HasEditingViewModel, Converter={StaticResource BooleanToVisibilityConverter}}">
            <local:ArchiveOutboundApprovalPanel DataContext="{Binding EditingViewModel}"/>
        </Border>
    </Grid>
</Page>
