<Page x:Class="DocMgr.Views.YearlyArchive.ArchiveOutboundHandoverPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="资料出库"
      Background="#F0F2F5">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCardBorderStyle}" Margin="0" CornerRadius="0" Padding="16,12">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Button Content="打开出库" Command="{Binding OpenCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="96"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="状态:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="140"
                                  Style="{StaticResource ToolbarFilterComboBoxStyle}"
                                  ItemsSource="{Binding StatusFilterOptions}"
                                  SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="Label"
                                  ToolTip="{Binding StatusFilterTooltipTitle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="申请年度:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="100"
                                  Style="{StaticResource ToolbarFilterComboBoxStyle}"
                                  ItemsSource="{Binding YearOptions}"
                                  SelectedItem="{Binding SelectedYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="项目:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="160"
                                  Style="{StaticResource ToolbarFilterComboBoxStyle}"
                                  ItemsSource="{Binding ProjectOptions}"
                                  SelectedValue="{Binding SelectedProjectId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Name"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="申请人:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Grid>
                            <ToggleButton x:Name="ApplicantFilterButton"
                                          Width="160"
                                          Height="32"
                                          IsChecked="{Binding IsApplicantPopupOpen, Mode=TwoWay}">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="{Binding SelectedApplicantSummary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="▼" Margin="8,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Right"/>
                                </DockPanel>
                            </ToggleButton>
                            <Popup PlacementTarget="{Binding ElementName=ApplicantFilterButton}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   IsOpen="{Binding IsApplicantPopupOpen, Mode=TwoWay}">
                                <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="10" MinWidth="160">
                                    <StackPanel>
                                        <CheckBox Content="全部"
                                                  IsChecked="{Binding IsAllApplicantsSelected, Mode=TwoWay}"/>
                                        <Separator Margin="0,6,0,6"/>
                                        <ItemsControl ItemsSource="{Binding ApplicantOptions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Label}"
                                                              Margin="0,2,0,0"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="介质:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="120"
                                  Style="{StaticResource ToolbarFilterComboBoxStyle}"
                                  ItemsSource="{Binding MediaKindOptions}"
                                  SelectedItem="{Binding SelectedMediaKindOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="Label"/>
                    </StackPanel>

                    <Button Grid.Column="6"
                            Content="刷新列表"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource ToolbarActionButtonStyle}"
                            Width="96"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1" Margin="0,12,0,12" Padding="12" Background="#E8F5E9" BorderBrush="#81C784" BorderThickness="1">
            <TextBlock Text="资料出库（实物交接与办结）" FontSize="20" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Center"/>
        </Border>

        <Border Grid.Row="2" Background="White" Padding="10">
            <DataGrid AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      RowHeight="38"
                      ColumnHeaderHeight="40"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      ItemsSource="{Binding Records}"
                      SelectedItem="{Binding SelectedRecord}"
                      MouseDoubleClick="DgRecords_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="申请单号" Binding="{Binding OutboundNo}" Width="160"/>
                    <DataGridTextColumn Header="项目" Binding="{Binding ProjectName}" Width="140"/>
                    <DataGridTextColumn Header="资料摘要" Binding="{Binding MaterialSummary}" Width="*"/>
                    <DataGridTextColumn Header="介质" Binding="{Binding MediaKindSummary}" Width="90"/>
                    <DataGridTextColumn Header="申请人" Binding="{Binding ApplicantName}" Width="90"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusStr}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
