<Window x:Class="DocMgr.Views.YearlyArchive.ArchiveDisposalEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="1200"
        Height="820"
        MinWidth="1040"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F5">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="DisposalSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="DisposalFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="DisposalFilterLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="DisposalCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="DisposalFooterButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogPrimaryActionButtonStyle}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="DisposalFooterDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogDangerActionButtonStyle}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="DisposalTransferButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarActionButtonStyle}">
            <Setter Property="Width" Value="82"/>
            <Setter Property="Height" Value="{StaticResource DialogFormControlHeight}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="16,14">
            <StackPanel>
                <TextBlock Text="{Binding WindowTitle, Mode=OneWay}"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#37474F"/>
                <TextBlock Text="{Binding BannerText, Mode=OneWay}"
                           Margin="0,6,0,0"
                           Foreground="#546E7A"
                           FontSize="12"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 处置信息 -->
            <Border Grid.Row="0" Style="{StaticResource DisposalCardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="处置信息" Style="{StaticResource DisposalSectionTitleStyle}"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="申请人" Style="{StaticResource DisposalFieldLabelStyle}"/>
                            <TextBox Text="{Binding ApplicantName, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Background="#F9FAFB"
                                     Height="{StaticResource DialogFormControlHeight}"
                                     Padding="8,0"
                                     VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="申请部门" Style="{StaticResource DisposalFieldLabelStyle}"/>
                            <TextBox Text="{Binding ApplicantDept, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Background="#F9FAFB"
                                     Height="{StaticResource DialogFormControlHeight}"
                                     Padding="8,0"
                                     VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="申请说明 *" Style="{StaticResource DisposalFieldLabelStyle}"/>
                            <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanEditHeader, Mode=OneWay}"
                                     Height="44"
                                     Padding="8,6"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="备注" Style="{StaticResource DisposalFieldLabelStyle}"/>
                            <TextBox Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanEditHeader, Mode=OneWay}"
                                     Height="44"
                                     Padding="8,6"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 资料选取 -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="资料选取" Style="{StaticResource DisposalSectionTitleStyle}" Margin="0"/>
                    <TextBlock DockPanel.Dock="Right"
                               Text="按盘库中间态选取；移入后按原因带出默认处置方式，可勾选后批量赋值；提交后锁定关联介质"
                               Foreground="#64748B"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Column="0"
                            Grid.Row="0"
                            Grid.RowSpan="3"
                            Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="4"/>
                    <Border Grid.Column="2"
                            Grid.Row="0"
                            Grid.RowSpan="3"
                            Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="4"/>

                    <TextBlock Grid.Column="0"
                               Grid.Row="0"
                               Text="{Binding AvailableItemsTitle, Mode=OneWay}"
                               FontWeight="SemiBold"
                               Foreground="#37474F"
                               Margin="12,12,12,8"/>
                    <TextBlock Grid.Column="2"
                               Grid.Row="0"
                               Text="{Binding DisposalItemsTitle, Mode=OneWay}"
                               FontWeight="SemiBold"
                               Foreground="#37474F"
                               Margin="12,12,12,8"/>

                    <WrapPanel Grid.Column="0"
                               Grid.Row="1"
                               Margin="12,0,12,8"
                               IsEnabled="{Binding CanEditHeader, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                            <TextBlock Text="盘库类型" Style="{StaticResource DisposalFilterLabelStyle}"/>
                            <ComboBox Width="110"
                                      Height="{StaticResource DialogFormControlHeight}"
                                      VerticalContentAlignment="Center"
                                      ItemsSource="{Binding SourceRegisterKindFilterOptions}"
                                      SelectedItem="{Binding FilterSourceRegisterKind}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,12,6"
                                    Visibility="{Binding ShowMediumKindFilter, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="介质类别" Style="{StaticResource DisposalFilterLabelStyle}"/>
                            <ComboBox Width="96"
                                      Height="{StaticResource DialogFormControlHeight}"
                                      VerticalContentAlignment="Center"
                                      ItemsSource="{Binding MediumKindFilterOptions}"
                                      SelectedItem="{Binding FilterMediumKind}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                            <TextBlock Text="关键词" Style="{StaticResource DisposalFilterLabelStyle}"/>
                            <TextBox Width="140"
                                     Height="{StaticResource DialogFormControlHeight}"
                                     Padding="8,0"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding FilterKeyword, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <Button Content="清空筛选"
                                Command="{Binding ClearFiltersCommand}"
                                Style="{StaticResource ToolbarActionButtonStyle}"
                                Height="{StaticResource DialogFormControlHeight}"
                                Margin="0,0,0,6"
                                VerticalAlignment="Center"/>
                    </WrapPanel>

                    <StackPanel Grid.Column="2"
                                Grid.Row="1"
                                Margin="12,0,12,8"
                                IsEnabled="{Binding CanEditHeader, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="处置方式"
                                       Style="{StaticResource DisposalFilterLabelStyle}"/>
                            <ComboBox Width="140"
                                      Height="{StaticResource DialogFormControlHeight}"
                                      VerticalContentAlignment="Center"
                                      ItemsSource="{Binding DispositionMethodOptions}"
                                      SelectedItem="{Binding BatchDispositionMethod}"
                                      Margin="0,0,8,0"
                                      ToolTip="先勾选同一离库原因的待处置明细，再选择处置方式进行赋值"/>
                            <Button Content="赋值"
                                    Command="{Binding ApplyDispositionMethodCommand}"
                                    Style="{StaticResource ToolbarActionButtonStyle}"
                                    Height="{StaticResource DialogFormControlHeight}"
                                    ToolTip="将当前处置方式写入勾选的待处置明细（须同一离库原因）"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Grid.Row="0"
                                Grid.RowSpan="3"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                IsEnabled="{Binding CanEditHeader, Mode=OneWay}">
                        <Button Content="移入 ▶"
                                Command="{Binding MoveToDisposalCommand}"
                                Style="{StaticResource DisposalTransferButtonStyle}"
                                ToolTip="将左侧勾选资料移入待处置"/>
                        <Button Content="◀ 移出"
                                Command="{Binding MoveToAvailableCommand}"
                                Style="{StaticResource DisposalTransferButtonStyle}"
                                Margin="0"
                                ToolTip="将右侧勾选明细移回可选列表"/>
                    </StackPanel>

                    <DataGrid Grid.Column="0"
                              Grid.Row="2"
                              Margin="12,0,12,12"
                              ItemsSource="{Binding AvailableItems}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              SelectionMode="Extended"
                              IsReadOnly="False"
                              IsEnabled="{Binding CanEditHeader, Mode=OneWay}"
                              RowHeight="36">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="36"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding DisplayTitle, Mode=OneWay}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="盘库类型" Binding="{Binding SourceRegisterKind, Mode=OneWay}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="位置" Binding="{Binding BeforeStorageLocation, Mode=OneWay}" Width="120" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DataGrid Grid.Column="2"
                              Grid.Row="2"
                              Margin="12,0,12,12"
                              ItemsSource="{Binding Items}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              SelectionMode="Extended"
                              IsReadOnly="False"
                              IsEnabled="{Binding CanInteractItemsGrid, Mode=OneWay}"
                              RowHeight="36">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="36"/>
                            <DataGridTextColumn Header="序号" Binding="{Binding SortOrder, Mode=OneWay}" Width="40" IsReadOnly="True"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding DisplayTitle, Mode=OneWay}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="盘库类型" Binding="{Binding SourceRegisterKind, Mode=OneWay}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="原位置" Binding="{Binding BeforeStorageLocation, Mode=OneWay}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="处置方式" Binding="{Binding DispositionMethod, Mode=OneWay}" Width="80" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="空盘档口" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding TargetBlankSlotLocation, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding DataContext.CanEditBlankSlots, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                                 Visibility="{Binding IsFormatRetain, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 Height="28"
                                                 Padding="4,0"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="低格留盘办结前填写目标空盘档口（不做预占用）"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="推荐档口" Width="82">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="推荐"
                                                Command="{Binding DataContext.RecommendBlankSlotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ToolbarActionButtonStyle}"
                                                Height="{StaticResource DialogFormControlHeight}"
                                                MinWidth="56"
                                                Padding="6,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsFormatRetain, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                ToolTip="推荐空白硬盘专用档口（不做预占用）"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="档口快照" Width="82">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="快照"
                                                Command="{Binding DataContext.ShowBlankSlotSnapshotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ToolbarActionButtonStyle}"
                                                Height="{StaticResource DialogFormControlHeight}"
                                                MinWidth="56"
                                                Padding="6,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsFormatRetain, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                ToolTip="查看目标空盘档口占用快照"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>

            <!-- 审批与附件：左默认审批人 / 右附件 -->
            <Border Grid.Row="2" Style="{StaticResource DisposalCardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.35*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="默认审批人" Style="{StaticResource DisposalSectionTitleStyle}"/>
                        <TextBlock Text="线下签批参考（办结后重打将预填下列姓名）"
                                   Foreground="#64748B"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>
                        <Border Background="#FFF8E1"
                                BorderBrush="#FFE082"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="8,6"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                           Text="审核"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Margin="0,0,0,4"/>
                                <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,4" LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="资料室负责人"
                                               Style="{StaticResource DisposalFilterLabelStyle}"
                                               Width="84"/>
                                    <TextBlock Text="{Binding DefaultArchiveRoomHeadDisplay, Mode=OneWay}"
                                               VerticalAlignment="Center"
                                               Foreground="#1E293B"/>
                                </DockPanel>
                                <DockPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,4" LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="生产科负责人"
                                               Style="{StaticResource DisposalFilterLabelStyle}"
                                               Width="84"/>
                                    <TextBlock Text="{Binding DefaultProductionHeadDisplay, Mode=OneWay}"
                                               VerticalAlignment="Center"
                                               Foreground="#1E293B"/>
                                </DockPanel>
                                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                           Text="审批"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Margin="0,6,0,4"/>
                                <DockPanel Grid.Row="3" Grid.Column="0" LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="分管资料室副院长"
                                               Style="{StaticResource DisposalFilterLabelStyle}"
                                               Width="96"/>
                                    <TextBlock Text="{Binding DefaultArchiveDeputyPresidentDisplay, Mode=OneWay}"
                                               VerticalAlignment="Center"
                                               Foreground="#1E293B"/>
                                </DockPanel>
                                <DockPanel Grid.Row="3" Grid.Column="2" LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="分管生产副院长"
                                               Style="{StaticResource DisposalFilterLabelStyle}"
                                               Width="96"/>
                                    <TextBlock Text="{Binding DefaultProductionVicePresidentDisplay, Mode=OneWay}"
                                               VerticalAlignment="Center"
                                               Foreground="#1E293B"/>
                                </DockPanel>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="审批意见" Style="{StaticResource DisposalFilterLabelStyle}"/>
                            <TextBox Width="160"
                                     Height="{StaticResource DialogFormControlHeight}"
                                     Padding="8,0"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding ApprovalOpinion, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanApprove, Mode=OneWay}"/>
                        </StackPanel>
                        <WrapPanel>
                            <CheckBox Content="已确认空盒/空袋物理移除"
                                      Margin="0,0,12,0"
                                      IsChecked="{Binding PhysicalRemovalConfirmed, Mode=TwoWay}"
                                      Visibility="{Binding ShowPhysicalRemovalConfirm, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      VerticalAlignment="Center"/>
                            <CheckBox Content="已确认硬盘低级格式化"
                                      IsChecked="{Binding FormatRetainedConfirmed, Mode=TwoWay}"
                                      Visibility="{Binding ShowFormatRetainConfirm, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      VerticalAlignment="Center"/>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="附件" Style="{StaticResource DisposalSectionTitleStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="上传分类" Style="{StaticResource DisposalFilterLabelStyle}"/>
                            <ComboBox Width="140"
                                      Height="{StaticResource DialogFormControlHeight}"
                                      VerticalContentAlignment="Center"
                                      ItemsSource="{Binding UploadCategoryOptions}"
                                      SelectedItem="{Binding UploadCategory}"
                                      Margin="0,0,8,0"/>
                            <Button Content="上传附件"
                                    Command="{Binding UploadAttachmentCommand}"
                                    Style="{StaticResource ToolbarActionButtonStyle}"
                                    Height="{StaticResource DialogFormControlHeight}"/>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Attachments}"
                                  SelectedItem="{Binding SelectedAttachment}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  Height="168"
                                  RowHeight="38"
                                  ColumnHeaderHeight="36"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="分类" Binding="{Binding FileCategoryDisplay, Mode=OneWay}" Width="80"/>
                                <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="*"/>
                                <DataGridTextColumn Header="上传人" Binding="{Binding UploaderName}" Width="72"/>
                                <DataGridTextColumn Header="上传时间" Binding="{Binding UploadTime, StringFormat=yyyy-MM-dd HH:mm}" Width="120"/>
                                <DataGridTemplateColumn Header="操作" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="查看"
                                                        Command="{Binding DataContext.ViewAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource ToolbarActionButtonStyle}"
                                                        Height="{StaticResource DialogFormControlHeight}"
                                                        MinWidth="52"
                                                        Margin="0,0,6,0"/>
                                                <Button Content="删除"
                                                        Command="{Binding DataContext.DeleteAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource ToolbarDangerButtonStyle}"
                                                        Height="{StaticResource DialogFormControlHeight}"
                                                        MinWidth="52"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 底栏 -->
            <Border Grid.Row="3"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,8">
                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="保存草稿" Command="{Binding SaveDraftCommand}" Style="{StaticResource DisposalFooterButtonStyle}"/>
                    <Button Content="提交" Command="{Binding SubmitCommand}" Style="{StaticResource DisposalFooterButtonStyle}"/>
                    <Button Content="打印签批单" Command="{Binding PrintCommand}" Style="{StaticResource DisposalFooterButtonStyle}"/>
                    <Button Content="审批通过" Command="{Binding ApproveCommand}" Style="{StaticResource DisposalFooterButtonStyle}"/>
                    <Button Content="确认可上传" Command="{Binding ConfirmUploadCommand}" Style="{StaticResource DisposalFooterButtonStyle}"/>
                    <Button Content="办结" Command="{Binding CompleteCommand}" Style="{StaticResource DisposalFooterButtonStyle}"/>
                    <Button Content="撤回作废" Command="{Binding WithdrawCommand}" Style="{StaticResource DisposalFooterDangerButtonStyle}"/>
                    <Button Content="关闭" Command="{Binding CloseCommand}" Style="{StaticResource DisposalFooterButtonStyle}" Margin="0"/>
                </WrapPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
