<local:LedgerGridHost x:Class="DocMgr.Views.YearlyArchive.CirculationLedgerSubItemGrid"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:local="clr-namespace:DocMgr.Views.Shared"
                      xmlns:ya="clr-namespace:DocMgr.Views.YearlyArchive">
    <local:LedgerGridHost.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CirculationLedgerGridResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:LedgerGridHost.Resources>
    <DataGrid ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=ya:CirculationLedgerSubItemGrid}}"
              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
              SelectionMode="Single" RowHeight="34" ColumnHeaderHeight="34"
              GridLinesVisibility="Horizontal" BorderThickness="0"
              RowStyle="{StaticResource CirculationLossHighlightRowStyle}"
              VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <DataGrid.Columns>
            <DataGridTextColumn Header="标记" Binding="{Binding LossMarkerDisplay, Mode=OneWay}" Width="64"
                                ElementStyle="{StaticResource CirculationLossMarkerTextStyle}"/>
            <DataGridTextColumn Header="操作时间" Binding="{Binding OperatedAtDisplay, Mode=OneWay}" Width="128"/>
            <DataGridTextColumn Header="事件类型" Binding="{Binding CategoryDisplay, Mode=OneWay}" Width="80"/>
            <DataGridTextColumn Header="摘要" Binding="{Binding DetailDisplay, Mode=OneWay}" Width="180"/>
            <DataGridTextColumn Header="立档编号" Binding="{Binding FilingFactNo, Mode=OneWay}" Width="120"/>
            <DataGridTextColumn Header="资料名称" Binding="{Binding MaterialName, Mode=OneWay}" Width="120"/>
            <DataGridTextColumn Header="分项名称" Binding="{Binding ItemName, Mode=OneWay}" Width="100"/>
            <DataGridTextColumn Header="位置变更" Binding="{Binding LocationChangeDisplay, Mode=OneWay}" Width="140"/>
            <DataGridTextColumn Header="生命周期" Binding="{Binding LifecycleChangeDisplay, Mode=OneWay}" Width="88"/>
            <DataGridTextColumn Header="业务状态" Binding="{Binding OutboundStatusDisplay, Mode=OneWay}" Width="80"
                                ElementStyle="{StaticResource WorkflowStatusColumnTextStyle}"/>
            <DataGridTextColumn Header="使用方式" Binding="{Binding UsageModeDisplay, Mode=OneWay}" Width="72"/>
            <DataGridTextColumn Header="申请人" Binding="{Binding ApplicantName, Mode=OneWay}" Width="72"/>
            <DataGridTextColumn Header="操作人" Binding="{Binding OperatorName, Mode=OneWay}" Width="72"/>
            <DataGridTextColumn Header="备注" Binding="{Binding Remark, Mode=OneWay}" Width="*"/>
        </DataGrid.Columns>
    </DataGrid>
</local:LedgerGridHost>
