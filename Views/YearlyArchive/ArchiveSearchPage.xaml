<Page x:Class="DocMgr.Views.YearlyArchive.ArchiveSearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DocMgr.Views.YearlyArchive"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="ArchiveSearchPage" Background="#F0F2F5">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. 顶部搜索栏 -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarCardBorderStyle}">
            <Border.Effect>
                <DropShadowEffect Color="#DDDDDD" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.5"/>
            </Border.Effect>

            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                <!-- 年份 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="年份:" VerticalAlignment="Center" Foreground="#666" Margin="0,0,5,0"/>
                    <!-- Change: Binding ItemsSource and SelectedItem -->
                    <ComboBox x:Name="CmbYear" Width="100" Style="{StaticResource ToolbarFilterComboBoxStyle}" VerticalContentAlignment="Center"
                              ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- 关键词 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="关键词:" VerticalAlignment="Center" Foreground="#666" Margin="0,0,5,0"/>
                    <!-- Change: Binding Text -->
                    <TextBox x:Name="TxtKeyword" Width="200" Style="{StaticResource SearchTextBoxStyle}"
                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="支持资料名称、单号、申请人、项目名称、提供单位"/>
                </StackPanel>

                <!-- 状态 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="状态:" VerticalAlignment="Center" Foreground="#666" Margin="0,0,5,0"/>
                    <!-- Change: Binding ItemsSource, DisplayMemberPath, SelectedValuePath, SelectedValue -->
                    <ComboBox x:Name="CmbStatus" Width="120" Style="{StaticResource ToolbarFilterComboBoxStyle}" VerticalContentAlignment="Center"
                              ItemsSource="{Binding StatusOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedStatusValue}"/>
                </StackPanel>

                <!-- 项目 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="项目:" VerticalAlignment="Center" Foreground="#666" Margin="0,0,5,0"/>
                    <ComboBox Width="220" Style="{StaticResource ToolbarFilterComboBoxStyle}" VerticalContentAlignment="Center"
                              ItemsSource="{Binding ProjectOptions}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedProjectId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                    <!-- 按钮组 -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <!-- Change: Binding Command -->
                        <Button x:Name="BtnSearch" Content="🔍 查询" Style="{StaticResource ToolbarActionButtonStyle}" 
                                Command="{Binding SearchCommand}"/>
                        <!-- Change: Binding Command -->
                        <Button x:Name="BtnReset" Content="重置" Margin="10,0,0,0"
                                Command="{Binding ResetCommand}"
                                Padding="15,6" Style="{StaticResource ToolbarActionButtonStyle}"/>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Border>

        <!-- 2. 数据列表 -->
        <Border Grid.Row="1" Background="White" CornerRadius="4" Padding="10">
            <Border.Effect>
                <DropShadowEffect Color="#DDDDDD" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.5"/>
            </Border.Effect>

            <!-- Change: Binding ItemsSource -->
            <DataGrid x:Name="DgRecords" AutoGenerateColumns="False" IsReadOnly="True" 
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="White" BorderThickness="0"
                  CanUserAddRows="False"
                  ItemsSource="{Binding SearchResults}"
                  SelectedItem="{Binding SelectedResult}"
                  MouseDoubleClick="DgRecords_MouseDoubleClick"
                  RowHeight="40">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridHeaderStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="Padding" Value="10,12"/>
                    </Style>

                    <Style TargetType="DataGridCell" BasedOn="{StaticResource StandardDataGridCellStyle}">
                        <Setter Property="Padding" Value="10,5"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="档案编号 (表单号)" Binding="{Binding FormNo}" Width="180" Foreground="#00695C"/>

                    <DataGridTextColumn Header="资料名称" Binding="{Binding MaterialName}" Width="*"/>
                    <DataGridTextColumn Header="所属项目" Binding="{Binding ProjectName}" Width="200"/>
                    <DataGridTextColumn Header="提供单位" Binding="{Binding ProvideUnit}" Width="150"/>
                    <DataGridTextColumn Header="申请人" Binding="{Binding ApplicantName}" Width="100"/>
                    <DataGridTextColumn Header="申请日期" Binding="{Binding CreatedDate, StringFormat=yyyy-MM-dd}" Width="110"/>
                    <DataGridTextColumn Header="登记状态" Binding="{Binding StatusStr}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="{Binding StatusColor}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="档案盒/介质袋编号" Binding="{Binding ArchiveBoxNos}" Width="180" Foreground="#004D40" FontWeight="Bold" />
                    <DataGridTextColumn Header="物理位置" Binding="{Binding ArchiveBoxLocations}" Width="140" Foreground="#1B5E20"/>
                    <DataGridTextColumn Header="立档状态" Binding="{Binding FilingStatusStr}" Width="110"/>

                    <DataGridTemplateColumn Header="操作" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="查看" Padding="10,4" Style="{StaticResource ButtonNormalStyle}"
                                        Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>