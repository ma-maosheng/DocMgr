<Window x:Class="DocMgr.Views.YearlyArchive.ArchiveOutboundHandoverAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="860"
        Height="680"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="14" Background="White" BorderBrush="#C8E6C9" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="{Binding WindowTitle}" FontSize="18" FontWeight="Bold" Foreground="#1B5E20"/>
                <TextBlock Text="{Binding HeaderText}" Margin="0,6,0,0" FontSize="14" Foreground="#2E7D32"/>
                <TextBlock Text="{Binding SubHeaderText}" Margin="0,4,0,0" Foreground="#666" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding IntroText}" Margin="0,10,0,0" Foreground="#555" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="0,12,0,12" Padding="12" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding GroupedItems}">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               Foreground="#2E7D32"
                                               Margin="0,10,0,6"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,8">
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="打印清单" Command="{Binding PrintCommand}" Padding="16,8" Margin="0,0,8,0"/>
            <Button Content="关闭" Command="{Binding CloseCommand}" Padding="16,8"/>
        </StackPanel>
    </Grid>
</Window>
