<Page x:Class="DocMgr.Views.YearlyArchive.ArchiveFilingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:DocMgr.Views.YearlyArchive"
      xmlns:viewShared="clr-namespace:DocMgr.Views.Shared"
      xmlns:vm="clr-namespace:DocMgr.ViewModels.YearlyArchive"
      xmlns:archive="clr-namespace:DocMgr.Models.YearlyArchive"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d"
      d:DesignHeight="1207.636"
      d:DesignWidth="1280"
      Title="档案资料立档"
      Loaded="Page_Loaded"
      d:DataContext="{d:DesignInstance Type=vm:ArchiveFilingViewModel, IsDesignTimeCreatable=False}">

    <Page.Resources>
        <DropShadowEffect x:Key="DefaultShadow" BlurRadius="8" ShadowDepth="2" Direction="315" Color="#CCCCCC" Opacity="0.4"/>
        <local:BoolToVisConverter x:Key="BoolToVisConverter"/>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}">
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource FormComboBoxStyle}">
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style x:Key="ArchiveFilingContentPathLineRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="ArchiveFilingContentPathPairPathTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="LineHeight" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="ArchiveFilingContentPathPairSummaryTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <!-- 第四步立档明细：子项名称约 30 字宽（300 DIP）；路径列加宽 -->
        <Style x:Key="ElectronicFilingDetailDataGridCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource StandardDataGridCellStyle}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style x:Key="ElectronicFilingDetailCellTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ElectronicFilingDetailCellTextBoxStyle" TargetType="TextBox">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="ElectronicFilingEditableStoragePathTextBoxStyle" TargetType="TextBox">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="Background" Value="#FFFBEB"/>
            <Setter Property="BorderBrush" Value="#F59E0B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ToolTip" Value="可编辑：请确认或修改立档后的目标存储路径"/>
        </Style>
        <Style x:Key="ElectronicFilingEditableStoragePathCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource ElectronicFilingDetailDataGridCellStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStoragePathEditable}" Value="True">
                    <Setter Property="Background" Value="#FFF7ED"/>
                    <Setter Property="BorderBrush" Value="#FDBA74"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Background="#F5F7FA">
        <TabControl Margin="10"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="{Binding SelectedTrackIndex, Mode=OneWay}"
                    SelectionChanged="ArchiveFilingTracks_SelectionChanged">
            <TabItem Header="{Binding SimulatedTrackTabHeader}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" Margin="0,0,10,0" CornerRadius="4" Effect="{StaticResource DefaultShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="模拟介质待立档池" FontSize="16" FontWeight="Bold" Foreground="#333"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="年度筛选:" Margin="0,0,10,0"/>
                                        <ComboBox Width="100"
                                                  ItemsSource="{Binding PendingYears}"
                                                  SelectedItem="{Binding SelectedPendingYear}"/>
                                        <Button Content="刷新"
                                                Margin="10,0,0,0"
                                                Padding="10,2"
                                                Command="{Binding RefreshPendingCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <ListView x:Name="LvSimulatedPendingRecords"
                                      Grid.Row="1"
                                      BorderThickness="0"
                                      SelectionMode="Extended"
                                      ItemsSource="{Binding SimulatedPendingRecords}"
                                      SelectionChanged="LvSimulatedPendingRecords_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="表单编号" Width="110" DisplayMemberBinding="{Binding FormNo}"/>
                                        <GridViewColumn Header="项目名称" Width="150" DisplayMemberBinding="{Binding ProjectName}"/>
                                        <GridViewColumn Header="资料名称" Width="120" DisplayMemberBinding="{Binding MaterialName}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <TextBlock Grid.Row="2"
                                       Text="提示：按住 Ctrl 或 Shift 可多选同一项目的记录。"
                                       Foreground="#888"
                                       FontSize="11"
                                       Padding="10"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="White" CornerRadius="4" Effect="{StaticResource DefaultShadow}">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <Border Padding="24">
                                <StackPanel>
                                    <TextBlock Text="模拟介质立档操作台" FontSize="20" FontWeight="Bold" Foreground="#1E88E5" Margin="0,0,0,20"/>

                                    <GroupBox Header="第一步：资料登记信息" Padding="15" Margin="0,0,0,20">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="项目名称：" Grid.Column="0" Margin="0,0,10,0"/>
                                            <Border Grid.Column="1" Background="#F9F9F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="2" Margin="0,0,20,0" Padding="6,4">
                                                <TextBlock Text="{Binding TargetProject}" TextWrapping="Wrap"/>
                                            </Border>
                                            <TextBlock Text="归属年度：" Grid.Column="2" Margin="0,0,10,0"/>
                                            <Border Grid.Column="3" Background="#F9F9F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="2" Padding="6,4">
                                                <TextBlock Text="{Binding TargetYear}" TextWrapping="Wrap"/>
                                            </Border>
                                        </Grid>
                                    </GroupBox>

                                    <GroupBox Header="资料子项列表：选择本次拟入盒内容" Padding="15" Margin="0,0,0,20">
                                        <StackPanel>
                                            <TextBlock Text="提示：可勾选本次需要归入当前档案盒的资料子项，完成一个档案盒后继续选择剩余子项即可。"
                                                        Foreground="#666"
                                                        Margin="0,0,0,10"
                                                        TextWrapping="Wrap"/>
                                            <viewShared:ItemDetailsPanelHeader DataContext="{Binding SimulatedRecordItemsPanel}" Margin="0,0,0,6"/>
                                            <DataGrid AutoGenerateColumns="False"
                                                       CanUserAddRows="False"
                                                       HeadersVisibility="Column"
                                                        HorizontalAlignment="Stretch"
                                                       ItemsSource="{Binding SimulatedRecordItemsPanel.PageItems}"
                                                       MinHeight="180">
                                                <DataGrid.Style>
                                                    <Style TargetType="DataGrid">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SimulatedRecordItemsPanel.IsExpanded}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.Style>
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource StandardDataGridRowStyle}">
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding ArchiveStatusText}" Value="已入盒"/>
                                                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Background" Value="#E8F5E9"/>
                                                            </MultiDataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding ArchiveStatusText}" Value="未入盒"/>
                                                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Background" Value="#FFF8E1"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.RowStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="选择" Width="60">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <CheckBox HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                           IsEnabled="{Binding CanSelect}"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="表单编号" Binding="{Binding FormNo}" Width="110" IsReadOnly="True"/>
                                                    <DataGridTextColumn Header="资料名称" Binding="{Binding MaterialName}" Width="160" IsReadOnly="True"/>
                                                    <DataGridTextColumn Header="介质类型" Binding="{Binding MediaType}" Width="100" IsReadOnly="True"/>
                                                    <DataGridTextColumn Header="子项类型" Binding="{Binding ItemType}" Width="80" IsReadOnly="True"/>
                                                    <DataGridTextColumn Header="内容说明" Binding="{Binding ContentDesc}" Width="*" IsReadOnly="True"/>
                                                    <DataGridTextColumn Header="数量" Binding="{Binding ContentCount}" Width="70" IsReadOnly="True"/>
                                                    <DataGridTextColumn Header="状态" Binding="{Binding ArchiveStatusText}" Width="80" IsReadOnly="True"/>
                                                    <DataGridTextColumn Header="所属档案盒" Binding="{Binding ArchiveSequenceNo}" Width="110" IsReadOnly="True"/>
                                                    <DataGridTextColumn Header="档口位置" Binding="{Binding ArchiveLocationCode}" Width="130" IsReadOnly="True"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <viewShared:ItemDetailsPanelPaginationBar DataContext="{Binding SimulatedRecordItemsPanel}"/>
                                        </StackPanel>
                                    </GroupBox>

                                    <GroupBox Header="选择立档方式" Padding="15" Margin="0,0,0,20">
                                        <StackPanel>
                                            <TextBlock Text="该项目当年已存在的档案盒：" Margin="0,0,0,5" FontWeight="Bold"/>
                                            <DataGrid Height="120"
                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="False"
                                                      IsReadOnly="True"
                                                      HeadersVisibility="Column"
                                                      SelectionMode="Single"
                                                       HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding ExistingBoxes}"
                                                      SelectedItem="{Binding SelectedExistingBox}">
                                                <DataGrid.Columns>
                                                     <DataGridTemplateColumn Header="选择" Width="60">
                                                         <DataGridTemplateColumn.CellTemplate>
                                                             <DataTemplate>
                                                                 <RadioButton HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              GroupName="ExistingArchiveBoxSelection"
                                                                              IsChecked="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                             </DataTemplate>
                                                         </DataGridTemplateColumn.CellTemplate>
                                                     </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="档案盒编号" Binding="{Binding ArchiveSequenceNo}" Width="100"/>
                                                    <DataGridTextColumn Header="位置编号" Binding="{Binding BoxLocationCode}" Width="120"/>
                                                    <DataGridTextColumn Header="规格" Binding="{Binding Specs}" Width="60"/>
                                                    <DataGridTextColumn Header="备注" Binding="{Binding Remarks}" Width="*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                                <RadioButton Content="新建档案盒"
                                                             GroupName="SimulatedMode"
                                                             IsChecked="{Binding IsNewBoxMode, Mode=TwoWay}"
                                                             FontSize="14"
                                                             FontWeight="Bold"
                                                             Margin="0,0,20,0"/>
                                                <RadioButton Content="并入选中档案盒"
                                                             GroupName="SimulatedMode"
                                                             IsChecked="{Binding IsAppendMode, Mode=OneWay}"
                                                             FontSize="14"
                                                             FontWeight="Bold"
                                                             IsEnabled="{Binding ExistingBoxes.Count, Converter={x:Static local:CountToBoolConverter.Instance}}"/>
                                                <TextBlock Margin="12,0,0,0"
                                                           Foreground="#4A5568"
                                                           FontSize="12"
                                                           Text="{Binding SelectedSimulatedAppendTargetHintText}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </GroupBox>

                                    <GroupBox Header="第二步：选择物理存放位置" Padding="12" Margin="0,0,0,16">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding SimulatedStepTwoLocationSelectorVisibility}">
                                                <TextBlock Text="档口编号："
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                                <ComboBox MinWidth="240"
                                                          Height="{StaticResource FormControlHeight}"
                                                          ItemsSource="{Binding SimulatedTargetLocationOptions}"
                                                          SelectedItem="{Binding SelectedSimulatedTargetLocationOption}"
                                                          DisplayMemberPath="DisplayText"
                                                          IsEnabled="{Binding IsSimulatedLocationEditable}"
                                                          VerticalAlignment="Center"/>
                                                <Button Width="120"
                                                        Margin="10,0,0,0"
                                                        Content="建议档口位置"
                                                        Command="{Binding SuggestSimulatedLocationCommand}"
                                                        IsEnabled="{Binding IsSimulatedLocationEditable}"
                                                        Style="{StaticResource FormInlineButtonStyle}"/>
                                                <Button Width="120"
                                                        Margin="10,0,0,0"
                                                        Content="档口占用快照"
                                                        Command="{Binding ShowSimulatedSlotSnapshotCommand}"
                                                        IsEnabled="{Binding CanShowSimulatedSlotSnapshot}"
                                                        Style="{StaticResource FormInlineButtonStyle}"/>
                                            </StackPanel>

                                            <Border Padding="10,8"
                                                    Background="#F8FAFC"
                                                    BorderBrush="#CBD5E1"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Visibility="{Binding SimulatedStepTwoAppendNoticeVisibility}">
                                                <TextBlock Foreground="#475569"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Text="当前场景为并档操作，无需选择新的档案盒物理存放位置。"/>
                                            </Border>
                                        </StackPanel>
                                    </GroupBox>

                                    <GroupBox Header="第三步：赋码与确认" Padding="12">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,15">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="10"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="档案盒编号："
                                                           Grid.Row="0"
                                                           Grid.Column="0"
                                                           Margin="0,0,10,0"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Left"/>
                                                <StackPanel Grid.Row="0"
                                                            Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            Margin="0,0,20,0"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            IsEnabled="{Binding IsSimulatedArchiveFieldsEditable}">
                                                    <TextBox Width="140"
                                                             Height="{StaticResource FormControlHeight}"
                                                             FontWeight="Bold"
                                                             FontSize="14"
                                                             Text="{Binding ArchiveSequenceNo}"
                                                             IsReadOnly="{Binding IsAppendMode}"/>
                                                    <Button Content="自动生成"
                                                            Margin="6,0,0,0"
                                                            Style="{StaticResource FormInlineButtonStyle}"
                                                            Command="{Binding GenSeqCommand}"/>
                                                </StackPanel>

                                                <TextBlock Text="物理盒号：" Grid.Row="0" Grid.Column="2" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding PhysicalCodeResult}" Grid.Row="0" Grid.Column="3" FontWeight="Bold" FontSize="14">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPhysicalCodeWarning}" Value="True">
                                                                    <Setter Property="Foreground" Value="Gray"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsPhysicalCodeWarning}" Value="False">
                                                                    <Setter Property="Foreground" Value="#E91E63"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Text="档案盒规格：" Grid.Row="2" Grid.Column="0" Margin="0,0,10,0"/>
                                                <ComboBox Grid.Row="2" Grid.Column="1" Width="120" HorizontalAlignment="Left"
                                                          ItemsSource="{Binding Specs}"
                                                          SelectedItem="{Binding SelectedSpec}"
                                                           IsEnabled="{Binding IsSimulatedArchiveFieldsEditable}"/>

                                                <TextBlock Text="格内现有盒数：" Grid.Row="2" Grid.Column="2" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding CellCountText}" Grid.Row="2" Grid.Column="3" Foreground="Gray"/>
                                            </Grid>

                                            <TextBlock Text="备注：" Margin="0,0,0,5"/>
                                            <TextBox Text="{Binding Remarks}" AcceptsReturn="True" Height="80" TextWrapping="Wrap" IsReadOnly="{Binding IsAppendMode}"/>
                                        </StackPanel>
                                    </GroupBox>

                                    <Border Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,20,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SummaryText}" FontWeight="Bold" Foreground="#2D3748"/>
                                            <Button Content="执行模拟介质立档"
                                                    Width="180"
                                                    Margin="0,12,0,0"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource ToolbarActionButtonStyle}"
                                                    Command="{Binding SubmitCommand}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding ElectronicTrackTabHeader}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" Margin="0,0,10,0" CornerRadius="4" Effect="{StaticResource DefaultShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="电子介质待立档池" FontSize="16" FontWeight="Bold" Foreground="#333"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="年度筛选:" Margin="0,0,10,0"/>
                                        <ComboBox Width="100"
                                                  ItemsSource="{Binding PendingYears}"
                                                  SelectedItem="{Binding SelectedPendingYear}"/>
                                        <Button Content="刷新"
                                                Margin="10,0,0,0"
                                                Padding="10,2"
                                                Command="{Binding RefreshPendingCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <ListView x:Name="LvElectronicPendingRecords"
                                      Grid.Row="1"
                                      BorderThickness="0"
                                      SelectionMode="Extended"
                                      ItemsSource="{Binding ElectronicPendingRecords}"
                                      SelectionChanged="LvElectronicPendingRecords_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="表单编号" Width="110" DisplayMemberBinding="{Binding FormNo}"/>
                                        <GridViewColumn Header="项目名称" Width="150" DisplayMemberBinding="{Binding ProjectName}"/>
                                        <GridViewColumn Header="资料名称" Width="120" DisplayMemberBinding="{Binding MaterialName}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <TextBlock Grid.Row="2"
                                       Text="提示：电子介质立档将记录存放载体、路径和位置。"
                                       Foreground="#888"
                                       FontSize="11"
                                       Padding="10"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="White" CornerRadius="4" Effect="{StaticResource DefaultShadow}">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <Border Padding="24">
                                <StackPanel>
                                    <TextBlock Text="电子介质立档操作台" FontSize="20" FontWeight="Bold" Foreground="#1E88E5" Margin="0,0,0,20"/>

                                    <GroupBox Header="第一步：资料登记信息" Padding="15" Margin="0,0,0,20">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="申请单编号：" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Background="#F9F9F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="2" Margin="0,0,14,0" Padding="6,4">
                                                    <TextBlock Text="{Binding ElectronicApplicationFormNosText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                </Border>
                                                <TextBlock Text="项目名称：" Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <Border Grid.Column="3" Background="#F9F9F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="2" Margin="0,0,14,0" Padding="6,4">
                                                    <TextBlock Text="{Binding TargetProject}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                </Border>
                                                <TextBlock Text="归属年度：" Grid.Column="4" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <Border Grid.Column="5" Background="#F9F9F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="2" Padding="6,4">
                                                    <TextBlock Text="{Binding TargetYear}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                </Border>
                                            </Grid>

                                            <TextBlock Text="电子介质表单（单选当前立档介质）" Margin="0,0,0,8" FontWeight="Bold"/>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="3*"/>
                                                    <ColumnDefinition Width="1.4*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="当前" FontWeight="SemiBold" Foreground="#374151" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="电子介质表单" FontWeight="SemiBold" Foreground="#374151"/>
                                                <TextBlock Grid.Column="2" Text="处置方式" FontWeight="SemiBold" Foreground="#374151"/>
                                                <TextBlock Grid.Column="3" Text="介质编号" FontWeight="SemiBold" Foreground="#374151"/>
