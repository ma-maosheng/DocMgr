                                            <StackPanel Visibility="{Binding ElectronicStepFourNewBoxSectionVisibility}">
                                                <StackPanel Visibility="{Binding ExternalHardDiskRegistrationVisibility}">
                                                    <TextBlock Text="外来硬盘留存登记"
                                                               FontWeight="SemiBold"
                                                               Foreground="#2D3748"
                                                               Margin="0,0,0,6"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0"
                                                                Height="{StaticResource FormControlHeight}"
                                                                Margin="0,0,10,0"
                                                                Background="#F9F9F9"
                                                                BorderBrush="#E2E8F0"
                                                                BorderThickness="1"
                                                                CornerRadius="2"
                                                                Padding="6,4"
                                                                ToolTip="{Binding ExternalHardDiskRegistrationTooltip}">
                                                            <TextBlock Text="{Binding RegisteredExternalHardDiskCodeDisplay}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                        </Border>
                                                        <Button Grid.Column="1"
                                                                Style="{StaticResource FormInlineButtonStyle}"
                                                                Width="140"
                                                                Content="登记外来硬盘"
                                                                Command="{Binding RegisterExternalHardDiskCommand}"/>
                                                    </Grid>
                                                </StackPanel>

                                                <Border Margin="0,12,0,0"
                                                        Padding="10,8"
                                                        Background="#EDF7ED"
                                                        BorderBrush="#A5D6A7"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Visibility="{Binding ElectronicStepFourBorrowedDirectCompleteVisibility}">
                                                    <TextBlock Foreground="#2E7D32"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Text="申请单所载借出硬盘与所选资料室借出记录一致，本步无需新增外来硬盘登记，请继续第六步。"/>
                                                </Border>

                                                <Border Margin="0,12,0,0"
                                                        Padding="10,8"
                                                        Background="#F8FAFC"
                                                        BorderBrush="#CBD5E1"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Visibility="{Binding ElectronicStepFourGenericIdleVisibility}">
                                                    <TextBlock Foreground="#475569"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Text="本步无需执行外来硬盘新增登记，请继续第六步。"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </GroupBox>

                                    <GroupBox Header="第六步：外来硬盘格式化后物理存放位置" Padding="15" Margin="0,0,0,20">
                                        <StackPanel>
                                            <Border Padding="10,8"
                                                    Background="#F8FAFC"
                                                    BorderBrush="#CBD5E1"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Visibility="{Binding ExternalHardDiskFormattedBlankLocationVisibility}">
                                                <StackPanel>
                                                    <TextBlock Foreground="#475569"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding ExternalHardDiskFormattedBlankTargetHintText}"/>
                                                    <Grid Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0"
                                                                Height="{StaticResource FormControlHeight}"
                                                                Margin="0,0,10,0"
                                                                Background="#F9F9F9"
                                                                BorderBrush="#E2E8F0"
                                                                BorderThickness="1"
                                                                CornerRadius="2"
                                                                Padding="6,4">
                                                            <TextBlock Text="{Binding ExternalHardDiskFormattedBlankTargetLocation}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                        </Border>
                                                        <Button Grid.Column="1"
                                                                Style="{StaticResource FormInlineButtonStyle}"
                                                                Width="140"
                                                                Content="空白硬盘入库推荐档口"
                                                                Command="{Binding RecommendExternalHardDiskBlankTargetLocationCommand}"/>
                                                        <Button Grid.Column="2"
                                                                Style="{StaticResource FormInlineButtonStyle}"
                                                                Width="120"
                                                                Margin="10,0,0,0"
                                                                Content="档口占用快照"
                                                                Command="{Binding ShowExternalHardDiskBlankTargetSlotSnapshotCommand}"
                                                                IsEnabled="{Binding CanShowExternalHardDiskBlankTargetSlotSnapshot}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <Border Padding="10,8"
                                                    Background="#F8FAFC"
                                                    BorderBrush="#CBD5E1"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ExternalHardDiskFormattedBlankLocationVisibility}" Value="Visible">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Foreground="#475569"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Text="当前场景无需对外来硬盘执行格式化后空盘入库，请继续第七步。"/>
                                            </Border>
                                        </StackPanel>
                                    </GroupBox>

                                    <GroupBox Header="{Binding ElectronicStepSevenTitle}" Padding="12" Margin="0,0,0,16">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding ElectronicStepSevenLocationSelectorVisibility}">
                                                <TextBlock Text="档口编号："
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                                <ComboBox MinWidth="240"
                                                          Height="{StaticResource FormControlHeight}"
                                                          ItemsSource="{Binding ElectronicTargetLocationOptions}"
                                                          SelectedItem="{Binding SelectedElectronicTargetLocationOption}"
                                                          DisplayMemberPath="DisplayText"
                                                          IsEnabled="{Binding IsElectronicLocationEditable}"
                                                          VerticalAlignment="Center"
                                                          ToolTip="{Binding ElectronicLocationActionHintText}"/>
                                                <Button Width="120"
                                                        Margin="10,0,0,0"
                                                        Content="建议档口位置"
                                                        Command="{Binding SuggestElectronicLocationCommand}"
                                                        IsEnabled="{Binding IsElectronicStepSevenSuggestLocationEnabled}"
                                                        Style="{StaticResource FormInlineButtonStyle}"/>
                                                <Button Width="120"
                                                        Margin="10,0,0,0"
                                                        Content="档口占用快照"
                                                        Command="{Binding ShowElectronicSlotSnapshotCommand}"
                                                        IsEnabled="{Binding CanShowElectronicSlotSnapshot}"
                                                        Style="{StaticResource FormInlineButtonStyle}"/>
                                                <TextBlock Margin="12,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding ElectronicLocationSuggestionBrush}"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="280"
                                                           Text="{Binding ElectronicLocationSuggestionHint}"
                                                           Visibility="{Binding ElectronicLocationSuggestionHintVisibility}"/>
                                            </StackPanel>

                                            <Border Padding="10,8"
                                                    Background="#F8FAFC"
                                                    BorderBrush="#CBD5E1"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Visibility="{Binding ElectronicStepSevenAppendNoticeVisibility}">
                                                <TextBlock Foreground="#475569"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding ElectronicStepSevenAppendNoticeText}"/>
                                            </Border>
                                        </StackPanel>
                                    </GroupBox>

                                    <GroupBox Header="{Binding ElectronicStepEightTitle}" Padding="12" Margin="0,0,0,16">
                                        <StackPanel>
                                            <UniformGrid Columns="5" Margin="0,0,0,12">
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Margin="4,0">
                                                    <TextBlock Text="介质袋编号：" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <StackPanel Orientation="Horizontal"
                                                                VerticalAlignment="Center"
                                                                IsEnabled="{Binding IsElectronicArchiveFieldsEditable}">
                                                        <TextBox MinWidth="96"
                                                                
                                                                 FontWeight="Bold"
                                                                 FontSize="14"
                                                                 Text="{Binding ElectronicArchiveNo}"/>
                                                        <Button Content="自动生成"
                                                                Style="{StaticResource FormInlineButtonStyle}"
                                                                Margin="6,0,0,0"
                                                                Padding="10,0"
                                                                Command="{Binding GenSeqCommand}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Margin="4,0">
                                                    <TextBlock Text="物理位置：" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ElectronicStorageLocation}"
                                                               FontWeight="Bold"
                                                               FontSize="14"
                                                               Foreground="#E91E63"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="120"/>
                                                    <Button 
                                                            Margin="6,0,0,0"
                                                            Padding="8,0"
                                                            Content="档口占用快照"
                                                            Command="{Binding ShowElectronicSlotSnapshotCommand}"
                                                            IsEnabled="{Binding CanShowElectronicSlotSnapshot}"
                                                            Visibility="{Binding ElectronicStepEightSlotSnapshotVisibility}"
                                                            Style="{StaticResource FormInlineButtonStyle}"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Margin="4,0">
                                                    <TextBlock Text="格内现有袋数：" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ElectronicCellCountText}"
                                                               Foreground="Gray"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Margin="4,0">
                                                    <TextBlock Text="袋内载体：" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <Border MinWidth="56"
                                                            Height="{StaticResource FormControlHeight}"
                                                            Background="#F9F9F9"
                                                            BorderBrush="#E2E8F0"
                                                            BorderThickness="1"
                                                            CornerRadius="2"
                                                            Padding="6,4">
                                                        <TextBlock Text="{Binding ElectronicStorageCarrierType}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Margin="4,0">
                                                    <TextBlock Text="{Binding ElectronicMediaCountLabel}"
                                                               Margin="0,0,6,0"
                                                               VerticalAlignment="Center"/>
                                                    <Border MinWidth="40"
                                                            Height="{StaticResource FormControlHeight}"
                                                            Background="#F9F9F9"
                                                            BorderBrush="#E2E8F0"
                                                            BorderThickness="1"
                                                            CornerRadius="2"
                                                            Padding="6,4">
                                                        <TextBlock Text="{Binding ElectronicMediaCount}"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </StackPanel>
                                            </UniformGrid>

                                            <TextBlock Text="资料摘要：" Margin="0,0,0,4" Foreground="#4A5568" FontSize="12"/>
                                            <TextBox Text="{Binding ElectronicContentSummary}"
                                                     AcceptsReturn="True"
                                                     Height="72"
                                                     TextWrapping="Wrap"
                                                     Margin="0,0,0,10"/>

                                            <TextBlock Text="备注：" Margin="0,0,0,4" Foreground="#4A5568" FontSize="12"/>
                                            <TextBox Text="{Binding Remarks}"
                                                     AcceptsReturn="True"
                                                     Height="64"
                                                     TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </GroupBox>

                                    <Border Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,20,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SummaryText}" FontWeight="Bold" Foreground="#2D3748"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <Button Content="执行电子介质立档"
                                                        Width="220"
                                                        HorizontalAlignment="Left"
                                                        Style="{StaticResource ToolbarActionButtonStyle}"
                                                        Command="{Binding SubmitCommand}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>