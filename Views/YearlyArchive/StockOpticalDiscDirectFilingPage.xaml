<Page x:Class="DocMgr.Views.YearlyArchive.StockOpticalDiscDirectFilingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:viewShared="clr-namespace:DocMgr.Views.Shared"
      Title="存量光盘资料直办立档"
      Background="#F0F2F5">
    <Page.Resources>
        <viewShared:InverseBoolRadioConverter x:Key="InverseBoolRadioConverter"/>
        <viewShared:StringMatchRadioConverter x:Key="StringMatchRadioConverter"/>
        <viewShared:BoolToVisConverter x:Key="BoolToVisConverter"/>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Width" Value="112"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Foreground" Value="#37474F"/>
        </Style>
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="112,2,0,0"/>
        </Style>
        <Style x:Key="InlineActionButtonStyle" TargetType="Button" BasedOn="{StaticResource FormInlineButtonStyle}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="16,14"
                Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="{Binding PageTitle, Mode=OneWay}"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#37474F"/>
                <TextBlock Text="扫描光盘上的真实目录，由资料管理员指定年度、项目和资料子项后直接完成光盘登记与电子立档，无需申请审批。编目路径单独生成，不改写光盘目录。"
                           Margin="0,6,0,0"
                           FontSize="12"
                           Foreground="#546E7A"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding BusinessNumberHint, Mode=OneWay}"
                       VerticalAlignment="Center" FontSize="12" Foreground="#546E7A"
                       TextWrapping="Wrap" Margin="0,0,12,0"/>
            <Button Grid.Column="1" Content="确认立档" Command="{Binding ConfirmCommand}"
                    Padding="16,6" MinHeight="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </Grid>

        <GroupBox DockPanel.Dock="Bottom" Header="4. 立档默认值与档口" Padding="8,5" Margin="0,4,0,0">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="来源：" Style="{StaticResource LabelStyle}"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding SourceTypeOptions}"
                              SelectedItem="{Binding SourceType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Height="{StaticResource FormControlHeight}" Margin="0,0,12,0"
                              ToolTip="立档默认值：扫描子项时自动带入；子项可单独修改"/>
                    <TextBlock Grid.Column="2" Text="提供单位：" Style="{StaticResource LabelStyle}"/>
                    <Grid Grid.Column="3" Margin="0,0,12,0">
                        <ComboBox ItemsSource="{Binding Departments}"
                                  DisplayMemberPath="Name" SelectedValuePath="Name" IsEditable="True"
                                  SelectedValue="{Binding ProvideUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Height="{StaticResource FormControlHeight}"
                                  ToolTip="内部：可选当前部门或手输历史机构名；外来请改来源为「外来」后填写">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource FormComboBoxStyle}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExternalSource}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <TextBox Text="{Binding ProvideUnit, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource FormControlHeight}"
                                 ToolTip="外来资料的提供单位名称">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExternalSource}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                    <TextBlock Grid.Column="4" Text="库管模式：" Style="{StaticResource LabelStyle}"/>
                    <ComboBox Grid.Column="5" ItemsSource="{Binding ArchivePurposeOptions}" SelectedItem="{Binding ArchivePurpose}"
                              Height="{StaticResource FormControlHeight}"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="介质袋编号：" Style="{StaticResource LabelStyle}"/>
                    <TextBox Grid.Column="1" Text="{Binding PreviewElectronicArchiveNo, Mode=OneWay}" IsReadOnly="True"
                             Height="{StaticResource FormControlHeight}" Background="#F9F9F9" Margin="0,0,12,0"
                             ToolTip="确认写入前预览，不占用号段；年度取自「年度」"/>
                    <TextBlock Grid.Column="2" Text="物理位置编号：" Style="{StaticResource LabelStyle}"/>
                    <TextBox Grid.Column="3" Text="{Binding StorageLocation, Mode=OneWay}" IsReadOnly="True"
                             Height="{StaticResource FormControlHeight}" Background="#F9F9F9" Margin="0,0,12,0"
                             ToolTip="确认写入前预览，不占用号段"/>
                    <TextBlock Grid.Column="4" Text="数据档口：" Style="{StaticResource LabelStyle}"/>
                    <ComboBox Grid.Column="5" ItemsSource="{Binding SlotOptions}" SelectedItem="{Binding SelectedSlotOption}"
                              DisplayMemberPath="DisplayText" Height="{StaticResource FormControlHeight}" VerticalAlignment="Center"/>
                    <Button Grid.Column="6" Content="推荐空位" Command="{Binding RecommendSlotCommand}"
                            Style="{StaticResource InlineActionButtonStyle}"
                            ToolTip="推荐年度数据光盘专用档口空位（含档内序号，不预占用）"/>
                    <Button Grid.Column="7" Content="档口快照" Command="{Binding ShowSlotSnapshotCommand}"
                            Style="{StaticResource InlineActionButtonStyle}"
                            ToolTip="查看目标档口占用快照"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="96"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="1. 光盘身份" Padding="8,5" Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="登记方式：" Style="{StaticResource LabelStyle}"/>
                    <TextBox Grid.Column="1" Text="{Binding RegistrationMethod, Mode=OneWay}" IsReadOnly="True"
                             Height="{StaticResource FormControlHeight}" Background="#F9F9F9"
                             ToolTip="光盘没有单独盘面编号，立档后光盘编号与介质袋编号相同"/>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="2. 目录对照" Padding="8,5" Margin="0,0,0,4">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="资料所属目录：" Style="{StaticResource LabelStyle}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding RootPathOptions}"
                                  IsEditable="True"
                                  Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}"
                                  Height="{StaticResource FormControlHeight}"
                                  VerticalAlignment="Center"
                                  ToolTip="可选 D:\ 至 K:\，也可手输或通过「选择目录」指定资料所属目录"/>
                        <Button Grid.Column="2" Content="选择目录" Command="{Binding PickRootCommand}"
                                Style="{StaticResource InlineActionButtonStyle}"/>
                        <Button Grid.Column="3" Content="扫描" Command="{Binding ScanCommand}"
                                Style="{StaticResource InlineActionButtonStyle}"/>
                    </Grid>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="年度：" Style="{StaticResource LabelStyle}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding YearOptions}"
                                  IsEditable="True"
                                  Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}"
                                  Height="{StaticResource FormControlHeight}" Margin="0,0,12,0"
                                  ToolTip="开放域：列出已有年度；也可手输。不从光盘目录推断"/>
                        <TextBlock Grid.Column="2" Text="项目：" Style="{StaticResource LabelStyle}"/>
                        <ComboBox Grid.Column="3"
                                  ItemsSource="{Binding ProjectNameOptions}"
                                  IsEditable="True"
                                  Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                                  Height="{StaticResource FormControlHeight}" Margin="0,0,12,0"
                                  ToolTip="开放域：列出当前年度已登记项目；也可手输。一张光盘只登记一个项目"/>
                        <TextBlock Grid.Column="4" Text="项目编号：" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Column="5" Text="{Binding ProjectCode, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource FormControlHeight}"/>
                        <Button Grid.Column="6" Content="查看年度已有项目" Command="{Binding ViewYearProjectsCommand}"
                                Style="{StaticResource InlineActionButtonStyle}"
                                ToolTip="{Binding YearProjectHint, Mode=OneWay}"/>
                    </Grid>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="112,0,0,4">
                        <RadioButton Content="所属目录一个子项" GroupName="DiscAssignMode"
                                     IsChecked="{Binding AssignMode, Converter={StaticResource StringMatchRadioConverter}, ConverterParameter=WholeDisc, Mode=TwoWay}"
                                     VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <RadioButton Content="按文件夹指派" GroupName="DiscAssignMode"
                                     IsEnabled="{Binding CanAssignByFolder}"
                                     IsChecked="{Binding AssignMode, Converter={StaticResource StringMatchRadioConverter}, ConverterParameter=Folder, Mode=TwoWay}"
                                     VerticalAlignment="Center" Margin="0,0,16,0"
                                     ToolTip="把一级业务文件夹分别指派为资料子项"/>
                        <RadioButton Content="按后缀指派" GroupName="DiscAssignMode"
                                     IsEnabled="{Binding CanAssignByExtension}"
                                     IsChecked="{Binding AssignMode, Converter={StaticResource StringMatchRadioConverter}, ConverterParameter=Extension, Mode=TwoWay}"
                                     VerticalAlignment="Center" Margin="0,0,16,0"
                                     ToolTip="把资料所属目录及其子目录中的文件按后缀分成子项，再用资料名称归组"/>
                        <CheckBox Content="{Binding IgnoreConfirmText, Mode=OneWay}"
                                  IsChecked="{Binding IgnoredContentAcknowledged}"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding HasUnassignedContent, Converter={StaticResource BoolToVisConverter}}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="112,0,0,4"
                                Visibility="{Binding IsExtensionAssignMode, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="统计资料所属目录及其子目录中的文件。勾选纳入；资料名称相同的后缀归成一份资料，子项名就是后缀。"
                                   FontSize="12" Foreground="#546E7A" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="全选" Command="{Binding SelectAllExtensionsCommand}"
                                    Style="{StaticResource InlineActionButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="清空" Command="{Binding ClearExtensionsCommand}"
                                    Style="{StaticResource InlineActionButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="反选" Command="{Binding InvertExtensionsCommand}"
                                    Style="{StaticResource InlineActionButtonStyle}" Margin="0"/>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding ExtensionRows}" AutoGenerateColumns="False" IsReadOnly="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                                  MaxHeight="132" SelectionUnit="Cell"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="纳入" Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}" Width="52"/>
                                <DataGridTextColumn Header="后缀" Binding="{Binding ItemName, Mode=OneWay}" Width="90" IsReadOnly="True"/>
                                <DataGridTextColumn Header="文件数" Binding="{Binding FileCount, Mode=OneWay}" Width="70" IsReadOnly="True"/>
                                <DataGridTextColumn Header="数据量" Binding="{Binding DataSizeText, Mode=OneWay}" Width="90" IsReadOnly="True"/>
                                <DataGridTextColumn Header="资料名称" Binding="{Binding MaterialName, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="84"
                                  VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="{Binding YearProjectHint, Mode=OneWay}" Style="{StaticResource HintStyle}" Foreground="#546E7A"/>
                            <TextBlock Text="{Binding ProjectHint, Mode=OneWay}" Style="{StaticResource HintStyle}" Foreground="#00695C"/>
                            <TextBlock Text="{Binding ExistingBagHint, Mode=OneWay}" Style="{StaticResource HintStyle}" Foreground="#546E7A"/>
                            <TextBlock Text="{Binding ScanWarningText, Mode=OneWay}" Style="{StaticResource HintStyle}" Foreground="#C2410C"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="3. 扫描预览" Padding="8,5" Margin="0,0,0,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,4" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Content="全选" Command="{Binding SelectAllPreviewCommand}"
                                    Style="{StaticResource InlineActionButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="清空" Command="{Binding ClearPreviewCommand}"
                                    Style="{StaticResource InlineActionButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="反选" Command="{Binding InvertPreviewCommand}"
                                    Style="{StaticResource InlineActionButtonStyle}" Margin="0,0,12,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PreviewSummary, Mode=OneWay}"
                                   FontSize="12" Foreground="#546E7A" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                    <WrapPanel Grid.Row="2" Margin="0,4,0,0" VerticalAlignment="Center">
                        <TextBlock Text="来源：" VerticalAlignment="Center" Foreground="#37474F"/>
                        <ComboBox ItemsSource="{Binding SourceTypeOptions}"
                                  SelectedItem="{Binding BatchSourceType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Width="88" Height="{StaticResource FormControlHeight}" Margin="0,0,8,0"
                                  ToolTip="留空则批量赋值时不改各行来源"/>
                        <TextBlock Text="提供单位：" VerticalAlignment="Center" Foreground="#37474F"/>
                        <Grid Width="150" Margin="0,0,8,0">
                            <ComboBox ItemsSource="{Binding Departments}"
                                      DisplayMemberPath="Name" SelectedValuePath="Name" IsEditable="True"
                                      SelectedValue="{Binding BatchProvideUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Height="{StaticResource FormControlHeight}"
                                      ToolTip="留空则批量赋值时不改各行提供单位">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource FormComboBoxStyle}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBatchExternalSource}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                            <TextBox Text="{Binding BatchProvideUnit, UpdateSourceTrigger=PropertyChanged}"
                                     Height="{StaticResource FormControlHeight}"
                                     ToolTip="外来资料的提供单位。留空则不改各行">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBatchExternalSource}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                        <TextBlock Text="资料类型：" VerticalAlignment="Center" Foreground="#37474F"/>
                        <ComboBox ItemsSource="{Binding MaterialCategoryOptions}"
                                  SelectedItem="{Binding BatchMaterialCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Width="100" Height="{StaticResource FormControlHeight}" Margin="0,0,8,0"
                                  ToolTip="留空则批量赋值时不改各行资料类型"/>
                        <TextBlock Text="子类：" VerticalAlignment="Center" Foreground="#37474F"/>
                        <ComboBox ItemsSource="{Binding BatchSubCategoryOptions}"
                                  SelectedItem="{Binding BatchSubCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Width="120" Height="{StaticResource FormControlHeight}" Margin="0,0,8,0"
                                  ToolTip="随资料类型列出可选子类。留空则不改各行子类"/>
                        <TextBlock Text="密级：" VerticalAlignment="Center" Foreground="#37474F"/>
                        <ComboBox ItemsSource="{Binding ConfidentialLevelOptions}"
                                  SelectedItem="{Binding BatchConfidentialLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Width="88" Height="{StaticResource FormControlHeight}" Margin="0,0,8,0"
                                  ToolTip="留空则批量赋值时不改各行密级"/>
                        <Button Content="批量赋值" Command="{Binding ApplyPreviewBatchCommand}"
                                Style="{StaticResource InlineActionButtonStyle}" Margin="0"
                                ToolTip="把已填写的来源、提供单位、资料类型、子类、密级写入当前预览各行"/>
                    </WrapPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding PreviewRows}" AutoGenerateColumns="False" IsReadOnly="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                              SelectionUnit="Cell"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="纳入" Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}" Width="52"/>
                            <DataGridTextColumn Header="资料名称" Binding="{Binding MaterialName, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                            <DataGridTextColumn Header="子项" Binding="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                            <DataGridTextColumn Header="盘上目录" Binding="{Binding PhysicalPath, Mode=OneWay}" Width="2*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="编目路径" Binding="{Binding FilingStoragePath, Mode=OneWay}" Width="2*" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="来源" Width="72">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.SourceTypeOptions, RelativeSource={RelativeSource AncestorType=Page}}"
                                                  SelectedItem="{Binding SourceType, UpdateSourceTrigger=PropertyChanged}"
                                                  Height="{StaticResource FormControlHeight}" Margin="1"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="提供单位" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ComboBox ItemsSource="{Binding DataContext.Departments, RelativeSource={RelativeSource AncestorType=Page}}"
                                                      DisplayMemberPath="Name" SelectedValuePath="Name" IsEditable="True"
                                                      SelectedValue="{Binding ProvideUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Height="{StaticResource FormControlHeight}" Margin="1">
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox" BasedOn="{StaticResource FormComboBoxStyle}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExternalSource}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.Style>
                                            </ComboBox>
                                            <TextBox Text="{Binding ProvideUnit, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="{StaticResource FormControlHeight}" Margin="1">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExternalSource}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="资料类型" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.MaterialCategoryOptions, RelativeSource={RelativeSource AncestorType=Page}}"
                                                  SelectedItem="{Binding MaterialCategory, UpdateSourceTrigger=PropertyChanged}"
                                                  Height="{StaticResource FormControlHeight}" Margin="1"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="子类" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding AvailableSubCategories}"
                                                  SelectedItem="{Binding SubCategory, UpdateSourceTrigger=PropertyChanged}"
                                                  Height="{StaticResource FormControlHeight}" Margin="1"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="密级" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.ConfidentialLevelOptions, RelativeSource={RelativeSource AncestorType=Page}}"
                                                  SelectedItem="{Binding ConfidentialLevel, UpdateSourceTrigger=PropertyChanged}"
                                                  Height="{StaticResource FormControlHeight}" Margin="1"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="组织形式" Binding="{Binding OrganizationForm, Mode=OneWay}" Width="72" IsReadOnly="True"/>
                            <DataGridTextColumn Header="数据量" Binding="{Binding DataSizeText, Mode=OneWay}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="文件数" Binding="{Binding FileCount, Mode=OneWay}" Width="70" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
        </Grid>
    </DockPanel>
</Page>
