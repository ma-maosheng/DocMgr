<Page x:Class="DocMgr.Views.YearlyArchive.ArchiveFilingSearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:DocMgr.Views.YearlyArchive"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="1300"
      Title="ArchiveFilingSearchPage" Background="#F0F2F5">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:InverseBoolToVisConverter x:Key="InverseBoolToVisConverter"/>
        <Style x:Key="SearchFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="SearchFieldValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,20,6"/>
        </Style>
        <Style x:Key="SearchSubSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#546E7A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <DataTemplate x:Key="FiledArchiveSearchItemGroupTemplate">
            <Border Margin="0,0,0,6" Padding="8,6" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                                  IsChecked="{Binding Primary.IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsElectronicSearch}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                        <WrapPanel Grid.Column="1">
                            <TextBlock Text="表单号：" Style="{StaticResource SearchFieldLabelStyle}"/>
                            <TextBlock Text="{Binding Primary.FormNo}" Style="{StaticResource SearchFieldValueStyle}" Foreground="#00695C"/>
                            <TextBlock Text="所属项目：" Style="{StaticResource SearchFieldLabelStyle}"/>
                            <TextBlock Text="{Binding Primary.ProjectName}" Style="{StaticResource SearchFieldValueStyle}"/>
                            <TextBlock Text="资料名称：" Style="{StaticResource SearchFieldLabelStyle}"/>
                            <TextBlock Text="{Binding Primary.MaterialName}" Style="{StaticResource SearchFieldValueStyle}"/>
                            <TextBlock Text="库管模式：" Style="{StaticResource SearchFieldLabelStyle}"/>
                            <TextBlock Text="{Binding Primary.ArchivePurpose}" Style="{StaticResource SearchFieldValueStyle}"/>
                            <TextBlock Text="子项名称：" Style="{StaticResource SearchFieldLabelStyle}"/>
                            <TextBlock Text="{Binding Primary.ItemName}" Style="{StaticResource SearchFieldValueStyle}"/>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsElectronicSearch}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="介质类型：" Style="{StaticResource SearchFieldLabelStyle}"/>
                                <TextBlock Text="{Binding Primary.RegisterMediaType}" Style="{StaticResource SearchFieldValueStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="资料类型：" Style="{StaticResource SearchFieldLabelStyle}"/>
                                <TextBlock Text="{Binding Primary.MaterialCategory}" Style="{StaticResource SearchFieldValueStyle}"/>
                                <TextBlock Text="所属子类：" Style="{StaticResource SearchFieldLabelStyle}"/>
                                <TextBlock Text="{Binding Primary.SubCategory}" Style="{StaticResource SearchFieldValueStyle}"/>
                                <TextBlock Text="组织形式：" Style="{StaticResource SearchFieldLabelStyle}"/>
                                <TextBlock Text="{Binding Primary.DataOrganizationForm}" Style="{StaticResource SearchFieldValueStyle}"/>
                            </StackPanel>
                            <TextBlock Text="份数：" Style="{StaticResource SearchFieldLabelStyle}"/>
                            <TextBlock Text="{Binding Primary.FilingCopyCountDisplay}" Style="{StaticResource SearchFieldValueStyle}" Foreground="#1565C0"/>
                            <TextBlock Text="状态：" Style="{StaticResource SearchFieldLabelStyle}"/>
                            <TextBlock Text="{Binding Primary.LifecycleStatusDisplay, Mode=OneWay}" Style="{StaticResource SearchFieldValueStyle}" Foreground="#C62828" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding ShowArchiveContainerSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="档案盒/介质袋编号：" Style="{StaticResource SearchFieldLabelStyle}"/>
                                <TextBlock Text="{Binding Primary.ContainerCode}" Style="{StaticResource SearchFieldValueStyle}"/>
                                <TextBlock Text="立档位置：" Style="{StaticResource SearchFieldLabelStyle}"/>
                                <TextBlock Text="{Binding Primary.StorageLocation}" Style="{StaticResource SearchFieldValueStyle}"/>
                                <TextBlock Text="当前位置：" Style="{StaticResource SearchFieldLabelStyle}"/>
                                <TextBlock Text="{Binding Primary.CurrentStorageLocation}" Style="{StaticResource SearchFieldValueStyle}" Foreground="#1B5E20" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="关联介质：" Style="{StaticResource SearchFieldLabelStyle}"
                                       Visibility="{Binding IsElectronicSearch, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding Primary.LinkedMediumDisplay}" Style="{StaticResource SearchFieldValueStyle}"
                                       Visibility="{Binding IsElectronicSearch, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="立档日期：" Style="{StaticResource SearchFieldLabelStyle}"/>
                            <TextBlock Text="{Binding Primary.FiledAtDisplay}" Style="{StaticResource SearchFieldValueStyle}"/>
                        </WrapPanel>
                        <Button Grid.Column="2" Content="查看" Padding="8,3" Margin="8,0,0,0"
                                VerticalAlignment="Top" Style="{StaticResource ButtonNormalStyle}"
                                Command="{Binding ViewPrimaryDetailCommand}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                Visibility="{Binding HasBackups, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding BackupSummaryText}" Foreground="#666" VerticalAlignment="Center" FontSize="12"/>
                        <Button Content="{Binding ExpandToggleText}" Margin="8,0,0,0" Padding="6,2"
                                Style="{StaticResource ButtonNormalStyle}"
                                Command="{Binding ToggleExpandCommand}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                Visibility="{Binding CanExpandContentEntries, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding ContentSummaryText}" Foreground="#666" VerticalAlignment="Center" FontSize="12"/>
                        <Button Content="{Binding ContentExpandToggleText}" Margin="8,0,0,0" Padding="6,2"
                                Style="{StaticResource ButtonNormalStyle}"
                                Command="{Binding ToggleContentExpandCommand}"/>
                        <Button Content="全部选择" Margin="8,0,0,0" Padding="6,2"
                                Style="{StaticResource ButtonNormalStyle}"
                                Command="{Binding SelectAllContentEntriesCommand}"
                                Visibility="{Binding ShowContentEntrySelectionCommands, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Content="清空选择" Margin="6,0,0,0" Padding="6,2"
                                Style="{StaticResource ButtonNormalStyle}"
                                Command="{Binding ClearContentEntrySelectionCommand}"
                                Visibility="{Binding ShowContentEntrySelectionCommands, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Content="切换选择" Margin="6,0,0,0" Padding="6,2"
                                Style="{StaticResource ButtonNormalStyle}"
                                Command="{Binding ToggleContentEntrySelectionCommand}"
                                Visibility="{Binding ShowContentEntrySelectionCommands, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                    <StackPanel Margin="0,6,0,0"
                                Visibility="{Binding IsContentExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="118"/>
                                <ColumnDefinition Width="118"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="类型" FontWeight="SemiBold" Foreground="#546E7A" FontSize="12"/>
                            <TextBlock Grid.Column="2" Text="名称" FontWeight="SemiBold" Foreground="#546E7A" FontSize="12"/>
                            <TextBlock Grid.Column="3" Text="立档路径" FontWeight="SemiBold" Foreground="#546E7A" FontSize="12"/>
                            <TextBlock Grid.Column="4" Text="创建日期" FontWeight="SemiBold" Foreground="#546E7A" FontSize="12"/>
                            <TextBlock Grid.Column="5" Text="修改日期" FontWeight="SemiBold" Foreground="#546E7A" FontSize="12"/>
                            <TextBlock Grid.Column="6" Text="大小" FontWeight="SemiBold" Foreground="#546E7A" FontSize="12"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding ContentEntryRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,4" Padding="6,4" Background="#F3FAF8" CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="72"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="118"/>
                                                <ColumnDefinition Width="118"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding EntryKind}" VerticalAlignment="Center" Foreground="#00695C" FontSize="12"/>
                                            <TextBlock Grid.Column="2" Text="{Binding EntryName}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"/>
                                            <TextBlock Grid.Column="3" Text="{Binding FilingPath}" VerticalAlignment="Center" Foreground="#666" TextWrapping="Wrap" FontSize="12"/>
                                            <TextBlock Grid.Column="4" Text="{Binding CreatedDateText}" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
                                            <TextBlock Grid.Column="5" Text="{Binding ModifiedDateText}" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
                                            <TextBlock Grid.Column="6" Text="{Binding SizeText}" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Margin="0,6,0,0"
                                Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="副本角色" Style="{StaticResource SearchSubSectionHeaderStyle}" FontSize="12"/>
                            <TextBlock Grid.Column="2" Text="档案盒/介质袋编号" Style="{StaticResource SearchSubSectionHeaderStyle}" FontSize="12"/>
                            <TextBlock Grid.Column="3" Text="当前位置" Style="{StaticResource SearchSubSectionHeaderStyle}" FontSize="12"/>
                            <TextBlock Grid.Column="4" Text="状态" Style="{StaticResource SearchSubSectionHeaderStyle}" FontSize="12"/>
                            <TextBlock Grid.Column="5" Text="介质编号" Style="{StaticResource SearchSubSectionHeaderStyle}" FontSize="12"/>
                            <TextBlock Grid.Column="6" Text="操作" Style="{StaticResource SearchSubSectionHeaderStyle}" FontSize="12"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding BackupRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,4" Padding="6,4" Background="#F8FAFC" CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="72"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="72"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="64"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ArchiveCopyRoleDisplay}" VerticalAlignment="Center" Foreground="#00695C" FontSize="12"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ContainerCode}" VerticalAlignment="Center" FontSize="12"/>
                                            <TextBlock Grid.Column="3" Text="{Binding CurrentStorageLocation}" VerticalAlignment="Center" FontSize="12"/>
                                            <TextBlock Grid.Column="4" Text="{Binding LifecycleStatusDisplay, Mode=OneWay}" VerticalAlignment="Center" Foreground="#C62828" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Grid.Column="5" Text="{Binding MediumCode}" VerticalAlignment="Center" FontSize="12"/>
                                            <Button Grid.Column="6" Content="查看" Padding="6,2" Style="{StaticResource ButtonNormalStyle}"
                                                    Command="{Binding DataContext.ViewBackupDetailCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.15*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding PageTitle}" FontSize="17" FontWeight="SemiBold"
                   Foreground="#004D40" Margin="0,0,0,6"/>

        <Border Grid.Row="1" Style="{StaticResource ToolbarCardBorderStyle}" Padding="10,8" Margin="0,0,0,8">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="年份:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox Width="100" Style="{StaticResource ToolbarFilterComboBoxStyle}" ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="15,0,16,0">
                        <TextBlock Text="项目:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox Width="220" Style="{StaticResource ToolbarFilterComboBoxStyle}" VerticalContentAlignment="Center"
                                  ItemsSource="{Binding ProjectOptions}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedProjectId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="关键词:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Width="180" Style="{StaticResource SearchTextBoxStyle}" Text="{Binding RegisterKeyword, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="表单号、资料名称、子项名称、提供单位等"/>
                    </StackPanel>


                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,16,0"
                            Visibility="{Binding IsElectronicSearch, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="条目类型:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox Width="100"
                              Style="{StaticResource ToolbarFilterComboBoxStyle}"
                              ItemsSource="{Binding ContentEntryKindOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedContentEntryKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,16,0"
                                Visibility="{Binding IsElectronicSearch, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="目录/文件名称:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Width="160" Style="{StaticResource SearchTextBoxStyle}"
                                 Text="{Binding ContentEntryKeyword, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="按目录/文件名称检索。支持通配符：* 任意字符，? 单字符；不含通配符时为包含匹配；\ 可转义 * ?"/>
                    </StackPanel>
                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                        <TextBlock Text="状态:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox Width="110" Style="{StaticResource ToolbarFilterComboBoxStyle}" ItemsSource="{Binding LifecycleStatusOptions}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedLifecycleStatus}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6" Orientation="Horizontal" Margin="20,0,16,0">
                        <Button Content="查询" Style="{StaticResource ToolbarActionButtonStyle}" Command="{Binding SearchCommand}"/>
                        <Button Content="重置" Margin="10,0,0,0" Style="{StaticResource ToolbarActionButtonStyle}" Command="{Binding ResetCommand}"/>
                        <Button Content="选中加入筛选池" Margin="40,0,0,0" Style="{StaticResource ToolbarActionButtonStyle}" Command="{Binding AddSelectedToPoolCommand}"/>
                        <Button Content="本页全部加入" Margin="10,0,0,0" Style="{StaticResource ToolbarActionButtonStyle}" Command="{Binding AddAllResultsToPoolCommand}"/>
                        <Button Content="检索池" Margin="40,0,0,0" Style="{StaticResource ToolbarActionButtonStyle}" Click="OpenSearchPool_Click"/>
                    </StackPanel>
                </Grid>




            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="4" Padding="8" Margin="0,0,0,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Foreground="#37474F" Margin="0,0,0,6">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="检索结果（按档案盒分组，展开后可批量选择盒内资料子项；子项下可展开备份副本）"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsElectronicSearch}" Value="True">
                                    <Setter Property="Text" Value="检索结果（默认折叠备份副本，按需展开）"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsElectronicSearch}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl ItemsSource="{Binding SearchResultBoxGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="10,8" BorderBrush="#B2DFDB" BorderThickness="1" CornerRadius="4" Background="#FAFFFE">
                                    <StackPanel>
                                        <WrapPanel Margin="0,0,0,4">
                                            <TextBlock Text="档案盒编号：" Style="{StaticResource SearchFieldLabelStyle}"/>
                                            <TextBlock Text="{Binding ArchiveSequenceNo}" Style="{StaticResource SearchFieldValueStyle}" Foreground="#004D40" FontWeight="SemiBold"/>
                                            <TextBlock Text="所属项目：" Style="{StaticResource SearchFieldLabelStyle}"/>
                                            <TextBlock Text="{Binding ProjectName}" Style="{StaticResource SearchFieldValueStyle}"/>
                                            <TextBlock Text="年度：" Style="{StaticResource SearchFieldLabelStyle}"/>
                                            <TextBlock Text="{Binding Year}" Style="{StaticResource SearchFieldValueStyle}"/>
                                            <TextBlock Text="立档位置：" Style="{StaticResource SearchFieldLabelStyle}"/>
                                            <TextBlock Text="{Binding StorageLocation}" Style="{StaticResource SearchFieldValueStyle}"/>
                                            <TextBlock Text="当前位置：" Style="{StaticResource SearchFieldLabelStyle}"/>
                                            <TextBlock Text="{Binding CurrentStorageLocation}" Style="{StaticResource SearchFieldValueStyle}" Foreground="#1B5E20" FontWeight="SemiBold"/>
                                            <TextBlock Text="盒状态：" Style="{StaticResource SearchFieldLabelStyle}"/>
                                            <TextBlock Text="{Binding ContainerLifecycleStatusDisplay, Mode=OneWay}" Style="{StaticResource SearchFieldValueStyle}" Foreground="#C62828" FontWeight="SemiBold"/>
                                            <TextBlock Text="规格：" Style="{StaticResource SearchFieldLabelStyle}"/>
                                            <TextBlock Text="{Binding Specifications}" Style="{StaticResource SearchFieldValueStyle}"/>
                                            <TextBlock Text="摆放方式：" Style="{StaticResource SearchFieldLabelStyle}"/>
                                            <TextBlock Text="{Binding PlacementModeDisplay}" Style="{StaticResource SearchFieldValueStyle}"/>
                                            <TextBlock Text="归档人：" Style="{StaticResource SearchFieldLabelStyle}"/>
                                            <TextBlock Text="{Binding ArchivedBy}" Style="{StaticResource SearchFieldValueStyle}"/>
                                            <TextBlock Text="归档时间：" Style="{StaticResource SearchFieldLabelStyle}"/>
                                            <TextBlock Text="{Binding ArchivedDateText}" Style="{StaticResource SearchFieldValueStyle}"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Remarks, StringFormat=备注：{0}}"
                                                   Style="{StaticResource SearchFieldValueStyle}" Margin="0,0,0,4"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding SummaryText}" Foreground="#666" VerticalAlignment="Center" FontSize="12"/>
                                            <Button Content="{Binding ExpandToggleText}" Margin="8,0,0,0" Padding="6,2"
                                                    Style="{StaticResource ButtonNormalStyle}"
                                                    Command="{Binding ToggleExpandCommand}"/>
                                            <Button Content="全部选择" Margin="8,0,0,0" Padding="6,2"
                                                    Style="{StaticResource ButtonNormalStyle}"
                                                    Command="{Binding SelectAllItemGroupsCommand}"
                                                    Visibility="{Binding ShowItemGroupSelectionCommands, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <Button Content="清空选择" Margin="6,0,0,0" Padding="6,2"
                                                    Style="{StaticResource ButtonNormalStyle}"
                                                    Command="{Binding ClearItemGroupSelectionCommand}"
                                                    Visibility="{Binding ShowItemGroupSelectionCommands, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <Button Content="切换选择" Margin="6,0,0,0" Padding="6,2"
                                                    Style="{StaticResource ButtonNormalStyle}"
                                                    Command="{Binding ToggleItemGroupSelectionCommand}"
                                                    Visibility="{Binding ShowItemGroupSelectionCommands, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,8,0,0"
                                                    Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="盒内资料子项" FontWeight="SemiBold" Foreground="#546E7A" Margin="0,0,0,6"/>
                                            <ItemsControl ItemsSource="{Binding ItemGroups}"
                                                          ItemTemplate="{StaticResource FiledArchiveSearchItemGroupTemplate}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsElectronicSearch}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl ItemsSource="{Binding SearchResultGroups}"
                                      ItemTemplate="{StaticResource FiledArchiveSearchItemGroupTemplate}"/>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Background="#E8F5E9" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="移出选中" Style="{StaticResource ToolbarActionButtonStyle}" Command="{Binding RemoveSelectedFromPoolCommand}"/>
                    <Button Content="清空筛选池" Margin="8,0,0,0" Style="{StaticResource ToolbarActionButtonStyle}" Command="{Binding ClearPoolCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding PoolSummary}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1B5E20"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="4" Background="White" CornerRadius="4" Padding="8" Margin="0,0,0,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="筛选池（当前会话）" FontWeight="SemiBold" Foreground="#37474F" Margin="0,0,0,6"/>
                <DataGrid AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"
                          ItemsSource="{Binding FilterPool}" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="34">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="选" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                        <DataGridTextColumn Header="表单号" Binding="{Binding FormNo}" Width="150"/>
                        <DataGridTextColumn Header="项目年度" Binding="{Binding ProjectYear}" Width="70"/>
                        <DataGridTextColumn Header="所属项目" Binding="{Binding ProjectName}" Width="140"/>
                        <DataGridTextColumn Header="资料名称" Binding="{Binding MaterialName}" Width="*"/>
                        <DataGridTextColumn Header="库管模式" Binding="{Binding ArchivePurpose}" Width="88"/>
                        <DataGridTextColumn Header="子项名称" Binding="{Binding ItemName}" Width="140"/>
                        <DataGridTextColumn Header="载体类型" Binding="{Binding RegisterMediaType}" Width="80"/>
                        <DataGridTextColumn Header="介质类型" Binding="{Binding StorageCarrierTypeDisplay}" Width="80">
                            <DataGridTextColumn.Visibility>
                                <Binding Path="DataContext.IsElectronicSearch" RelativeSource="{RelativeSource AncestorType=Page}" Converter="{StaticResource BooleanToVisibilityConverter}"/>
                            </DataGridTextColumn.Visibility>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="所在目录" Binding="{Binding FilingDirectoryDisplay}" Width="200">
                            <DataGridTextColumn.Visibility>
                                <Binding Path="DataContext.IsElectronicSearch" RelativeSource="{RelativeSource AncestorType=Page}" Converter="{StaticResource BooleanToVisibilityConverter}"/>
                            </DataGridTextColumn.Visibility>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="资料类型" Binding="{Binding MaterialCategory}" Width="72"/>
                        <DataGridTextColumn Header="所属子类" Binding="{Binding SubCategory}" Width="88"/>
                        <DataGridTextColumn Header="组织形式" Binding="{Binding DataOrganizationForm}" Width="72"/>
                        <DataGridTextColumn Header="份数" Width="70"
                                            Binding="{Binding RequestedCopyCount, UpdateSourceTrigger=LostFocus, Mode=TwoWay}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCopyCountEditable}" Value="False">
                                            <Setter Property="Text" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCopyCountEditable}" Value="False">
                                            <Setter Property="IsReadOnly" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="筛选范围" Binding="{Binding SelectionScopeDisplay}" Width="180">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="Foreground" Value="#00695C"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="密级" Binding="{Binding ConfidentialLevel}" Width="70"/>
                        <DataGridTextColumn Header="命中明细" Binding="{Binding MatchedContentEntrySummary}" Width="200">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="Foreground" Value="#00695C"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="数据量" Binding="{Binding DataSizeDisplay}" Width="90">
                            <DataGridTextColumn.Visibility>
                                <Binding Path="DataContext.IsElectronicSearch" RelativeSource="{RelativeSource AncestorType=Page}" Converter="{StaticResource BooleanToVisibilityConverter}"/>
                            </DataGridTextColumn.Visibility>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="档案盒/介质袋编号" Binding="{Binding ContainerCode}" Width="130"/>
                        <DataGridTextColumn Header="立档位置" Binding="{Binding StorageLocation}" Width="100"/>
                        <DataGridTextColumn Header="当前位置" Binding="{Binding CurrentStorageLocation}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#1B5E20"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="借出提示" Binding="{Binding BorrowHintDisplay}" Width="120"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding LifecycleStatusDisplay}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="5" Style="{StaticResource ToolbarCardBorderStyle}" Padding="10,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="结果集名称:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Width="180" Style="{StaticResource SearchTextBoxStyle}" Text="{Binding ResultSetName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="备注:" VerticalAlignment="Center" Margin="16,0,5,0"/>
                    <TextBox Width="160" Style="{StaticResource SearchTextBoxStyle}" Text="{Binding ResultSetRemarks, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="保存筛选池为结果集" Margin="16,0,0,0" Style="{StaticResource ToolbarActionButtonStyle}" Command="{Binding SaveResultSetCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding LastSaveResultSetNotice}" Foreground="#1B5E20" Margin="0,8,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasLastSaveResultSetNotice}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Page>
