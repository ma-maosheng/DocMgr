<local:LedgerGridHost x:Class="DocMgr.Views.YearlyArchive.CirculationLedgerBusinessGrid"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:local="clr-namespace:DocMgr.Views.Shared"
                      xmlns:ya="clr-namespace:DocMgr.Views.YearlyArchive">
    <local:LedgerGridHost.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CirculationLedgerGridResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:LedgerGridHost.Resources>
    <DataGrid ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=ya:CirculationLedgerBusinessGrid}}"
              SelectedItem="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ya:CirculationLedgerBusinessGrid}, Mode=TwoWay}"
              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
              SelectionMode="Single" RowHeight="34" ColumnHeaderHeight="34"
              GridLinesVisibility="Horizontal" BorderThickness="0"
              RowStyle="{StaticResource CirculationLossHighlightRowStyle}"
              VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <DataGrid.Columns>
            <DataGridTextColumn Header="标记" Binding="{Binding LossMarkerDisplay, Mode=OneWay}" Width="64"
                                ElementStyle="{StaticResource CirculationLossMarkerTextStyle}"/>
            <DataGridTextColumn Header="业务单" Binding="{Binding DisplayTitle, Mode=OneWay}" Width="220"/>
            <DataGridTextColumn Header="最近活动" Binding="{Binding LatestOperatedAtDisplay, Mode=OneWay}" Width="128"/>
            <DataGridTextColumn Header="明细数" Binding="{Binding SubItemCount, Mode=OneWay}" Width="56"/>
            <DataGridTextColumn Header="业务状态" Binding="{Binding OutboundStatusDisplay, Mode=OneWay}" Width="88"
                                ElementStyle="{StaticResource WorkflowStatusColumnTextStyle}"/>
            <DataGridTextColumn Header="申请人" Binding="{Binding ApplicantName, Mode=OneWay}" Width="72"/>
            <DataGridTextColumn Header="最近摘要" Binding="{Binding LatestSummary, Mode=OneWay}" Width="*"/>
        </DataGrid.Columns>
    </DataGrid>
</local:LedgerGridHost>
