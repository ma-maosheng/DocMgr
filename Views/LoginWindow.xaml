<Window x:Class="DocMgr.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:viewShared="clr-namespace:DocMgr.Views.Shared"
        Height="450" Width="800"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        FocusManager.FocusedElement="{Binding ElementName=TxtUsername}"
        InputLanguageManager.InputLanguage="en-US">

    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding LoginCommand}"/>
    </Window.InputBindings>

    <Border Background="White" CornerRadius="10"
            BorderBrush="#FF397E7A" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="关闭"
                    Command="{x:Static viewShared:ViewCommands.CloseCurrentView}"
                    Style="{StaticResource PageCloseButtonStyle}"
                    Margin="0,12,12,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"/>

            <Border Grid.Column="0" Background="#FF397E7A" CornerRadius="10,0,0,10">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="河北省第三测绘院" Foreground="White"
                                   FontSize="24" FontWeight="Bold" Margin="0,0,0,10"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="测绘资料管理系统" Foreground="#E0F2F1"
                                   FontSize="18" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding VersionDisplay, Mode=OneWay}"
                               Foreground="#B2DFDB"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,18"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" Margin="40" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="用户登录" FontSize="24" FontWeight="Bold" Foreground="#333" Margin="0,0,0,30" HorizontalAlignment="Center"/>

                    <TextBlock Text="账号" Foreground="#666" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtUsername"
                             Height="40" Padding="5,10" FontSize="14" Margin="0,0,0,15"
                             Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="密码" Foreground="#999" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="TxtPassword"
                                 PasswordChanged="TxtPassword_PasswordChanged"
                                 Height="40" Padding="5,10" FontSize="14" Margin="0,0,0,25"/>

                    <Button x:Name="BtnLogin" Content="登 录" Command="{Binding LoginCommand}"
                            IsEnabled="{Binding CanSubmitLogin}"
                            Height="45" FontSize="16" FontWeight="Bold"
                            Cursor="Hand" Style="{StaticResource ButtonNormalStyle}"/>

                    <TextBlock Text="{Binding InitializationStatus}"
                               Foreground="#888"
                               FontSize="12"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"/>

                    <Button Content="退出" Command="{Binding CancelCommand}" Margin="0,15,0,0"
                            Cursor="Hand" Style="{StaticResource ButtonNormalStyle}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>