<Window x:Class="DocMgr.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewShared="clr-namespace:DocMgr.Views.Shared"
        Height="572" Width="932"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        FocusManager.FocusedElement="{Binding ElementName=TxtUsername}"
        InputLanguageManager.InputLanguage="en-US"
        FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif">

    <Window.Resources>
        <SolidColorBrush x:Key="LoginMutedTextBrush" Color="#6B7C7A"/>
        <SolidColorBrush x:Key="LoginInputBorderBrush" Color="#B7CEC9"/>

        <Style x:Key="LoginCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#8A9A98"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8EFEE"/>
                                <Setter Property="Foreground" Value="#397E7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource LoginMutedTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- 内凹输入框：外圈暗边 + 内高光，形成下沉立体 -->
        <Style x:Key="LoginTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#F3F8F7"/>
            <Setter Property="BorderBrush" Value="{StaticResource LoginInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#397E7A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="8" Background="#D5E4E1" Padding="0,1,0,0">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#EAF3F1"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#397E7A"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8BB8B4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#F3F8F7"/>
            <Setter Property="BorderBrush" Value="{StaticResource LoginInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#397E7A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border CornerRadius="8" Background="#D5E4E1" Padding="0,1,0,0">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#EAF3F1"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#397E7A"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8BB8B4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 凸起主按钮：渐变顶光 + 投下阴影，按下时压扁 -->
        <Style x:Key="LoginPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Shadow"
                                    CornerRadius="8"
                                    Background="#1F4F4C"
                                    Opacity="0.28"
                                    Margin="0,3,0,-1"/>
                            <Border x:Name="Bd"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    BorderBrush="#4F9A95"
                                    SnapsToDevicePixels="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#4A9A94" Offset="0"/>
                                        <GradientStop Color="#397E7A" Offset="0.45"/>
                                        <GradientStop Color="#2F6B67" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6BB0AA"/>
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#56A8A1" Offset="0"/>
                                            <GradientStop Color="#3F8A85" Offset="0.45"/>
                                            <GradientStop Color="#336F6A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shadow" Property="Opacity" Value="0.12"/>
                                <Setter TargetName="Shadow" Property="Margin" Value="0,1,0,0"/>
                                <Setter TargetName="Bd" Property="Margin" Value="0,2,0,0"/>
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#2F6B67" Offset="0"/>
                                            <GradientStop Color="#255753" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shadow" Property="Opacity" Value="0"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#B7CEC9"/>
                                <Setter TargetName="Bd" Property="Background" Value="#A8C5C3"/>
                                <Setter Property="Foreground" Value="#F5FAF9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#397E7A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="White"
                                BorderBrush="#A8C5C3"
                                BorderThickness="1"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.12" Color="#1F4F4C"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8F3F2"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#397E7A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D5E8E6"/>
                                <Setter TargetName="Bd" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外层留白承载双层阴影 -->
    <Grid Margin="22">
        <!-- 底层软阴影（远处扩散） -->
        <Border CornerRadius="14" Background="#1F4F4C" Opacity="0.18" Margin="6,10,-2,-4"/>
        <!-- 主壳体：顶亮底暗描边，模拟斜切面 -->
        <Border CornerRadius="14"
                BorderThickness="1.5"
                SnapsToDevicePixels="True">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#E8F4F2" Offset="0"/>
                    <GradientStop Color="#9BBFBA" Offset="0.55"/>
                    <GradientStop Color="#6A908B" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="32"
                                  ShadowDepth="8"
                                  Direction="270"
                                  Opacity="0.35"
                                  Color="#143532"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧品牌区：径向高光形成体块感 -->
                <Border Grid.Column="0" CornerRadius="13,0,0,13" ClipToBounds="True">
                    <Grid>
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0.2,1">
                                    <GradientStop Color="#173E3B" Offset="0"/>
                                    <GradientStop Color="#2A6561" Offset="0.5"/>
                                    <GradientStop Color="#397E7A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border Opacity="0.55">
                            <Border.Background>
                                <RadialGradientBrush Center="0.28,0.22" GradientOrigin="0.28,0.22" RadiusX="0.75" RadiusY="0.55">
                                    <GradientStop Color="#66B5AE" Offset="0"/>
                                    <GradientStop Color="#00397E7A" Offset="1"/>
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- 右缘内阴影，与右侧表单形成交接纵深 -->
                        <Border HorizontalAlignment="Right" Width="18" Opacity="0.35">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#00173E3B" Offset="0"/>
                                    <GradientStop Color="#CC0F2E2B" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Canvas IsHitTestVisible="False" Opacity="0.12">
                            <Line X1="40" Y1="0" X2="40" Y2="560" Stroke="White" StrokeThickness="1"/>
                            <Line X1="90" Y1="0" X2="90" Y2="560" Stroke="White" StrokeThickness="1"/>
                            <Line X1="140" Y1="0" X2="140" Y2="560" Stroke="White" StrokeThickness="1"/>
                            <Line X1="190" Y1="0" X2="190" Y2="560" Stroke="White" StrokeThickness="1"/>
                            <Line X1="240" Y1="0" X2="240" Y2="560" Stroke="White" StrokeThickness="1"/>
                            <Line X1="290" Y1="0" X2="290" Y2="560" Stroke="White" StrokeThickness="1"/>
                            <Line X1="340" Y1="0" X2="340" Y2="560" Stroke="White" StrokeThickness="1"/>
                            <Line X1="390" Y1="0" X2="390" Y2="560" Stroke="White" StrokeThickness="1"/>
                            <Line X1="440" Y1="0" X2="440" Y2="560" Stroke="White" StrokeThickness="1"/>
                            <Line X1="0" Y1="60" X2="480" Y2="60" Stroke="White" StrokeThickness="1"/>
                            <Line X1="0" Y1="120" X2="480" Y2="120" Stroke="White" StrokeThickness="1"/>
                            <Line X1="0" Y1="180" X2="480" Y2="180" Stroke="White" StrokeThickness="1"/>
                            <Line X1="0" Y1="240" X2="480" Y2="240" Stroke="White" StrokeThickness="1"/>
                            <Line X1="0" Y1="300" X2="480" Y2="300" Stroke="White" StrokeThickness="1"/>
                            <Line X1="0" Y1="360" X2="480" Y2="360" Stroke="White" StrokeThickness="1"/>
                            <Line X1="0" Y1="420" X2="480" Y2="420" Stroke="White" StrokeThickness="1"/>
                            <Line X1="0" Y1="480" X2="480" Y2="480" Stroke="White" StrokeThickness="1"/>
                        </Canvas>

                        <Path Data="M 36,410 L 110,320 L 170,355 L 250,250 L 330,290 L 420,180"
                              Stroke="#A8D5D1"
                              StrokeThickness="1.5"
                              Opacity="0.32"
                              IsHitTestVisible="False"/>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="28,0">
                            <Ellipse Width="92" Height="92" Margin="0,0,0,18" HorizontalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.45" Color="#0D2A28"/>
                                </Ellipse.Effect>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="pack://application:,,,/Assets/institute-emblem.jpg"
                                                Stretch="UniformToFill"
                                                AlignmentX="Center"
                                                AlignmentY="Center"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="河北省第三测绘院"
                                       Foreground="White"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.35" Color="#0D2A28"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <Border Width="36" Height="3" CornerRadius="1.5"
                                    HorizontalAlignment="Center" Margin="0,14,0,14">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#66FFFFFF" Offset="0"/>
                                        <GradientStop Color="#E0F2F1" Offset="0.5"/>
                                        <GradientStop Color="#66FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock Text="测绘资料管理系统"
                                       Foreground="#D5EDEA"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="{Binding VersionDisplay, Mode=OneWay}"
                                   Foreground="#9EC9C5"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,22"/>
                    </Grid>
                </Border>

                <!-- 右侧：凹陷底 + 浮起登录卡片 -->
                <Border Grid.Column="1" CornerRadius="0,13,13,0" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#E8EFED" Offset="0"/>
                            <GradientStop Color="#F4F8F7" Offset="0.4"/>
                            <GradientStop Color="#DEE8E6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <Button Content="关闭"
                                Command="{x:Static viewShared:ViewCommands.CloseCurrentView}"
                                Style="{StaticResource LoginCloseButtonStyle}"
                                Margin="0,10,12,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Panel.ZIndex="2"/>

                        <!-- 浮起白卡片 -->
                        <Border Margin="28,40,28,36"
                                CornerRadius="14"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                MaxWidth="360"
                                HorizontalAlignment="Center">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#FFFFFF" Offset="0"/>
                                    <GradientStop Color="#D5E4E1" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#FFFFFF" Offset="0"/>
                                    <GradientStop Color="#F7FBFA" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24"
                                                  ShadowDepth="6"
                                                  Direction="270"
                                                  Opacity="0.22"
                                                  Color="#1F4F4C"/>
                            </Border.Effect>

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="28,26,28,24">
                                <StackPanel>
                                    <TextBlock Text="河北省第三测绘院"
                                               FontSize="12"
                                               Foreground="#8A9A98"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="欢迎登录"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Foreground="#1F3533"
                                               Margin="0,0,0,22"/>

                                    <TextBlock Text="账号" Style="{StaticResource LoginFieldLabelStyle}"/>
                                <TextBox x:Name="TxtUsername"
                                         Style="{StaticResource LoginTextBoxStyle}"
                                         Margin="0,0,0,14"
                                         InputMethod.PreferredImeState="Off"
                                         InputMethod.PreferredImeConversionMode="Alphanumeric"
                                         Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Text="密码" Style="{StaticResource LoginFieldLabelStyle}"/>
                                    <PasswordBox x:Name="TxtPassword"
                                                 Style="{StaticResource LoginPasswordBoxStyle}"
                                                 PasswordChanged="TxtPassword_PasswordChanged"
                                                 InputMethod.PreferredImeState="Off"
                                                 InputMethod.PreferredImeConversionMode="Alphanumeric"
                                                 Margin="0,0,0,22"/>

                                    <Button x:Name="BtnLogin"
                                            Content="登 录"
                                            Command="{Binding LoginCommand}"
                                            IsEnabled="{Binding CanSubmitLogin}"
                                            Style="{StaticResource LoginPrimaryButtonStyle}"/>

                                    <TextBlock Text="{Binding InitializationStatus}"
                                               Foreground="#8A9A98"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               Margin="0,14,0,0"/>

                                    <Button Content="退出"
                                            Command="{Binding CancelCommand}"
                                            Style="{StaticResource LoginSecondaryButtonStyle}"
                                            Margin="0,14,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
