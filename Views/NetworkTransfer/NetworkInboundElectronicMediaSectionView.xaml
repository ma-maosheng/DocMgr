<UserControl x:Class="DocMgr.Views.NetworkTransfer.NetworkInboundElectronicMediaSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../YearlyArchive/ArchiveRegisterResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <GroupBox Header="{Binding SectionHeader}" Margin="0,8,0,0" BorderBrush="#DDD" Padding="6">
        <StackPanel Margin="4">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="介质：" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="电子" Height="26" Margin="2,0" VerticalContentAlignment="Center" IsReadOnly="True" Background="#F5F5F5"/>
                <TextBlock Grid.Column="2" Text="类型：" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                <ComboBox Grid.Column="3" Margin="2,0" VerticalContentAlignment="Center"
                          ItemsSource="{Binding DataElectronicMediaTypeOptions}"
                          SelectedItem="{Binding SelectedElectronicMediaType}">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource ArchiveRegisterFormComboBoxStyle}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsElectronicMediaTypeEditable}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
                <TextBox Grid.Column="3" Margin="2,0" Height="26" VerticalContentAlignment="Center"
                         Text="{Binding SelectedElectronicMediaType, Mode=OneWay}" IsReadOnly="True" Background="#F5F5F5">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource ArchiveRegisterFormTextBoxStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsElectronicMediaTypeEditable}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <TextBlock Grid.Column="4" Text="数量：" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                <TextBox Grid.Column="5" Text="{Binding DataElectronicMediaCount, Mode=OneWay}" Height="26" Margin="2,0" VerticalContentAlignment="Center" IsReadOnly="True" Background="#F5F5F5"/>
                <TextBlock Grid.Column="6" Text="处置：" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                <ComboBox Grid.Column="7" Margin="2,0" VerticalContentAlignment="Center"
                          ItemsSource="{Binding DataElectronicDispositionOptions}"
                          SelectedItem="{Binding SelectedElectronicDisposition}">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource ArchiveRegisterFormComboBoxStyle}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsElectronicDispositionEditable}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
                <TextBox Grid.Column="7" Margin="2,0" Height="26" VerticalContentAlignment="Center"
                         Text="{Binding SelectedElectronicDisposition, Mode=OneWay}" IsReadOnly="True" Background="#F5F5F5">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource ArchiveRegisterFormTextBoxStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsElectronicDispositionEditable}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <Button Grid.Column="8"
                        Content="+ 添加资料介质（电子）"
                        Command="{Binding AddDataElectronicMediaEntryCommand}"
                        Padding="8,2">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanEditForm}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
            <ItemsControl ItemsSource="{Binding DataElectronicMediaView}" ItemTemplate="{StaticResource MediaEntryTemplate_DataElectronic}"/>
        </StackPanel>
    </GroupBox>
</UserControl>
