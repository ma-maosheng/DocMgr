<UserControl x:Class="DocMgr.Views.NetworkTransfer.NetworkInboundApprovalSectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DocMgr.Models.Shared"
             xmlns:viewShared="clr-namespace:DocMgr.Views.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../YearlyArchive/ArchiveRegisterResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <viewShared:ApprovalHandoverWorkspaceShell
        ShellKind="{x:Static models:ApprovalWorkflowShellKind.ApplicationHandover}"
        ShowTitleChrome="False"
        ShowFooterChrome="True">
        <viewShared:ApprovalHandoverWorkspaceShell.SignatureContent>
            <StackPanel>
                <DockPanel Margin="0,0,0,6" LastChildFill="False">
                    <Button DockPanel.Dock="Right" Content="回填默认审批信息"
                            Command="{Binding FillDefaultApprovalInfoCommand}"
                            Padding="10,4"
                            ToolTip="按当前用户与业务规则回填审批签字及资料交接默认值"/>
                </DockPanel>
                <viewShared:ApprovalSignatureCardsControl
                    ShowApprovalOpinion="False"
                    SignatureHintText="各节点仅需签字人与日期，无需签署具体意见。"/>
            </StackPanel>
        </viewShared:ApprovalHandoverWorkspaceShell.SignatureContent>

        <viewShared:ApprovalHandoverWorkspaceShell.SignatureExtraContent>
            <StackPanel>
                <Border Margin="0,0,0,8" Padding="8,6" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="3"
                        Visibility="{Binding CanEditApprovalPaths, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="审批通过前可补录本单统一服务器路径与资料路径（全部明细共用同一路径设置）。"
                                   Foreground="#92400E" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <DockPanel LastChildFill="True" Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="服务器路径" Width="72" VerticalAlignment="Center"
                                       Style="{StaticResource ArchiveRegisterApprovalInlineLabelStyle}"/>
                            <ComboBox Width="280" HorizontalAlignment="Left"
                                      Style="{StaticResource NetworkInboundApprovalPathComboBoxStyle}"
                                      ItemsSource="{Binding ApplicantServerPathOptions}"
                                      DisplayMemberPath="PathName"
                                      SelectedItem="{Binding SelectedServerPath, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <TextBlock Margin="72,0,0,6" Text="{Binding SelectedServerPathInfo, Mode=OneWay}"
                                   Foreground="#475569" FontSize="11" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="资料路径" VerticalAlignment="Center"
                                       Style="{StaticResource ArchiveRegisterApprovalInlineLabelStyle}"/>
                            <TextBox Grid.Column="1" Margin="0,0,8,0"
                                     Style="{StaticResource NetworkInboundApprovalPathTextBoxStyle}"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding CurrentRecord.MaterialPath, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2" Padding="8,2"
                                    Content="填入默认资料路径"
                                    Command="{Binding FillDefaultMaterialPathCommand}"/>
                        </Grid>
                        <TextBlock Margin="72,4,0,0" Foreground="#92400E" FontSize="11" TextWrapping="Wrap"
                                   Text="{Binding MaterialPathHint, Mode=OneWay}"/>
                    </StackPanel>
                </Border>

                <GroupBox Header="借出硬盘归位（资料入网后）" Margin="0,0,0,0" Padding="8"
                          Visibility="{Binding ShowReturnHardDiskApprovalSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="申请人声明随入网资料归还的借出硬盘，请为每块硬盘指定资料入网后的空白硬盘归位档口。"
                                   Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <DataGrid ItemsSource="{Binding ReturnHardDiskApprovalRows}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  MinHeight="88" MaxHeight="180"
                                  AlternatingRowBackground="#F8FAFC" RowHeight="36">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="硬盘编号" Binding="{Binding DiskCode, Mode=OneWay}" Width="110" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="空白硬盘归位档口" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                                          ItemsSource="{Binding SlotLocationOptions}"
                                                          SelectedItem="{Binding SelectedSlotLocationOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          DisplayMemberPath="DisplayText"
                                                          IsEnabled="{Binding DataContext.CanEditReturnHardDiskSlots, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <Button Grid.Column="1" Margin="8,0,0,0" Content="推荐档口" Padding="10,4"
                                                        Command="{Binding RecommendSlotLocationCommand}"
                                                        IsEnabled="{Binding DataContext.CanEditReturnHardDiskSlots, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        ToolTip="推荐归还硬盘目标空白档口（不预占用）"/>
                                                <Button Grid.Column="2" Margin="8,0,0,0" Content="档口快照" Padding="10,4"
                                                        Command="{Binding ShowSlotLocationSnapshotCommand}"
                                                        IsEnabled="{Binding CanShowSlotLocationSnapshot}"
                                                        ToolTip="查看目标空白档口占用快照"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </viewShared:ApprovalHandoverWorkspaceShell.SignatureExtraContent>

        <viewShared:ApprovalHandoverWorkspaceShell.MidStepExtraContent>
            <Border Style="{StaticResource ArchiveRegisterApprovalCompactStepCardStyle}"
                    IsEnabled="{Binding CanConfirmPhysicalHandover}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Text="资料交接" Style="{StaticResource ArchiveRegisterApprovalCompactStepTitleStyle}"/>
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <TextBlock Text="移交" Style="{StaticResource ArchiveRegisterApprovalInlineLabelStyle}"/>
                            <TextBox Width="90" Style="{StaticResource ArchiveRegisterApprovalCompactTextBoxStyle}"
                                     Text="{Binding Deliverer, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="日期" Style="{StaticResource ArchiveRegisterApprovalInlineLabelStyle}" Margin="8,0,4,0"/>
                            <DatePicker Style="{StaticResource ArchiveRegisterApprovalCompactDatePickerStyle}"
                                        SelectedDate="{Binding DeliverDate}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="资料员" Style="{StaticResource ArchiveRegisterApprovalInlineLabelStyle}"/>
                            <TextBox Width="90" Style="{StaticResource ArchiveRegisterApprovalCompactTextBoxStyle}"
                                     Text="{Binding Administrator, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="日期" Style="{StaticResource ArchiveRegisterApprovalInlineLabelStyle}" Margin="8,0,4,0"/>
                            <DatePicker Style="{StaticResource ArchiveRegisterApprovalCompactDatePickerStyle}"
                                        SelectedDate="{Binding AdminDate}"/>
                        </StackPanel>
                    </WrapPanel>
                </DockPanel>
            </Border>
        </viewShared:ApprovalHandoverWorkspaceShell.MidStepExtraContent>
    </viewShared:ApprovalHandoverWorkspaceShell>
</UserControl>
