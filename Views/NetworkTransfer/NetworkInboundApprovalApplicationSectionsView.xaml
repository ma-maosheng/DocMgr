<UserControl x:Class="DocMgr.Views.NetworkTransfer.NetworkInboundApprovalApplicationSectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nt="clr-namespace:DocMgr.Views.NetworkTransfer"
             xmlns:shared="clr-namespace:DocMgr.Views.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../YearlyArchive/ArchiveRegisterResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <Border Margin="0,0,0,12" Padding="10" Background="#EEF3F8" BorderBrush="#C5D3E0" BorderThickness="1">
            <TextBlock Text="以下为申请人提交信息（只读）。资料管理员可在「审批通过」前编辑各明细密级，以及本单服务器路径与资料路径；其余申请内容不可修改。"
                       Foreground="#475569" TextWrapping="Wrap"/>
        </Border>

        <GroupBox Header="1. 申请信息" Style="{StaticResource Level1GroupBoxStyle}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,6">
                    <TextBlock Text="申请人 / 部门 / 日期：" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                    <TextBlock Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}">
                        <Run Text="{Binding CurrentRecord.ApplicantName, Mode=OneWay}"/>
                        <Run Text="  ·  "/>
                        <Run Text="{Binding CurrentRecord.ApplicantDept, Mode=OneWay}"/>
                        <Run Text="  ·  "/>
                        <Run Text="{Binding CurrentRecord.ApplyTime, Mode=OneWay, StringFormat=yyyy-MM-dd}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,6">
                    <TextBlock Text="申请说明：" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                    <TextBlock Text="{Binding CurrentRecord.Reason, Mode=OneWay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,6">
                    <TextBlock Text="其他要求：" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                    <TextBlock Text="{Binding CurrentRecord.OtherRequests, Mode=OneWay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,6">
                    <TextBlock Text="证明材料：" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                    <TextBlock Text="{Binding ProofMaterialDisplay, Mode=OneWay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                            Visibility="{Binding ReturnBorrowedHardDiskWithInbound, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="硬盘随资料归还：" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                    <TextBlock Text="是（详见资料介质（电子）借出硬盘编号）" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Header="2. 资料信息" Style="{StaticResource Level1GroupBoxStyle}" Padding="10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="资料名称：" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                    <TextBlock Text="{Binding CurrentRecord.MaterialName, Mode=OneWay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}" TextWrapping="Wrap"/>
                </StackPanel>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,6">
                        <TextBlock Text="所属项目：" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                        <TextBlock Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}">
                            <Run Text="{Binding CurrentRecord.Year, Mode=OneWay}"/>
                            <Run Text="  ·  "/>
                            <Run Text="{Binding CurrentRecord.ProjectName, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,6">
                        <TextBlock Text="数据来源：" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                        <TextBlock Text="{Binding SourceKindDisplay, Mode=OneWay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,6">
                        <TextBlock Text="提供部门(单位)：" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                        <TextBlock Text="{Binding ProvideUnitDisplay, Mode=OneWay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                    </StackPanel>
                </Grid>

                <Border Margin="0,0,0,8" Padding="8,6" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="3"
                        Visibility="{Binding CanEditApprovalPaths, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="审批通过前可补录本单统一服务器路径与资料路径（全部明细共用）。"
                                   Foreground="#92400E" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="服务器路径：" VerticalAlignment="Center"
                                       Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                            <ComboBox Grid.Column="1" Margin="2,0"
                                      Style="{StaticResource NetworkInboundApprovalPathComboBoxStyle}"
                                      ItemsSource="{Binding ApplicantServerPathOptions}"
                                      DisplayMemberPath="PathName"
                                      SelectedItem="{Binding SelectedServerPath, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <TextBlock Margin="96,0,0,6" Foreground="#475569" FontSize="11" TextWrapping="Wrap"
                                   Text="{Binding SelectedServerPathInfo, Mode=OneWay}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="资料路径：" VerticalAlignment="Center"
                                       Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                            <TextBox Grid.Column="1" Margin="2,0"
                                     Style="{StaticResource NetworkInboundApprovalPathTextBoxStyle}"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding CurrentRecord.MaterialPath, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2" Margin="8,0,0,0" Padding="8,2"
                                    Content="填入默认资料路径"
                                    Command="{Binding FillDefaultMaterialPathCommand}"/>
                        </Grid>
                        <TextBlock Margin="96,4,0,0" Foreground="#64748B" FontSize="11" TextWrapping="Wrap"
                                   Text="{Binding MaterialPathHint, Mode=OneWay}"/>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,0,0,8">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanEditApprovalPaths}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="服务器路径：" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                        <TextBlock Text="{Binding SelectedServerPathInfo, Mode=OneWay}"
                                   Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="资料路径：" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                        <TextBlock Text="{Binding CurrentRecord.MaterialPath, Mode=OneWay}"
                                   Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <Grid Visibility="{Binding ShowExternalElectronicMediaSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <nt:NetworkInboundElectronicMediaSectionView DataContext="{Binding ElectronicMediaEditor}"/>
                </Grid>

                <Grid Visibility="{Binding ShowArchivedDataSourceSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <GroupBox Header="{Binding ArchivedDataSourceSectionTitle}" Margin="0,8,0,0" BorderBrush="#DDD" Padding="6">
                        <StackPanel Margin="4">
                        <TextBlock Text="电子检索集：" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                        <TextBlock Text="{Binding SelectedSearchResultSetSummary, Mode=OneWay}"
                                   Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8">
                            <Run Text="检索集编号："/>
                            <Run Text="{Binding CurrentRecord.SourceResultSetNo, Mode=OneWay}"/>
                        </TextBlock>

                        <TextBlock Text="检索集明细" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                        <shared:ArchiveSearchPoolItemGrid ItemsSource="{Binding ItemRows}"
                                                          AllowConfidentialLevelEdit="True"
                                                          ConfidentialLevelOptions="{Binding ConfidentialLevelOptions}"
                                                          CanEditConfidentialLevel="{Binding CanEditItemConfidentialLevel}"
                                                          BorderThickness="1"
                                                          MinHeight="160"
                                                          MaxHeight="280"
                                                          Margin="0,4,0,0"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
