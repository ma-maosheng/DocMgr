<Window x:Class="DocMgr.Views.NetworkTransfer.NetworkOnNetDisposalEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DocMgr.Models.Shared"
        xmlns:nt="clr-namespace:DocMgr.Views.NetworkTransfer"
        xmlns:viewShared="clr-namespace:DocMgr.Views.Shared"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="1200"
        Height="820"
        MinWidth="1040"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F0F2F5">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../YearlyArchive/ArchiveRegisterResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
      <viewShared:InverseBoolToVisConverter x:Key="InverseBoolToVisConverter"/>

      <Style x:Key="DisposalSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#1E293B"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
      </Style>
      <Style x:Key="DisposalFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FormFieldCaptionStyle}">
        <Setter Property="Foreground" Value="#64748B"/>
        <Setter Property="FontSize" Value="12"/>
      </Style>
      <Style x:Key="DisposalCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E0E0E0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <viewShared:ApprovalHandoverWorkspaceShell Margin="12"
                                             ShellKind="{x:Static models:ApprovalWorkflowShellKind.DisposalUnlockUpload}">
    <viewShared:ApprovalHandoverWorkspaceShell.HeaderContent>
      <StackPanel>
        <!-- 基本信息 -->
        <Border Style="{StaticResource DisposalCardBorderStyle}">
          <StackPanel>
            <TextBlock Text="基本信息" Style="{StaticResource DisposalSectionTitleStyle}"/>
            <DockPanel Margin="0,2">
              <TextBlock Text="处置单号："
                         Style="{StaticResource ArchiveRegisterFormLabelStyle}"
                         Width="{StaticResource FormLabelColumnWidth}"/>
              <TextBox Width="200" HorizontalAlignment="Left"
                       Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                       Text="{Binding DisposalNo, Mode=OneWay}" IsReadOnly="True" Background="#F5F5F5"/>
              <TextBlock Text="业务状态："
                         Style="{StaticResource ArchiveRegisterFormLabelStyle}"
                         Width="{StaticResource FormLabelColumnWidth}"
                         Margin="16,0,8,0"/>
              <TextBlock Text="{Binding StatusDisplay, Mode=OneWay}" VerticalAlignment="Center" Foreground="#1E293B"/>
            </DockPanel>
            <DockPanel Margin="0,6,0,0">
              <TextBlock Text="申请说明："
                         Style="{StaticResource ArchiveRegisterFormLabelStyle}"
                         Width="{StaticResource FormLabelColumnWidth}"
                         VerticalAlignment="Top" Margin="0,4,8,0"/>
              <TextBox Height="48" AcceptsReturn="True" TextWrapping="Wrap"
                       Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                       Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                       IsEnabled="{Binding CanEditHeader}"/>
            </DockPanel>
          </StackPanel>
        </Border>

        <!-- 处置明细 -->
        <Border Style="{StaticResource DisposalCardBorderStyle}">
          <StackPanel>
            <TextBlock Text="处置明细" Style="{StaticResource DisposalSectionTitleStyle}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <TextBlock Text="批量原因："
                         Style="{StaticResource ArchiveRegisterFormLabelStyle}"
                         Width="{StaticResource FormLabelColumnWidth}"/>
              <ComboBox Width="140"
                        Style="{StaticResource ArchiveRegisterFormComboBoxStyle}"
                        ItemsSource="{Binding ReasonOptions}"
                        SelectedItem="{Binding BatchReason, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding CanEditHeader}"
                        ToolTip="加入明细时写入；也可点「赋值」覆盖已选明细"/>
              <TextBlock Text="批量方式："
                         Style="{StaticResource ArchiveRegisterFormLabelStyle}"
                         Width="{StaticResource FormLabelColumnWidth}"
                         Margin="12,0,8,0"/>
              <ComboBox Width="140"
                        Style="{StaticResource ArchiveRegisterFormComboBoxStyle}"
                        ItemsSource="{Binding MethodOptions}"
                        SelectedItem="{Binding BatchMethod, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding CanEditHeader}"
                        ToolTip="加入明细时写入；也可点「赋值」覆盖已选明细"
                        Margin="0,0,12,0"/>
              <Button Content="赋值" Command="{Binding ApplyBatchToItemsCommand}" Padding="12,6" Margin="0,0,8,0"
                      ToolTip="将当前原因和方式写入全部已选明细"/>
              <Button Content="刷新候选" Command="{Binding RefreshCandidatesCommand}" Padding="12,6" Margin="0,0,8,0"/>
              <Button Content="查看详情" Command="{Binding ViewAssetDetailCommand}" Padding="12,6" Margin="0,0,8,0"/>
              <Button Content="加入明细" Command="{Binding AddSelectedCommand}" Padding="12,6"
                      ToolTip="将在网台账勾选项写入处置明细，并带入批量原因/方式"/>
            </StackPanel>

            <TextBlock Text="{Binding AvailableAssetsTitle, Mode=OneWay}" FontWeight="SemiBold" Foreground="#00796B" Margin="0,0,0,4"/>
            <nt:NetworkOnNetAssetDataGrid ItemsSource="{Binding AvailableAssets}"
                                          SelectedItem="{Binding SelectedAsset}"
                                          ViewDetailCommand="{Binding ViewAssetDetailCommand}"
                                          ShowSelectionColumn="True"
                                          Height="200"
                                          Margin="0,0,0,10"/>

            <TextBlock Text="{Binding SelectedItemsTitle, Mode=OneWay}" FontWeight="SemiBold" Foreground="#00796B" Margin="0,0,0,4"/>
            <nt:NetworkOnNetAssetDataGrid ItemsSource="{Binding Items}"
                                          SelectedItem="{Binding SelectedItem}"
                                          ViewDetailCommand="{Binding ViewAssetDetailCommand}"
                                          RemoveItemCommand="{Binding RemoveItemCommand}"
                                          ShowDisposalColumns="True"
                                          Height="280"
                                          MinHeight="220"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </viewShared:ApprovalHandoverWorkspaceShell.HeaderContent>

    <viewShared:ApprovalHandoverWorkspaceShell.SignatureContent>
      <viewShared:ApprovalSignatureCardsControl ShowApprovalOpinion="False"/>
    </viewShared:ApprovalHandoverWorkspaceShell.SignatureContent>
  </viewShared:ApprovalHandoverWorkspaceShell>
</Window>
