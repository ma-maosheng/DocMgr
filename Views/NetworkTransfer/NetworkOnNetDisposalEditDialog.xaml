<Window x:Class="DocMgr.Views.NetworkTransfer.NetworkOnNetDisposalEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle, Mode=OneWay}" Height="680" Width="920"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="保存草稿" Command="{Binding SaveDraftCommand}" Width="88" Margin="0,0,8,0"/>
      <Button Content="提交" Command="{Binding SubmitCommand}" Width="72" Margin="0,0,8,0"/>
      <Button Content="审批" Command="{Binding ApproveCommand}" Width="72" Margin="0,0,8,0"/>
      <Button Content="确认可上传" Command="{Binding ConfirmUploadCommand}" Width="100" Margin="0,0,8,0"/>
      <Button Content="办结" Command="{Binding CompleteCommand}" Width="72" Margin="0,0,8,0"/>
      <Button Content="关闭" Command="{Binding CloseCommand}" Width="72"/>
    </StackPanel>
    <ScrollViewer>
      <StackPanel>
        <TextBlock Text="{Binding StatusDisplay, Mode=OneWay}" Margin="0,0,0,8"/>
        <TextBox Text="{Binding DisposalNo}" IsReadOnly="True" Margin="0,0,0,8"/>
        <TextBox Text="{Binding Reason}" Height="40" AcceptsReturn="True" TextWrapping="Wrap" IsEnabled="{Binding CanEditHeader}" Margin="0,0,0,8" ToolTip="申请说明"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <ComboBox Width="140" ItemsSource="{Binding ReasonOptions}" SelectedItem="{Binding BatchReason}"/>
          <ComboBox Width="140" Margin="8,0" ItemsSource="{Binding MethodOptions}" SelectedItem="{Binding BatchMethod}"/>
          <Button Content="刷新候选" Command="{Binding RefreshCandidatesCommand}" Width="88" Margin="0,0,8,0"/>
          <Button Content="加入明细" Command="{Binding AddSelectedCommand}" Width="88"/>
        </StackPanel>
        <DataGrid ItemsSource="{Binding AvailableAssets}" Height="110" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,0,0,8">
          <DataGrid.Columns>
            <DataGridCheckBoxColumn Header="选" Binding="{Binding IsSelected}" Width="40"/>
            <DataGridTextColumn Header="候选在网对象" Binding="{Binding Display, Mode=OneWay}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
        <DataGrid ItemsSource="{Binding Items}" Height="160" AutoGenerateColumns="False" CanUserAddRows="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="编号" Binding="{Binding AssetNo, Mode=OneWay}" Width="120"/>
            <DataGridTextColumn Header="名称" Binding="{Binding AssetName, Mode=OneWay}" Width="140"/>
            <DataGridComboBoxColumn Header="原因" Width="120" ItemsSource="{Binding DataContext.ReasonOptions, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItemBinding="{Binding DisposalReason}"/>
            <DataGridComboBoxColumn Header="方式" Width="120" ItemsSource="{Binding DataContext.MethodOptions, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItemBinding="{Binding DispositionMethod}"/>
            <DataGridTemplateColumn Width="60">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Content="移除" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <TextBox Text="{Binding ApprovalOpinion}" Margin="0,8,0,8" ToolTip="审批意见"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <ComboBox Width="140" ItemsSource="{Binding UploadCategoryOptions}" SelectedItem="{Binding UploadCategory}"/>
          <Button Content="上传附件" Command="{Binding UploadAttachmentCommand}" Margin="8,0" Width="88"/>
        </StackPanel>
        <DataGrid ItemsSource="{Binding Attachments}" Height="90" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="分类" Binding="{Binding FileCategory, Mode=OneWay}" Width="100"/>
            <DataGridTextColumn Header="文件名" Binding="{Binding FileName, Mode=OneWay}" Width="*"/>
            <DataGridTemplateColumn Width="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Button Content="查看" Command="{Binding DataContext.ViewAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,4,0"/>
                    <Button Content="删除" Command="{Binding DataContext.DeleteAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
