<Window x:Class="DocMgr.Views.NetworkTransfer.NetworkOnNetDisposalEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nt="clr-namespace:DocMgr.Views.NetworkTransfer"
        Width="1200"
        Height="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F5F7FA">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../YearlyArchive/ArchiveRegisterResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="{Binding WindowTitle, Mode=OneWay}" FontSize="18" FontWeight="Bold"/>
      <TextBlock Text="在网数据处置：选择在网对象，填写原因与方式后提交；提交后打印签批单并线下签字，再审批办结。"
                 Margin="0,6,0,0" Foreground="#666" TextWrapping="Wrap"/>
    </StackPanel>

    <Border Grid.Row="1" BorderBrush="#D8E2EC" BorderThickness="1" CornerRadius="4" Background="White">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="10">
        <StackPanel Margin="12" Orientation="Vertical">

          <GroupBox Header="1. 基本信息" Style="{StaticResource Level1GroupBoxStyle}" Padding="10">
            <StackPanel>
              <DockPanel Margin="0,2">
                <TextBlock Text="处置单号" Width="110" VerticalAlignment="Center" Style="{StaticResource ArchiveRegisterFormLabelStyle}" HorizontalAlignment="Left"/>
                <TextBox Width="200" HorizontalAlignment="Left"
                         Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                         Text="{Binding DisposalNo, Mode=OneWay}" IsReadOnly="True" Background="#F5F5F5"/>
                <TextBlock Text="状态" Width="50" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource ArchiveRegisterFormLabelStyle}" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding StatusDisplay, Mode=OneWay}" VerticalAlignment="Center" Foreground="#1E293B"/>
              </DockPanel>
              <DockPanel Margin="0,6,0,0">
                <TextBlock Text="申请说明" Width="110" VerticalAlignment="Top" Margin="0,4,0,0" Style="{StaticResource ArchiveRegisterFormLabelStyle}" HorizontalAlignment="Left"/>
                <TextBox Height="48" AcceptsReturn="True" TextWrapping="Wrap"
                         Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                         Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding CanEditHeader}"/>
              </DockPanel>
            </StackPanel>
          </GroupBox>

          <GroupBox Header="2. 处置明细" Style="{StaticResource Level1GroupBoxStyle}" Padding="10">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="批量原因" Width="110" VerticalAlignment="Center" Style="{StaticResource ArchiveRegisterFormLabelStyle}" HorizontalAlignment="Left"/>
                <ComboBox Width="140"
                          Style="{StaticResource ArchiveRegisterFormComboBoxStyle}"
                          ItemsSource="{Binding ReasonOptions}"
                          SelectedItem="{Binding BatchReason, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding CanEditHeader}"
                          ToolTip="加入明细时写入；也可点「赋值」覆盖已选明细"/>
                <TextBlock Text="批量方式" Width="70" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource ArchiveRegisterFormLabelStyle}" HorizontalAlignment="Left"/>
                <ComboBox Width="140"
                          Style="{StaticResource ArchiveRegisterFormComboBoxStyle}"
                          ItemsSource="{Binding MethodOptions}"
                          SelectedItem="{Binding BatchMethod, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding CanEditHeader}"
                          ToolTip="加入明细时写入；也可点「赋值」覆盖已选明细"
                          Margin="0,0,12,0"/>
                <Button Content="赋值" Command="{Binding ApplyBatchToItemsCommand}" Padding="12,6" Margin="0,0,8,0"
                        ToolTip="将当前原因和方式写入全部已选明细"/>
                <Button Content="刷新候选" Command="{Binding RefreshCandidatesCommand}" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="查看详情" Command="{Binding ViewAssetDetailCommand}" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="加入明细" Command="{Binding AddSelectedCommand}" Padding="12,6"/>
              </StackPanel>

              <TextBlock Text="{Binding AvailableAssetsTitle, Mode=OneWay}" FontWeight="SemiBold" Foreground="#00796B" Margin="0,0,0,4"/>
              <nt:NetworkOnNetAssetDataGrid ItemsSource="{Binding AvailableAssets}"
                                            SelectedItem="{Binding SelectedAsset}"
                                            ViewDetailCommand="{Binding ViewAssetDetailCommand}"
                                            ShowSelectionColumn="True"
                                            Height="200"
                                            Margin="0,0,0,10"/>

              <TextBlock Text="{Binding SelectedItemsTitle, Mode=OneWay}" FontWeight="SemiBold" Foreground="#00796B" Margin="0,0,0,4"/>
              <nt:NetworkOnNetAssetDataGrid ItemsSource="{Binding Items}"
                                            SelectedItem="{Binding SelectedItem}"
                                            ViewDetailCommand="{Binding ViewAssetDetailCommand}"
                                            RemoveItemCommand="{Binding RemoveItemCommand}"
                                            ShowDisposalColumns="True"
                                            Height="180"/>
            </StackPanel>
          </GroupBox>

          <GroupBox Header="3. 审批办结" Style="{StaticResource Level1GroupBoxStyle}" Padding="10">
            <DockPanel>
              <TextBlock Text="审批意见" Width="110" VerticalAlignment="Center" Style="{StaticResource ArchiveRegisterFormLabelStyle}" HorizontalAlignment="Left"/>
              <TextBox Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                       Text="{Binding ApprovalOpinion, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
          </GroupBox>

          <GroupBox Header="4. 附件材料" Style="{StaticResource Level1GroupBoxStyle}" Padding="10">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="附件分类" Width="110" VerticalAlignment="Center" Style="{StaticResource ArchiveRegisterFormLabelStyle}" HorizontalAlignment="Left"/>
                <ComboBox Width="160"
                          Style="{StaticResource ArchiveRegisterFormComboBoxStyle}"
                          ItemsSource="{Binding UploadCategoryOptions}"
                          SelectedItem="{Binding UploadCategory}"/>
                <Button Content="上传附件" Command="{Binding UploadAttachmentCommand}" Margin="8,0,0,0" Padding="12,6"/>
              </StackPanel>
              <DataGrid ItemsSource="{Binding Attachments}" Height="110" AutoGenerateColumns="False"
                        IsReadOnly="True" HeadersVisibility="Column"
                        AlternatingRowBackground="#F8FAFC">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="分类" Binding="{Binding FileCategory, Mode=OneWay}" Width="100"/>
                  <DataGridTextColumn Header="文件名" Binding="{Binding FileName, Mode=OneWay}" Width="*"/>
                  <DataGridTemplateColumn Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                          <Button Content="查看" Padding="8,2" Margin="0,0,4,0"
                                  Command="{Binding DataContext.ViewAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                          <Button Content="删除" Padding="8,2"
                                  Command="{Binding DataContext.DeleteAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </GroupBox>

        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,10,0,0"
            BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Background="#FAFBFC">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button Content="保存草稿" Command="{Binding SaveDraftCommand}" Margin="0,0,8,0" Padding="12,6"/>
          <Button Content="提交" Command="{Binding SubmitCommand}" Margin="0,0,8,0" Padding="12,6"/>
          <Button Content="打印签批单" Command="{Binding PrintCommand}" Margin="0,0,8,0" Padding="12,6"/>
          <Button Content="审批" Command="{Binding ApproveCommand}" Margin="0,0,8,0" Padding="12,6"/>
          <Button Content="确认可上传" Command="{Binding ConfirmUploadCommand}" Margin="0,0,8,0" Padding="12,6"/>
          <Button Content="办结" Command="{Binding CompleteCommand}" Margin="0,0,8,0" Padding="12,6"/>
        </StackPanel>
        <Button Grid.Column="1" Content="关闭" Command="{Binding CloseCommand}" Padding="16,6"/>
      </Grid>
    </Border>
  </Grid>
</Window>
