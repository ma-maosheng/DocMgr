<Page x:Class="DocMgr.Views.NetworkTransfer.NetworkOnNetDisposalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="在网数据处置" Background="#F0F2F5">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="2*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="3*"/>
    </Grid.RowDefinitions>
    <Border Style="{StaticResource ToolbarCardBorderStyle}" Padding="12,10" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal">
        <Button Content="加工产出登记" Command="{Binding RegisterOutputCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="120" Margin="0,0,10,0"/>
        <Button Content="新增处置" Command="{Binding AddDisposalCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="96" Margin="0,0,10,0"/>
        <Button Content="打开处置" Command="{Binding OpenDisposalCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="96" Margin="0,0,10,0"/>
        <Button Content="撤回作废" Command="{Binding WithdrawDisposalCommand}" Style="{StaticResource ToolbarDangerButtonStyle}" Width="96" Margin="0,0,16,0"/>
        <Button Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="72"/>
      </StackPanel>
    </Border>
    <DockPanel Grid.Row="1">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
        <TextBlock Text="在网台账" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <TextBlock Text="来源:" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <ComboBox Width="120" ItemsSource="{Binding OriginKindOptions}" SelectedItem="{Binding AssetOriginKind}"/>
        <TextBlock Text="状态:" VerticalAlignment="Center" Margin="12,0,4,0"/>
        <ComboBox Width="110" ItemsSource="{Binding LifecycleOptions}" SelectedItem="{Binding AssetLifecycle}"/>
        <TextBox Width="160" Margin="12,0,8,0" Height="28" VerticalContentAlignment="Center" Text="{Binding AssetKeyword, UpdateSourceTrigger=PropertyChanged}"/>
        <Button Content="查询台账" Command="{Binding SearchAssetsCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="88"/>
      </StackPanel>
      <DataGrid ItemsSource="{Binding Assets}" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="资产编号" Binding="{Binding AssetNo, Mode=OneWay}" Width="140"/>
          <DataGridTextColumn Header="类别" Binding="{Binding AssetKind, Mode=OneWay}" Width="90"/>
          <DataGridTextColumn Header="名称" Binding="{Binding AssetName, Mode=OneWay}" Width="*"/>
          <DataGridTextColumn Header="来源" Binding="{Binding OriginKind, Mode=OneWay}" Width="90"/>
          <DataGridTextColumn Header="生命周期" Binding="{Binding LifecycleStatus, Mode=OneWay}" Width="90"/>
          <DataGridTextColumn Header="服务器路径" Binding="{Binding ServerPath, Mode=OneWay}" Width="220"/>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
    <TextBlock Grid.Row="2" Text="处置单" FontWeight="Bold" Margin="0,10,0,6"/>
    <DockPanel Grid.Row="3">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
        <TextBlock Text="状态:" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <ComboBox Width="200" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}"/>
        <TextBlock Text="年度:" VerticalAlignment="Center" Margin="12,0,4,0"/>
        <ComboBox Width="90" ItemsSource="{Binding ApplyYears}" SelectedItem="{Binding ApplyYear}"/>
        <TextBox Width="160" Margin="12,0,8,0" Height="28" VerticalContentAlignment="Center" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"/>
        <Button Content="查询单据" Command="{Binding SearchCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="88"/>
      </StackPanel>
      <DataGrid ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}" AutoGenerateColumns="False" IsReadOnly="True"
                MouseDoubleClick="DgRecords_MouseDoubleClick">
        <DataGrid.Columns>
          <DataGridTextColumn Header="处置单号" Binding="{Binding DisposalNo, Mode=OneWay}" Width="160"/>
          <DataGridTextColumn Header="状态" Binding="{Binding StatusDisplay, Mode=OneWay}" Width="160"/>
          <DataGridTextColumn Header="原因" Binding="{Binding DisposalReason, Mode=OneWay}" Width="140"/>
          <DataGridTextColumn Header="方式" Binding="{Binding DispositionMethod, Mode=OneWay}" Width="140"/>
          <DataGridTextColumn Header="明细数" Binding="{Binding ItemCount, Mode=OneWay}" Width="70"/>
          <DataGridTextColumn Header="申请时间" Binding="{Binding ApplyTime, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140"/>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
  </Grid>
</Page>
