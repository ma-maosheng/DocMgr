<Window x:Class="DocMgr.Views.NetworkTransfer.NetworkOutboundEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1200"
        Height="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F5F7FA">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../YearlyArchive/ArchiveRegisterResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="{Binding WindowTitle, Mode=OneWay}" FontSize="18" FontWeight="Bold"/>
      <TextBlock Text="{Binding BannerText, Mode=OneWay}"
                 Margin="0,6,0,0" Foreground="#666" TextWrapping="Wrap"/>
    </StackPanel>

    <Border Grid.Row="1" BorderBrush="#D8E2EC" BorderThickness="1" CornerRadius="4" Background="White">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="10">
        <StackPanel Margin="12" Orientation="Vertical">

          <GroupBox Header="1. 基本信息" Style="{StaticResource Level1GroupBoxStyle}" Padding="10">
            <StackPanel>
              <DockPanel Margin="0,2">
                <TextBlock Text="单号" Width="110" VerticalAlignment="Center" Style="{StaticResource ArchiveRegisterFormLabelStyle}" HorizontalAlignment="Left"/>
                <TextBox Width="180" HorizontalAlignment="Left"
                         Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                         Text="{Binding OutboundNo, Mode=OneWay}" IsReadOnly="True" Background="#F5F5F5"/>
                <TextBlock Text="目的地" Width="70" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource ArchiveRegisterFormLabelStyle}" HorizontalAlignment="Left"/>
                <ComboBox Width="140"
                          Style="{StaticResource ArchiveRegisterFormComboBoxStyle}"
                          ItemsSource="{Binding DestinationKindOptions}"
                          SelectedItem="{Binding DestinationKind}"
                          IsEnabled="{Binding CanEditHeader}"/>
                <TextBlock Text="状态" Width="50" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource ArchiveRegisterFormLabelStyle}" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding StatusDisplay, Mode=OneWay}" VerticalAlignment="Center" Foreground="#1E293B"/>
              </DockPanel>
              <DockPanel Margin="0,6,0,0">
                <TextBlock Text="项目" Width="110" VerticalAlignment="Center" Style="{StaticResource ArchiveRegisterFormLabelStyle}" HorizontalAlignment="Left"/>
                <TextBox Margin="0,0,12,0"
                         Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                         Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding CanEditHeader}"/>
                <TextBlock Text="年度" Width="50" VerticalAlignment="Center" Style="{StaticResource ArchiveRegisterFormLabelStyle}" HorizontalAlignment="Left"/>
                <TextBox Width="120" HorizontalAlignment="Left"
                         Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                         Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding CanEditHeader}"/>
              </DockPanel>
              <DockPanel Margin="0,6,0,0">
                <TextBlock Text="申请说明" Width="110" VerticalAlignment="Top" Margin="0,4,0,0" Style="{StaticResource ArchiveRegisterFormLabelStyle}" HorizontalAlignment="Left"/>
                <TextBox Height="48" AcceptsReturn="True" TextWrapping="Wrap"
                         Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                         Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding CanEditHeader}"/>
              </DockPanel>
            </StackPanel>
          </GroupBox>

          <GroupBox Header="2. 出网明细" Style="{StaticResource Level1GroupBoxStyle}" Padding="10">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="刷新候选" Command="{Binding RefreshCandidatesCommand}" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="加入明细" Command="{Binding AddSelectedCommand}" Padding="12,6"/>
              </StackPanel>

              <TextBlock Text="候选加工产出" FontWeight="SemiBold" Foreground="#00796B" Margin="0,0,0,4"/>
              <DataGrid ItemsSource="{Binding AvailableAssets}" AutoGenerateColumns="False" Height="120"
                        CanUserAddRows="False" HeadersVisibility="Column"
                        AlternatingRowBackground="#F8FAFC" Margin="0,0,0,10">
                <DataGrid.Columns>
                  <DataGridCheckBoxColumn Header="选" Binding="{Binding IsSelected}" Width="40"/>
                  <DataGridTextColumn Header="候选加工产出" Binding="{Binding Display, Mode=OneWay}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>

              <TextBlock Text="已选明细" FontWeight="SemiBold" Foreground="#00796B" Margin="0,0,0,4"/>
              <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" Height="160"
                        CanUserAddRows="False" HeadersVisibility="Column"
                        AlternatingRowBackground="#F8FAFC">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="资产编号" Binding="{Binding AssetNo, Mode=OneWay}" Width="130"/>
                  <DataGridTextColumn Header="名称" Binding="{Binding AssetName, Mode=OneWay}" Width="160"/>
                  <DataGridTextColumn Header="路径" Binding="{Binding ServerPath, Mode=OneWay}" Width="*"/>
                  <DataGridTemplateColumn Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Button Content="移除" Padding="8,2"
                                Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </GroupBox>

          <StackPanel Visibility="{Binding ShowApprovalPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
            <GroupBox Header="3. 审批流程" Style="{StaticResource Level1GroupBoxStyle}" Padding="8">
              <StackPanel>
                <TextBlock Text="各节点仅需签字人与日期，无需签署具体意见。"
                           Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ArchiveRegisterApprovalCompactStepCardStyle}">
                    <DockPanel LastChildFill="True">
                      <TextBlock DockPanel.Dock="Left" Text="生产管理科" Style="{StaticResource ArchiveRegisterApprovalCompactStepTitleStyle}"/>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="签字" Style="{StaticResource ArchiveRegisterApprovalInlineLabelStyle}"/>
                        <TextBox Width="90" Style="{StaticResource ArchiveRegisterApprovalCompactTextBoxStyle}"
                                 Text="{Binding ProdLeader, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="日期" Style="{StaticResource ArchiveRegisterApprovalInlineLabelStyle}" Margin="10,0,4,0"/>
                        <DatePicker Style="{StaticResource ArchiveRegisterApprovalCompactDatePickerStyle}"
                                    SelectedDate="{Binding ProdDate}"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>

                  <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource ArchiveRegisterApprovalCompactStepCardStyle}">
                    <DockPanel LastChildFill="True">
                      <TextBlock DockPanel.Dock="Left" Text="科研开发室" Style="{StaticResource ArchiveRegisterApprovalCompactStepTitleStyle}"/>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="签字" Style="{StaticResource ArchiveRegisterApprovalInlineLabelStyle}"/>
                        <TextBox Width="90" Style="{StaticResource ArchiveRegisterApprovalCompactTextBoxStyle}"
                                 Text="{Binding RndLeader, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="日期" Style="{StaticResource ArchiveRegisterApprovalInlineLabelStyle}" Margin="10,0,4,0"/>
                        <DatePicker Style="{StaticResource ArchiveRegisterApprovalCompactDatePickerStyle}"
                                    SelectedDate="{Binding RndDate}"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>

                  <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ArchiveRegisterApprovalCompactStepCardStyle}">
                    <DockPanel LastChildFill="True">
                      <TextBlock DockPanel.Dock="Left" Text="分管领导" Style="{StaticResource ArchiveRegisterApprovalCompactStepTitleStyle}"/>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="签字" Style="{StaticResource ArchiveRegisterApprovalInlineLabelStyle}"/>
                        <TextBox Width="90" Style="{StaticResource ArchiveRegisterApprovalCompactTextBoxStyle}"
                                 Text="{Binding DeputyLeader, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="日期" Style="{StaticResource ArchiveRegisterApprovalInlineLabelStyle}" Margin="10,0,4,0"/>
                        <DatePicker Style="{StaticResource ArchiveRegisterApprovalCompactDatePickerStyle}"
                                    SelectedDate="{Binding DeputyDate}"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>

                  <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource ArchiveRegisterApprovalCompactStepCardStyle}">
                    <DockPanel LastChildFill="True">
                      <TextBlock DockPanel.Dock="Left" Text="部门负责人" Style="{StaticResource ArchiveRegisterApprovalCompactStepTitleStyle}"/>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="签字" Style="{StaticResource ArchiveRegisterApprovalInlineLabelStyle}"/>
                        <TextBox Width="90" Style="{StaticResource ArchiveRegisterApprovalCompactTextBoxStyle}"
                                 Text="{Binding DeptLeader, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="日期" Style="{StaticResource ArchiveRegisterApprovalInlineLabelStyle}" Margin="10,0,4,0"/>
                        <DatePicker Style="{StaticResource ArchiveRegisterApprovalCompactDatePickerStyle}"
                                    SelectedDate="{Binding DeptDate}"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </Grid>

                <Border Style="{StaticResource ArchiveRegisterApprovalCompactStepCardStyle}" Margin="0">
                  <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Text="资料交接" Style="{StaticResource ArchiveRegisterApprovalCompactStepTitleStyle}"/>
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="移交" Style="{StaticResource ArchiveRegisterApprovalInlineLabelStyle}"/>
                        <TextBox Width="90" Style="{StaticResource ArchiveRegisterApprovalCompactTextBoxStyle}"
                                 Text="{Binding Deliverer, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="日期" Style="{StaticResource ArchiveRegisterApprovalInlineLabelStyle}" Margin="8,0,4,0"/>
                        <DatePicker Style="{StaticResource ArchiveRegisterApprovalCompactDatePickerStyle}"
                                    SelectedDate="{Binding DeliverDate}"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="资料员" Style="{StaticResource ArchiveRegisterApprovalInlineLabelStyle}"/>
                        <TextBox Width="90" Style="{StaticResource ArchiveRegisterApprovalCompactTextBoxStyle}"
                                 Text="{Binding Administrator, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="日期" Style="{StaticResource ArchiveRegisterApprovalInlineLabelStyle}" Margin="8,0,4,0"/>
                        <DatePicker Style="{StaticResource ArchiveRegisterApprovalCompactDatePickerStyle}"
                                    SelectedDate="{Binding AdminDate}"/>
                      </StackPanel>
                    </WrapPanel>
                  </DockPanel>
                </Border>
              </StackPanel>
            </GroupBox>

            <GroupBox Header="4. 附件材料" Style="{StaticResource Level1GroupBoxStyle}" Padding="10">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <TextBlock Text="附件分类" Width="110" VerticalAlignment="Center" Style="{StaticResource ArchiveRegisterFormLabelStyle}" HorizontalAlignment="Left"/>
                  <ComboBox Width="160"
                            Style="{StaticResource ArchiveRegisterFormComboBoxStyle}"
                            ItemsSource="{Binding UploadCategoryOptions}"
                            SelectedItem="{Binding UploadCategory}"/>
                  <Button Content="上传附件" Command="{Binding UploadAttachmentCommand}" Margin="8,0,0,0" Padding="12,6"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Attachments}" AutoGenerateColumns="False" Height="110"
                          IsReadOnly="True" HeadersVisibility="Column"
                          AlternatingRowBackground="#F8FAFC">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="分类" Binding="{Binding FileCategory, Mode=OneWay}" Width="100"/>
                    <DataGridTextColumn Header="文件名" Binding="{Binding FileName, Mode=OneWay}" Width="*"/>
                    <DataGridTemplateColumn Width="130">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal">
                            <Button Content="查看" Padding="8,2" Margin="0,0,4,0"
                                    Command="{Binding DataContext.ViewAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="删除" Padding="8,2"
                                    Command="{Binding DataContext.DeleteAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </GroupBox>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,10,0,0"
            BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Background="#FAFBFC">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button Content="保存草稿" Command="{Binding SaveDraftCommand}" Margin="0,0,8,0" Padding="12,6"/>
          <Button Content="提交" Command="{Binding SubmitCommand}" Margin="0,0,8,0" Padding="12,6"/>
          <Button Content="审批通过" Command="{Binding ApproveCommand}" Margin="0,0,8,0" Padding="12,6"/>
          <Button Content="确认交接" Command="{Binding ConfirmHandoverCommand}" Margin="0,0,8,0" Padding="12,6"/>
          <Button Content="办结" Command="{Binding CompleteCommand}" Margin="0,0,8,0" Padding="12,6"/>
        </StackPanel>
        <Button Grid.Column="1" Content="关闭" Command="{Binding CloseCommand}" Padding="16,6"/>
      </Grid>
    </Border>
  </Grid>
</Window>
