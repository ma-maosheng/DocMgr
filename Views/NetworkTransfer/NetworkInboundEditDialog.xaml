<Window x:Class="DocMgr.Views.NetworkTransfer.NetworkInboundEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DocMgr.Views.YearlyArchive"
        xmlns:nt="clr-namespace:DocMgr.Views.NetworkTransfer"
        Width="1200"
        Height="820"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../YearlyArchive/ArchiveRegisterResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <local:InverseBoolRadioConverter x:Key="InverseBoolRadioConverter"/>

            <DataTemplate x:Key="ApplicantSectionsTemplate">
                <UserControl>
                    <StackPanel Orientation="Vertical">
                        <GroupBox Header="1. 资料信息" Style="{StaticResource Level1GroupBoxStyle}" Padding="10">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <Label Width="110" VerticalAlignment="Center">资料名称 *：</Label>
                                    <TextBox Text="{Binding CurrentRecord.MaterialName, UpdateSourceTrigger=PropertyChanged}"
                                             Width="500" Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                                             IsEnabled="{Binding CanEditForm}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <Label Width="110" VerticalAlignment="Center">所属项目 *：</Label>
                                    <ComboBox Width="100" Style="{StaticResource ArchiveRegisterFormComboBoxStyle}" Margin="0,0,5,0"
                                              ItemsSource="{Binding ProjectYears}"
                                              SelectedItem="{Binding SelectedProjectYear}"
                                              IsEnabled="{Binding CanEditForm}"/>
                                    <ComboBox Width="395" Style="{StaticResource ArchiveRegisterFormComboBoxStyle}"
                                              ItemsSource="{Binding Projects}"
                                              DisplayMemberPath="ProjectName"
                                              SelectedItem="{Binding SelectedProject, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding CanEditForm}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,4" VerticalAlignment="Center">
                                    <Label Width="110" VerticalAlignment="Center">数据来源 *：</Label>
                                    <ComboBox Width="200"
                                              ItemsSource="{Binding SourceKindOptions}"
                                              SelectedItem="{Binding SourceKind}">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource ArchiveRegisterFormComboBoxStyle}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSourceKindEditable}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>
                                    <TextBox Width="200" Text="{Binding SourceKind, Mode=OneWay}" IsReadOnly="True"
                                             Background="#F5F5F5" VerticalContentAlignment="Center">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource ArchiveRegisterFormTextBoxStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSourceKindEditable}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <Label Width="140" VerticalAlignment="Center" Content="        提供部门(单位) *："/>
                                    <ComboBox Width="260"
                                              ItemsSource="{Binding InternalDepartments}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Name"
                                              SelectedValue="{Binding ProvideUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource ArchiveRegisterFormComboBoxStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowProvideUnitDepartmentCombo}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>
                                    <TextBox Width="260"
                                             Text="{Binding ProvideUnit, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource ArchiveRegisterFormTextBoxStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowProvideUnitExternalTextBox}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBox Width="260"
                                             Text="{Binding ProvideUnit, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Background="#F5F5F5"
                                             VerticalContentAlignment="Center">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource ArchiveRegisterFormTextBoxStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowProvideUnitReadOnlyText}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </StackPanel>

                                <GroupBox Header="入网明细 *" Margin="0,8,0,0" BorderBrush="#DDD" Padding="6">
                                    <StackPanel Margin="4">
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="88"/>
                                                <ColumnDefinition Width="280"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="服务器路径：" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" Margin="2,0" VerticalContentAlignment="Center"
                                                      Style="{StaticResource ArchiveRegisterFormComboBoxStyle}"
                                                      ItemsSource="{Binding ApplicantServerPathOptions}"
                                                      DisplayMemberPath="PathName"
                                                      SelectedItem="{Binding SelectedServerPath, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding CanEditServerPath}"/>
                                            <Button Grid.Column="2" HorizontalAlignment="Right"
                                                    Content="+ 添加明细"
                                                    Command="{Binding AddExternalItemCommand}"
                                                    Padding="8,2">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowExternalItemToolbar}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                        <TextBlock Margin="2,0,0,6" Foreground="#475569" FontSize="11" TextWrapping="Wrap"
                                                   Text="{Binding SelectedServerPathInfo, Mode=OneWay}"/>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="88"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="资料路径：" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Margin="2,0"
                                                     Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                                                     VerticalContentAlignment="Center"
                                                     Text="{Binding CurrentRecord.MaterialPath, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding CanEditServerPath}"/>
                                            <Button Grid.Column="2" Margin="8,0,0,0" Padding="8,2"
                                                    Content="填入默认资料路径"
                                                    Command="{Binding FillDefaultMaterialPathCommand}"/>
                                        </Grid>

                                        <Grid Visibility="{Binding ShowExternalElectronicMediaSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <nt:NetworkInboundElectronicMediaSectionView DataContext="{Binding ElectronicMediaEditor}"/>
                                        </Grid>

                                        <Grid Visibility="{Binding ShowArchivedDataSourceSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <nt:NetworkInboundArchivedDataSourceSectionView/>
                                        </Grid>

                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="2. 申请信息" Style="{StaticResource Level1GroupBoxStyle}" Padding="10">
                            <StackPanel>
                                <DockPanel Margin="0,2" LastChildFill="True">
                                    <Label DockPanel.Dock="Left" Width="110" Style="{StaticResource FormLabelStyle}" Content="申请说明 *："/>
                                    <TextBox Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                                             Height="48" AcceptsReturn="True" TextWrapping="Wrap"
                                             Text="{Binding CurrentRecord.Reason, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanEditForm}"/>
                                </DockPanel>

                                <DockPanel Margin="0,2" LastChildFill="True">
                                    <Label DockPanel.Dock="Left" Width="110" Style="{StaticResource FormLabelStyle}" Content="其他要求："/>
                                    <TextBox Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                                             Text="{Binding CurrentRecord.OtherRequests, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanEditForm}"/>
                                </DockPanel>

                                <DockPanel Margin="0,2" LastChildFill="True">
                                    <Label DockPanel.Dock="Left" Width="110" Style="{StaticResource FormLabelStyle}" Content="附有证明材料："/>
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                                                Style="{StaticResource FormInlineRadioGroupStyle}" Margin="0,0,8,0"
                                                IsEnabled="{Binding CanEditForm}">
                                        <RadioButton Content="是" GroupName="InboundProofMaterialHas"
                                                     Style="{StaticResource ArchiveRegisterFormRadioButtonStyle}"
                                                     IsChecked="{Binding HasProofMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <RadioButton Content="否" GroupName="InboundProofMaterialHas"
                                                     Style="{StaticResource ArchiveRegisterFormRadioButtonStyle}"
                                                     IsChecked="{Binding HasProofMaterial, Converter={StaticResource InverseBoolRadioConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <DockPanel LastChildFill="True" IsEnabled="{Binding CanEditHeader}">
                                        <DockPanel.Style>
                                            <Style TargetType="DockPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasProofMaterial}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DockPanel.Style>
                                        <Label DockPanel.Dock="Left" Style="{StaticResource FormLabelStyle}" Content="名称：" Margin="0,0,6,0"/>
                                        <TextBox Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                                                 Text="{Binding ProofMaterialName, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="填写证明材料名称；审批环节由资料管理员上传扫描件"/>
                                    </DockPanel>
                                </DockPanel>

                                <DockPanel Margin="0,2" LastChildFill="True">
                                    <Label DockPanel.Dock="Left" Width="110" Style="{StaticResource FormLabelStyle}" Content="备注："/>
                                    <TextBox Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                                             Height="36" AcceptsReturn="True" TextWrapping="Wrap"
                                             Text="{Binding CurrentRecord.Remark, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanEditForm}"/>
                                </DockPanel>

                                <DockPanel Margin="0,2" LastChildFill="True">
                                    <Label DockPanel.Dock="Left" Width="110" Style="{StaticResource FormLabelStyle}" Content="申请人 *："/>
                                    <TextBox DockPanel.Dock="Left" Width="88" Margin="0,0,12,0"
                                             Text="{Binding CurrentRecord.ApplicantName, Mode=OneWay}" IsReadOnly="True" Background="#F5F5F5"
                                             Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"/>
                                    <Label DockPanel.Dock="Left" Style="{StaticResource FormLabelStyle}" Content="部门 *：" Margin="0,0,6,0"/>
                                    <TextBox DockPanel.Dock="Left" Width="150" Margin="0,0,12,0"
                                             Text="{Binding CurrentRecord.ApplicantDept, Mode=OneWay}" IsReadOnly="True" Background="#F5F5F5"
                                             Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"/>
                                    <Label DockPanel.Dock="Left" Style="{StaticResource FormLabelStyle}" Content="日期 *：" Margin="0,0,6,0"/>
                                    <DatePicker DockPanel.Dock="Left" Width="120"
                                                SelectedDate="{Binding CurrentRecord.ApplyTime, Mode=OneWay}"
                                                IsEnabled="False"
                                                Style="{StaticResource ArchiveRegisterFormDatePickerStyle}"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding ShowApplicationSubmitActions}" Value="True"/>
                                                                <Condition Binding="{Binding ShowEmbeddedActionButtons}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button Content="💾 保存草稿" Command="{Binding SaveDraftCommand}"
                                                    Padding="10,0" FontSize="12" FontWeight="Bold" Cursor="Hand" Margin="0,0,8,0" Width="100"
                                                    Style="{StaticResource ButtonNormalStyle}"/>
                                            <Button Content="💾 提交申请" Command="{Binding SubmitApplicationsCommand}"
                                                    Padding="10,0" FontSize="12" FontWeight="Bold" Cursor="Hand" Width="100"
                                                    Style="{StaticResource ButtonNormalStyle}"/>
                                        </StackPanel>
                                        <Button Content="💾 打印申请" Command="{Binding PrintApplicationsCommand}"
                                                Padding="10,0" FontSize="12" FontWeight="Bold" Cursor="Hand" Width="100">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ButtonNormalStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding ShowApplicationSubmitActions}" Value="True"/>
                                                                <Condition Binding="{Binding ShowEmbeddedActionButtons}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </UserControl>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding WindowTitle, Mode=OneWay}" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="{Binding RegisterWorkspaceBannerText, Mode=OneWay}"
                       Margin="0,6,0,0" Foreground="#666" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding BusinessChainProgressDisplay, Mode=OneWay}"
                       Margin="0,4,0,0" Foreground="#2563EB" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#D8E2EC" BorderThickness="1" CornerRadius="4" Background="White">
            <ScrollViewer x:Name="FormScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="10">
                <StackPanel Margin="12" Orientation="Vertical">
                    <ContentControl Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource ApplicantSectionsTemplate}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowApprovalWorkflowPanel}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{x:Null}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                    <nt:NetworkInboundApprovalApplicationSectionsView>
                        <nt:NetworkInboundApprovalApplicationSectionsView.Style>
                            <Style TargetType="nt:NetworkInboundApprovalApplicationSectionsView">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowApprovalWorkflowPanel}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </nt:NetworkInboundApprovalApplicationSectionsView.Style>
                    </nt:NetworkInboundApprovalApplicationSectionsView>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowApprovalWorkflowPanel}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <nt:NetworkInboundApprovalSectionsView/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,10,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Background="#FAFBFC">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowApplicationSubmitActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Content="保存草稿" Command="{Binding SaveDraftCommand}" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Content="提交申请" Command="{Binding SubmitApplicationsCommand}" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Content="打印申请" Command="{Binding PrintApplicationsCommand}" Margin="0,0,8,0" Padding="12,6"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowApprovalWorkflowPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Content="审批通过" Command="{Binding SaveApprovalCommand}" ToolTip="{Binding ApproveHintText}" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Content="确认实物交接" Command="{Binding ConfirmPhysicalHandoverCommand}" ToolTip="{Binding ConfirmHandoverHintText}" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Content="确认办结" Command="{Binding CompleteCommand}" ToolTip="{Binding CompleteHintText}" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Content="打印交接单" Command="{Binding PrintApprovalCommand}" ToolTip="{Binding PrintHintText}" Margin="0,0,8,0" Padding="12,6"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Content="关闭" Command="{Binding CloseCommand}" Padding="16,6"/>
            </Grid>
        </Border>
    </Grid>
</Window>
