<Window x:Class="DocMgr.Views.NetworkTransfer.NetworkInboundEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewShared="clr-namespace:DocMgr.Views.Shared"
        xmlns:nt="clr-namespace:DocMgr.Views.NetworkTransfer"
        Width="1200"
        Height="820"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../YearlyArchive/ArchiveRegisterResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <viewShared:InverseBoolRadioConverter x:Key="InverseBoolRadioConverter"/>

            <DataTemplate x:Key="ApplicantSectionsTemplate">
                <UserControl>
                    <StackPanel Orientation="Vertical">
                        <viewShared:ApplicationRequestHeaderSectionView DataContext="{Binding RequestHeader}"/>
                        <GroupBox Header="2. 资料信息" Style="{StaticResource Level1GroupBoxStyle}" Padding="10">
                            <StackPanel Orientation="Vertical">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="105"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="168"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource FormLabelTextBlockStyle}" Text="所属项目 *："/>
                                    <ComboBox Grid.Column="1" Style="{StaticResource ArchiveRegisterFormComboBoxStyle}" Margin="0,0,5,0"
                                              ItemsSource="{Binding ProjectYears}"
                                              SelectedItem="{Binding SelectedProjectYear}"
                                              IsEnabled="{Binding CanEditForm}"/>
                                    <ComboBox Grid.Column="2" Style="{StaticResource ArchiveRegisterFormComboBoxStyle}" Margin="0,0,12,0"
                                              ItemsSource="{Binding Projects}"
                                              DisplayMemberPath="ProjectName"
                                              SelectedItem="{Binding SelectedProject, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding CanEditForm}"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource FormLabelTextBlockStyle}" Text="数据来源 *："/>
                                    <ComboBox Grid.Column="4"
                                              ItemsSource="{Binding SourceKindOptions}"
                                              SelectedItem="{Binding SourceKind}">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource ArchiveRegisterFormComboBoxStyle}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSourceKindEditable}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>
                                    <TextBox Grid.Column="4" Text="{Binding SourceKind, Mode=OneWay}" IsReadOnly="True"
                                             Background="#F5F5F5" VerticalContentAlignment="Center">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource ArchiveRegisterFormTextBoxStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSourceKindEditable}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBlock Grid.Column="5" Style="{StaticResource FormLabelTextBlockStyle}" Text="提供部门(单位) *："/>
                                    <ComboBox Grid.Column="6"
                                              ItemsSource="{Binding InternalDepartments}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Name"
                                              SelectedValue="{Binding ProvideUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource ArchiveRegisterFormComboBoxStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowProvideUnitDepartmentCombo}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>
                                    <TextBox Grid.Column="6"
                                             Text="{Binding ProvideUnit, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource ArchiveRegisterFormTextBoxStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowProvideUnitExternalTextBox}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBox Grid.Column="6"
                                             Text="{Binding ExternalSourceProvideUnitDisplay, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Background="#F5F5F5"
                                             VerticalContentAlignment="Center"
                                             ToolTip="由各介质子项的资料来源与提供单位汇总，格式与立档申请一致">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource ArchiveRegisterFormTextBoxStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowExternalSourceProvideUnitSummary}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBox Grid.Column="6"
                                             Text="{Binding ProvideUnit, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Background="#F5F5F5"
                                             VerticalContentAlignment="Center">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource ArchiveRegisterFormTextBoxStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowProvideUnitReadOnlyText}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>

                                <GroupBox Header="入网明细 *" Margin="0,8,0,0" BorderBrush="#DDD" Padding="6">
                                    <StackPanel Margin="4">
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="88"/>
                                                <ColumnDefinition Width="280"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="服务器路径：" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" Margin="2,0" VerticalContentAlignment="Center"
                                                      Style="{StaticResource ArchiveRegisterFormComboBoxStyle}"
                                                      ItemsSource="{Binding ApplicantServerPathOptions}"
                                                      DisplayMemberPath="PathName"
                                                      SelectedItem="{Binding SelectedServerPath, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding CanEditServerPath}"/>
                                            <Button Grid.Column="2" HorizontalAlignment="Right"
                                                    Content="+ 添加明细"
                                                    Command="{Binding AddExternalItemCommand}"
                                                    Padding="8,2">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowExternalItemToolbar}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                        <TextBlock Margin="2,0,0,6" Foreground="#475569" FontSize="11" TextWrapping="Wrap"
                                                   Text="{Binding SelectedServerPathInfo, Mode=OneWay}"/>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="88"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="资料路径：" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Margin="2,0"
                                                     Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                                                     VerticalContentAlignment="Center"
                                                     Text="{Binding CurrentRecord.MaterialPath, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding CanEditServerPath}"/>
                                            <Button Grid.Column="2" Margin="8,0,0,0" Padding="8,2"
                                                    Content="填入默认资料路径"
                                                    Command="{Binding FillDefaultMaterialPathCommand}"/>
                                        </Grid>
                                        <TextBlock Margin="90,0,0,6" Foreground="#64748B" FontSize="11" TextWrapping="Wrap"
                                                   Text="{Binding MaterialPathHint, Mode=OneWay}"/>

                                        <Grid Visibility="{Binding ShowExternalElectronicMediaSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <nt:NetworkInboundElectronicMediaSectionView DataContext="{Binding ElectronicMediaEditor}"/>
                                        </Grid>

                                        <Grid Visibility="{Binding ShowArchivedDataSourceSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <nt:NetworkInboundArchivedDataSourceSectionView/>
                                        </Grid>

                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </UserControl>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding WindowTitle, Mode=OneWay}" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="{Binding RegisterWorkspaceBannerText, Mode=OneWay}"
                       Margin="0,6,0,0" Foreground="#666" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding BusinessChainProgressDisplay, Mode=OneWay}"
                       Margin="0,4,0,0" Foreground="#2563EB" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 申请态：外层白卡 + 可编辑表单 -->
        <Border Grid.Row="1" BorderBrush="#D8E2EC" BorderThickness="1" CornerRadius="4" Background="White">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowApprovalWorkflowPanel}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ScrollViewer x:Name="FormScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="10">
                <ContentControl Margin="12" Content="{Binding}" ContentTemplate="{StaticResource ApplicantSectionsTemplate}"/>
            </ScrollViewer>
        </Border>

        <!-- 审批态：壳自带白卡；打印/办结/关闭底栏固定在白卡外 -->
        <nt:NetworkInboundApprovalSectionsView Grid.Row="1">
            <nt:NetworkInboundApprovalSectionsView.Style>
                <Style TargetType="nt:NetworkInboundApprovalSectionsView">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowApprovalWorkflowPanel}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </nt:NetworkInboundApprovalSectionsView.Style>
        </nt:NetworkInboundApprovalSectionsView>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,10,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Background="#FAFBFC">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowApprovalWorkflowPanel}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowApplicationSubmitActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Content="保存草稿" Command="{Binding SaveDraftCommand}" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Content="提交申请" Command="{Binding SubmitApplicationsCommand}" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Content="打印申请" Command="{Binding PrintApplicationsCommand}" Margin="0,0,8,0" Padding="12,6"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Content="关闭" Command="{Binding CloseCommand}" Padding="16,6"/>
            </Grid>
        </Border>
    </Grid>
</Window>
