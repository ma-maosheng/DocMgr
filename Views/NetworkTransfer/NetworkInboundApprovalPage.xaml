<Page x:Class="DocMgr.Views.NetworkTransfer.NetworkInboundApprovalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="入网审批" Background="#F0F2F5">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Border Style="{StaticResource ToolbarCardBorderStyle}" Padding="16,12">
      <StackPanel Orientation="Horizontal">
        <Button Content="打开办理" Command="{Binding OpenCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="96" Margin="0,0,16,0"/>
        <TextBlock Text="状态:" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox Width="200" Style="{StaticResource ToolbarFilterComboBoxStyle}" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}"/>
        <TextBlock Text="年度:" VerticalAlignment="Center" Margin="16,0,6,0"/>
        <ComboBox Width="90" Style="{StaticResource ToolbarFilterComboBoxStyle}" ItemsSource="{Binding ApplyYears}" SelectedItem="{Binding ApplyYear}"/>
        <TextBlock Text="关键词:" VerticalAlignment="Center" Margin="16,0,6,0"/>
        <TextBox Width="160" Height="32" VerticalContentAlignment="Center" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"/>
        <Button Content="查询" Command="{Binding SearchCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="72" Margin="10,0,0,0"/>
        <Button Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="72" Margin="8,0,0,0"/>
      </StackPanel>
    </Border>
    <DataGrid Grid.Row="1" Margin="12" ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}"
              AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="DgRecords_MouseDoubleClick">
      <DataGrid.Columns>
        <DataGridTextColumn Header="入网单号" Binding="{Binding InboundNo, Mode=OneWay}" Width="160"/>
        <DataGridTextColumn Header="状态" Binding="{Binding StatusDisplay, Mode=OneWay}" Width="160"/>
        <DataGridTextColumn Header="数据源" Binding="{Binding SourceKind, Mode=OneWay}" Width="100"/>
        <DataGridTextColumn Header="项目" Binding="{Binding ProjectName, Mode=OneWay}" Width="*"/>
        <DataGridTextColumn Header="关联业务进度" Binding="{Binding BusinessChainProgressDisplay, Mode=OneWay}" Width="230"/>
        <DataGridTextColumn Header="申请人" Binding="{Binding ApplicantName, Mode=OneWay}" Width="90"/>
        <DataGridTextColumn Header="申请时间" Binding="{Binding ApplyTime, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140"/>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</Page>
