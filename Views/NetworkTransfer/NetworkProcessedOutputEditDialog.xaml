<Window x:Class="DocMgr.Views.NetworkTransfer.NetworkProcessedOutputEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="加工产出登记" Height="420" Width="520" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="登记" Command="{Binding SaveCommand}" Width="80" Margin="0,0,8,0"/>
      <Button Content="取消" Command="{Binding CloseCommand}" Width="80"/>
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="100"/><ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Text="资料类别" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding AssetKindOptions}" SelectedItem="{Binding AssetKind}" Margin="0,0,0,8"/>
      <TextBlock Grid.Row="1" Text="名称" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AssetName}" Margin="0,0,0,8"/>
      <TextBlock Grid.Row="2" Text="服务器路径" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ServerPath}" Margin="0,0,0,8"/>
      <TextBlock Grid.Row="3" Text="项目" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ProjectName}" Margin="0,0,0,8"/>
      <TextBlock Grid.Row="4" Text="年度" VerticalAlignment="Center"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Year}" Margin="0,0,0,8"/>
      <TextBlock Grid.Row="5" Text="密级" VerticalAlignment="Center"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ConfidentialLevel}" Margin="0,0,0,8"/>
      <TextBlock Grid.Row="6" Text="数据量" VerticalAlignment="Center"/><TextBox Grid.Row="6" Grid.Column="1" Text="{Binding DataSizeText}" Margin="0,0,0,8"/>
      <TextBlock Grid.Row="7" Text="父资产Id" VerticalAlignment="Center"/><TextBox Grid.Row="7" Grid.Column="1" Text="{Binding ParentAssetIdText}" Margin="0,0,0,8"/>
      <TextBlock Grid.Row="8" Text="备注" VerticalAlignment="Center"/><TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Remark}"/>
    </Grid>
  </DockPanel>
</Window>
