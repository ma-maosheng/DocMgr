<UserControl x:Class="DocMgr.Views.NetworkTransfer.NetworkInboundArchivedDataSourceSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../YearlyArchive/ArchiveRegisterResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <GroupBox Header="{Binding ArchivedDataSourceSectionTitle}" Margin="0,8,0,0" BorderBrush="#DDD" Padding="6">
        <StackPanel Margin="4">
            <DockPanel Margin="0,0,0,4" LastChildFill="True">
                <TextBlock Text="电子检索集 *" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button DockPanel.Dock="Right" Content="刷新列表"
                        Command="{Binding RefreshApplicantSearchResultSetsCommand}"
                        Padding="8,2" IsEnabled="{Binding CanEditHeader}"/>
            </DockPanel>
            <DataGrid ItemsSource="{Binding ApplicantSearchResultSets}"
                      SelectedItem="{Binding SelectedSearchResultSet, UpdateSourceTrigger=PropertyChanged}"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      IsReadOnly="True" SelectionMode="Single" Height="120"
                      AlternatingRowBackground="#F8FAFC">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="检索集编号" Binding="{Binding ResultSetNo, Mode=OneWay}" Width="140"/>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name, Mode=OneWay}" Width="*"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusDisplay, Mode=OneWay}" Width="80"/>
                    <DataGridTextColumn Header="明细数" Binding="{Binding ItemCount, Mode=OneWay}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Margin="0,4,0,8" Text="{Binding SelectedSearchResultSetSummary, Mode=OneWay}"
                       Foreground="#475569" FontSize="11" TextWrapping="Wrap"/>

            <TextBlock Text="检索集明细" Margin="0,0,0,4" Foreground="#334155" FontWeight="SemiBold"/>
            <DataGrid ItemsSource="{Binding ItemRows}" AutoGenerateColumns="False" MinHeight="200" Height="240"
                      CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F8FAFC" RowHeight="32"
                      IsReadOnly="{Binding IsInboundItemGridReadOnly}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="资料类别" Width="96">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AssetKindDisplay, Mode=OneWay}" VerticalAlignment="Center" Margin="6,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.AssetKindOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding AssetKind, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource ArchiveRegisterFormComboBoxStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="资料名称" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MaterialNameDisplay, Mode=OneWay}" VerticalAlignment="Center" Margin="6,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding MaterialName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="表单编号" Binding="{Binding FormNoDisplay, Mode=OneWay}" Width="100" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="资料明细" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ItemNameDisplay, Mode=OneWay}" VerticalAlignment="Center" Margin="6,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="密级" Width="72">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ConfidentialLevelDisplay, Mode=OneWay}" VerticalAlignment="Center" Margin="6,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.ConfidentialLevelOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding ConfidentialLevel, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource ArchiveRegisterFormComboBoxStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="数据量" Width="118">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DataSizeTextDisplay, Mode=OneWay}" VerticalAlignment="Center" Margin="6,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <ComboBox DockPanel.Dock="Right" Width="52" Margin="4,0,0,0"
                                              ItemsSource="{Binding DataContext.DataSizeUnitOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding DataSizeUnit, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource ArchiveRegisterFormComboBoxStyle}"/>
                                    <TextBox Text="{Binding DataSizeValue, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"/>
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="容器编号" Binding="{Binding ContainerCodeDisplay, Mode=OneWay}" Width="88" IsReadOnly="True"/>
                    <DataGridTextColumn Header="存放位置" Binding="{Binding StorageLocationDisplay, Mode=OneWay}" Width="96" IsReadOnly="True"/>
                    <DataGridTextColumn Header="硬盘编号" Binding="{Binding HardDiskCodeDisplay, Mode=OneWay}" Width="88" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="移除" Padding="8,2"
                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </GroupBox>
</UserControl>
