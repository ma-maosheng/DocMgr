<UserControl x:Class="DocMgr.Views.NetworkTransfer.NetworkInboundArchivedDataSourceSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../YearlyArchive/ArchiveRegisterResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <GroupBox Header="{Binding ArchivedDataSourceSectionTitle}" Margin="0,8,0,0" BorderBrush="#DDD" Padding="6">
        <StackPanel Margin="4">
            <DockPanel Margin="0,0,0,4" LastChildFill="True">
                <TextBlock Text="电子检索集 *" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button DockPanel.Dock="Right" Content="刷新列表"
                        Command="{Binding RefreshApplicantSearchResultSetsCommand}"
                        Padding="8,2" IsEnabled="{Binding CanEditHeader}"/>
            </DockPanel>
            <DataGrid ItemsSource="{Binding ApplicantSearchResultSets}"
                      SelectedItem="{Binding SelectedSearchResultSet, UpdateSourceTrigger=PropertyChanged}"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      IsReadOnly="True" SelectionMode="Single" Height="120"
                      AlternatingRowBackground="#F8FAFC">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="检索集编号" Binding="{Binding ResultSetNo, Mode=OneWay}" Width="140"/>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name, Mode=OneWay}" Width="*"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusDisplay, Mode=OneWay}" Width="80"/>
                    <DataGridTextColumn Header="明细数" Binding="{Binding ItemCount, Mode=OneWay}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Margin="0,4,0,8" Text="{Binding SelectedSearchResultSetSummary, Mode=OneWay}"
                       Foreground="#475569" FontSize="11" TextWrapping="Wrap"/>

            <TextBlock Text="检索集明细" Margin="0,0,0,4" Foreground="#334155" FontWeight="SemiBold"/>
            <!-- 列与 YA-FIL-POOL 右侧「池内立档记录」一致（立档入网仅为电子介质，电子列始终显示）。 -->
            <DataGrid ItemsSource="{Binding ItemRows}" AutoGenerateColumns="False" MinHeight="200" Height="240"
                      CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F8FAFC" RowHeight="34" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="表单号" Binding="{Binding FormNo, Mode=OneWay}" Width="150"/>
                    <DataGridTextColumn Header="项目年度" Binding="{Binding ProjectYear, Mode=OneWay}" Width="70"/>
                    <DataGridTextColumn Header="所属项目" Binding="{Binding ProjectName, Mode=OneWay}" Width="140"/>
                    <DataGridTextColumn Header="资料名称" Binding="{Binding MaterialName, Mode=OneWay}" Width="*"/>
                    <DataGridTextColumn Header="库管模式" Binding="{Binding ArchivePurpose, Mode=OneWay}" Width="88"/>
                    <DataGridTextColumn Header="子项名称" Binding="{Binding ItemName, Mode=OneWay}" Width="140"/>
                    <DataGridTextColumn Header="介质类型" Binding="{Binding StorageCarrierTypeDisplay, Mode=OneWay}" Width="80"/>
                    <DataGridTextColumn Header="所在目录" Binding="{Binding FilingDirectoryDisplay, Mode=OneWay}" Width="200">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="资料类型" Binding="{Binding MaterialCategory, Mode=OneWay}" Width="72"/>
                    <DataGridTextColumn Header="所属子类" Binding="{Binding SubCategory, Mode=OneWay}" Width="88"/>
                    <DataGridTextColumn Header="组织形式" Binding="{Binding DataOrganizationForm, Mode=OneWay}" Width="72"/>
                    <DataGridTextColumn Header="份数" Binding="{Binding RequestedCopyCount, Mode=OneWay}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCopyCountEditable}" Value="False">
                                        <Setter Property="Text" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="筛选范围" Binding="{Binding SelectionScopeDisplay, Mode=OneWay}" Width="180">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="Foreground" Value="#00695C"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="密级" Binding="{Binding ConfidentialLevel, Mode=OneWay}" Width="70"/>
                    <DataGridTextColumn Header="命中明细" Binding="{Binding MatchedContentEntrySummary, Mode=OneWay}" Width="200">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="Foreground" Value="#00695C"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="数据量" Binding="{Binding DataSizeDisplay, Mode=OneWay}" Width="90"/>
                    <DataGridTextColumn Header="档案盒/介质袋编号" Binding="{Binding ContainerCode, Mode=OneWay}" Width="130"/>
                    <DataGridTextColumn Header="立档位置" Binding="{Binding StorageLocation, Mode=OneWay}" Width="100"/>
                    <DataGridTextColumn Header="当前位置" Binding="{Binding CurrentStorageLocation, Mode=OneWay}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#1B5E20"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="借出提示" Binding="{Binding BorrowHintDisplay, Mode=OneWay}" Width="120"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding LifecycleStatusDisplay, Mode=OneWay}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </GroupBox>
</UserControl>
