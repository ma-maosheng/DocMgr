<UserControl x:Class="DocMgr.Views.Shared.ItemDetailsPanelHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ItemCountDisplay}" Foreground="#64748B" FontSize="12"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
            <Button Content="{Binding ExpandToggleText}"
                    Command="{Binding ToggleExpandCommand}"
                    Margin="12,0,0,0" Padding="8,3" VerticalAlignment="Center"
                    Style="{StaticResource ButtonNormalStyle}"/>
        </StackPanel>
        <TextBlock Text="{Binding CollapsedSummary}"
                   Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                   Visibility="{Binding ShowCollapsedSummary, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    </StackPanel>
</UserControl>
