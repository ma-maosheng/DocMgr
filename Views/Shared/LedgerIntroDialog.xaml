<Window x:Class="DocMgr.Views.Shared.LedgerIntroDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="520"
        Width="640"
        MinHeight="400"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F5F5"
        Title="{Binding DialogTitle, Mode=OneWay}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding DialogTitle, Mode=OneWay}"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#333"
                   Margin="0,0,0,10"/>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="14,12">
                <StackPanel>
                    <TextBlock Text="业务范围"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="#1565C0"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding ScopeText, Mode=OneWay}"
                               TextWrapping="Wrap"
                               FontSize="13"
                               LineHeight="22"
                               LineStackingStrategy="BlockLineHeight"
                               Foreground="#333"
                               Margin="0,0,0,14"/>

                    <TextBlock Text="关联对象"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="#1565C0"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding RelatedObjectsText, Mode=OneWay}"
                               TextWrapping="Wrap"
                               FontSize="13"
                               LineHeight="22"
                               LineStackingStrategy="BlockLineHeight"
                               Foreground="#333"
                               Margin="0,0,0,14"/>

                    <TextBlock Text="写入逻辑"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="#1565C0"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding WriteLogicText, Mode=OneWay}"
                               TextWrapping="Wrap"
                               FontSize="13"
                               LineHeight="22"
                               LineStackingStrategy="BlockLineHeight"
                               Foreground="#333"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="2"
                Content="关闭"
                Width="96"
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                Style="{StaticResource DialogPrimaryActionButtonStyle}"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
