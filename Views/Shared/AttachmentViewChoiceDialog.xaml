<Window x:Class="DocMgr.Views.Shared.AttachmentViewChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="查看附件"
        Width="460"
        Height="220"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F7FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="请选择附件操作方式"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#1E293B"
                       Margin="0,0,0,10"/>
            <TextBlock x:Name="MessageTextBlock"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="#475569"
                       LineHeight="20"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="用默认程序打开"
                    Click="OpenButton_Click"
                    Padding="12,6"
                    Margin="0,0,8,0"
                    Style="{StaticResource DialogPrimaryActionButtonStyle}"/>
            <Button Content="另存为"
                    Click="SaveAsButton_Click"
                    Padding="12,6"
                    Margin="0,0,8,0"/>
            <Button Content="取消"
                    Click="CancelButton_Click"
                    Padding="12,6"
                    Style="{StaticResource DialogSecondaryActionButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
