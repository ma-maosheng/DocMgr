<Window x:Class="DocMgr.Views.Shared.SheetSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewShared="clr-namespace:DocMgr.Views.Shared"
        Width="520"
        Height="380"
        MinWidth="420"
        MinHeight="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="ToolWindow"
        Background="#F5F5F5">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button Content="关闭"
                Command="{x:Static viewShared:ViewCommands.CloseCurrentView}"
                Style="{StaticResource DialogCloseButtonStyle}"
                HorizontalAlignment="Right"/>

        <TextBlock Grid.Row="0"
                   Text="请选择："
                   FontSize="14"
                   FontWeight="Bold"
                   Foreground="#333"
                   TextWrapping="Wrap"
                   Margin="0,0,0,0"/>

        <ComboBox Grid.Row="1"
                  Margin="0,15,0,0"
                  Height="35"
                  Padding="5,8"
                  VerticalContentAlignment="Center"
                  FontSize="14"
                  ItemsSource="{Binding SheetNames}"
                  SelectedItem="{Binding SelectedSheet, Mode=TwoWay}"/>

        <DockPanel Grid.Row="2"
                   Margin="0,12,0,0"
                   LastChildFill="True"
                   Visibility="{Binding ShowCategoryInput, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock DockPanel.Dock="Left"
                       Text="分类："
                       Style="{StaticResource FormLabelTextBlockStyle}"
                       Width="48"
                       HorizontalAlignment="Right"
                       TextAlignment="Right"
                       VerticalAlignment="Center"/>
            <TextBox Text="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Height="{StaticResource FormControlHeight}"
                     VerticalContentAlignment="Center"
                     FontSize="13"
                     ToolTip="默认「规定前缀 + 工作表名」；须以「地形图：/航片：/其他：」开头且后缀非空，确定时校验。"/>
        </DockPanel>

        <CheckBox Grid.Row="3"
                  Margin="0,12,0,0"
                  VerticalAlignment="Top"
                  FontSize="13"
                  Content="{Binding ExpandItemsByTextLineContent, Mode=OneWay}"
                  IsChecked="{Binding ExpandItemsByTextLine, Mode=TwoWay}"
                  Visibility="{Binding ShowExpandItemsByTextLineOption, Converter={StaticResource BooleanToVisibilityConverter}}"
                  ToolTip="{Binding ExpandItemsByTextLineToolTip, Mode=OneWay}"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="确定" Style="{StaticResource DialogPrimaryActionButtonStyle}"
                    Command="{Binding ConfirmCommand}" Cursor="Hand"/>
            <Button Content="取消" Margin="10,0,0,0" Style="{StaticResource DialogSecondaryActionButtonStyle}"
                    Command="{Binding CancelCommand}" Cursor="Hand"/>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
