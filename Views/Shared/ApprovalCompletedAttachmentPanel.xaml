<UserControl x:Class="DocMgr.Views.Shared.ApprovalCompletedAttachmentPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <GroupBox Header="附件材料" Style="{DynamicResource Level1GroupBoxStyle}" Padding="10">
        <StackPanel>
            <TextBlock Margin="0,0,0,8"
                       Foreground="#B45309"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Visibility="{Binding CanSupplementOtherAttachments, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Text="{Binding SupplementAttachmentHint, Mode=OneWay}"/>
            <ListView ItemsSource="{Binding Attachments}"
                      Height="120"
                      BorderBrush="#EEE"
                      BorderThickness="1">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="文件名" Width="250" DisplayMemberBinding="{Binding FileName}"/>
                        <GridViewColumn Header="附件分类" Width="90" DisplayMemberBinding="{Binding FileCategoryDisplay}"/>
                        <GridViewColumn Header="上传时间" Width="140" DisplayMemberBinding="{Binding UploadTime, StringFormat='yyyy-MM-dd HH:mm'}"/>
                        <GridViewColumn Header="上传人" Width="90" DisplayMemberBinding="{Binding UploaderName}"/>
                        <GridViewColumn Header="操作" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="查看"
                                            Style="{DynamicResource ButtonNormalStyle}"
                                            Command="{Binding DataContext.ViewAttachmentCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>
    </GroupBox>
</UserControl>
