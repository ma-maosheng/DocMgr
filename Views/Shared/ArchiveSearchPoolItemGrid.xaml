<UserControl x:Class="DocMgr.Views.Shared.ArchiveSearchPoolItemGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:DocMgr.Views.Shared">
    <!--
      立档检索池 / 入网检索集明细共用表。
      列序：单据与资料 → 分类 → 载体与介质内容 → 数量 → 存放 → 状态。
      「载体类型」始终显示；「介质类型 / 所在目录 / 数据量」由 ShowElectronicColumns 控制。
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <shared:BindingProxy x:Key="SelfProxy"/>
        <Style x:Key="WrapCellTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ScopeCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource WrapCellTextStyle}">
            <Setter Property="Foreground" Value="#00695C"/>
        </Style>
        <Style x:Key="CurrentLocationCellTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1B5E20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <DataGrid x:Name="ItemGrid"
              ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=shared:ArchiveSearchPoolItemGrid}}"
              SelectedItem="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=shared:ArchiveSearchPoolItemGrid}, Mode=TwoWay}"
              IsReadOnly="{Binding IsGridReadOnly, RelativeSource={RelativeSource AncestorType=shared:ArchiveSearchPoolItemGrid}}"
              MinHeight="{Binding MinHeight, RelativeSource={RelativeSource AncestorType=shared:ArchiveSearchPoolItemGrid}}"
              MaxHeight="{Binding MaxHeight, RelativeSource={RelativeSource AncestorType=shared:ArchiveSearchPoolItemGrid}}"
              BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=shared:ArchiveSearchPoolItemGrid}}"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"
              AlternatingRowBackground="#F8FAFC"
              RowHeight="34"
              VerticalAlignment="Stretch"
              HorizontalAlignment="Stretch">
        <DataGrid.Columns>
            <DataGridTextColumn Header="表单号" Binding="{Binding FormNo, Mode=OneWay}" Width="150" IsReadOnly="True"/>
            <DataGridTextColumn Header="项目年度" Binding="{Binding ProjectYear, Mode=OneWay}" Width="70" IsReadOnly="True"/>
            <DataGridTextColumn Header="所属项目" Binding="{Binding ProjectName, Mode=OneWay}" Width="140" IsReadOnly="True"/>
            <DataGridTextColumn Header="资料名称" Binding="{Binding MaterialName, Mode=OneWay}" Width="*" IsReadOnly="True"/>
            <DataGridTextColumn Header="子项名称" Binding="{Binding ItemName, Mode=OneWay}" Width="140" IsReadOnly="True"/>
            <DataGridTextColumn Header="库管模式" Binding="{Binding ArchivePurpose, Mode=OneWay}" Width="88" IsReadOnly="True"/>
            <DataGridTemplateColumn Header="密级" Width="70"
                                    IsReadOnly="{Binding Data.ConfidentialLevelIsReadOnly, Source={StaticResource SelfProxy}}">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ConfidentialLevel, Mode=OneWay}" VerticalAlignment="Center" Margin="6,0"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                <DataGridTemplateColumn.CellEditingTemplate>
                    <DataTemplate>
                        <ComboBox ItemsSource="{Binding Data.ConfidentialLevelOptions, Source={StaticResource SelfProxy}}"
                                  SelectedItem="{Binding ConfidentialLevel, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding Data.CanEditConfidentialLevel, Source={StaticResource SelfProxy}}"
                                  Style="{StaticResource FormComboBoxStyle}"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellEditingTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="资料类型" Binding="{Binding MaterialCategory, Mode=OneWay}" Width="72" IsReadOnly="True"/>
            <DataGridTextColumn Header="所属子类" Binding="{Binding SubCategory, Mode=OneWay}" Width="88" IsReadOnly="True"/>
            <DataGridTextColumn Header="组织形式" Binding="{Binding DataOrganizationForm, Mode=OneWay}" Width="72" IsReadOnly="True"/>
            <DataGridTextColumn Header="载体类型" Binding="{Binding RegisterMediaType, Mode=OneWay}" Width="80" IsReadOnly="True"/>
            <DataGridTextColumn Header="介质类型" Binding="{Binding StorageCarrierTypeDisplay, Mode=OneWay}" Width="80" IsReadOnly="True">
                <DataGridTextColumn.Visibility>
                    <Binding Path="Data.ShowElectronicColumns" Source="{StaticResource SelfProxy}" Converter="{StaticResource BooleanToVisibilityConverter}"/>
                </DataGridTextColumn.Visibility>
            </DataGridTextColumn>
            <DataGridTextColumn Header="所在目录" Binding="{Binding FilingDirectoryDisplay, Mode=OneWay}" Width="200" IsReadOnly="True"
                                ElementStyle="{StaticResource WrapCellTextStyle}">
                <DataGridTextColumn.Visibility>
                    <Binding Path="Data.ShowElectronicColumns" Source="{StaticResource SelfProxy}" Converter="{StaticResource BooleanToVisibilityConverter}"/>
                </DataGridTextColumn.Visibility>
            </DataGridTextColumn>
            <DataGridTextColumn Header="筛选范围" Binding="{Binding SelectionScopeDisplay, Mode=OneWay}" Width="180" IsReadOnly="True"
                                ElementStyle="{StaticResource ScopeCellTextStyle}"/>
            <DataGridTextColumn Header="命中明细" Binding="{Binding MatchedContentEntrySummary, Mode=OneWay}" Width="200" IsReadOnly="True"
                                ElementStyle="{StaticResource ScopeCellTextStyle}"/>
            <DataGridTemplateColumn Header="份数" Width="70"
                                    IsReadOnly="{Binding Data.CopyCountIsReadOnly, Source={StaticResource SelfProxy}}">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="{Binding RequestedCopyCount, Mode=OneWay}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCopyCountEditable}" Value="False">
                                            <Setter Property="Text" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                <DataGridTemplateColumn.CellEditingTemplate>
                    <DataTemplate>
                        <TextBox HorizontalContentAlignment="Center" VerticalAlignment="Center"
                                 Text="{Binding RequestedCopyCount, UpdateSourceTrigger=LostFocus, Mode=TwoWay}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCopyCountEditable}" Value="False">
                                            <Setter Property="IsReadOnly" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </DataTemplate>
                </DataGridTemplateColumn.CellEditingTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="数据量" Binding="{Binding DataSizeDisplay, Mode=OneWay}" Width="90" IsReadOnly="True">
                <DataGridTextColumn.Visibility>
                    <Binding Path="Data.ShowElectronicColumns" Source="{StaticResource SelfProxy}" Converter="{StaticResource BooleanToVisibilityConverter}"/>
                </DataGridTextColumn.Visibility>
            </DataGridTextColumn>
            <DataGridTextColumn Header="档案盒/介质袋编号" Binding="{Binding ContainerCode, Mode=OneWay}" Width="130" IsReadOnly="True"/>
            <DataGridTextColumn Header="立档位置" Binding="{Binding StorageLocation, Mode=OneWay}" Width="100" IsReadOnly="True"/>
            <DataGridTextColumn Header="当前位置" Binding="{Binding CurrentStorageLocation, Mode=OneWay}" Width="100" IsReadOnly="True"
                                ElementStyle="{StaticResource CurrentLocationCellTextStyle}"/>
            <DataGridTextColumn Header="借出提示" Binding="{Binding BorrowHintDisplay, Mode=OneWay}" Width="120" IsReadOnly="True"/>
            <DataGridTextColumn Header="状态" Binding="{Binding LifecycleStatusDisplay, Mode=OneWay}" Width="80" IsReadOnly="True"/>
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
