<Window x:Class="DocMgr.Views.Shared.ImportOptionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewShared="clr-namespace:DocMgr.Views.Shared"
        Width="520"
        MinWidth="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right"
                    Content="关闭"
                    Command="{x:Static viewShared:ViewCommands.CloseCurrentView}"
                    Style="{StaticResource DialogCloseButtonStyle}"
                    Margin="12,0,0,0"
                    VerticalAlignment="Top"/>
            <TextBlock Text="{Binding Message}"
                       TextWrapping="Wrap"
                       FontSize="14"
                       Foreground="#333"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="4,0,0,8">
            <RadioButton IsChecked="{Binding IsAppendMode, Mode=TwoWay}"
                         Margin="0,0,0,8"
                         FontSize="13"
                         VerticalContentAlignment="Top">
                <TextBlock TextWrapping="Wrap"
                           Text="追加导入（保留现有数据，新增数据追加到末尾）"/>
            </RadioButton>
            <RadioButton IsChecked="{Binding IsRecreateMode, Mode=TwoWay}"
                         Margin="0,0,0,4"
                         FontSize="13"
                         VerticalContentAlignment="Top">
                <TextBlock TextWrapping="Wrap"
                           Text="重新建表（清空现有表数据，重新导入）"/>
            </RadioButton>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="确定"
                    Style="{StaticResource DialogPrimaryActionButtonStyle}"
                    Command="{Binding ConfirmCommand}"
                    Cursor="Hand"/>
            <Button Content="取消"
                    Margin="10,0,0,0"
                    Style="{StaticResource DialogSecondaryActionButtonStyle}"
                    Command="{Binding CancelCommand}"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
