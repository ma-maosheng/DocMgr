<UserControl x:Class="DocMgr.Views.Shared.OperationProgressOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#CCF5F7FA">
    <Border HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="White"
            BorderBrush="#D1D5DB"
            BorderThickness="1"
            CornerRadius="6"
            Padding="20,16"
            MinWidth="360"
            MaxWidth="480">
        <StackPanel>
            <TextBlock Text="{Binding Title, Mode=OneWay}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#1F2937"
                       Margin="0,0,0,10"/>
            <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="#334155"
                       Margin="0,0,0,12"/>
            <Grid Height="16">
                <ProgressBar IsIndeterminate="True">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsIndeterminate, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <ProgressBar Minimum="0"
                             Maximum="100"
                             IsIndeterminate="False"
                             Value="{Binding ProgressValue, Mode=OneWay}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsIndeterminate, Mode=OneWay}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </Grid>
            <TextBlock Margin="0,8,0,0"
                       HorizontalAlignment="Right"
                       FontSize="12"
                       Foreground="#64748B"
                       Text="{Binding PercentText, Mode=OneWay}"/>
        </StackPanel>
    </Border>
</UserControl>
