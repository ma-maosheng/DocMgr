<Window x:Class="DocMgr.Views.Shared.AttachmentPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="附件预览"
        Width="960"
        Height="720"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F7FA">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TitleTextBlock" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="图像已在程序内预览；如需编辑或打印，可使用系统程序打开或另存为。"
                       Margin="0,6,0,0"
                       Foreground="#64748B"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#D8E2EC"
                BorderThickness="1"
                CornerRadius="4">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="#111827">
                <Image x:Name="PreviewImage"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="12"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="用系统程序打开"
                    Click="OpenWithDefaultAppButton_Click"
                    Padding="12,6"
                    Margin="0,0,8,0"/>
            <Button Content="另存为"
                    Click="SaveAsButton_Click"
                    Padding="12,6"
                    Margin="0,0,8,0"/>
            <Button Content="关闭"
                    Click="CloseButton_Click"
                    Padding="16,6"
                    Style="{StaticResource DialogPrimaryActionButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
