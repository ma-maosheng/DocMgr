<UserControl x:Class="DocMgr.Views.Shared.ApplicationRequestHeaderSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DocMgr.Views.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../YearlyArchive/ArchiveRegisterResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <GroupBox Header="1. 申请信息" Style="{StaticResource Level1GroupBoxStyle}">
        <StackPanel>
            <DockPanel Margin="{StaticResource YaRegFormRowMargin}" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ShowSubmitActions}" Value="True"/>
                                        <Condition Binding="{Binding ShowEmbeddedActionButtons}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Content="💾 保存草稿" Command="{Binding SaveDraftCommand}"
                            Padding="10,0" Margin="0,0,8,0" Width="100" Style="{StaticResource ButtonNormalStyle}"/>
                    <Button Content="💾 提交申请" Command="{Binding SubmitCommand}"
                            Padding="10,0" Margin="0,0,8,0" Width="100" Style="{StaticResource ButtonNormalStyle}"/>
                    <Button Content="💾 打印申请" Command="{Binding PrintCommand}"
                            Padding="10,0" Width="100" Style="{StaticResource ButtonNormalStyle}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource ArchiveRegisterCardLabelStyle}" Text="申请人 *："/>
                    <TextBox Width="{StaticResource YaRegPersonNameWidth}"
                             Margin="{StaticResource YaRegFieldTrailingMargin}"
                             Text="{Binding ApplicantName, Mode=OneWay}"
                             IsReadOnly="True"
                             Background="#F5F5F5"
                             Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"/>
                    <TextBlock Style="{StaticResource ArchiveRegisterInlineLabelStyle}" Text="部门 *："/>
                    <TextBox Width="{StaticResource YaRegDepartmentWidth}"
                             Margin="{StaticResource YaRegFieldTrailingMargin}"
                             Text="{Binding ApplicantDept, Mode=OneWay}"
                             IsReadOnly="True"
                             Background="#F5F5F5"
                             Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"/>
                    <TextBlock Style="{StaticResource ArchiveRegisterInlineLabelStyle}" Text="日期 *："/>
                    <DatePicker Width="{StaticResource YaRegDateWidth}"
                                SelectedDate="{Binding ApplicationDate}"
                                IsEnabled="{Binding CanEditApplicationDate}"
                                Style="{StaticResource ArchiveRegisterFormDatePickerStyle}"/>
                </StackPanel>
            </DockPanel>

            <ContentPresenter Content="{Binding IdentityContent, RelativeSource={RelativeSource AncestorType=local:ApplicationRequestHeaderSectionView}}"/>

            <DockPanel Margin="{StaticResource YaRegFormRowMargin}" LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Width="110" Style="{StaticResource FormLabelTextBlockStyle}" Text="申请说明 *："/>
                <TextBox Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                         Text="{Binding ApplicationReason, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding CanEdit}"/>
            </DockPanel>

            <DockPanel Margin="{StaticResource YaRegFormRowMargin}" LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Width="110" Style="{StaticResource FormLabelTextBlockStyle}" Text="其他要求："/>
                <TextBox Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                         Text="{Binding OtherRequests, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding CanEdit}"/>
            </DockPanel>

            <DockPanel Margin="{StaticResource YaRegFormRowMargin}" LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Width="110" Style="{StaticResource FormLabelTextBlockStyle}" Text="附有证明材料："/>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            Style="{StaticResource FormInlineRadioGroupStyle}"
                            Margin="{StaticResource YaRegFieldTrailingMargin}"
                            IsEnabled="{Binding CanEdit}">
                    <RadioButton Content="是"
                                 GroupName="ApplicationRequestProofMaterial"
                                 Style="{StaticResource ArchiveRegisterFormRadioButtonStyle}"
                                 IsChecked="{Binding HasProofMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <RadioButton Content="否"
                                 GroupName="ApplicationRequestProofMaterial"
                                 Style="{StaticResource ArchiveRegisterFormRadioButtonStyle}"
                                 IsChecked="{Binding HasProofMaterial, Converter={StaticResource InverseBoolRadioConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" MinWidth="140" IsEnabled="{Binding CanEdit}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasProofMaterial}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Style="{StaticResource ArchiveRegisterInlineLabelStyle}" Text="名称："/>
                    <TextBox Width="220"
                             Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                             Text="{Binding ProofMaterialName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="填写证明材料名称；审批环节由资料管理员上传扫描件"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </GroupBox>
</UserControl>
