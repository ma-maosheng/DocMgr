<UserControl x:Class="DocMgr.Views.Shared.IntegerSpinnerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="72"
             MinHeight="24"
             Focusable="False">
    <Border BorderBrush="#CFD8DC" BorderThickness="1" Background="White" CornerRadius="2">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="ValueTextBox"
                     Grid.Column="0"
                     BorderThickness="0"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Center"
                     Padding="4,0"
                     Background="Transparent"
                     PreviewKeyDown="ValueTextBox_PreviewKeyDown"
                     PreviewTextInput="ValueTextBox_PreviewTextInput"
                     LostFocus="ValueTextBox_LostFocus"
                     TextChanged="ValueTextBox_TextChanged"/>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <RepeatButton x:Name="IncreaseButton"
                              Grid.Row="0"
                              Content="▲"
                              FontSize="7"
                              Padding="0"
                              Margin="0"
                              BorderThickness="1,0,0,0"
                              BorderBrush="#CFD8DC"
                              Click="IncreaseButton_Click"
                              Focusable="False"
                              Interval="80"
                              Delay="300"/>
                <RepeatButton x:Name="DecreaseButton"
                              Grid.Row="1"
                              Content="▼"
                              FontSize="7"
                              Padding="0"
                              Margin="0"
                              BorderThickness="1,1,0,0"
                              BorderBrush="#CFD8DC"
                              Click="DecreaseButton_Click"
                              Focusable="False"
                              Interval="80"
                              Delay="300"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
