<Window x:Class="DocMgr.Views.Shared.DocumentCameraCaptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewShared="clr-namespace:DocMgr.Views.Shared"
        Title="高影仪直拍"
        Width="960"
        Height="720"
        MinWidth="760"
        MinHeight="560"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="#F5F7FA">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right"
              Content="关闭"
              Command="{x:Static viewShared:ViewCommands.CloseCurrentView}"
              Style="{StaticResource DialogCloseButtonStyle}"/>
      <TextBlock Text="高影仪直拍"
                 FontSize="16"
                 FontWeight="Bold"
                 VerticalAlignment="Center"
                 Foreground="#1E293B"/>
    </DockPanel>

    <TextBlock Grid.Row="1"
               Text="{Binding StatusText, Mode=OneWay}"
               Foreground="#64748B"
               TextWrapping="Wrap"
               Margin="0,0,0,8"/>

    <Grid Grid.Row="2" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="64"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="48"/>
        <ColumnDefinition Width="140"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="拍摄设备"
                 VerticalAlignment="Center"
                 Style="{StaticResource FormLabelTextBlockStyle}"
                 HorizontalAlignment="Left"/>
      <ComboBox Grid.Column="1"
                ItemsSource="{Binding Devices}"
                SelectedItem="{Binding SelectedDevice}"
                DisplayMemberPath="DisplayName"
                IsEnabled="{Binding CanChangeDevice}"
                Style="{StaticResource FormComboBoxStyle}"/>
      <TextBlock Grid.Column="3"
                 Text="像素数"
                 VerticalAlignment="Center"
                 Style="{StaticResource FormLabelTextBlockStyle}"
                 HorizontalAlignment="Left"/>
      <ComboBox Grid.Column="4"
                ItemsSource="{Binding Resolutions}"
                SelectedItem="{Binding SelectedResolution}"
                DisplayMemberPath="DisplayName"
                IsEnabled="{Binding CanChangeDevice}"
                Style="{StaticResource FormComboBoxStyle}"/>
      <Button Grid.Column="6"
              Content="刷新"
              Style="{StaticResource DialogSecondaryActionButtonStyle}"
              Command="{Binding RefreshCommand}"/>
    </Grid>

    <Border Grid.Row="3"
            Margin="0,0,0,8"
            Padding="8,6"
            Background="#FAFBFC"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="4">
      <StackPanel>
        <DockPanel LastChildFill="True" Margin="0,0,0,6">
          <Button DockPanel.Dock="Right"
                  Content="恢复默认"
                  Padding="8,2"
                  Command="{Binding RestoreDefaultsCommand}"/>
          <TextBlock Text="影像处理（按当前用户保存在本机，重开直拍或重新登录后仍有效）"
                     FontSize="12"
                     Foreground="#475569"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"/>
        </DockPanel>
        <WrapPanel Orientation="Horizontal">
          <CheckBox Content="自动切边" Margin="0,0,12,4"
                    Style="{StaticResource ToolbarFilterCheckBoxStyle}"
                    IsChecked="{Binding AutoCrop}"/>
          <CheckBox Content="形变校正" Margin="0,0,12,4"
                    Style="{StaticResource ToolbarFilterCheckBoxStyle}"
                    IsChecked="{Binding PerspectiveCorrection}"/>
          <CheckBox Content="去除黑边" Margin="0,0,12,4"
                    Style="{StaticResource ToolbarFilterCheckBoxStyle}"
                    IsChecked="{Binding RemoveBlackBorder}"/>
          <CheckBox Content="白底文档" Margin="0,0,12,4"
                    Style="{StaticResource ToolbarFilterCheckBoxStyle}"
                    IsChecked="{Binding WhiteDocument}"/>
          <CheckBox Content="去除阴影" Margin="0,0,12,4"
                    Style="{StaticResource ToolbarFilterCheckBoxStyle}"
                    IsChecked="{Binding RemoveShadow}"/>
          <CheckBox Content="自动扶正" Margin="0,0,12,4"
                    Style="{StaticResource ToolbarFilterCheckBoxStyle}"
                    IsChecked="{Binding AutoDeskew}"/>
          <CheckBox Content="镜像" Margin="0,0,12,4"
                    Style="{StaticResource ToolbarFilterCheckBoxStyle}"
                    IsChecked="{Binding Mirror}"/>
          <CheckBox Content="锐化" Margin="0,0,12,4"
                    Style="{StaticResource ToolbarFilterCheckBoxStyle}"
                    IsChecked="{Binding Sharpen}"/>
        </WrapPanel>
        <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
          <TextBlock Text="旋转" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#4B5563" FontSize="12"/>
          <Button Content="左转" Width="48" Padding="4,2" Margin="0,0,4,0" Command="{Binding RotateLeftCommand}"/>
          <TextBlock Text="{Binding RotationDisplay, Mode=OneWay}" Width="36" VerticalAlignment="Center" TextAlignment="Center"/>
          <Button Content="右转" Width="48" Padding="4,2" Margin="0,0,16,0" Command="{Binding RotateRightCommand}"/>
          <TextBlock Text="色彩" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#4B5563" FontSize="12"/>
          <ComboBox Width="88" Margin="0,0,16,0"
                    ItemsSource="{Binding ColorModeOptions}"
                    DisplayMemberPath="DisplayName"
                    SelectedValuePath="Value"
                    SelectedValue="{Binding ColorMode}"
                    Style="{StaticResource ToolbarFilterComboBoxStyle}"/>
          <TextBlock Text="亮度" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#4B5563" FontSize="12"/>
          <Slider Width="110" Minimum="-50" Maximum="50" TickFrequency="5"
                  VerticalAlignment="Center" Margin="0,0,16,0"
                  Value="{Binding Brightness}"/>
          <TextBlock Text="对比度" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#4B5563" FontSize="12"/>
          <Slider Width="110" Minimum="-50" Maximum="50" TickFrequency="5"
                  VerticalAlignment="Center"
                  Value="{Binding Contrast}"/>
        </WrapPanel>
      </StackPanel>
    </Border>

    <Grid Grid.Row="4">
      <Border Background="#111827"
              BorderBrush="#D8E2EC"
              BorderThickness="1"
              CornerRadius="4">
        <Image Source="{Binding PreviewImage, Mode=OneWay}"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Margin="8">
          <Image.LayoutTransform>
            <TransformGroup>
              <ScaleTransform ScaleX="{Binding PreviewMirrorScaleX, Mode=OneWay}"/>
              <RotateTransform Angle="{Binding PreviewRotationAngle, Mode=OneWay}"/>
            </TransformGroup>
          </Image.LayoutTransform>
        </Image>
      </Border>
      <TextBlock Text="等待预览画面…"
                 Visibility="{Binding ShowPreviewPlaceholder, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                 Foreground="#94A3B8"
                 FontSize="14"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 IsHitTestVisible="False"/>
    </Grid>

    <StackPanel Grid.Row="5"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,12,0,0">
      <Button Content="拍摄"
              Padding="12,6"
              Margin="0,0,8,0"
              IsEnabled="{Binding CanCapture}"
              Command="{Binding CaptureCommand}"/>
      <Button Content="重拍"
              Padding="12,6"
              Margin="0,0,8,0"
              IsEnabled="{Binding CanRetake}"
              Command="{Binding RetakeCommand}"/>
      <Button Content="确认上传"
              Padding="12,6"
              Margin="0,0,8,0"
              FontWeight="SemiBold"
              IsEnabled="{Binding CanConfirm}"
              Command="{Binding ConfirmCommand}"/>
      <Button Content="关闭"
              Padding="12,6"
              Command="{Binding CloseCommand}"/>
    </StackPanel>
  </Grid>
</Window>
