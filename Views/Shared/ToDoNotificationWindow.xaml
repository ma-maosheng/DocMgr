<Window x:Class="DocMgr.Views.Shared.ToDoNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewShared="clr-namespace:DocMgr.Views.Shared"
        Width="420"
        Height="320"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Background="White">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button Content="关闭"
                Command="{x:Static viewShared:ViewCommands.CloseCurrentView}"
                Style="{StaticResource DialogCloseButtonStyle}"
                HorizontalAlignment="Right"/>

        <TextBlock Text="{Binding SummaryText}"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#333"
                   Margin="0,0,120,10"/>

        <ListBox Grid.Row="1" ItemsSource="{Binding Items}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            HorizontalContentAlignment="Stretch"
                            Padding="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ButtonNormalStyle}">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>

                        <Border BorderBrush="#EEE" BorderThickness="0,0,0,1" Padding="0,6">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding BizNo, StringFormat=单号：{0}}" Foreground="#666" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding Stage, StringFormat=环节：{0}}" Foreground="#666"/>
                            </StackPanel>
                        </Border>
                    </Button>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="知道了"
                    Command="{Binding CloseCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource DialogPrimaryActionButtonStyle}">
                        <Setter Property="IsEnabled" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>