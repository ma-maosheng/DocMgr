<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- 表单控件统一高度令牌 -->
    <sys:Double x:Key="FormControlHeight">28</sys:Double>
    <sys:Double x:Key="ToolbarControlHeight">32</sys:Double>
    <sys:Double x:Key="DialogFormControlHeight">34</sys:Double>

    <!-- 表单行内标签（TextBlock，用于 Grid 两列布局） -->
    <Style x:Key="FormLabelTextBlockStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <!-- 表单行内标签（Label，消除默认 Padding 造成的错位） -->
    <Style x:Key="FormLabelStyle" TargetType="Label">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>

    <!-- 对话框字段上方标签 -->
    <Style x:Key="FormFieldCaptionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#666666"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- 标准表单输入控件 -->
    <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="{StaticResource FormControlHeight}"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="{StaticResource FormControlHeight}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FormDatePickerStyle" TargetType="DatePicker">
        <Setter Property="Height" Value="{StaticResource FormControlHeight}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 与 ComboBox/DatePicker 同高的行内单选按钮 -->
    <Style x:Key="FormRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Height" Value="{StaticResource FormControlHeight}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,16,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- 标签在上方的字段值行：统一占位高度，避免 Radio 与 ComboBox 视觉错位 -->
    <Style x:Key="FormFieldValueHostStyle" TargetType="Grid">
        <Setter Property="MinHeight" Value="{StaticResource FormControlHeight}"/>
    </Style>

    <!-- 行内是/否单选组 -->
    <Style x:Key="FormInlineRadioGroupStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="MinHeight" Value="{StaticResource FormControlHeight}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 标签在上方的字段列（标题 + 控件） -->
    <Style x:Key="FormLabeledFieldColumnStyle" TargetType="StackPanel">
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <!-- 与 ComboBox 同高的行内复选框 -->
    <Style x:Key="FormCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Height" Value="{StaticResource FormControlHeight}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- 工具栏筛选区 -->
    <Style x:Key="ToolbarFilterLabelStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="Foreground" Value="#4B5563"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
    </Style>

    <Style x:Key="ToolbarFilterTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}">
        <Setter Property="Height" Value="{StaticResource ToolbarControlHeight}"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="BorderBrush" Value="#E5E7EB"/>
    </Style>

    <Style x:Key="ToolbarFilterComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource FormComboBoxStyle}">
        <Setter Property="Height" Value="{StaticResource ToolbarControlHeight}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="ToolbarFilterDatePickerStyle" TargetType="DatePicker" BasedOn="{StaticResource FormDatePickerStyle}">
        <Setter Property="Height" Value="{StaticResource ToolbarControlHeight}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="ToolbarFilterCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- 兼容旧页面别名（台账等紧凑筛选区，28px） -->
    <Style x:Key="FilterLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource ToolbarFilterLabelStyle}">
        <Setter Property="Width" Value="44"/>
    </Style>

    <Style x:Key="FilterInputStyle" TargetType="ComboBox" BasedOn="{StaticResource FormComboBoxStyle}">
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="FilterDatePickerStyle" TargetType="DatePicker" BasedOn="{StaticResource FormDatePickerStyle}">
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="SearchTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}">
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="BorderBrush" Value="#E5E7EB"/>
    </Style>

</ResourceDictionary>
