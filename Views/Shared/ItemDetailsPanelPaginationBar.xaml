<UserControl x:Class="DocMgr.Views.Shared.ItemDetailsPanelPaginationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="0,8,0,0">
        <DockPanel.Style>
            <Style TargetType="DockPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowPagination}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </DockPanel.Style>
        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#64748B" FontSize="12"
                   Text="{Binding PageInfo}"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="首页" Width="64" Margin="0,0,6,0" Command="{Binding FirstPageCommand}"/>
            <Button Content="上一页" Width="72" Margin="0,0,6,0" Command="{Binding PreviousPageCommand}"/>
            <Button Content="下一页" Width="72" Margin="0,0,6,0" Command="{Binding NextPageCommand}"/>
            <Button Content="末页" Width="64" Command="{Binding LastPageCommand}"/>
        </StackPanel>
    </DockPanel>
</UserControl>
