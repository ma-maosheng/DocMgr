                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="#E3F2FD" Margin="0,0,10,0">
                                            <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#1565C0"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="检索 → 检索池 → 借出/入网" FontWeight="SemiBold" Foreground="#1F2937"/>
