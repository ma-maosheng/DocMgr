                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="#F3E5F5" Margin="0,0,10,0">
                                            <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#7B1FA2"/>
