                                               Text="0"
                                               Foreground="White"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="4,0"/>
                                </Border>
                            </Grid>

                            <Rectangle Width="1" Height="14" Fill="#E0E0E0" Margin="12,0,0,0"
                                       IsHitTestVisible="False"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="HomeContentPanel"
                              Grid.Row="1" Grid.RowSpan="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="20,16,12,20">
                    <StackPanel>
                        <Border Background="{StaticResource HomeHeroBrush}" CornerRadius="16" Padding="22,18" Margin="0,0,8,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="260"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="测绘资料管理系统" Foreground="White" FontSize="26" FontWeight="Bold"/>
                                    <TextBlock Text="面向资料室日常作业：年度资料按模拟盒、电子袋双轨立档并落柜，再经检索、借还、迁档、盘库与离库形成闭环；出入网、历史图件、档案柜与硬盘/光盘介质在同一工作台协同。"
                                               Foreground="#E8FFFB" FontSize="13.5" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,14,0,0">
                                        <Border Background="#20FFFFFF" CornerRadius="10" Padding="12,7" Margin="0,0,8,8">
                                            <StackPanel>
                                                <TextBlock Text="资料形态" Foreground="#D9FFFA" FontSize="11"/>
                                                <TextBlock Text="模拟盒 · 电子袋" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#20FFFFFF" CornerRadius="10" Padding="12,7" Margin="0,0,8,8">
                                            <StackPanel>
                                                <TextBlock Text="存放位置" Foreground="#D9FFFA" FontSize="11"/>
                                                <TextBlock Text="柜体 · 档口 · 盒袋" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#20FFFFFF" CornerRadius="10" Padding="12,7" Margin="0,0,8,8">
                                            <StackPanel>
                                                <TextBlock Text="办理方式" Foreground="#D9FFFA" FontSize="11"/>
                                                <TextBlock Text="申请 · 审批 · 签批办结" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>

                                <Border Grid.Column="2" Background="#18FFFFFF" CornerRadius="14" Padding="14">
