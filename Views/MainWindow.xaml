                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource HomeCardStyle}" Padding="16" Margin="0,0,0,10">
