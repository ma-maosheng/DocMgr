                                                   Style="{StaticResource HomeBodyStyle}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource HomeCardStyle}" Padding="16" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="使用提示" Style="{StaticResource HomeSectionTitleStyle}"/>
