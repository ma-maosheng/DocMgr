<Window x:Class="DocMgr.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DocMgr"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Height="720" Width="1280" WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow" Background="#F0F2F5">

    <!-- windowchrome 与 resources 保持不变 ... -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="60" ResizeBorderThickness="8" GlassFrameThickness="1" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 主容器样式 -->
        <Style x:Key="MainContainerStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="#F0F2F5"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                    <Setter Property="Margin" Value="8"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 侧栏导航专用模板：禁用态保持暗色弱化，避免继承全局按钮的浅灰底（易被误认为选中） -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="ActiveBar"
                                        Width="3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        Background="Transparent"/>
                                <ContentPresenter x:Name="Content"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="ActiveBar" Property="Background" Value="#4DB6AC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsEnabled" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#455A64"/>
                </MultiTrigger>
                <!-- 当前打开页：暗底微抬亮 + 左侧色条，不抢侧栏整体色调 -->
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Background" Value="#3A4F57"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsEnabled" Value="True"/>
                        <Condition Property="Tag" Value="Active"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#455A64"/>
                </MultiTrigger>
                <!-- 无权限：字色仍可读，仅略弱于正常项，不用低透明度 -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#9AA8B0"/>
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SubNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Padding" Value="36,12,16,12"/>
            <Setter Property="Foreground" Value="#CFD8DC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#2F3D44"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsEnabled" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#3D4D55"/>
                </MultiTrigger>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Background" Value="#3A4F57"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsEnabled" Value="True"/>
                        <Condition Property="Tag" Value="Active"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#455A64"/>
                </MultiTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#9AA8B0"/>
                    <Setter Property="Background" Value="#28343A"/>
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SubSubNavButton" TargetType="Button" BasedOn="{StaticResource SubNavButton}">
            <Setter Property="Padding" Value="56,10,16,10"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#B0BEC5"/>
            <Setter Property="Background" Value="#243138"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsEnabled" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#32424A"/>
                </MultiTrigger>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Background" Value="#3A4F57"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsEnabled" Value="True"/>
                        <Condition Property="Tag" Value="Active"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#455A64"/>
                </MultiTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#9AA8B0"/>
                    <Setter Property="Background" Value="#1F2A30"/>
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <LinearGradientBrush x:Key="HomeHeroBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F6B63" Offset="0"/>
            <GradientStop Color="#2C8F84" Offset="0.55"/>
            <GradientStop Color="#8CCDC3" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="HomeCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="BorderBrush" Value="#E4E8EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#14000000" BlurRadius="18" ShadowDepth="3" Opacity="0.18"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Expander" x:Key="SubNavExpander">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#D0D8DC"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderSite"
                                          Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="#2B3940"
                                          BorderThickness="0"
                                          Foreground="{TemplateBinding Foreground}"
                                          Padding="38,12,16,12"
                                          HorizontalContentAlignment="Left">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ContentPresenter Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" ContentSource="Content"/>
                                                            <Path x:Name="Arrow" Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Stroke="#CFD8DC" StrokeThickness="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Arrow" Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <RotateTransform Angle="180" CenterX="4" CenterY="2"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#36464E"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Background" Value="#3E525A"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="0,0,0,5"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HomeMetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>

        <Style x:Key="HomeMetricLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Expander 样式 -->
        <Style TargetType="Expander" x:Key="NavExpander">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderSite"
                                          Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Foreground="{TemplateBinding Foreground}"
                                          Padding="20,15"
                                          HorizontalContentAlignment="Left">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ContentPresenter Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" ContentSource="Content"/>
                                                            <Path x:Name="Arrow" Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Stroke="White" StrokeThickness="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Arrow" Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <RotateTransform Angle="180" CenterX="4" CenterY="2"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#455A64"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Background" Value="#37474F"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="0,0,0,5"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader" x:Key="DataGridHeaderStyle">
            <Setter Property="Background" Value="#FF397E7A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource MainContainerStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. 左侧导航栏 -->
            <Grid Grid.Column="0" Background="#FF263238">
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                    <!-- 底部操作栏 -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo/标题区域 -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="河北省第三测绘院" Foreground="White" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="测绘资料管理系统" Foreground="White" FontSize="14"
                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- 导航按钮区 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
                    <StackPanel>

                        <!-- NEW: 年度项目管理 -->
                        <Expander x:Name="ExpProjects" Header="年度项目管理" Style="{StaticResource NavExpander}">
                            <StackPanel>
                                <Button x:Name="BtnProjectInfo" Content="项目信息设置" Style="{StaticResource SubNavButton}" Click="BtnProjectSetting_Click"/>
                            </StackPanel>
                        </Expander>

                        <!-- 1. 年度资料档案化管理 -->
                        <Expander x:Name="ExpYearlyArchive" Header="年度资料档案化管理" Style="{StaticResource NavExpander}">
                            <StackPanel>
                                <Expander Header="模拟测试" Style="{StaticResource SubNavExpander}">
                                    <StackPanel>
                                        <Button x:Name="BtnArchiveSimulation" Content="模拟登记_方式1" Style="{StaticResource SubSubNavButton}" Click="BtnArchiveSimulation_Click"/>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="资料建档" Style="{StaticResource SubNavExpander}">
                                    <StackPanel>
                                        <Button x:Name="BtnArchiveRegisterApply" Content="建档申请" Style="{StaticResource SubSubNavButton}" Click="BtnArchiveRegisterApply_Click"/>
                                        <Button x:Name="BtnArchiveRegisterApprove" Content="申请审批" Style="{StaticResource SubSubNavButton}" Click="BtnArchiveRegisterApprove_Click"/>
                                        <Button x:Name="BtnArchiveFiling" Content="资料立档" Style="{StaticResource SubSubNavButton}" Click="BtnArchiveFiling_Click"/>
                                        <Button x:Name="BtnArchiveFilingLedger" Content="立档台账" Style="{StaticResource SubSubNavButton}" Click="BtnArchiveFilingLedger_Click"/>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="资料迁档" Style="{StaticResource SubNavExpander}">
                                    <StackPanel>
                                        <Button x:Name="BtnArchiveSimulatedRelocation" Content="模拟介质资料迁档" Style="{StaticResource SubSubNavButton}" Click="BtnArchiveSimulatedRelocation_Click"/>
                                        <Button x:Name="BtnArchiveElectronicRelocation" Content="电子介质资料迁档" Style="{StaticResource SubSubNavButton}" Click="BtnArchiveElectronicRelocation_Click"/>
                                        <Button x:Name="BtnArchiveRelocationLedger" Content="迁档台账" Style="{StaticResource SubSubNavButton}" Click="BtnArchiveRelocationLedger_Click"/>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="资料检索" Style="{StaticResource SubNavExpander}">
                                    <StackPanel>
                                        <Button x:Name="BtnArchiveSearch" Content="资料检索(综合模式)" Style="{StaticResource SubSubNavButton}" Click="BtnArchiveSearch_Click"/>
                                        <Button x:Name="BtnArchiveElectronicFilingSearch" Content="电子介质资料检索" Style="{StaticResource SubSubNavButton}" Click="BtnArchiveElectronicFilingSearch_Click"/>
                                        <Button x:Name="BtnArchiveSimulatedFilingSearch" Content="模拟介质资料检索" Style="{StaticResource SubSubNavButton}" Click="BtnArchiveSimulatedFilingSearch_Click"/>
                                        <Button x:Name="BtnArchiveFilingSearchPool" Content="检索池" Style="{StaticResource SubSubNavButton}" Click="BtnArchiveFilingSearchPool_Click"/>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="资料流转" Style="{StaticResource SubNavExpander}">
                                    <StackPanel>
                                        <Button x:Name="BtnArchiveOutboundApply" Content="借出申请" Style="{StaticResource SubSubNavButton}" Click="BtnArchiveOutboundApply_Click"/>
                                        <Button x:Name="BtnArchiveOutboundApproval" Content="审批出库" Style="{StaticResource SubSubNavButton}" Click="BtnArchiveOutboundApproval_Click"/>
                                        <Button x:Name="BtnArchiveReturnApply" Content="归还申请" Style="{StaticResource SubSubNavButton}" Click="BtnArchiveReturnApply_Click"/>
                                        <Button x:Name="BtnArchiveReturnApproval" Content="审批入库" Style="{StaticResource SubSubNavButton}" Click="BtnArchiveReturnApproval_Click"/>
                                        <Button x:Name="BtnArchiveCirculationLedger" Content="流转台账" Style="{StaticResource SubSubNavButton}" Click="BtnArchiveCirculationLedger_Click"/>
                                        <Button x:Name="BtnArchiveCrossDomainTransferLedger" Content="跨域流转台账" Style="{StaticResource SubSubNavButton}" Click="BtnArchiveCrossDomainTransferLedger_Click"/>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="盘库登记" Style="{StaticResource SubNavExpander}">
                                    <StackPanel>
                                        <Button x:Name="BtnArchiveSimulatedInventoryRegister" Content="模拟资料盘库" Style="{StaticResource SubSubNavButton}" Click="BtnArchiveSimulatedInventoryRegister_Click"/>
                                        <Button x:Name="BtnArchiveElectronicInventoryRegister" Content="电子资料盘库" Style="{StaticResource SubSubNavButton}" Click="BtnArchiveElectronicInventoryRegister_Click"/>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="离库处置" Style="{StaticResource SubNavExpander}">
                                    <StackPanel>
                                        <Button x:Name="BtnArchiveSimulatedDisposal" Content="模拟资料离库处置" Style="{StaticResource SubSubNavButton}" Click="BtnArchiveSimulatedDisposal_Click"/>
                                        <Button x:Name="BtnArchiveElectronicDisposal" Content="电子资料离库处置" Style="{StaticResource SubSubNavButton}" Click="BtnArchiveElectronicDisposal_Click"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Expander>

                        <!-- 2. 年度资料出入网管理 -->
                        <Expander x:Name="ExpNetworkMgr" Header="年度资料出入网管理" Style="{StaticResource NavExpander}">
                            <StackPanel>
                                <Button x:Name="BtnNetInboundApply"   Content="入网申请" Style="{StaticResource SubNavButton}" Click="BtnNetInboundApply_Click"/>
                                <Button x:Name="BtnNetInboundApprove" Content="入网审批" Style="{StaticResource SubNavButton}" Click="BtnNetInboundApprove_Click"/>
                                <Button x:Name="BtnNetOutboundApply"  Content="出网申请" Style="{StaticResource SubNavButton}" Click="BtnNetOutboundApply_Click"/>
                                <Button x:Name="BtnNetOutboundApprove" Content="出网审批" Style="{StaticResource SubNavButton}" Click="BtnNetOutboundApprove_Click"/>
                                <Button x:Name="BtnNetDispose"        Content="在网数据处置" Style="{StaticResource SubNavButton}" Click="BtnNetDispose_Click"/>
                            </StackPanel>
                        </Expander>

                        <!-- 3. 历史存档资料管理 -->
                        <Expander x:Name="ExpHistoryArchive" Header="历史存档资料管理" Style="{StaticResource NavExpander}">
                            <StackPanel>
                                <Button x:Name="BtnHistMap"       Content="地形图" Style="{StaticResource SubNavButton}" Click="BtnTopoMap_Click"/>
                                <Button x:Name="BtnHistAerial"    Content="航摄影像" Style="{StaticResource SubNavButton}" Click="BtnAerialPhoto_Click"  />
                                <Button x:Name="BtnHistSatellite" Content="卫星影像" Style="{StaticResource SubNavButton}" Click="BtnHistSatellite_Click"/>
                                <Button x:Name="BtnHistDoc"       Content="文档资料" Style="{StaticResource SubNavButton}" Click="BtnHistDoc_Click"/>
                                <Button x:Name="BtnOtherData"     Content="其他资料" Style="{StaticResource SubNavButton}" Click="BtnOtherMap_Click"/>
                            </StackPanel>
                        </Expander>

                        <!-- 4. 档案柜管理 -->
                        <Expander x:Name="ExpCabinets" Header="档案柜管理" Style="{StaticResource NavExpander}">
                            <StackPanel>
                                <Button x:Name="BtnCabRegister" Content="档案柜登记" Style="{StaticResource SubNavButton}" Click="BtnCabRegister_Click"/>
                                <Button x:Name="BtnCabSearch"   Content="档案柜检索" Style="{StaticResource SubNavButton}" Click="BtnCabSearch_Click"/>
                            </StackPanel>
                        </Expander>

                        <!-- 5. 介质管理 -->
                        <Expander x:Name="ExpMediaMgr" Header="介质管理" Style="{StaticResource NavExpander}">
                            <StackPanel>
                                <Expander x:Name="ExpHardDiskSection" Header="硬盘" Style="{StaticResource SubNavExpander}">
                                    <StackPanel>
                                        <Button x:Name="BtnDiskSearch"   Content="概览" Style="{StaticResource SubSubNavButton}" Click="BtnDiskImportExport_Click"/>
                                        <Button x:Name="BtnDiskRegister" Content="初始登记" Style="{StaticResource SubSubNavButton}" Click="BtnDiskLedger_Click"/>
                                        <Button x:Name="BtnDiskBorrow"   Content="出库申请" Style="{StaticResource SubSubNavButton}" Click="BtnDiskOutboundApplication_Click"/>
                                        <Button x:Name="BtnDiskApproval" Content="出库审批" Style="{StaticResource SubSubNavButton}" Click="BtnDiskApproval_Click"/>
                                        <Button x:Name="BtnDiskReturnApply" Content="归还申请" Style="{StaticResource SubSubNavButton}" Click="BtnDiskReturnApply_Click"/>
                                        <Button x:Name="BtnDiskReturnApproval" Content="审批入库" Style="{StaticResource SubSubNavButton}" Click="BtnDiskReturnApproval_Click"/>
                                        <Button x:Name="BtnDiskInventoryRegister" Content="盘库登记" Style="{StaticResource SubSubNavButton}" Click="BtnDiskInventoryRegister_Click"/>
                                        <Button x:Name="BtnDiskOffWarehouse" Content="离库处置" Style="{StaticResource SubSubNavButton}" Click="BtnDiskOffWarehouse_Click"/>
                                        <Button x:Name="BtnDiskDispose"  Content="硬盘台账" Style="{StaticResource SubSubNavButton}" Click="BtnDiskTransaction_Click"/>
                                    </StackPanel>
                                </Expander>

                                <Expander x:Name="ExpOpticalDiscSection" Header="光盘" Style="{StaticResource SubNavExpander}">
                                    <StackPanel>
                                        <Button x:Name="BtnOpticalDiscOverview" Content="概览" Style="{StaticResource SubSubNavButton}" Click="BtnOpticalDiscOverview_Click"/>
                                        <Button x:Name="BtnOpticalDiscLedger" Content="流转台账" Style="{StaticResource SubSubNavButton}" Click="BtnOpticalDiscLedger_Click"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Expander>

                        <!-- 6. 系统设置 -->
                        <Expander x:Name="SystemSettingsExpander" Header="系统设置" Style="{StaticResource NavExpander}">
                            <StackPanel>
                                <Button x:Name="BtnUserMgr" Content="用户管理" Style="{StaticResource SubNavButton}" Click="BtnUserManagement_Click"/>
                                <Button x:Name="BtnDeptMgr" Content="部门设置" Style="{StaticResource SubNavButton}" Click="BtnDeptSetting_Click"/>
                                <Button x:Name="BtnRoleMgr" Content="角色设置" Style="{StaticResource SubNavButton}" Click="BtnRoleSetting_Click"/>
                                <Button x:Name="BtnServerPathMgr" Content="服务器路径设置" Style="{StaticResource SubNavButton}" Click="BtnServerPathSetting_Click"/>
                                <Button x:Name="BtnTestPreparation" Content="测试准备" Style="{StaticResource SubNavButton}" Click="BtnTestPreparation_Click"/>
                                <Button x:Name="BtnAdvancedData" Content="⚠️ 高级数据管理" Style="{StaticResource SubNavButton}" Click="BtnAdvancedData_Click"/>
                                <Button x:Name="BtnBusinessLogicSettings"
                                        Content="业务逻辑设置"
                                        Style="{StaticResource SubNavButton}"
                                        Click="BtnBusinessLogicSettings_Click"/>
                                <!-- 在“系统设置”Expander 内新增一个入口按钮 -->
                                <Button x:Name="BtnUserPreference"
                                        Content="个人设置"
                                        Style="{StaticResource SubNavButton}"
                                        Click="BtnUserPreference_Click"/>
                                <Button x:Name="BtnDbOperationLog"
                                        Content="数据库操作日志"
                                        Style="{StaticResource SubNavButton}"
                                        Click="BtnDbOperationLog_Click"/>
                            </StackPanel>
                        </Expander>

                        <!-- 7. 帮助 -->
                        <Expander x:Name="ExpHelp" Header="帮助" Style="{StaticResource NavExpander}">
                            <StackPanel>
                                <Button x:Name="BtnHelpDoc" Content="帮助文档" Style="{StaticResource SubNavButton}" Click="BtnHelpDoc_Click"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <!-- 底部退出按钮区 -->
                <StackPanel Grid.Row="2" Margin="0,0,0,20">
                    <Border Background="#37474F" Height="1" Margin="20,10"/>

                    <Button x:Name="BtnLogout" Content="切换用户" Style="{StaticResource NavButton}" Click="BtnLogout_Click"/>

                    <Button x:Name="BtnExit" Content="退出系统" Style="{StaticResource ButtonCautionStyle}" Click="BtnExit_Click"/>
                </StackPanel>
            </Grid>

            <!-- 2. 右侧主内容区 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <!-- 将最后一行设为*，用于撑开Frame -->
                </Grid.RowDefinitions>

                <!-- 顶部栏 -->
                <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：页面标题 -->
                        <TextBlock x:Name="TxtPageTitle" Text="首页" VerticalAlignment="Center" Margin="20,0" 
                                   FontSize="16" FontWeight="Bold" HorizontalAlignment="Left"
                                   IsHitTestVisible="False"/>

                        <Button x:Name="BtnGoBack"
                                Grid.Column="1"
                                Width="110"
                                Height="32"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource ButtonSecondaryStyle}"
                                Content="返回上级页面"
                                Click="BtnGoBack_Click"
                                IsEnabled="False"
                                Visibility="Collapsed"/>

                        <Button x:Name="BtnReturnHome"
                                Grid.Column="2"
                                Width="96"
                                Height="32"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource ButtonSecondaryStyle}"
                                Content="返回首页"
                                Click="BtnReturnHome_Click"
                                IsEnabled="False"
                                Visibility="Collapsed"/>

                        <!-- 右侧：用户信息区域 -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,0,20,0">

                            <TextBlock Text="欢迎，" Foreground="#757575" FontSize="14" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>

                            <TextBlock x:Name="TxtCurrentUserName" Text="用户"
                                       Foreground="#333333" FontSize="14" FontWeight="Bold"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"/>

                            <TextBlock Text=" [" Foreground="#9E9E9E" FontSize="14" VerticalAlignment="Center" Margin="5,0,0,0"
                                       IsHitTestVisible="False"/>
                            <TextBlock x:Name="TxtCurrentUserDept" Text="部门"
                                        Foreground="#616161" FontSize="14" VerticalAlignment="Center"
                                        IsHitTestVisible="False"/>
                            <TextBlock Text="]" Foreground="#9E9E9E" FontSize="14" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>

                            <Border Background="#E0F2F1" CornerRadius="4" Margin="10,0,0,0" Padding="8,2"
                                    IsHitTestVisible="False">
                                <TextBlock x:Name="TxtCurrentUserRole" Text="角色"
                                           Foreground="#00695C" FontSize="12"/>
                            </Border>

                            <Rectangle Width="1" Height="14" Fill="#E0E0E0" Margin="15,0,0,0"
                                       IsHitTestVisible="False"/>

                            <!-- 待办中心入口 + 角标 -->
                            <Grid Margin="12,0,0,0" VerticalAlignment="Center">
                                <Button x:Name="BtnToDoCenter"
                                        Click="BtnToDoCenter_Click"
                                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                        Cursor="Hand"
                                        Padding="6,2"
                                        ToolTip="查看待办事项"
                                        Style="{StaticResource ButtonNormalStyle}">
                                    <TextBlock Text="🔔 待办" Foreground="#455A64" FontSize="13" FontWeight="SemiBold"/>
                                </Button>

                                <Border x:Name="BdToDoBadge"
                                        Background="#E53935"
                                        CornerRadius="9"
                                        Height="18"
                                        MinWidth="18"
                                        IsHitTestVisible="False"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,-4,-6,0"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="TxtToDoBadge"
                                               Text="0"
                                               Foreground="White"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="4,0"/>
                                </Border>
                            </Grid>

                            <Rectangle Width="1" Height="14" Fill="#E0E0E0" Margin="12,0,0,0"
                                       IsHitTestVisible="False"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="HomeContentPanel" Grid.Row="1" Grid.RowSpan="2" Margin="20,20,20,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.1*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,18,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource HomeHeroBrush}" CornerRadius="18" Padding="24" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="欢迎使用测绘资料管理系统" Foreground="White" FontSize="28" FontWeight="Bold"/>
                                    <TextBlock Text="聚合年度资料登记、资料立档、历史资料与介质流转，帮助资料室形成更清晰、更稳健的日常协同体验。"
                                               Foreground="#E8FFFB" FontSize="14" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,18,0,0">
                                        <Border Background="#20FFFFFF" CornerRadius="12" Padding="12,8" Margin="0,0,10,10">
                                            <StackPanel>
                                                <TextBlock Text="资料登记" Foreground="#D9FFFA" FontSize="12"/>
                                                <TextBlock Text="规范化" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#20FFFFFF" CornerRadius="12" Padding="12,8" Margin="0,0,10,10">
                                            <StackPanel>
                                                <TextBlock Text="资料立档" Foreground="#D9FFFA" FontSize="12"/>
                                                <TextBlock Text="可追溯" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#20FFFFFF" CornerRadius="12" Padding="12,8" Margin="0,0,10,10">
                                            <StackPanel>
                                                <TextBlock Text="介质流转" Foreground="#D9FFFA" FontSize="12"/>
                                                <TextBlock Text="全流程" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>

                                <Border Grid.Column="1" Background="#18FFFFFF" CornerRadius="16" Padding="18" HorizontalAlignment="Stretch">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="今日建议" Foreground="#D6FFF8" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="优先处理已提交待审批资料与待归档记录。" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,8,0,10" TextWrapping="Wrap"/>
                                        <TextBlock Text="可通过左侧菜单快速进入“资料建档”“资料检索”“资料流转”等功能区。" Foreground="#E8FFFB" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18">
                            <Border Style="{StaticResource HomeCardStyle}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="01" Foreground="#9CA3AF" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Text="年度资料档案化" Margin="0,8,0,0" Style="{StaticResource HomeMetricLabelStyle}"/>
                                    <TextBlock Text="登记 · 立档 · 检索" Margin="0,4,0,0" Style="{StaticResource HomeMetricValueStyle}" FontSize="20"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HomeCardStyle}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="02" Foreground="#9CA3AF" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Text="历史资料管理" Margin="0,8,0,0" Style="{StaticResource HomeMetricLabelStyle}"/>
                                    <TextBlock Text="图件 · 影像 · 文档" Margin="0,4,0,0" Style="{StaticResource HomeMetricValueStyle}" FontSize="20"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HomeCardStyle}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="03" Foreground="#9CA3AF" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Text="硬盘介质流转" Margin="0,8,0,0" Style="{StaticResource HomeMetricLabelStyle}"/>
                                    <TextBlock Text="申请 · 审批 · 归还" Margin="0,4,0,0" Style="{StaticResource HomeMetricValueStyle}" FontSize="20"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Grid.Row="2" Style="{StaticResource HomeCardStyle}">
                            <StackPanel>
                                <TextBlock Text="推荐操作路径" FontSize="16" FontWeight="Bold" Foreground="#1F2937"/>
                                <TextBlock Text="结合资料室常见工作节奏，对日常操作做简洁提示。" Foreground="#6B7280" Margin="0,6,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Width="34" Height="34" CornerRadius="17" Background="#E0F2F1" Margin="0,0,14,14">
                                        <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#00695C"/>
                                    </Border>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                                        <TextBlock Text="资料建档" FontWeight="Bold" Foreground="#1F2937"/>
                                        <TextBlock Text="先执行建档申请，再进入申请审批，最后完成资料立档。" Foreground="#6B7280" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Border Grid.Row="1" Width="34" Height="34" CornerRadius="17" Background="#E3F2FD" Margin="0,0,14,14">
                                        <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#1565C0"/>
                                    </Border>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                                        <TextBlock Text="资料立档" FontWeight="Bold" Foreground="#1F2937"/>
                                        <TextBlock Text="将模拟档案盒与电子介质袋落位，并维护容器编号与物理位置。" Foreground="#6B7280" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Border Grid.Row="2" Width="34" Height="34" CornerRadius="17" Background="#F3E5F5">
                                        <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#7B1FA2"/>
                                    </Border>
                                    <StackPanel Grid.Row="2" Grid.Column="1">
                                        <TextBlock Text="资料检索" FontWeight="Bold" Foreground="#1F2937"/>
                                        <TextBlock Text="按编号、项目、人员和状态快速定位资料，并查看立档结果。" Foreground="#6B7280" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource HomeCardStyle}">
                            <StackPanel>
                                <TextBlock Text="系统亮点" FontSize="16" FontWeight="Bold" Foreground="#1F2937"/>
                                <TextBlock Text="面向资料室实际业务流程的统一工作台。" Foreground="#6B7280" Margin="0,6,0,12"/>
                                <Border Background="#F8FAFC" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="资料与容器关联" FontWeight="SemiBold" Foreground="#0F172A"/>
                                        <TextBlock Text="支持档案盒、电子介质袋及物理位置的关联追溯。" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F8FAFC" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="流程闭环" FontWeight="SemiBold" Foreground="#0F172A"/>
                                        <TextBlock Text="贯通申请、审批、交接、立档、检索与介质流转。" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F8FAFC" CornerRadius="10" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="统一入口" FontWeight="SemiBold" Foreground="#0F172A"/>
                                        <TextBlock Text="首页提供清晰导航，便于快速切换到当前工作场景。" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HomeCardStyle}">
                            <StackPanel>
                                <TextBlock Text="操作建议" FontSize="16" FontWeight="Bold" Foreground="#1F2937"/>
                                <TextBlock Text="建议先关注顶部待办，再按业务模块逐项处理。" Foreground="#6B7280" Margin="0,6,0,12"/>
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <Ellipse Width="8" Height="8" Fill="#26A69A" Margin="0,6,10,0"/>
                                        <TextBlock Text="若顶部显示待办角标，优先处理审批和交接事项。" TextWrapping="Wrap" Foreground="#374151"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <Ellipse Width="8" Height="8" Fill="#42A5F5" Margin="0,6,10,0"/>
                                        <TextBlock Text="立档前建议先核对建档申请与审批信息，避免后续返工。" TextWrapping="Wrap" Foreground="#374151"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <Ellipse Width="8" Height="8" Fill="#AB47BC" Margin="0,6,10,0"/>
                                        <TextBlock Text="检索页可直接查看已立档结果，便于后续借阅与追踪。" TextWrapping="Wrap" Foreground="#374151"/>
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 页面内容容器 -->
                <!-- NavigationUIVisibility="Hidden" 用于隐藏Frame自带的后退按钮 -->
                <Frame x:Name="MainContentFrame" Grid.Row="1" Grid.RowSpan="2"
                       JournalOwnership="OwnsJournal"
                       NavigationUIVisibility="Hidden" Background="#F0F2F5" Visibility="Collapsed" />

            </Grid>
        </Grid>
    </Border>
</Window>