                                    <TextBlock Text="年度资料主闭环" Style="{StaticResource HomeSectionTitleStyle}"/>
                                    <TextBlock Text="模拟资料入档案盒，电子资料入介质袋；每条立档事实绑定容器与柜位，状态随流转更新。"
                                               Style="{StaticResource HomeBodyStyle}" Margin="0,4,0,12"/>

                                    <DockPanel Margin="0,0,0,8">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="#E0F2F1" Margin="0,0,10,0">
                                            <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#00695C"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="建档 → 审批 → 立档" FontWeight="SemiBold" Foreground="#1F2937"/>
