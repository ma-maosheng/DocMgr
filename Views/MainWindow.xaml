                                        <TextBlock Text="无权限的菜单会显示为灰色。详细操作说明见「帮助 → 帮助文档」。" Foreground="#E8FFFB" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock Text="功能模块" Style="{StaticResource HomeSectionTitleStyle}" Margin="2,0,0,8"/>
                        <UniformGrid Columns="3" Margin="0,0,8,8">
                            <Border Style="{StaticResource HomeCardStyle}" Margin="0,0,10,10" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="年度项目管理" Style="{StaticResource HomeModuleTitleStyle}"/>
