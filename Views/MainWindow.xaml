                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HomeCardStyle}" Margin="0,0,10,10" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="年度资料档案化" Style="{StaticResource HomeModuleTitleStyle}"/>
                                    <TextBlock Text="建档、立档、迁档、检索、借还、盘库、离库；存量硬盘/文本可直办立档。" Style="{StaticResource HomeBodyStyle}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HomeCardStyle}" Margin="0,0,0,10" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="年度资料出入网" Style="{StaticResource HomeModuleTitleStyle}"/>
                                    <TextBlock Text="入网、出网申请与审批，以及在网数据处置；可与检索池、建档、硬盘归还衔接。" Style="{StaticResource HomeBodyStyle}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HomeCardStyle}" Margin="0,0,10,10" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="历史存档资料" Style="{StaticResource HomeModuleTitleStyle}"/>
                                    <TextBlock Text="地形图、航摄影像、其他图件按盒号落柜；支持历史资料离库处置。" Style="{StaticResource HomeBodyStyle}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HomeCardStyle}" Margin="0,0,10,10" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="档案柜管理" Style="{StaticResource HomeModuleTitleStyle}"/>
                                    <TextBlock Text="登记柜体布局与档口用途，检索盒位/硬盘槽位占用，支撑立档落柜与迁档。" Style="{StaticResource HomeBodyStyle}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HomeCardStyle}" Margin="0,0,0,10" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="介质管理" Style="{StaticResource HomeModuleTitleStyle}"/>
                                    <TextBlock Text="硬盘：登记、出库、归还、盘库、离库与台账。光盘：概览与流转台账。" Style="{StaticResource HomeBodyStyle}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Margin="0,0,8,0">
