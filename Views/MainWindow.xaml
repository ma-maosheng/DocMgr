                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="#FFF3E0" Margin="0,0,10,0">
                                            <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#EF6C00"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="迁档换位" FontWeight="SemiBold" Foreground="#1F2937"/>
