<Page x:Class="DocMgr.Views.Projects.ProjectSettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:DocMgr.Views.Projects"
      xmlns:vm="clr-namespace:DocMgr.ViewModels.Projects"
          mc:Ignorable="d" 
      Title="项目信息设置" Background="White"
      d:DataContext="{d:DesignInstance Type=vm:ProjectSettingViewModel}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Margin="0,0,0,20" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,10">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧按钮组：增删改仅资料室资料管理员可见 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="新增项目" Command="{Binding AddCommand}" Width="100" Style="{StaticResource ToolbarActionButtonStyle}" Margin="0,0,10,0"
                                Visibility="{Binding CanMaintainProjects, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Content="编辑项目" Command="{Binding EditCommand}" Width="100" Style="{StaticResource ToolbarActionButtonStyle}" Margin="0,0,10,0"
                                Visibility="{Binding CanMaintainProjects, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Content="删除选中" Command="{Binding DeleteCommand}" Width="100" Style="{StaticResource ToolbarDangerButtonStyle}" Margin="0,0,10,0"
                                Visibility="{Binding CanMaintainProjects, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Content="刷新列表" Command="{Binding RefreshCommand}" Width="100" Style="{StaticResource ToolbarActionButtonStyle}"/>
                    </StackPanel>

                    <!-- 右侧搜索 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="年度:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Text="{Binding SearchYear, UpdateSourceTrigger=PropertyChanged}" Width="80" VerticalContentAlignment="Center" Margin="0,0,10,0"/>

                        <TextBlock Text="关键词:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <!-- 绑定 Enter 键触发搜索 -->
                        <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" Width="150" VerticalContentAlignment="Center" Margin="0,0,10,0" ToolTip="项目名称/编码/资金部门">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <Button Content="年度项目检索" Command="{Binding SearchCommand}" Width="100" Style="{StaticResource ToolbarActionButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- 数据表格 -->
        <!-- ItemsSource 绑定到 VM.Projects, SelectedItem 绑定到 VM.SelectedProject -->
        <DataGrid x:Name="DgProjects" Grid.Row="1" AutoGenerateColumns="False" 
                  CanUserAddRows="False" IsReadOnly="True"
                  SelectionMode="Single"
                  ItemsSource="{Binding Projects}"
                  SelectedItem="{Binding SelectedProject}"
                  BorderThickness="1" BorderBrush="#E0E0E0"
                  RowHeight="35" ColumnHeaderHeight="40">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="项目名称" Binding="{Binding ProjectName}" Width="250"/>
                <DataGridTextColumn Header="项目编码" Binding="{Binding ProjectCode}" Width="150"/>
                <DataGridTextColumn Header="实施年度" Binding="{Binding ImplementYear}" Width="100"/>
                <DataGridTextColumn Header="资金管理部门" Binding="{Binding CapitalMgrDept}" Width="150"/>
                <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>