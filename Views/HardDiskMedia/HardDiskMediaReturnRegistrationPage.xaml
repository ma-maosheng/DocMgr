<Page x:Class="DocMgr.Views.HardDiskMedia.HardDiskMediaReturnRegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="clr-namespace:DocMgr.Models.Shared"
      xmlns:conv="clr-namespace:DocMgr.Views.Shared"
      xmlns:viewShared="clr-namespace:DocMgr.Views.Shared"
      mc:Ignorable="d"
      d:DesignHeight="800"
      d:DesignWidth="1200"
      Title="硬盘归还登记工作台"
      Background="#F0F2F5">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../YearlyArchive/ArchiveRegisterResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <conv:BoolToVisConverter x:Key="BoolToVisConverter"/>
            <conv:BoolToStarOrZeroGridLengthConverter x:Key="BoolToStarOrZeroGridLengthConverter"/>
            <conv:InverseBoolToVisConverter x:Key="InverseBoolToVisConverter"/>

            <Style x:Key="LeftPanelToggleButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="22"/>
                <Setter Property="MinHeight" Value="72"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Background" Value="#ECEFF1"/>
                <Setter Property="BorderBrush" Value="#CFD8DC"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#546E7A"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#CFD8DC"/>
                                    <Setter Property="Foreground" Value="#37474F"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#B0BEC5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCardBorderStyle}" Margin="0" CornerRadius="0" Padding="16,12">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="借出/归还人:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="120"
                              Style="{StaticResource ToolbarFilterComboBoxStyle}"
                              ItemsSource="{Binding ApplicantFilterOptions}"
                              SelectedItem="{Binding SelectedApplicantFilter}"
                              Margin="0,0,16,0"/>
                    <TextBlock Text="业务状态:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="140" Style="{StaticResource ToolbarFilterComboBoxStyle}" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" Margin="0,0,16,0"
                              ToolTip="可按归还登记业务状态筛选；选【全部】含未提交"/>
                    <TextBlock Text="登记类型:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="140" Style="{StaticResource ToolbarFilterComboBoxStyle}" ItemsSource="{Binding ApplicationTypeOptions}" SelectedItem="{Binding SelectedApplicationType}" Margin="0,0,16,0"
                              ToolTip="归还登记类型（正常归还/挂失等）"/>
                    <TextBlock Text="年度:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="100"
                              Style="{StaticResource ToolbarFilterComboBoxStyle}"
                              ItemsSource="{Binding ApplicationYears}"
                              SelectedItem="{Binding ApplicationYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,0,16,0"/>
                    <TextBlock Text="关键词:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Width="200" Style="{StaticResource ToolbarFilterTextBoxStyle}" VerticalContentAlignment="Center" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0"
                             ToolTip="申请单号、申请人、目标单位、硬盘编号/序列号、相关批次/资料">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="刷新列表" Command="{Binding RefreshCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="96"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1" Margin="0,12,0,12" Padding="12" Background="#E8F5E9" BorderBrush="#81C784" BorderThickness="1">
            <TextBlock Text="硬盘归还登记（借出介质收回入库）" FontSize="20" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Center"/>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding IsLeftPanelExpanded, Converter={StaticResource BoolToStarOrZeroGridLengthConverter}, ConverterParameter=3}"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="7*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0"
                  Visibility="{Binding IsLeftPanelExpanded, Converter={StaticResource BoolToVisConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="White" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="待归还介质" FontSize="14" FontWeight="Bold" Foreground="#37474F" VerticalAlignment="Center"/>
                            <Button Content="发起归还" Command="{Binding StartReturnCommand}" DockPanel.Dock="Right"
                                    HorizontalAlignment="Right" Width="96" Style="{StaticResource FormInlineButtonStyle}"/>
                        </DockPanel>
                        <DataGrid Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single"
                                  ItemsSource="{Binding ReturnCandidates}" SelectedItem="{Binding SelectedCandidate}"
                                  MouseDoubleClick="DgCandidates_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="硬盘编号" Binding="{Binding DiskCode}" Width="90"/>
                                <DataGridTextColumn Header="借出人" Binding="{Binding ApplicantName}" Width="70"/>
                                <DataGridTextColumn Header="来源单号" Binding="{Binding SourceApplicationNo}" Width="*"/>
                                <DataGridTextColumn Header="预计归还" Binding="{Binding ExpectedReturnDate, StringFormat=yyyy-MM-dd}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="White" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="归还登记单" FontSize="14" FontWeight="Bold" Foreground="#37474F" VerticalAlignment="Center"/>
                            <Button Content="打开" Command="{Binding OpenReturnCommand}" DockPanel.Dock="Right"
                                    HorizontalAlignment="Right" Width="96" Style="{StaticResource FormInlineButtonStyle}"/>
                        </DockPanel>
                        <DataGrid x:Name="DgApplications"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  ItemsSource="{Binding Applications}"
                                  SelectedItem="{Binding SelectedApplication}"
                                  MouseDoubleClick="DgApplications_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="登记单号" Binding="{Binding ApplicationNo}" Width="140"/>
                                <DataGridTextColumn Header="硬盘编号" Binding="{Binding Medium.DiskCode}" Width="90"/>
                                <DataGridTextColumn Header="归还人" Binding="{Binding ApplicantName}" Width="70"/>
                                <DataGridTextColumn Header="登记类型" Binding="{Binding ReturnRegistrationKindText}" Width="80"/>
                                <DataGridTextColumn Header="业务状态" Binding="{Binding ReturnRegistrationStageText}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <Button Grid.Column="1"
                    Command="{Binding ToggleLeftPanelCommand}"
                    Content="{Binding LeftPanelToggleGlyph}"
                    ToolTip="{Binding LeftPanelToggleToolTip}"
                    Style="{StaticResource LeftPanelToggleButtonStyle}"
                    Margin="4,0"/>

            <Border Grid.Column="2" Background="White" Padding="10">
                <Grid>
                    <TextBlock Text="请从左侧选择待归还介质发起归还，或打开已有归还登记单。"
                               Foreground="#90A4AE"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisConverter}}"/>

                    <Grid Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="归还登记详情" FontSize="14" FontWeight="Bold" Foreground="#37474F" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Grid.Row="1" Text="{Binding EditHeader}" TextWrapping="Wrap" Foreground="#546E7A" Margin="0,0,0,10"/>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Background="#F9FAFB" BorderBrush="#E0E0E0" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="归还登记单号" Foreground="#78909C" FontSize="12"/>
                                        <TextBlock Text="{Binding ApplicationNo}" FontWeight="SemiBold" Foreground="#263238" Margin="0,4,0,0"/>
                                        <TextBlock Text="来源借出单号" Foreground="#78909C" FontSize="12" Margin="0,8,0,0"/>
                                        <TextBlock Text="{Binding SourceApplicationNo}" Foreground="#37474F" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                        <TextBlock Text="归还人" Foreground="#666666" Margin="0,0,0,4"/>
                                        <TextBox Height="{StaticResource DialogFormControlHeight}"
                                                 Text="{Binding SelectedApplicant.DisplayText, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 Background="#F9FAFB"
                                                 ToolTip="由出库申请带入，不可更改"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                                        <TextBlock Text="归还介质" Foreground="#666666" Margin="0,0,0,4"/>
                                        <TextBox Height="{StaticResource DialogFormControlHeight}"
                                                 Text="{Binding SelectedMedium.DisplayText, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 Background="#F9FAFB"
                                                 ToolTip="由出库申请带入，不可更改"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                                        <TextBlock Text="申请部门" Foreground="#666666" Margin="0,0,0,4"/>
                                        <TextBox Height="{StaticResource DialogFormControlHeight}" Text="{Binding ApplicantDept, Mode=OneWay}" IsReadOnly="True" Background="#F9FAFB"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                                        <TextBlock Text="归还日期" Foreground="#666666" Margin="0,0,0,4"/>
                                        <DatePicker Height="{StaticResource DialogFormControlHeight}" SelectedDate="{Binding ApplyTime, Mode=OneWay}" IsEnabled="False"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,10">
                                        <TextBlock Text="借出位置" Foreground="#666666" Margin="0,0,0,4"/>
                                        <TextBox Height="{StaticResource DialogFormControlHeight}" Text="{Binding CurrentLocation, Mode=OneWay}" IsReadOnly="True" Background="#F9FAFB"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding ReturnLocationLabel}" Foreground="#666666" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Height="{StaticResource DialogFormControlHeight}"
                                                     Text="{Binding TargetLocationDisplay, Mode=OneWay}"
                                                     IsReadOnly="True"
                                                     Background="#F9FAFB"
                                                     Visibility="{Binding TargetLocationReadOnlyVisibility}"/>
                                            <ComboBox Grid.Column="0"
                                                      Height="{StaticResource DialogFormControlHeight}"
                                                      ItemsSource="{Binding ReturnTargetLocationOptions}"
                                                      SelectedItem="{Binding SelectedReturnTargetLocationOption, Mode=TwoWay}"
                                                      DisplayMemberPath="DisplayText"
                                                      IsEnabled="{Binding CanEditTargetLocation}"
                                                      Visibility="{Binding TargetLocationSelectionVisibility}"/>
                                            <Button Grid.Column="1"
                                                    Margin="8,0,0,0"
                                                    Content="推荐档口"
                                                    Style="{StaticResource FormInlineButtonStyle}"
                                                    Command="{Binding RecommendTargetLocationCommand}"
                                                    Visibility="{Binding RecommendTargetLocationButtonVisibility}"
                                                    ToolTip="推荐归还目标空白档口（不预占用）"/>
                                            <Button Grid.Column="2"
                                                    Margin="8,0,0,0"
                                                    Content="档口快照"
                                                    Style="{StaticResource FormInlineButtonStyle}"
                                                    Command="{Binding ShowTargetLocationSnapshotCommand}"
                                                    IsEnabled="{Binding CanShowTargetLocationSnapshot}"
                                                    Visibility="{Binding TargetLocationSnapshotButtonVisibility}"
                                                    ToolTip="查看目标空白档口占用快照"/>
                                        </Grid>
                                        <TextBlock Text="{Binding TargetLocationHintText}"
                                                   TextWrapping="Wrap"
                                                   Foreground="#78909C"
                                                   FontSize="11"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,0">
                                        <TextBlock Text="登记类型 *" Foreground="#666666" Margin="0,0,0,4"/>
                                        <ComboBox Height="{StaticResource DialogFormControlHeight}"
                                                  ItemsSource="{Binding InspectionResultOptions}"
                                                  SelectedItem="{Binding InspectionResult, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding IsRegistrationEditable}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,0">
                                        <TextBlock Text="格式化确认 *" Foreground="#666666" Margin="0,0,0,4"/>
                                        <ComboBox Height="{StaticResource DialogFormControlHeight}"
                                                  ItemsSource="{Binding FormatConfirmationOptions}"
                                                  SelectedItem="{Binding FormatConfirmation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding IsFormatConfirmationEditable}"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,10"
                                            Visibility="{Binding ShowNormalReturnReasonField, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding ReasonFieldLabel}" Foreground="#666666" Margin="0,0,0,4"/>
                                    <TextBox Height="72"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalContentAlignment="Top"
                                             Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsRegistrationEditable}"/>
                                </StackPanel>

                                <Border Padding="10" Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" Margin="0,0,0,10"
                                        Visibility="{Binding ShowAbnormalReturnPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="非正常归还情况" FontWeight="SemiBold" Foreground="#E65100" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding AbnormalFlowHint}" TextWrapping="Wrap" Foreground="#C62828" Margin="0,0,0,8"/>
                                        <TextBlock Text="具体情况说明 *" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="120"
                                                 VerticalScrollBarVisibility="Auto"
                                                 IsEnabled="{Binding IsRegistrationEditable}"/>
                                    </StackPanel>
                                </Border>

                                <viewShared:ApprovalHandoverWorkspaceShell
                                        Margin="0,0,0,10"
                                        ShellKind="{x:Static models:ApprovalWorkflowShellKind.ApplicationHandover}"
                                        ShowTitleChrome="False"
                                        ShowFooterChrome="False"
                                        Visibility="{Binding ShowApprovalActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <viewShared:ApprovalHandoverWorkspaceShell.SignatureContent>
                                        <viewShared:ApprovalSignatureCardsControl
                                            ShowApprovalOpinion="True"
                                            SignatureHintText="按启用节点填写签字人与日期。"/>
                                    </viewShared:ApprovalHandoverWorkspaceShell.SignatureContent>

                                    <viewShared:ApprovalHandoverWorkspaceShell.MidStepExtraContent>
                                        <StackPanel>
                                            <Border Style="{StaticResource ArchiveRegisterApprovalCompactStepCardStyle}"
                                                    IsEnabled="{Binding CanConfirmHandover}">
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock DockPanel.Dock="Left" Text="办理交接人（归还人）"
                                                               Style="{StaticResource ArchiveRegisterApprovalCompactStepTitleStyle}"
                                                               Width="148"/>
                                                    <TextBox Width="160" HorizontalAlignment="Left"
                                                             Style="{StaticResource ArchiveRegisterApprovalCompactTextBoxStyle}"
                                                             Text="{Binding HandoverApplicant, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DockPanel>
                                            </Border>
                                            <Border Style="{StaticResource ArchiveRegisterApprovalCompactStepCardStyle}"
                                                    IsEnabled="{Binding CanConfirmHandover}">
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock DockPanel.Dock="Left" Text="办理交接人（资料管理员）"
                                                               Style="{StaticResource ArchiveRegisterApprovalCompactStepTitleStyle}"
                                                               Width="148"/>
                                                    <TextBox Width="160" HorizontalAlignment="Left"
                                                             Style="{StaticResource ArchiveRegisterApprovalCompactTextBoxStyle}"
                                                             Text="{Binding HandoverAdmin, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DockPanel>
                                            </Border>
                                            <Border Style="{StaticResource ArchiveRegisterApprovalCompactStepCardStyle}"
                                                    IsEnabled="{Binding CanConfirmHandover}">
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock DockPanel.Dock="Left" Text="办理交接日期"
                                                               Style="{StaticResource ArchiveRegisterApprovalCompactStepTitleStyle}"
                                                               Width="148"/>
                                                    <DatePicker Width="160" HorizontalAlignment="Left"
                                                                Style="{StaticResource ArchiveRegisterApprovalCompactDatePickerStyle}"
                                                                SelectedDate="{Binding HandoverDate}"/>
                                                </DockPanel>
                                            </Border>
                                        </StackPanel>
                                    </viewShared:ApprovalHandoverWorkspaceShell.MidStepExtraContent>
                                </viewShared:ApprovalHandoverWorkspaceShell>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="3" Padding="10" Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" Margin="0,10,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowApplicationActions}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ShowApprovalActions}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding WorkflowHintText}" TextWrapping="Wrap" Foreground="#E65100"/>
                        </Border>

                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowApplicationActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button Content="{Binding SaveButtonText}" Command="{Binding SaveDraftCommand}" Width="96" Height="32" Margin="0,0,10,0"/>
                                <Button Content="{Binding SubmitButtonText}" Command="{Binding SubmitCommand}" Width="112" Height="32" Margin="0,0,10,0"/>
                                <Button Content="打印签批交接单" Command="{Binding PrintSignedHandoverCommand}" Width="128" Height="32" Margin="0,0,10,0"/>
                                <Button Content="撤回作废" Command="{Binding WithdrawCommand}" Width="96" Height="32" Margin="0,0,10,0"
                                        ToolTip="申请人撤回，状态变为「已作废（撤回）」"/>
                                <Button Content="关闭" Command="{Binding CancelEditCommand}" Width="80" Height="32"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowApprovalActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button Content="强制作废" Command="{Binding ForceWithdrawCommand}" Width="96" Height="32" Margin="0,0,10,0"
                                        ToolTip="资料管理员强制作废（须满足逾期时限），状态变为「已作废（强制）」"/>
                                <Button Content="确认办结" Command="{Binding CompleteCommand}" Width="96" Height="32" Margin="0,0,10,0"
                                        ToolTip="{Binding CompleteHintText, Mode=OneWay}"/>
                                <Button Content="打印交接单" Command="{Binding PrintHandoverSheetCommand}" Width="112" Height="32" Margin="0,0,10,0"
                                        ToolTip="{Binding PrintHintText, Mode=OneWay}"/>
                                <Button Content="关闭" Command="{Binding CancelEditCommand}" Width="80" Height="32"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
