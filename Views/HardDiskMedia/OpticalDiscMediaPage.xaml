<Page x:Class="DocMgr.Views.HardDiskMedia.OpticalDiscMediaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:odm="clr-namespace:DocMgr.Models.OpticalDiscMedia"
      mc:Ignorable="d"
      d:DesignHeight="800"
      d:DesignWidth="1200"
      Title="OpticalDiscMediaPage"
      Background="#F0F2F5">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="20"
                    Margin="0,0,0,16"
                    Background="White"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="介质管理（光盘）"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#1F2937"/>
                    <TextBlock Margin="0,8,0,0"
                               Text="数据光盘概览"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#0F766E"/>
                    <TextBlock Margin="0,8,0,0"
                               Text="本系统仅管理已写入资料数据的光盘，不管理空白光盘。光盘台账随电子立档、资料出库/归还与迁档业务被动维护。"
                               TextWrapping="Wrap"
                               Foreground="#4B5563"/>
                    <Border Margin="0,14,0,0"
                            Padding="12"
                            Background="#ECFDF5"
                            BorderBrush="#A7F3D0"
                            BorderThickness="1"
                            CornerRadius="4">
                        <TextBlock Text="重点：主表看当前库存与位置，流转台账看立档入库、出库、归还、迁档与销毁全过程；点击 KPI 卡片可下钻到流转台账。"
                                   TextWrapping="Wrap"
                                   Foreground="#065F46"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Padding="16"
                    Margin="0,0,0,16"
                    Background="White"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="库存概览"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>
                    <Button Grid.Column="1"
                            Content="刷新概览"
                            Padding="16,6"
                            Style="{StaticResource ButtonSecondaryStyle}"
                            Command="{Binding RefreshCommand}"/>
                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Margin="0,0,12,12" Padding="14" Background="#F8FAFC" CornerRadius="4" Cursor="Hand" ToolTip="点击查看对应流转台账" MouseLeftButtonUp="KpiCard_MouseLeftButtonUp" Tag="{x:Static odm:OpticalDiscOverviewKpiKind.TotalMedia}">
                            <StackPanel>
                                <TextBlock Text="光盘总数" Foreground="#64748B"/>
                                <TextBlock Margin="0,8,0,0" Text="{Binding TotalMediumCount}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" Margin="0,0,12,12" Padding="14" Background="#F8FAFC" CornerRadius="4" Cursor="Hand" ToolTip="点击查看对应流转台账" MouseLeftButtonUp="KpiCard_MouseLeftButtonUp" Tag="{x:Static odm:OpticalDiscOverviewKpiKind.InStock}">
                            <StackPanel>
                                <TextBlock Text="在库(资料)" Foreground="#64748B"/>
                                <TextBlock Margin="0,8,0,0" Text="{Binding InStockCount}" FontSize="24" FontWeight="Bold" Foreground="#1D4ED8"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="2" Margin="0,0,12,12" Padding="14" Background="#F8FAFC" CornerRadius="4" Cursor="Hand" ToolTip="点击查看对应流转台账" MouseLeftButtonUp="KpiCard_MouseLeftButtonUp" Tag="{x:Static odm:OpticalDiscOverviewKpiKind.OutTemporary}">
                            <StackPanel>
                                <TextBlock Text="出库(临时)" Foreground="#64748B"/>
                                <TextBlock Margin="0,8,0,0" Text="{Binding OutTemporaryCount}" FontSize="24" FontWeight="Bold" Foreground="#B45309"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="3" Margin="0,0,0,12" Padding="14" Background="#FFF7ED" CornerRadius="4" Cursor="Hand" ToolTip="点击查看对应流转台账" MouseLeftButtonUp="KpiCard_MouseLeftButtonUp" Tag="{x:Static odm:OpticalDiscOverviewKpiKind.DamagedInStock}">
                            <StackPanel>
                                <TextBlock Text="在库(损坏)" Foreground="#9A3412"/>
                                <TextBlock Margin="0,8,0,0" Text="{Binding DamagedInStockCount}" FontSize="24" FontWeight="Bold" Foreground="#C2410C"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Margin="0,0,12,0" Padding="14" Background="#F8FAFC" CornerRadius="4" Cursor="Hand" ToolTip="点击查看对应流转台账" MouseLeftButtonUp="KpiCard_MouseLeftButtonUp" Tag="{x:Static odm:OpticalDiscOverviewKpiKind.Destroyed}">
                            <StackPanel>
                                <TextBlock Text="出库(销毁)" Foreground="#64748B"/>
                                <TextBlock Margin="0,8,0,0" Text="{Binding DestroyedCount}" FontSize="24" FontWeight="Bold" Foreground="#7C3AED"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Margin="0,0,12,0" Padding="14" Background="#EFF6FF" CornerRadius="4" Cursor="Hand" ToolTip="点击查看对应流转台账" MouseLeftButtonUp="KpiCard_MouseLeftButtonUp" Tag="{x:Static odm:OpticalDiscOverviewKpiKind.NeedReturn}">
                            <StackPanel>
                                <TextBlock Text="需归还" Foreground="#1D4ED8"/>
                                <TextBlock Margin="0,8,0,0" Text="{Binding NeedReturnMediumCount}" FontSize="24" FontWeight="Bold" Foreground="#2563EB"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="2" Margin="0,0,12,0" Padding="14" Background="#FEFCE8" CornerRadius="4" Cursor="Hand" ToolTip="点击查看对应流转台账" MouseLeftButtonUp="KpiCard_MouseLeftButtonUp" Tag="{x:Static odm:OpticalDiscOverviewKpiKind.MissingLocation}">
                            <StackPanel>
                                <TextBlock Text="未登记位置" Foreground="#A16207"/>
                                <TextBlock Margin="0,8,0,0" Text="{Binding MissingLocationMediumCount}" FontSize="24" FontWeight="Bold" Foreground="#CA8A04"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="3" Padding="14" Background="#ECFEFF" CornerRadius="4" Cursor="Hand" ToolTip="点击查看对应流转台账" MouseLeftButtonUp="KpiCard_MouseLeftButtonUp" Tag="{x:Static odm:OpticalDiscOverviewKpiKind.RecentTransactions}">
                            <StackPanel>
                                <TextBlock Text="近90天流转" Foreground="#0F766E"/>
                                <TextBlock Margin="0,8,0,0" Text="{Binding RecentTransactionCount}" FontSize="24" FontWeight="Bold" Foreground="#0D9488"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="16"
                        Margin="0,0,16,0"
                        Background="White"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="业务主线"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2937"/>
                        <TextBlock Margin="0,6,0,0"
                                   Text="数据光盘作为年度电子立档的伴生介质管理"
                                   Foreground="#6B7280"/>
                        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding SectionHighlights}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,8,8"
                                            Padding="10,6"
                                            Background="#EEF2FF"
                                            CornerRadius="14">
                                        <TextBlock Text="{Binding}" Foreground="#3730A3"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding WorkflowSteps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10"
                                            Padding="12"
                                            Background="#F8FAFC"
                                            CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="22"
                                                    Height="22"
                                                    Margin="0,0,10,0"
                                                    Background="#0F766E"
                                                    CornerRadius="11">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Text="✓"
                                                           Foreground="White"/>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding}"
                                                       TextWrapping="Wrap"
                                                       Foreground="#374151"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1">
                    <Border Padding="16" Margin="0,0,0,16" Background="White" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="统计分析" FontSize="16" FontWeight="SemiBold" Foreground="#1F2937"/>
                            <TextBlock Margin="0,6,0,0" Text="从位置、生命周期、流转与风险四个维度看数据光盘运行情况" Foreground="#6B7280"/>

                            <Border Margin="0,12,0,0" Padding="12" Background="#F8FAFC" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="位置与保管分布" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding LocationInsights}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="0,0,0,6" Text="{Binding}" TextWrapping="Wrap" Foreground="#4B5563"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0" Padding="12" Background="#F8FAFC" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="生命周期结构" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding LifecycleInsights}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="0,0,0,6" Text="{Binding}" TextWrapping="Wrap" Foreground="#4B5563"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0" Padding="12" Background="#F8FAFC" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="流转分析" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding CirculationInsights}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="0,0,0,6" Text="{Binding}" TextWrapping="Wrap" Foreground="#4B5563"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0" Padding="12" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="风险提示" FontWeight="SemiBold" Foreground="#991B1B"/>
                                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding RiskInsights}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="0,0,0,6" Text="{Binding}" TextWrapping="Wrap" Foreground="#7F1D1D"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Margin="0,8,0,0"
                                               Cursor="Hand"
                                               ToolTip="点击查看对应流转台账"
                                               MouseLeftButtonUp="KpiCard_MouseLeftButtonUp"
                                               Tag="{x:Static odm:OpticalDiscOverviewKpiKind.OutboundWithoutKeeper}"
                                               Text="{Binding OutboundWithoutKeeperMediumCount, StringFormat=出库未明确保管：{0} 张}"
                                               Foreground="#7F1D1D"
                                               TextDecorations="Underline"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Padding="16" Background="White" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="关键域值" FontSize="16" FontWeight="SemiBold" Foreground="#1F2937"/>
                            <TextBlock Margin="0,6,0,0" Text="数据光盘状态与流转类型摘要" Foreground="#6B7280"/>

                            <Border Margin="0,12,0,0" Padding="12" Background="#F8FAFC" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="介质状态" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    <TextBlock Margin="0,6,0,0" Text="{Binding StatusSummary}" TextWrapping="Wrap" Foreground="#4B5563"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0" Padding="12" Background="#F8FAFC" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="流转类型" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    <TextBlock Margin="0,6,0,0" Text="{Binding TransactionTypeSummary}" TextWrapping="Wrap" Foreground="#4B5563"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
