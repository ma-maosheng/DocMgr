<Page x:Class="DocMgr.Views.HardDiskMedia.HardDiskMediumLedgerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="800"
      Title="HardDiskMediumLedgerPage"
      Background="#F0F2F5">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCardBorderStyle}" Margin="0" CornerRadius="0" Padding="16,12">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Button Content="批量式登记" Command="{Binding ImportCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="110" Margin="0,0,10,0"/>
                        <Button Content="交互式登记" Command="{Binding AddCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="110" Margin="0,0,10,0"/>
                        <Button Content="硬盘参数修正" Command="{Binding EditCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="120" Margin="0,0,10,0"/>
                        <Button Content="注销所选硬盘" Command="{Binding DeleteCommand}" Style="{StaticResource ToolbarDangerButtonStyle}" Width="120"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="关键词:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Width="220" Style="{StaticResource ToolbarFilterTextBoxStyle}" VerticalContentAlignment="Center" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>

                    <Button Grid.Column="2" Content="查询" Command="{Binding SearchCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="88"  Margin="0,0,10,0"/>
                    <Button Grid.Column="3" Content="导出台账" Command="{Binding ExportTemplateCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="96" Margin="0,0,10,0"/>
                    <Button Grid.Column="4" Content="刷新列表" Command="{Binding RefreshCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="88"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1"
                Margin="0,12,0,12"
                Padding="0"
                Background="#FFFDF7"
                BorderBrush="#E2C98F"
                BorderThickness="1"
                CornerRadius="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#B98A2E"/>

                <TextBlock Grid.Row="1"
                           Text="库内硬盘物理参数台账表"
                           Margin="0,12,0,4"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#6F4A00"
                           HorizontalAlignment="Center"
                           TextDecorations="Underline"/>

                <TextBlock Grid.Row="2"
                           Text="Hard Disk Physical Parameter Ledger"
                           Margin="0,0,0,10"
                           FontSize="12"
                           Foreground="#9A7B3F"
                           HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="0" Padding="10" Margin="0">
            <DataGrid x:Name="DgMedia"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      RowHeight="38"
                      ColumnHeaderHeight="40"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      ItemsSource="{Binding MediaItems}"
                      SelectedItem="{Binding SelectedMedium}"
                      MouseDoubleClick="DgMedia_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="硬盘编号" Binding="{Binding DiskCode}" Width="120"/>
                    <DataGridTextColumn Header="序列号" Binding="{Binding SerialNumber}" Width="160"/>
                    <DataGridTextColumn Header="硬盘类型" Binding="{Binding DiskType}" Width="110"/>
                    <DataGridTextColumn Header="品牌" Binding="{Binding Brand}" Width="110"/>
                    <DataGridTextColumn Header="容量" Binding="{Binding Capacity}" Width="90"/>
                    <DataGridTextColumn Header="接口类型" Binding="{Binding InterfaceType}" Width="100"/>
                    <DataGridTextColumn Header="登记方式" Binding="{Binding RegistrationMethod}" Width="120"/>
                    <DataGridTextColumn Header="登记人" Binding="{Binding RegisterPerson}" Width="90"/>
                    <DataGridTextColumn Header="登记日期" Binding="{Binding RegisterDate, StringFormat=yyyy-MM-dd}" Width="110"/>
                    <DataGridTextColumn Header="出厂日期" Binding="{Binding FactoryDate, StringFormat=yyyy-MM-dd}" Width="110"/>
                    <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>

