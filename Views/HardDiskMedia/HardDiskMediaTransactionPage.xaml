<Page x:Class="DocMgr.Views.HardDiskMedia.HardDiskMediaTransactionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:conv="clr-namespace:DocMgr.Views.YearlyArchive"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="800"
      d:DesignWidth="1200"
      Title="HardDiskMediaTransactionPage"
      Background="#F0F2F5">
    <Page.Resources>
        <conv:BoolToVisConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCardBorderStyle}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="状态:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="150" Style="{StaticResource ToolbarFilterComboBoxStyle}" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="属性:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="150" Style="{StaticResource ToolbarFilterComboBoxStyle}" ItemsSource="{Binding NatureOptions}" SelectedItem="{Binding SelectedNature}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="征用锁:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="180"
                                  Style="{StaticResource ToolbarFilterComboBoxStyle}"
                                  ItemsSource="{Binding RegisterLockFilterOptions}"
                                  SelectedItem="{Binding SelectedRegisterLockFilter}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="关键词:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Width="240"
                                 Style="{StaticResource ToolbarFilterTextBoxStyle}"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>

                    <Button Grid.Column="4"
                            Content="查询"
                            Command="{Binding SearchCommand}"
                            Style="{StaticResource ToolbarActionButtonStyle}"
                            Width="88"
                            Margin="0,0,10,0"/>
                    <Button Grid.Column="5"
                            Content="刷新列表"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource ToolbarActionButtonStyle}"
                            Width="96"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- 内容区：先上下，再上区左右 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.15*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 上半区：左台账 + 右初始登记 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.4*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- 上左：硬盘台账 -->
                <Border Grid.Column="0" Background="White" CornerRadius="4" Padding="10">
                    <DataGrid x:Name="DgLedger"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              RowHeight="38"
                              ColumnHeaderHeight="40"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              ItemsSource="{Binding MediaItems}"
                              SelectedItem="{Binding SelectedMedium}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="硬盘编号" Binding="{Binding DiskCode}" Width="110"/>
                            <DataGridTextColumn Header="当前存放位置" Binding="{Binding Ledger.StorageLocation}" Width="180"/>
                            <DataGridTextColumn Header="持有人/保管单位" Binding="{Binding Ledger.HolderOrOrganization}" Width="160"/>
                            <DataGridTextColumn Header="是否要求归还" Binding="{Binding Ledger.NeedReturn}" Width="100"/>
                            <DataGridTextColumn Header="台账登记人" Binding="{Binding Ledger.RegisterPerson}" Width="110"/>
                            <DataGridTextColumn Header="台账登记日期" Binding="{Binding Ledger.RegisterDate, StringFormat=yyyy-MM-dd}" Width="120"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding Ledger.MediaStatus}" Width="110"/>
                            <DataGridTextColumn Header="属性" Binding="{Binding Ledger.MediaNature}" Width="110"/>
                            <DataGridTextColumn Header="征用锁" Binding="{Binding RegisterLockDisplayText}" Width="180"/>
                            <DataGridTextColumn Header="台账备注" Binding="{Binding Ledger.Remark}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- 上右：所选硬盘初始登记信息 -->
                <Border Grid.Column="2" Background="White" CornerRadius="4" Padding="16">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="初始登记信息" FontSize="16" FontWeight="SemiBold" Foreground="#1F2937"/>

                            <TextBlock Margin="0,12,0,0" Text="{Binding SelectedDiskCodeText, StringFormat=硬盘编号：{0}}" Foreground="#374151"/>
                            <TextBlock Margin="0,6,0,0" Text="{Binding SelectedSerialNumberText, StringFormat=序列号：{0}}" Foreground="#374151"/>
                            <TextBlock Margin="0,6,0,0" Text="{Binding SelectedDiskTypeText, StringFormat=硬盘类型：{0}}" Foreground="#374151"/>
                            <TextBlock Margin="0,6,0,0" Text="{Binding SelectedBrandText, StringFormat=品牌：{0}}" Foreground="#374151"/>
                            <TextBlock Margin="0,6,0,0" Text="{Binding SelectedCapacityText, StringFormat=容量：{0}}" Foreground="#374151"/>
                            <TextBlock Margin="0,6,0,0" Text="{Binding SelectedInterfaceTypeText, StringFormat=接口类型：{0}}" Foreground="#374151"/>
                            <TextBlock Margin="0,6,0,0" Text="{Binding SelectedRegistrationMethodText, StringFormat=登记方式：{0}}" Foreground="#374151"/>
                            <TextBlock Margin="0,6,0,0" Text="{Binding SelectedRegisterPersonText, StringFormat=登记人：{0}}" Foreground="#374151"/>
                            <TextBlock Margin="0,6,0,0" Text="{Binding SelectedRegisterDateText, StringFormat=登记日期：{0}}" Foreground="#374151"/>
                            <TextBlock Margin="0,6,0,0" Text="{Binding SelectedFactoryDateText, StringFormat=出厂日期：{0}}" Foreground="#374151"/>
                            <TextBlock Margin="0,6,0,0" Text="{Binding SelectedInitialRemarkText, StringFormat=初始备注：{0}}" Foreground="#374151" TextWrapping="Wrap"/>

                            <Border Margin="0,12,0,0"
                                    Padding="10"
                                    Background="#FFF7ED"
                                    BorderBrush="#FED7AA"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Visibility="{Binding HasRegisterLock, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="征用锁记录"
                                               FontWeight="SemiBold"
                                               Foreground="#9A3412"/>
                                    <TextBlock Margin="0,8,0,0" Text="{Binding RegisterLockBusinessTypeText, StringFormat=业务类型：{0}}" Foreground="#7C2D12"/>
                                    <TextBlock Margin="0,6,0,0" Text="{Binding RegisterLockBusinessNoText, StringFormat=业务单号：{0}}" Foreground="#7C2D12"/>
                                    <TextBlock Margin="0,6,0,0" Text="{Binding RegisterLockBusinessRecordIdText, StringFormat=业务记录ID：{0}}" Foreground="#7C2D12"/>
                                    <TextBlock Margin="0,6,0,0" Text="{Binding RegisterLockPreviousStatusText, StringFormat=进入征用前状态：{0}}" Foreground="#7C2D12"/>
                                    <TextBlock Margin="0,6,0,0" Text="{Binding RegisterLockLockedTimeText, StringFormat=锁定时间：{0}}" Foreground="#7C2D12"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- 下半区：历史流转记录 -->
            <Border Grid.Row="2" Background="White" CornerRadius="4" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="历史流转记录"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>

                    <DataGrid Grid.Row="2"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              RowHeight="34"
                              ColumnHeaderHeight="38"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              ItemsSource="{Binding SelectedMediumTransactions}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="办理时间" Binding="{Binding OperateTime, StringFormat=yyyy-MM-dd HH:mm}" Width="130"/>
                            <DataGridTextColumn Header="流转类型" Binding="{Binding TransactionType}" Width="95"/>
                            <DataGridTextColumn Header="流转前状态" Binding="{Binding BeforeStatus}" Width="100"/>
                            <DataGridTextColumn Header="流转后状态" Binding="{Binding AfterStatus}" Width="100"/>
                            <DataGridTextColumn Header="流转前位置" Binding="{Binding BeforeLocation}" Width="120"/>
                            <DataGridTextColumn Header="流转后位置" Binding="{Binding AfterLocation}" Width="120"/>
                            <DataGridTextColumn Header="经办人" Binding="{Binding OperatorName}" Width="90"/>
                            <DataGridTextColumn Header="相关人员" Binding="{Binding RelatedPerson}" Width="100"/>
                            <DataGridTextColumn Header="目标单位" Binding="{Binding TargetOrganization}" Width="110"/>
                            <DataGridTextColumn Header="相关批次" Binding="{Binding RelatedBatch}" Width="120"/>
                            <DataGridTextColumn Header="相关资料标题" Binding="{Binding RelatedArchiveTitle}" Width="160"/>
                            <DataGridTextColumn Header="业务说明" Binding="{Binding Description}" Width="180"/>
                            <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>