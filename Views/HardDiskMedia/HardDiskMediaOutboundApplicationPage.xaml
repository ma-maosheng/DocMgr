<Page x:Class="DocMgr.Views.HardDiskMedia.HardDiskMediaOutboundApplicationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="800"
      d:DesignWidth="1200"
      Title="HardDiskMediaOutboundApplicationPage"
      Background="#F0F2F5">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCardBorderStyle}" Margin="0" CornerRadius="0" Padding="16,12">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Button Content="{Binding AddActionText}" Command="{Binding AddCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="96" Margin="0,0,10,0"/>
                        <Button Content="{Binding EditActionText}" Command="{Binding EditCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="96" Margin="0,0,10,0"/>
                        <Button Content="撤回作废" Command="{Binding WithdrawCommand}" Style="{StaticResource ToolbarDangerButtonStyle}" Width="130"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="状态:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Border Width="180"
                                Height="32"
                                Background="#EEF2F7"
                                BorderBrush="#C7CED8"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,0"
                                ToolTipService.InitialShowDelay="0"
                                ToolTipService.ShowDuration="30000">
                            <Border.ToolTip>
                                <ToolTip>
                                    <StackPanel>
                                        <TextBlock Text="审批状态已锁定为【全部】" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBlock Text="包含状态："/>
                                        <TextBlock Text="1. 当前草稿-待提交"/>
                                        <TextBlock Text="2. 已提交-待审批"/>
                                        <TextBlock Text="3. 已审批-待实物交接"/>
                                        <TextBlock Text="4. 已实物交接-待上传签批交接单"/>
                                        <TextBlock Text="5. 已办结（业务已闭环）"/>
                                        <TextBlock Text="6. 已作废（撤回）"/>
                                        <TextBlock Text="7. 已作废（强制）"/>
                                    </StackPanel>
                                </ToolTip>
                            </Border.ToolTip>
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="&#xE72E;"
                                           FontFamily="Segoe MDL2 Assets"
                                           VerticalAlignment="Center"
                                           Foreground="#6B7280"
                                           Margin="0,0,6,0"
                                           DockPanel.Dock="Left"/>
                                <TextBlock Text="全部"
                                           VerticalAlignment="Center"
                                           Foreground="#374151"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="&#xE946;"
                                           FontFamily="Segoe MDL2 Assets"
                                           VerticalAlignment="Center"
                                           Foreground="#6B7280"
                                           Margin="6,0,0,0"
                                           DockPanel.Dock="Right"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="申请年度:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="100"
                                  Style="{StaticResource ToolbarFilterComboBoxStyle}"
                                  ItemsSource="{Binding ApplicationYears}"
                                  SelectedItem="{Binding ApplicationYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <Button Grid.Column="3"
                            Content="刷新列表"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource ToolbarActionButtonStyle}"
                            Width="96"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1"
                Margin="0,12,0,12"
                Padding="0"
                Background="#FFFDF7"
                BorderBrush="#E2C98F"
                BorderThickness="1"
                CornerRadius="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#B98A2E"/>

                <TextBlock Grid.Row="1"
                           Text="硬盘出库申请办理表"
                           Margin="0,12,0,4"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#6F4A00"
                           HorizontalAlignment="Center"
                           TextDecorations="Underline"/>

                <TextBlock Grid.Row="2"
                           Text="Hard Disk Outbound Application Ledger"
                           Margin="0,0,0,8"
                           FontSize="12"
                           Foreground="#9A7B3F"
                           HorizontalAlignment="Center"/>

                <Border Grid.Row="3"
                        Margin="16,0,16,12"
                        Padding="12,10"
                        Background="#FFFBEB"
                        BorderBrush="#E2C98F"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="说明"
                                   FontWeight="SemiBold"
                                   Foreground="#6F4A00"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="临时出库归还期限为1个月，可提前填写预计归还日期；长期出库不设归还期限；永久出库表示硬盘另有他用无需归还。"
                                   Foreground="#6F4A00"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="关联介质最多选择5块硬盘，每块硬盘对应一份申请单，归还时可分别办理。"
                                   Foreground="#6F4A00"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="0" Padding="10" Margin="0">
            <DataGrid x:Name="DgApplications"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      RowHeight="38"
                      ColumnHeaderHeight="40"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      ItemsSource="{Binding Applications}"
                      SelectedItem="{Binding SelectedApplication}"
                      MouseDoubleClick="DgApplications_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="申请单编号" Binding="{Binding ApplicationNo}" Width="150"/>
                    <DataGridTextColumn Header="关联介质" Binding="{Binding Medium.DiskCode}" Width="110"/>
                    <DataGridTextColumn Header="序列号" Binding="{Binding Medium.SerialNumber}" Width="150"/>
                    <DataGridTextColumn Header="申请类型" Binding="{Binding ApplicationType}" Width="140"/>
                    <DataGridTextColumn Header="申请状态" Binding="{Binding StatusStr}" Width="120"/>
                    <DataGridTextColumn Header="申请人" Binding="{Binding ApplicantName}" Width="90"/>
                    <DataGridTextColumn Header="申请部门" Binding="{Binding ApplicantDept}" Width="120"/>
                    <DataGridTextColumn Header="申请日期" Binding="{Binding ApplyTime, StringFormat=yyyy-MM-dd}" Width="110"/>
                    <DataGridTextColumn Header="审核人" Binding="{Binding ReviewerName}" Width="90"/>
                    <DataGridTextColumn Header="审核日期" Binding="{Binding ReviewerDate, StringFormat=yyyy-MM-dd}" Width="110"/>
                    <DataGridTextColumn Header="审批人" Binding="{Binding ApprovedBy}" Width="90"/>
                    <DataGridTextColumn Header="审批日期" Binding="{Binding ApprovedTime, StringFormat=yyyy-MM-dd}" Width="110"/>
                    <DataGridTextColumn Header="经办人" Binding="{Binding ExecutedBy}" Width="90"/>
                    <DataGridTextColumn Header="经办日期" Binding="{Binding ExecutedTime, StringFormat=yyyy-MM-dd}" Width="110"/>
                    <DataGridTextColumn Header="当前位置" Binding="{Binding CurrentLocation}" Width="110"/>
                    <DataGridTextColumn Header="目标位置/去向" Binding="{Binding TargetLocation}" Width="130"/>
                    <DataGridCheckBoxColumn Header="已上传签字件" Binding="{Binding SignedAttachmentUploaded}" Width="100"/>
                    <DataGridTextColumn Header="打印次数" Binding="{Binding PrintCount}" Width="80"/>
                    <DataGridTextColumn Header="审批意见" Binding="{Binding ApprovalOpinion}" Width="160"/>
                    <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>

