<Window x:Class="DocMgr.Views.HardDiskMedia.HardDiskMediaApprovalEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1200"
        Height="820"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F7FA">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../YearlyArchive/ArchiveRegisterResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding WindowTitle}" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="{Binding WorkspaceBannerText}"
                       Margin="0,6,0,0" Foreground="#666" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#D8E2EC" BorderThickness="1" CornerRadius="4" Background="White">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="10">
                <StackPanel Margin="12">
                    <GroupBox Header="1. 申请信息" Style="{StaticResource Level1GroupBoxStyle}" Padding="10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,6">
                                    <TextBlock Text="申请类型" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding ApplicationType}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,6">
                                    <TextBlock Text="介质编号" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding DiskCode}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,6">
                                    <TextBlock Text="申请人" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding ApplicantName}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,6">
                                    <TextBlock Text="申请部门" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding ApplicantDept}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,6">
                                    <TextBlock Text="申请日期" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding ApplyDateDisplay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,6">
                                    <TextBlock Text="预计归还日期" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding ExpectedReturnDateDisplay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="当前位置" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding CurrentLocation}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="目标位置" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding TargetLocation}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="申请原因" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                            <TextBlock Text="{Binding Reason}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                            <TextBlock Text="当前申请状态" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding ApplicationStatusDisplay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SignedAttachmentStatusText}" Margin="0,4,0,0" Foreground="#64748B" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="2. 审批流程" Style="{StaticResource Level1GroupBoxStyle}" Padding="10">
                        <StackPanel>
                            <StackPanel IsEnabled="{Binding IsApprovalEditable}">
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="部门审核" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                <WrapPanel Grid.Column="1">
                                    <TextBlock Text="负责人签字：" VerticalAlignment="Center" Margin="0,0,4,6"/>
                                    <TextBox Width="100" Height="28" VerticalContentAlignment="Center" Margin="0,0,10,6"
                                             Text="{Binding ReviewerName, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="日期：" VerticalAlignment="Center" Margin="0,0,4,6"/>
                                    <DatePicker SelectedDate="{Binding ReviewerDate}" Width="120" Height="28" Margin="0,0,0,6"/>
                                </WrapPanel>
                            </Grid>

                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="资料室审批" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                <WrapPanel Grid.Column="1">
                                    <TextBlock Text="负责人签字：" VerticalAlignment="Center" Margin="0,0,4,6"/>
                                    <TextBox Width="100" Height="28" VerticalContentAlignment="Center" Margin="0,0,10,6"
                                             Text="{Binding ApproverName, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="日期：" VerticalAlignment="Center" Margin="0,0,4,6"/>
                                    <DatePicker SelectedDate="{Binding ApproverDate}" Width="120" Height="28" Margin="0,0,0,6"/>
                                </WrapPanel>
                            </Grid>

                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="审批意见" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                <TextBox Grid.Column="1"
                                         MinHeight="56"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         Padding="6,4"
                                         Text="{Binding ApprovalOpinion, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            </StackPanel>

                            <StackPanel IsEnabled="{Binding IsHandoverEditable}" Margin="0,8,0,0">
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="实物交接" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                <WrapPanel Grid.Column="1">
                                    <TextBlock Text="移交人签字：" VerticalAlignment="Center" Foreground="#666" Margin="0,0,4,6"/>
                                    <TextBox Width="100" Height="28" VerticalContentAlignment="Center" Margin="0,0,10,6"
                                             Text="{Binding HandoverApplicant, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="日期：" VerticalAlignment="Center" Margin="0,0,4,6"/>
                                    <DatePicker SelectedDate="{Binding HandoverDate}" Width="120" Height="28" Margin="0,0,16,6"/>
                                    <TextBlock Text="资料室资料员签字：" VerticalAlignment="Center" Foreground="#666" Margin="0,0,4,6"/>
                                    <TextBox Width="100" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,6"
                                             Text="{Binding HandoverAdmin, UpdateSourceTrigger=PropertyChanged}"/>
                                </WrapPanel>
                            </Grid>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="附件材料" Style="{StaticResource Level1GroupBoxStyle}" Padding="10">
                        <StackPanel>
                            <ListView ItemsSource="{Binding Attachments}" Height="120" BorderBrush="#EEE" BorderThickness="1">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="文件名" Width="250" DisplayMemberBinding="{Binding FileName}"/>
                                        <GridViewColumn Header="分类" Width="110" DisplayMemberBinding="{Binding FileCategory}"/>
                                        <GridViewColumn Header="上传时间" Width="140" DisplayMemberBinding="{Binding UploadTime, StringFormat='yyyy-MM-dd HH:mm'}"/>
                                        <GridViewColumn Header="上传人" Width="90" DisplayMemberBinding="{Binding UploaderName}"/>
                                        <GridViewColumn Header="操作" Width="120">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="查看" Style="{StaticResource ButtonNormalStyle}" Margin="0,0,5,0"
                                                                Command="{Binding DataContext.ViewAttachmentCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="删除" Style="{StaticResource ButtonCautionStyle}"
                                                                Command="{Binding DataContext.DeleteAttachmentCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <TextBlock Text="办结前须上传线下签字后的签批交接单扫描件（含审批意见与交接人签字）。"
                                       Margin="0,6,0,0"
                                       Foreground="#B45309"
                                       TextWrapping="Wrap"
                                       FontSize="11"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,10,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Background="#FAFBFC">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Content="审批通过" Command="{Binding ConfirmCommand}" ToolTip="{Binding ConfirmHintText}" Margin="0,0,8,0" Padding="12,6"/>
                    <Button Content="确认实物交接" Command="{Binding ConfirmPhysicalHandoverCommand}" ToolTip="{Binding ConfirmPhysicalHandoverHintText}" Margin="0,0,8,0" Padding="12,6"/>
                    <Button Content="上传签批交接单" Command="{Binding UploadSignedAttachmentCommand}" ToolTip="{Binding UploadHintText}" Margin="0,0,8,0" Padding="12,6"/>
                    <Button Content="确认办结" Command="{Binding CompleteCommand}" ToolTip="{Binding CompleteHintText}" Margin="0,0,8,0" Padding="12,6"/>
                    <Button Content="打印交接单" Command="{Binding PrintHandoverSheetCommand}" ToolTip="{Binding PrintHintText}" Margin="0,0,8,0" Padding="12,6"/>
                </StackPanel>

                <Button Grid.Column="1" Content="关闭" Command="{Binding CancelCommand}" Padding="16,6"/>
            </Grid>
        </Border>
    </Grid>
</Window>
