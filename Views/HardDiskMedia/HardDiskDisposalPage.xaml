<Page x:Class="DocMgr.Views.HardDiskMedia.HardDiskDisposalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="HardDiskDisposalPage"
      Background="#F0F2F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCardBorderStyle}" Margin="0" CornerRadius="0" Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="新增处置" Command="{Binding AddCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="96" Margin="0,0,10,0"/>
                <Button Content="打开办理" Command="{Binding OpenCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="96" Margin="0,0,10,0"/>
                <Button Content="撤回作废" Command="{Binding WithdrawCommand}" Style="{StaticResource ToolbarDangerButtonStyle}" Width="110" Margin="0,0,16,0"/>

                <TextBlock Text="状态:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Width="200"
                          Style="{StaticResource ToolbarFilterComboBoxStyle}"
                          ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"/>

                <TextBlock Text="年度:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                <ComboBox Width="100"
                          Style="{StaticResource ToolbarFilterComboBoxStyle}"
                          ItemsSource="{Binding ApplyYears}"
                          SelectedItem="{Binding ApplyYear, Mode=TwoWay}"/>

                <TextBlock Text="关键词:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                <TextBox Width="180" Height="32" VerticalContentAlignment="Center"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="查询" Command="{Binding SearchCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="80" Margin="10,0,0,0"/>
                <Button Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="80" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,12,0,12"
                Padding="0"
                Background="#FFFDF7"
                BorderBrush="#E2C98F"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#B98A2E"/>

                <TextBlock Grid.Row="1"
                           Text="硬盘离库处置办理表"
                           Margin="0,12,0,4"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#6F4A00"
                           HorizontalAlignment="Center"
                           TextDecorations="Underline"/>

                <TextBlock Grid.Row="2"
                           Text="Hard Disk Off-Warehouse Disposal Ledger"
                           Margin="0,0,0,8"
                           FontSize="12"
                           Foreground="#9A7B3F"
                           HorizontalAlignment="Center"/>

                <Border Grid.Row="3"
                        Margin="16,0,16,12"
                        Padding="12,10"
                        Background="#FFFBEB"
                        BorderBrush="#E2C98F"
                        BorderThickness="1"
                        CornerRadius="4">
                    <TextBlock Text="适用于淘汰、损毁、盘失及其他原因的硬盘离库处置；整单处置方式唯一。办结前须上传纸质签批单与硬盘照片。"
                               Foreground="#6F4A00"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" Padding="10">
            <DataGrid ItemsSource="{Binding Records}"
                      SelectedItem="{Binding SelectedRecord}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      RowHeight="36"
                      ColumnHeaderHeight="40"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      MouseDoubleClick="DgRecords_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="处置单编号" Binding="{Binding DisposalNo}" Width="150"/>
                    <DataGridTextColumn Header="离库原因" Binding="{Binding DisposalReason}" Width="80"/>
                    <DataGridTextColumn Header="处置方式" Binding="{Binding DispositionMethod}" Width="100"/>
                    <DataGridTextColumn Header="硬盘数" Binding="{Binding ItemCount}" Width="70"/>
                    <DataGridTextColumn Header="硬盘清单" Binding="{Binding DiskCodesSummary}" Width="220"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusDisplay}" Width="160"/>
                    <DataGridTextColumn Header="申请人" Binding="{Binding ApplicantName}" Width="90"/>
                    <DataGridTextColumn Header="申请日期" Binding="{Binding ApplyTime, StringFormat=yyyy-MM-dd}" Width="110"/>
                    <DataGridTextColumn Header="审批人" Binding="{Binding ApprovedBy}" Width="90"/>
                    <DataGridCheckBoxColumn Header="已传签批单" Binding="{Binding SignedAttachmentUploaded}" Width="90"/>
                    <DataGridCheckBoxColumn Header="已传照片" Binding="{Binding DiskPhotoUploaded}" Width="80"/>
                    <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
