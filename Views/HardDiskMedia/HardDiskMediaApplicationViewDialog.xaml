<Window x:Class="DocMgr.Views.HardDiskMedia.HardDiskMediaApplicationViewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1100"
        Height="780"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F7FA">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../YearlyArchive/ArchiveRegisterResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding WindowTitle}" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="{Binding WorkspaceBannerText}"
                       Margin="0,6,0,0" Foreground="#666" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#D8E2EC" BorderThickness="1" CornerRadius="4" Background="White">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="10">
                <StackPanel Margin="12">
                    <GroupBox Header="1. 申请信息" Style="{StaticResource Level1GroupBoxStyle}" Padding="10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,6">
                                    <TextBlock Text="申请单编号" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding ApplicationNo}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,6">
                                    <TextBlock Text="申请类型" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding ApplicationType}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,6">
                                    <TextBlock Text="介质编号" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding DiskCode}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,6">
                                    <TextBlock Text="去向/对方" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding TargetPersonOrUnit}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,6">
                                    <TextBlock Text="申请人" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding ApplicantName}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,6">
                                    <TextBlock Text="申请部门" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding ApplicantDept}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,6">
                                    <TextBlock Text="申请日期" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding ApplyDateDisplay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,0,6">
                                    <TextBlock Text="预计归还日期" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding ExpectedReturnDateDisplay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="当前位置" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding CurrentLocation}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="目标位置" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding TargetLocation}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="申请原因" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                            <TextBlock Text="{Binding Reason}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="相关批次" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding RelatedBatch}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="相关资料标题" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding RelatedArchiveTitle}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="当前申请状态" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding ApplicationStatus}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SignedAttachmentStatusText}" Margin="0,4,0,0" Foreground="#64748B" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="2. 审批与办理信息" Style="{StaticResource Level1GroupBoxStyle}" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,6">
                                <TextBlock Text="审核人" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                <TextBlock Text="{Binding ReviewerName}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,6">
                                <TextBlock Text="审核日期" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                <TextBlock Text="{Binding ReviewerDateDisplay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,6">
                                <TextBlock Text="审批人" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                <TextBlock Text="{Binding ApprovedBy}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,6">
                                <TextBlock Text="审批时间" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                <TextBlock Text="{Binding ApprovedTimeDisplay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,6">
                                <TextBlock Text="办理人" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                <TextBlock Text="{Binding ExecutedBy}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,6">
                                <TextBlock Text="办理时间" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                <TextBlock Text="{Binding ExecutedTimeDisplay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
                                <TextBlock Text="审批意见" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                <TextBlock Text="{Binding ApprovalOpinion}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                <TextBlock Text="打印信息" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding PrintInfoDisplay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                <TextBlock Text="备注" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding Remark}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="附件材料" Style="{StaticResource Level1GroupBoxStyle}" Padding="10">
                        <StackPanel>
                            <ListView ItemsSource="{Binding Attachments}" Height="120" BorderBrush="#EEE" BorderThickness="1">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="文件名" Width="250" DisplayMemberBinding="{Binding FileName}"/>
                                        <GridViewColumn Header="分类" Width="110" DisplayMemberBinding="{Binding FileCategory}"/>
                                        <GridViewColumn Header="上传时间" Width="140" DisplayMemberBinding="{Binding UploadTime, StringFormat='yyyy-MM-dd HH:mm'}"/>
                                        <GridViewColumn Header="上传人" Width="90" DisplayMemberBinding="{Binding UploaderName}"/>
                                        <GridViewColumn Header="操作" Width="80">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="查看" Style="{StaticResource ButtonNormalStyle}"
                                                            Command="{Binding DataContext.ViewAttachmentCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,10,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Background="#FAFBFC">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="打印" Command="{Binding PrintCommand}" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="关闭" Command="{Binding CloseCommand}" Padding="16,6"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>