<Window x:Class="DocMgr.Views.HardDiskMedia.HardDiskDisposalEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DocMgr.Models.Shared"
        xmlns:viewShared="clr-namespace:DocMgr.Views.Shared"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="1200"
        Height="820"
        MinWidth="1040"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F5">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../YearlyArchive/ArchiveRegisterResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <viewShared:InverseBoolToVisConverter x:Key="InverseBoolToVisConverter"/>

            <Style x:Key="DisposalSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#1E293B"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
            <Style x:Key="DisposalFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FormFieldCaptionStyle}">
                <Setter Property="Foreground" Value="#64748B"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style x:Key="DisposalFilterLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FormLabelTextBlockStyle}">
                <Setter Property="Foreground" Value="#64748B"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style x:Key="DisposalCardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>
            <Style x:Key="DisposalTransferButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarActionButtonStyle}">
                <Setter Property="Width" Value="82"/>
                <Setter Property="Height" Value="{StaticResource DialogFormControlHeight}"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="6,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <viewShared:ApprovalHandoverWorkspaceShell Margin="12"
                                               ShellKind="{x:Static models:ApprovalWorkflowShellKind.DisposalUnlockUpload}">
        <viewShared:ApprovalHandoverWorkspaceShell.HeaderContent>
            <StackPanel>
                <!-- 处置信息 -->
                <Border Style="{StaticResource DisposalCardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="处置信息" Style="{StaticResource DisposalSectionTitleStyle}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="申请人：" Style="{StaticResource DisposalFieldLabelStyle}"/>
                                <TextBox Text="{Binding ApplicantName, Mode=OneWay}"
                                         IsReadOnly="True"
                                         Background="#F9FAFB"
                                         Height="{StaticResource DialogFormControlHeight}"
                                         Padding="8,0"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="申请部门：" Style="{StaticResource DisposalFieldLabelStyle}"/>
                                <TextBox Text="{Binding ApplicantDept, Mode=OneWay}"
                                         IsReadOnly="True"
                                         Background="#F9FAFB"
                                         Height="{StaticResource DialogFormControlHeight}"
                                         Padding="8,0"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="申请说明 *：" Style="{StaticResource DisposalFieldLabelStyle}"/>
                                <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanEditHeader}"
                                         Height="44"
                                         Padding="8,6"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="备注：" Style="{StaticResource DisposalFieldLabelStyle}"/>
                                <TextBox Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanEditHeader}"
                                         Height="44"
                                         Padding="8,6"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 硬盘选取 -->
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="硬盘选取" Style="{StaticResource DisposalSectionTitleStyle}" Margin="0"/>
                    <TextBlock DockPanel.Dock="Right"
                               Text="空盘→淘汰 / 损坏→损坏 / 盘失→盘失+库内注销；提交后征用锁定"
                               Foreground="#64748B"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <Grid Height="360" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Column="0"
                            Grid.Row="0"
                            Grid.RowSpan="3"
                            Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="4"/>
                    <Border Grid.Column="2"
                            Grid.Row="0"
                            Grid.RowSpan="3"
                            Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="4"/>

                    <TextBlock Grid.Column="0"
                               Grid.Row="0"
                               Text="{Binding AvailableDisksTitle, Mode=OneWay}"
                               FontWeight="SemiBold"
                               Foreground="#37474F"
                               Margin="12,12,12,8"/>
                    <TextBlock Grid.Column="2"
                               Grid.Row="0"
                               Text="{Binding DisposalDisksTitle, Mode=OneWay}"
                               FontWeight="SemiBold"
                               Foreground="#37474F"
                               Margin="12,12,12,8"/>

                    <WrapPanel Grid.Column="0"
                               Grid.Row="1"
                               Margin="12,0,12,8"
                               IsEnabled="{Binding CanEditHeader}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                            <TextBlock Text="介质状态：" Style="{StaticResource DisposalFilterLabelStyle}"/>
                            <ComboBox Width="120"
                                      Height="{StaticResource DialogFormControlHeight}"
                                      VerticalContentAlignment="Center"
                                      ItemsSource="{Binding MediaStatusFilterOptions}"
                                      SelectedItem="{Binding FilterMediaStatus}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                            <TextBlock Text="关键词：" Style="{StaticResource DisposalFilterLabelStyle}"/>
                            <TextBox Width="120"
                                     Height="{StaticResource DialogFormControlHeight}"
                                     Padding="8,0"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding FilterKeyword, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="硬盘编号、序列号、品牌、当前档口"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                            <TextBlock Text="接口：" Style="{StaticResource DisposalFilterLabelStyle}"/>
                            <ComboBox Width="96"
                                      Height="{StaticResource DialogFormControlHeight}"
                                      VerticalContentAlignment="Center"
                                      ItemsSource="{Binding InterfaceTypeFilterOptions}"
                                      SelectedItem="{Binding FilterInterfaceType}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                            <TextBlock Text="容量：" Style="{StaticResource DisposalFilterLabelStyle}"/>
                            <ComboBox Width="96"
                                      Height="{StaticResource DialogFormControlHeight}"
                                      VerticalContentAlignment="Center"
                                      ItemsSource="{Binding CapacityFilterOptions}"
                                      SelectedItem="{Binding FilterCapacity}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                            <TextBlock Text="出厂日期：" Style="{StaticResource DisposalFilterLabelStyle}"/>
                            <DatePicker Width="120"
                                        Height="{StaticResource DialogFormControlHeight}"
                                        VerticalContentAlignment="Center"
                                        SelectedDate="{Binding FilterFactoryDateFrom, Mode=TwoWay}"
                                        Margin="0,0,6,0"/>
                            <TextBlock Text="至" Style="{StaticResource DisposalFilterLabelStyle}" Margin="0,0,6,0"/>
                            <DatePicker Width="120"
                                        Height="{StaticResource DialogFormControlHeight}"
                                        VerticalContentAlignment="Center"
                                        SelectedDate="{Binding FilterFactoryDateTo, Mode=TwoWay}"/>
                        </StackPanel>
                        <Button Content="清空筛选"
                                Command="{Binding ClearFiltersCommand}"
                                Style="{StaticResource ToolbarActionButtonStyle}"
                                Height="{StaticResource DialogFormControlHeight}"
                                Margin="0,0,0,6"
                                VerticalAlignment="Center"/>
                    </WrapPanel>

                    <StackPanel Grid.Column="2"
                                Grid.Row="1"
                                Margin="12,0,12,8"
                                IsEnabled="{Binding CanEditHeader}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="处置方式："
                                       Style="{StaticResource DisposalFilterLabelStyle}"/>
                            <ComboBox Width="140"
                                      Height="{StaticResource DialogFormControlHeight}"
                                      VerticalContentAlignment="Center"
                                      ItemsSource="{Binding DispositionMethodOptions}"
                                      SelectedItem="{Binding BatchDispositionMethod}"
                                      Margin="0,0,8,0"
                                      ToolTip="先勾选同一原状态的待处置硬盘，再选择处置方式进行赋值"/>
                            <Button Content="赋值"
                                    Command="{Binding ApplyDispositionMethodCommand}"
                                    Style="{StaticResource ToolbarActionButtonStyle}"
                                    Height="{StaticResource DialogFormControlHeight}"
                                    ToolTip="将当前处置方式写入勾选的待处置硬盘（须同一原状态）"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding RequiresOtherRemark, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="其他说明 *：" Style="{StaticResource DisposalFieldLabelStyle}"/>
                            <TextBox Text="{Binding OtherRemark, UpdateSourceTrigger=PropertyChanged}"
                                     Height="40"
                                     Padding="8,6"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Grid.Row="0"
                                Grid.RowSpan="3"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                IsEnabled="{Binding CanEditHeader}">
                        <Button Content="移入 ▶"
                                Command="{Binding MoveToDisposalCommand}"
                                Style="{StaticResource DisposalTransferButtonStyle}"
                                ToolTip="将左侧勾选硬盘移入待处置"/>
                        <Button Content="◀ 移出"
                                Command="{Binding MoveToAvailableCommand}"
                                Style="{StaticResource DisposalTransferButtonStyle}"
                                Margin="0"
                                ToolTip="将右侧勾选硬盘移回可选列表"/>
                    </StackPanel>

                    <DataGrid Grid.Column="0"
                              Grid.Row="2"
                              Margin="12,0,12,12"
                              ItemsSource="{Binding AvailableDisks}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              SelectionMode="Extended"
                              IsReadOnly="False"
                              IsEnabled="{Binding CanEditHeader}"
                              RowHeight="36">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="36"/>
                            <DataGridTextColumn Header="编号" Binding="{Binding DiskCode}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="容量" Binding="{Binding Capacity}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="接口" Binding="{Binding InterfaceType}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="出厂日期" Binding="{Binding FactoryDateText}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding MediaStatus}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="位置" Binding="{Binding StorageLocation}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DataGrid Grid.Column="2"
                              Grid.Row="2"
                              Margin="12,0,12,12"
                              ItemsSource="{Binding Items}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              SelectionMode="Extended"
                              IsReadOnly="False"
                              IsEnabled="{Binding CanEditHeader}"
                              RowHeight="36">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="36"/>
                            <DataGridTextColumn Header="序号" Binding="{Binding SortOrder}" Width="40" IsReadOnly="True"/>
                            <DataGridTextColumn Header="编号" Binding="{Binding DiskCode}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="容量" Binding="{Binding Capacity}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="接口" Binding="{Binding InterfaceType}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="出厂日期" Binding="{Binding FactoryDateText}" Width="75" IsReadOnly="True"/>
                            <DataGridTextColumn Header="原状态" Binding="{Binding BeforeMediaStatus}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="原位置" Binding="{Binding BeforeStorageLocation}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="离库原因" Binding="{Binding DisposalReason}" Width="60" IsReadOnly="True"/>
                            <DataGridTextColumn Header="处置方式" Binding="{Binding DispositionMethod}" Width="70" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </StackPanel>
        </viewShared:ApprovalHandoverWorkspaceShell.HeaderContent>

        <viewShared:ApprovalHandoverWorkspaceShell.SignatureContent>
            <viewShared:ApprovalSignatureCardsControl ShowApprovalOpinion="True"/>
        </viewShared:ApprovalHandoverWorkspaceShell.SignatureContent>
    </viewShared:ApprovalHandoverWorkspaceShell>
</Window>
