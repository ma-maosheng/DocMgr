<Window x:Class="DocMgr.Views.HardDiskMedia.LocalPhysicalDiskPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewShared="clr-namespace:DocMgr.Views.Shared"
        Title="选择本机硬盘"
        Width="820"
        Height="420"
        MinWidth="640"
        MinHeight="320"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button Content="关闭"
                Command="{x:Static viewShared:ViewCommands.CloseCurrentView}"
                Style="{StaticResource DialogCloseButtonStyle}"
                HorizontalAlignment="Right"/>

        <TextBlock Grid.Row="0"
                   Margin="0,0,48,8"
                   Text="选择本机硬盘"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#333333"/>

        <TextBlock Grid.Row="1"
                   Margin="0,0,0,10"
                   Text="{Binding StatusText}"
                   Foreground="#6B7280"
                   TextWrapping="Wrap"/>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Disks}"
                  SelectedItem="{Binding SelectedDisk}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  IsReadOnly="True"
                  ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CanRegister}" Value="False">
                            <Setter Property="Foreground" Value="#9CA3AF"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="型号" Binding="{Binding Model}" Width="*"/>
                <DataGridTextColumn Header="序列号" Binding="{Binding SerialNumber}" Width="140"/>
                <DataGridTextColumn Header="容量" Binding="{Binding CapacityText}" Width="70"/>
                <DataGridTextColumn Header="接口" Binding="{Binding InterfaceType}" Width="64"/>
                <DataGridTextColumn Header="类型" Binding="{Binding DiskType}" Width="72"/>
                <DataGridTextColumn Header="制造年" Binding="{Binding ManufactureYearText}" Width="64"/>
                <DataGridTextColumn Header="盘符" Binding="{Binding DriveLetters}" Width="64"/>
                <DataGridTextColumn Header="说明" Binding="{Binding StatusHint}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="刷新"
                    Width="88"
                    Margin="0,0,10,0"
                    Style="{StaticResource DialogSecondaryActionButtonStyle}"
                    Command="{Binding RefreshCommand}"/>
            <Button Content="确定"
                    Style="{StaticResource DialogPrimaryActionButtonStyle}"
                    Command="{Binding ConfirmCommand}"/>
            <Button Content="取消"
                    Margin="10,0,0,0"
                    Style="{StaticResource DialogSecondaryActionButtonStyle}"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>
