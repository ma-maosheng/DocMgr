<Page x:Class="DocMgr.Views.HardDiskMedia.HardDiskInventoryRegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="HardDiskInventoryRegisterPage"
      Background="#F0F2F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCardBorderStyle}" Margin="0" CornerRadius="0" Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="新增登记" Command="{Binding AddCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="96" Margin="0,0,10,0"/>
                <Button Content="打开办理" Command="{Binding OpenCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="96" Margin="0,0,10,0"/>
                <Button Content="撤回作废" Command="{Binding WithdrawCommand}" Style="{StaticResource ToolbarDangerButtonStyle}" Width="110" Margin="0,0,16,0"/>

                <TextBlock Text="状态:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Width="160"
                          Style="{StaticResource ToolbarFilterComboBoxStyle}"
                          ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"/>

                <TextBlock Text="年度:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                <ComboBox Width="100"
                          Style="{StaticResource ToolbarFilterComboBoxStyle}"
                          ItemsSource="{Binding ApplyYears}"
                          SelectedItem="{Binding ApplyYear, Mode=TwoWay}"/>

                <TextBlock Text="关键词:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                <TextBox Width="180" Height="32" VerticalContentAlignment="Center"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="查询" Command="{Binding SearchCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="80" Margin="10,0,0,0"/>
                <Button Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="80" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,12,0,12"
                Padding="0"
                Background="#FFFDF7"
                BorderBrush="#E2C98F"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#B98A2E"/>

                <TextBlock Grid.Row="1"
                           Text="硬盘盘库登记办理表"
                           Margin="0,12,0,4"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#6F4A00"
                           HorizontalAlignment="Center"
                           TextDecorations="Underline"/>

                <TextBlock Grid.Row="2"
                           Text="Hard Disk Inventory Register Ledger"
                           Margin="0,0,0,8"
                           FontSize="12"
                           Foreground="#9A7B3F"
                           HorizontalAlignment="Center"/>

                <Border Grid.Row="3"
                        Margin="16,0,16,12"
                        Padding="12,10"
                        Background="#FFFBEB"
                        BorderBrush="#E2C98F"
                        BorderThickness="1"
                        CornerRadius="4">
                    <TextBlock Text="库内空白/损坏硬盘异常即时登记：损坏登记（可指定损坏专用档口）、盘失登记。确认登记办结即时写台账，无需审批签批。损坏盘档口调整请在开柜界面使用交互式迁档。正式离库请使用「离库处置」。"
                               Foreground="#6F4A00"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- 左列表 / 右详情 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" Padding="10">
                <DataGrid ItemsSource="{Binding Records}"
                          SelectedItem="{Binding SelectedRecord}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          RowHeight="36"
                          ColumnHeaderHeight="40"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          MouseDoubleClick="DgRecords_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="登记单编号" Binding="{Binding RegisterNo}" Width="130"/>
                        <DataGridTextColumn Header="登记类型" Binding="{Binding RegisterKind}" Width="110"/>
                        <DataGridTextColumn Header="硬盘数" Binding="{Binding ItemCount}" Width="60"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding StatusDisplay}" Width="80"/>
                        <DataGridTextColumn Header="登记人" Binding="{Binding ApplicantName}" Width="70"/>
                        <DataGridTextColumn Header="登记日期" Binding="{Binding ApplyTime, StringFormat=yyyy-MM-dd}" Width="95"/>
                        <DataGridTextColumn Header="办结人" Binding="{Binding CompletedBy}" Width="70"/>
                        <DataGridTextColumn Header="登记说明" Binding="{Binding Reason}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#D1D5DB"
                          ShowsPreview="True"/>

            <Border Grid.Column="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1,0,0,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="选中记录详情"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#6F4A00"
                               Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="1"
                               Text="请在左侧列表中选择一条盘库登记记录，查看摘要与明细。"
                               Foreground="#9CA3AF"
                               FontSize="13"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding DetailEmptyVisibility, Mode=OneWay}"/>

                    <Grid Grid.Row="1" Visibility="{Binding DetailContentVisibility, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Margin="0,0,0,10"
                                Padding="10,8"
                                Background="#FFFBEB"
                                BorderBrush="#E2C98F"
                                BorderThickness="1"
                                CornerRadius="4">
                            <TextBlock Text="{Binding DetailSummaryText, Mode=OneWay}"
                                       TextWrapping="Wrap"
                                       Foreground="#6F4A00"
                                       FontSize="12"
                                       LineHeight="18"/>
                        </Border>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding DetailItems}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  RowHeight="34"
                                  ColumnHeaderHeight="36"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="硬盘编号" Binding="{Binding DiskCode}" Width="100"/>
                                <DataGridTextColumn Header="序列号" Binding="{Binding SerialNumber}" Width="110"/>
                                <DataGridTextColumn Header="原状态" Binding="{Binding BeforeMediaStatus}" Width="90"/>
                                <DataGridTextColumn Header="原档口" Binding="{Binding BeforeStorageLocation}" Width="110"/>
                                <DataGridTextColumn Header="目标档口" Binding="{Binding TargetStorageLocationDisplay}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
