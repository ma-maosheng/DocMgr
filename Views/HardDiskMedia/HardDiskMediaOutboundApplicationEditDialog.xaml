<Window x:Class="DocMgr.Views.HardDiskMedia.HardDiskMediaOutboundApplicationEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1280"
        Height="780"
        MinWidth="1100"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="OutboundFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="OutboundSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>
        <Style x:Key="OutboundCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8E2EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding WindowTitle}" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="{Binding HeaderGuidanceText}"
                       Margin="0,6,0,0" Foreground="#666" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="360"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="520"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：申请信息 -->
            <Border Grid.Column="0" Style="{StaticResource OutboundCardBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="申请信息" Style="{StaticResource OutboundSectionTitleStyle}" Margin="0,0,0,10"/>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="申请类型 *" Style="{StaticResource OutboundFieldLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding ApplicationTypeOptions}"
                                      SelectedItem="{Binding ApplicationType}"
                                      Height="{StaticResource DialogFormControlHeight}"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="申请人" Style="{StaticResource OutboundFieldLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding ApplicantOptions}"
                                          SelectedItem="{Binding SelectedApplicant}"
                                          DisplayMemberPath="DisplayText"
                                          IsEnabled="False"
                                          Height="{StaticResource DialogFormControlHeight}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="申请部门" Style="{StaticResource OutboundFieldLabelStyle}"/>
                                <TextBox Text="{Binding ApplicantDept, Mode=OneWay}"
                                         Height="{StaticResource DialogFormControlHeight}"
                                         IsReadOnly="True"
                                         Background="#F8FAFC"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="申请日期" Style="{StaticResource OutboundFieldLabelStyle}"/>
                                <DatePicker SelectedDate="{Binding ApplyTime, Mode=OneWay}"
                                            Height="{StaticResource DialogFormControlHeight}"
                                            IsEnabled="False"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="预计归还日期" Style="{StaticResource OutboundFieldLabelStyle}"/>
                                <DatePicker SelectedDate="{Binding ExpectedReturnDate}"
                                            Height="{StaticResource DialogFormControlHeight}"
                                            Visibility="{Binding CanEditExpectedReturnDate, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBox Text="{Binding ExpectedReturnDateDisplay, Mode=OneWay}"
                                         Height="{StaticResource DialogFormControlHeight}"
                                         IsReadOnly="True"
                                         Background="#F8FAFC"
                                         VerticalContentAlignment="Center"
                                         Visibility="{Binding ShowExpectedReturnDateAsDash, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding ExpectedReturnDateHint}"
                                   Margin="0,0,0,10"
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Visibility="{Binding CanEditExpectedReturnDate, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="当前位置" Style="{StaticResource OutboundFieldLabelStyle}"/>
                                <TextBox Text="{Binding CurrentLocation, Mode=OneWay}"
                                         Height="{StaticResource DialogFormControlHeight}"
                                         IsReadOnly="True"
                                         Background="#F8FAFC"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="目标位置/去向" Style="{StaticResource OutboundFieldLabelStyle}"/>
                                <TextBox Text="{Binding TargetLocation, Mode=OneWay}"
                                         Height="{StaticResource DialogFormControlHeight}"
                                         IsReadOnly="True"
                                         Background="#F8FAFC"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="申请原因 *" Style="{StaticResource OutboundFieldLabelStyle}"/>
                        <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="120"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Padding="6,4"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右侧：关联介质 -->
            <Border Grid.Column="2" Style="{StaticResource OutboundCardBorderStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="关联介质 *"
                                   Style="{StaticResource OutboundSectionTitleStyle}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding MediumSelectionGuidanceText}"
                                   Foreground="#64748B"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="12,0,12,0"/>
                        <Border Grid.Column="2"
                                Background="#E2E8F0"
                                CornerRadius="3"
                                Padding="8,3"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding MediumSelectionSummary}" Foreground="#1E293B" FontSize="12"/>
                        </Border>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding MediumOptions}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="1"
                              BorderBrush="#E2E8F0"
                              Background="#FAFBFC"
                              RowHeight="34"
                              ColumnHeaderHeight="34"
                              IsReadOnly="False"
                              EnableRowVirtualization="True"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="选"
                                                    Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="40"/>
                            <DataGridTextColumn Header="硬盘编号"
                                                Binding="{Binding DiskCode, Mode=OneWay}"
                                                Width="90"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="序列号"
                                                Binding="{Binding SerialNumber, Mode=OneWay}"
                                                Width="120"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="硬盘类型"
                                                Binding="{Binding DiskType, Mode=OneWay}"
                                                Width="80"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="品牌"
                                                Binding="{Binding Brand, Mode=OneWay}"
                                                Width="80"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="容量"
                                                Binding="{Binding Capacity, Mode=OneWay}"
                                                Width="70"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="接口类型"
                                                Binding="{Binding InterfaceType, Mode=OneWay}"
                                                Width="80"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="档口编号"
                                                Binding="{Binding SlotCode, Mode=OneWay}"
                                                Width="100"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="登记人"
                                                Binding="{Binding RegisterPerson, Mode=OneWay}"
                                                Width="80"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="登记日期"
                                                Binding="{Binding RegisterDateDisplay, Mode=OneWay}"
                                                Width="96"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="出厂日期"
                                                Binding="{Binding FactoryDateDisplay, Mode=OneWay}"
                                                Width="96"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="登记方式"
                                                Binding="{Binding RegistrationMethod, Mode=OneWay}"
                                                Width="110"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="备注"
                                                Binding="{Binding Remark, Mode=OneWay}"
                                                Width="*"
                                                MinWidth="80"
                                                IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,10,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Background="#FAFBFC">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding SaveButtonText}" Command="{Binding SaveDraftCommand}" Margin="0,0,8,0" Padding="12,6"/>
                    <Button Content="{Binding SubmitButtonText}" Command="{Binding SubmitCommand}" Margin="0,0,8,0" Padding="12,6"/>
                    <Button Content="{Binding PrintButtonText}" Command="{Binding PrintCommand}" Margin="0,0,8,0" Padding="12,6"/>
                </StackPanel>

                <Button Grid.Column="1" Content="关闭" Command="{Binding CancelCommand}" Padding="16,6"/>
            </Grid>
        </Border>
    </Grid>
</Window>
