<Window x:Class="DocMgr.Views.HardDiskMedia.HardDiskMediaOutboundApplicationEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1000"
        Height="760"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="OutboundFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="OutboundSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding WindowTitle}" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="{Binding HeaderGuidanceText}"
                       Margin="0,6,0,0" Foreground="#666" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Background="White" BorderBrush="#D8E2EC" BorderThickness="1" Padding="14" CornerRadius="4" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="申请信息" Style="{StaticResource OutboundSectionTitleStyle}" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="申请类型 *" Style="{StaticResource OutboundFieldLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding ApplicationTypeOptions}" SelectedItem="{Binding ApplicationType}" Height="30"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="申请人" Style="{StaticResource OutboundFieldLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding ApplicantOptions}"
                                          SelectedItem="{Binding SelectedApplicant}"
                                          DisplayMemberPath="DisplayText"
                                          IsEnabled="False"
                                          Height="30"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="申请部门" Style="{StaticResource OutboundFieldLabelStyle}"/>
                                <TextBox Text="{Binding ApplicantDept}" Height="30" IsReadOnly="True" Background="#F8FAFC" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="申请日期" Style="{StaticResource OutboundFieldLabelStyle}"/>
                                <DatePicker SelectedDate="{Binding ApplyTime}" Height="30" IsEnabled="False"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="预计归还日期" Style="{StaticResource OutboundFieldLabelStyle}"/>
                                <DatePicker SelectedDate="{Binding ExpectedReturnDate}"
                                            Height="30"
                                            Visibility="{Binding CanEditExpectedReturnDate, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBox Text="{Binding ExpectedReturnDateDisplay, Mode=OneWay}"
                                         Height="30"
                                         IsReadOnly="True"
                                         Background="#F8FAFC"
                                         VerticalContentAlignment="Center"
                                         Visibility="{Binding ShowExpectedReturnDateAsDash, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding ExpectedReturnDateHint}"
                                           Margin="0,6,0,0"
                                           Foreground="#64748B"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Visibility="{Binding CanEditExpectedReturnDate, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="当前位置" Style="{StaticResource OutboundFieldLabelStyle}"/>
                                <TextBox Text="{Binding CurrentLocation}" Height="30" IsReadOnly="True" Background="#F8FAFC" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="目标位置/去向" Style="{StaticResource OutboundFieldLabelStyle}"/>
                                <TextBox Text="{Binding TargetLocation}" Height="30" IsReadOnly="True" Background="#F8FAFC" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="申请原因 *" Style="{StaticResource OutboundFieldLabelStyle}"/>
                        <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                                 Height="80"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Padding="6,4"/>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#D8E2EC" BorderThickness="1" Padding="14" CornerRadius="4">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="关联介质 *" Style="{StaticResource OutboundSectionTitleStyle}"/>
                            <Border Grid.Column="1"
                                    Background="#E2E8F0"
                                    CornerRadius="3"
                                    Padding="8,3">
                                <TextBlock Text="{Binding MediumSelectionSummary}" Foreground="#1E293B" FontSize="12"/>
                            </Border>
                        </Grid>

                        <Border BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                Background="#FAFBFC"
                                MaxHeight="200">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding MediumOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding DisplayText}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Margin="8,4"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,10,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Background="#FAFBFC">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding SaveButtonText}" Command="{Binding SaveDraftCommand}" Margin="0,0,8,0" Padding="12,6"/>
                    <Button Content="{Binding SubmitButtonText}" Command="{Binding SubmitCommand}" Margin="0,0,8,0" Padding="12,6"/>
                    <Button Content="{Binding PrintButtonText}" Command="{Binding PrintCommand}" Margin="0,0,8,0" Padding="12,6"/>
                </StackPanel>

                <Button Grid.Column="1" Content="关闭" Command="{Binding CancelCommand}" Padding="16,6"/>
            </Grid>
        </Border>
    </Grid>
</Window>
