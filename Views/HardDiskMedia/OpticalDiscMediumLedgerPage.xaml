<Page x:Class="DocMgr.Views.HardDiskMedia.OpticalDiscMediumLedgerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="800"
      d:DesignWidth="1200"
      Title="OpticalDiscMediumLedgerPage"
      Background="#F0F2F5">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.1*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCardBorderStyle}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="关键词:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Width="220" Style="{StaticResource ToolbarFilterTextBoxStyle}" VerticalContentAlignment="Center"
                                 Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="状态:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="150" Style="{StaticResource ToolbarFilterComboBoxStyle}" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="查询" Command="{Binding SearchCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="88" Margin="0,0,10,0"/>
                    <Button Grid.Column="3" Content="刷新列表" Command="{Binding RefreshCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="88" Margin="0,0,10,0"/>
                    <Button Grid.Column="4" Content="导出台账" Command="{Binding ExportCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="96"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1"
                Margin="0,12,0,12"
                Padding="0"
                Background="#FFFDF7"
                BorderBrush="#E2C98F"
                BorderThickness="1"
                CornerRadius="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#B98A2E"/>

                <TextBlock Grid.Row="1"
                           Text="数据光盘流转台账"
                           Margin="0,12,0,4"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#6F4A00"
                           HorizontalAlignment="Center"
                           TextDecorations="Underline"/>

                <TextBlock Grid.Row="2"
                           Text="Optical Disc Circulation Ledger"
                           Margin="0,0,0,10"
                           FontSize="12"
                           Foreground="#9A7B3F"
                           HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="4" Padding="10">
            <DataGrid x:Name="DgMedia"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      RowHeight="38"
                      ColumnHeaderHeight="40"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      ItemsSource="{Binding MediaItems}"
                      SelectedItem="{Binding SelectedMedium}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="光盘编号" Binding="{Binding DiscCode}" Width="120"/>
                    <DataGridTextColumn Header="当前状态" Binding="{Binding Ledger.MediaStatus}" Width="120"/>
                    <DataGridTextColumn Header="当前存放位置" Binding="{Binding Ledger.StorageLocation}" Width="160"/>
                    <DataGridTextColumn Header="持有人/保管单位" Binding="{Binding Ledger.HolderOrOrganization}" Width="150"/>
                    <DataGridTextColumn Header="光盘类型" Binding="{Binding DiscType}" Width="100"/>
                    <DataGridTextColumn Header="容量" Binding="{Binding Capacity}" Width="80"/>
                    <DataGridTextColumn Header="登记方式" Binding="{Binding RegistrationMethod}" Width="120"/>
                    <DataGridTextColumn Header="登记人" Binding="{Binding RegisterPerson}" Width="90"/>
                    <DataGridTextColumn Header="登记日期" Binding="{Binding RegisterDate, StringFormat=yyyy-MM-dd}" Width="110"/>
                    <DataGridTextColumn Header="来源类型" Binding="{Binding SourceType}" Width="100"/>
                    <DataGridTextColumn Header="来源记录" Binding="{Binding SourceRecordKey}" Width="120"/>
                    <DataGridTextColumn Header="备注" Binding="{Binding Remarks}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="4" Background="White" CornerRadius="4" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="流转台账（随资料业务形成：立档/移库/销毁等）"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#374151"
                           Margin="0,0,0,8"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <TextBlock Text="光盘编号:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Width="140" VerticalContentAlignment="Center" Margin="0,0,16,0"
                             Text="{Binding TransactionDiscCodeKeyword, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="业务单号:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Width="180" VerticalContentAlignment="Center" Margin="0,0,16,0"
                             Text="{Binding TransactionBusinessNoKeyword, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="查询流转" Click="BtnSearchTransactions_Click" Style="{StaticResource ToolbarActionButtonStyle}" Width="96"/>
                </StackPanel>

                <DataGrid Grid.Row="3"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          RowHeight="34"
                          ColumnHeaderHeight="38"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          ItemsSource="{Binding Transactions}"
                          SelectedItem="{Binding SelectedTransaction}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="办理时间" Binding="{Binding OperateTime, StringFormat=yyyy-MM-dd HH:mm}" Width="130"/>
                        <DataGridTextColumn Header="光盘编号" Binding="{Binding DiscCode}" Width="110"/>
                        <DataGridTextColumn Header="流转类型" Binding="{Binding TransactionType}" Width="100"/>
                        <DataGridTextColumn Header="业务单号" Binding="{Binding BusinessNo}" Width="140"/>
                        <DataGridTextColumn Header="流转前位置" Binding="{Binding BeforeLocation}" Width="130"/>
                        <DataGridTextColumn Header="流转后位置" Binding="{Binding AfterLocation}" Width="130"/>
                        <DataGridTextColumn Header="办理人" Binding="{Binding OperatorName}" Width="90"/>
                        <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>
