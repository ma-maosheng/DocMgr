<Page x:Class="DocMgr.Views.Cabinets.CabinetLayoutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:DocMgr.Views.Cabinets"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1400"
      Title="档案柜登记">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="10" Padding="10" Background="#FAFAFA" BorderBrush="#EEE" BorderThickness="1" CornerRadius="4">
            <StackPanel Orientation="Horizontal">
                <Button Content="➕ 新增柜子"
                        Command="{Binding AddCommand}"
                        Width="100"
                        Margin="0,0,10,0"
                        Style="{StaticResource ButtonNormalStyle}"
                        Visibility="{Binding CanMaintainLayout, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Content="✏️ 编辑选中"
                        Command="{Binding EditCommand}"
                        Width="100"
                        Margin="0,0,10,0"
                        Style="{StaticResource ButtonNormalStyle}"
                        Visibility="{Binding CanMaintainLayout, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Content="🗑️ 删除选中"
                        Command="{Binding DeleteCommand}"
                        Width="100"
                        Margin="0,0,10,0"
                        Style="{StaticResource ButtonCautionStyle}"
                        Visibility="{Binding CanMaintainLayout, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Content="🔄 刷新" Command="{Binding RefreshCommand}" Width="80" Style="{StaticResource ButtonNormalStyle}"/>
                <TextBlock Text="提示：选中柜子可按住鼠标拖拽移动位置，右键可进行编号、旋转等操作"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"
                           Foreground="Gray"
                           Visibility="{Binding CanMaintainLayout, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </Border>

        <local:CabinetRoomMapControl Grid.Row="1"/>
    </Grid>
</Page>
