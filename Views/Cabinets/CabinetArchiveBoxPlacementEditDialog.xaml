<Window x:Class="DocMgr.Views.Cabinets.CabinetArchiveBoxPlacementEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewShared="clr-namespace:DocMgr.Views.Shared"
        Width="420"
        Height="250"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="#F5F7FA">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button Content="关闭"
                Command="{x:Static viewShared:ViewCommands.CloseCurrentView}"
                Style="{StaticResource DialogCloseButtonStyle}"
                HorizontalAlignment="Right"/>

        <TextBlock Text="设置档案盒放置方式"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#1F2937"/>

        <TextBlock Grid.Row="1"
                   Margin="0,12,0,0"
                   Text="{Binding Summary}"
                   TextWrapping="Wrap"
                   Foreground="#475569"/>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <RadioButton Content="盒脊向外"
                         IsChecked="{Binding IsSpineOut, Mode=TwoWay}"
                         FontSize="14"
                         Margin="0,0,0,10"/>
            <RadioButton Content="盒面向外"
                         IsChecked="{Binding IsFrontOut, Mode=TwoWay}"
                         FontSize="14"/>
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="确定"
                    Width="80"
                    Height="30"
                    Style="{DynamicResource ButtonNormalStyle}"
                    Command="{Binding ConfirmCommand}"/>
            <Button Content="取消"
                    Width="80"
                    Height="30"
                    Margin="10,0,0,0"
                    Style="{DynamicResource ButtonNormalStyle}"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
