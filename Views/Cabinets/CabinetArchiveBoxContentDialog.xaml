<Window x:Class="DocMgr.Views.Cabinets.CabinetArchiveBoxContentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1180"
        Height="620"
        MinWidth="860"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F5F7FA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="18" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <TextBlock Text="{Binding HeaderText}" FontSize="22" FontWeight="Bold" Foreground="#1F2937"/>
                <TextBlock Text="{Binding SummaryText}" Margin="0,8,0,0" FontSize="13" Foreground="#6B7280"/>
                <TextBlock Text="{Binding YearlyArchiveHintText}"
                           Margin="0,8,0,0"
                           FontSize="12"
                           Foreground="#475569"
                           TextWrapping="Wrap"/>
                <Border Margin="0,12,0,0"
                        Padding="12,10"
                        Background="#FEF2F2"
                        BorderBrush="#FCA5A5"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{Binding MixedPlacementNoticeVisibility}">
                    <StackPanel>
                        <TextBlock Text="{Binding MixedPlacementNoticeTitle}" FontSize="13" FontWeight="Bold" Foreground="#B91C1C"/>
                        <TextBlock Text="{Binding MixedPlacementNoticeText}" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12" Foreground="#7F1D1D"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="0,16,0,16" Padding="12" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
            <Grid>
                <!-- 年度模拟 / 电子袋：份数与载体列 -->
                <DataGrid ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          Visibility="{Binding YearlyStyleGridVisibility}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="来源类型" Binding="{Binding SourceType}" Width="90"/>
                        <DataGridTextColumn Header="载体" Binding="{Binding CarrierTypeText}" Width="90"/>
                        <DataGridTextColumn Header="类别" Binding="{Binding CategoryText}" Width="140"/>
                        <DataGridTextColumn Header="登记单号" Binding="{Binding IdentifierText}" Width="120"/>
                        <DataGridTextColumn Header="资料子项" Binding="{Binding TitleText}" Width="180"/>
                        <DataGridTextColumn Header="立档份数" Binding="{Binding FiledCopyCountDisplay}" Width="80"/>
                        <DataGridTextColumn Header="当前库内份数" Binding="{Binding CurrentInArchiveCopyCountDisplay}" Width="96"/>
                        <DataGridTextColumn Header="出库待还份数" Binding="{Binding PendingReturnCopyCountDisplay}" Width="96"/>
                        <DataGridTextColumn Header="出库不还份数" Binding="{Binding NoReturnCopyCountDisplay}" Width="96"/>
                        <DataGridTextColumn Header="出库灭失份数" Binding="{Binding LostCopyCountDisplay}" Width="96"/>
                        <DataGridTextColumn Header="盘库丢失份数" Binding="{Binding InventoryLostCopyCountDisplay, Mode=OneWay}" Width="96"/>
                        <DataGridTextColumn Header="盘库拟销份数" Binding="{Binding InventoryScrapCopyCountDisplay, Mode=OneWay}" Width="96"/>
                        <DataGridTextColumn Header="介质盘库状态" Binding="{Binding ElectronicStatusDisplay, Mode=OneWay}" Width="96"/>
                        <DataGridTextColumn Header="详细信息" Binding="{Binding DetailText}" Width="*"/>
                        <DataGridTextColumn Header="立档日期" Binding="{Binding DateText}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 历史存档：按对应台账表实际字段分表列出 -->
                <Grid Visibility="{Binding HistoryGridVisibility}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="{Binding HistoryTopoRowHeight}"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="{Binding HistoryAerialRowHeight}"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="{Binding HistoryOtherRowHeight}"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="地形图"
                               Margin="0,0,0,6"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#334155"
                               Visibility="{Binding HistoryTopoSectionHeaderVisibility}"/>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding TopoItems}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              Visibility="{Binding HistoryTopoGridVisibility}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="比例尺" Binding="{Binding HistoryFields.Scale}" Width="80"/>
                            <DataGridTextColumn Header="图上图号" Binding="{Binding HistoryFields.MapNumber}" Width="110"/>
                            <DataGridTextColumn Header="当前图号" Binding="{Binding HistoryFields.CurrentMapNumber}" Width="120"/>
                            <DataGridTextColumn Header="图名" Binding="{Binding HistoryFields.MapName}" Width="150"/>
                            <DataGridTextColumn Header="幅数" Binding="{Binding HistoryFields.SheetCount}" Width="56"/>
                            <DataGridTextColumn Header="成图日期" Binding="{Binding HistoryFields.CreationDate}" Width="100"/>
                            <DataGridTextColumn Header="调绘日期" Binding="{Binding HistoryFields.SurveyDate}" Width="100"/>
                            <DataGridTextColumn Header="坐标系统" Binding="{Binding HistoryFields.CoordinateSystem}" Width="100"/>
                            <DataGridTextColumn Header="高程基准" Binding="{Binding HistoryFields.ElevationDatum}" Width="100"/>
                            <DataGridTextColumn Header="涉及省市县" Binding="{Binding HistoryFields.Region}" Width="140"/>
                            <DataGridTextColumn Header="登记人" Binding="{Binding HistoryFields.Registrant}" Width="80"/>
                            <DataGridTextColumn Header="登记日期" Binding="{Binding HistoryFields.RegistrationDate}" Width="110"/>
                            <DataGridTextColumn Header="备注" Binding="{Binding HistoryFields.Remark}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2"
                               Text="航摄影像"
                               Margin="0,8,0,6"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#334155"
                               Visibility="{Binding HistoryAerialSectionHeaderVisibility}"/>
                    <DataGrid Grid.Row="3"
                              ItemsSource="{Binding AerialItems}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              Visibility="{Binding HistoryAerialGridVisibility}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="分类" Binding="{Binding HistoryFields.Category}" Width="100"/>
                            <DataGridTextColumn Header="测区名称" Binding="{Binding HistoryFields.SurveyArea}" Width="140"/>
                            <DataGridTextColumn Header="比例尺" Binding="{Binding HistoryFields.Scale}" Width="80"/>
                            <DataGridTextColumn Header="航摄日期" Binding="{Binding HistoryFields.PhotographyDate}" Width="100"/>
                            <DataGridTextColumn Header="档案盒内物品" Binding="{Binding HistoryFields.BoxContents}" Width="*"/>
                            <DataGridTextColumn Header="相片张数" Binding="{Binding HistoryFields.PhotoCount}" Width="80"/>
                            <DataGridTextColumn Header="档案盒规格" Binding="{Binding HistoryFields.BoxSpecification}" Width="100"/>
                            <DataGridTextColumn Header="登记人" Binding="{Binding HistoryFields.Registrant}" Width="80"/>
                            <DataGridTextColumn Header="登记日期" Binding="{Binding HistoryFields.RegistrationDate}" Width="110"/>
                            <DataGridTextColumn Header="备注" Binding="{Binding HistoryFields.Remark}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="4"
                               Text="其他图件"
                               Margin="0,8,0,6"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#334155"
                               Visibility="{Binding HistoryOtherSectionHeaderVisibility}"/>
                    <DataGrid Grid.Row="5"
                              ItemsSource="{Binding OtherItems}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              Visibility="{Binding HistoryOtherGridVisibility}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="序号" Binding="{Binding HistoryFields.SequenceNumber}" Width="70"/>
                            <DataGridTextColumn Header="资料分类" Binding="{Binding HistoryFields.MaterialCategory}" Width="120"/>
                            <DataGridTextColumn Header="起始年度" Binding="{Binding HistoryFields.StartYear}" Width="80"/>
                            <DataGridTextColumn Header="截止年度" Binding="{Binding HistoryFields.EndYear}" Width="80"/>
                            <DataGridTextColumn Header="资料内容" Binding="{Binding HistoryFields.MapName}" Width="*"/>
                            <DataGridTextColumn Header="档案盒规格" Binding="{Binding HistoryFields.BoxSpecification}" Width="110"/>
                            <DataGridTextColumn Header="登记人" Binding="{Binding HistoryFields.Registrant}" Width="90"/>
                            <DataGridTextColumn Header="登记日期" Binding="{Binding HistoryFields.RegistrationDate}" Width="120"/>
                            <DataGridTextColumn Header="备注" Binding="{Binding HistoryFields.Remark}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <TextBlock Text="{Binding EmptyHint}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="16"
                           Foreground="#94A3B8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="查看资料详情"
                    Command="{Binding ViewArchiveDetailCommand}"
                    Style="{StaticResource DialogSecondaryActionButtonStyle}"
                    Width="144"
                    Margin="0,0,8,0"
                    Visibility="{Binding ViewArchiveDetailButtonVisibility}"
                    ToolTip="查看所选资料子项的登记明细、立档容器与关联信息"/>
            <Button Content="关闭"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource DialogSecondaryActionButtonStyle}"
                    Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
