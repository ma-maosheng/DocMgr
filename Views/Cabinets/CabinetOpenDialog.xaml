                                                        Padding="8,3"
                                                        Background="#FCE7F3"
                                                        BorderBrush="#F9A8D4"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Visibility="{Binding DataOpticalDiscSlotVisibility}">
                                                    <TextBlock Text="年度光盘" Style="{StaticResource SnapFs11}" FontWeight="SemiBold" Foreground="#BE185D"/>
                                                </Border>
                                                <Border Margin="0,6,0,0"
                                                        Padding="8,3"
                                                        Background="#E0E7FF"
                                                        BorderBrush="#A5B4FC"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Visibility="{Binding HistoricalDataDiskSlotVisibility}">
                                                    <TextBlock Text="历史硬盘" Style="{StaticResource SnapFs11}" FontWeight="SemiBold" Foreground="#4338CA"/>
                                                </Border>
                                                <Border Margin="0,6,0,0"
                                                        Padding="8,3"
                                                        Background="#F5D0FE"
                                                        BorderBrush="#E879F9"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Visibility="{Binding HistoricalDataOpticalDiscSlotVisibility}">
                                                    <TextBlock Text="历史光盘" Style="{StaticResource SnapFs11}" FontWeight="SemiBold" Foreground="#A21CAF"/>
