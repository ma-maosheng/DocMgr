                                                                                                VerticalAlignment="Bottom"
                                                                                                Padding="2,0"
                                                                                                Background="{Binding SwBadgeBackground}"
                                                                                                BorderBrush="{Binding SwBadgeBorderBrush}"
                                                                                                BorderThickness="0.8"
                                                                                                CornerRadius="3"
                                                                                                ToolTip="{Binding SwBadgeToolTip, Mode=OneWay}"
                                                                                                Visibility="{Binding SwBadgeVisibility}">
                                                                                            <TextBlock Text="{Binding SwBadgeText, Mode=OneWay}"
                                                                                                       Style="{StaticResource SnapFs8}"
                                                                                                       FontWeight="Bold"
                                                                                                       Foreground="{Binding SwBadgeForeground}"/>
                                                                                        </Border>
                                                                                        <Border HorizontalAlignment="Right"
                                                                                                VerticalAlignment="Bottom"
                                                                                                Padding="2,0"
                                                                                                Background="{Binding SeBadgeBackground}"
                                                                                                BorderBrush="{Binding SeBadgeBorderBrush}"
                                                                                                BorderThickness="0.8"
                                                                                                CornerRadius="3"
                                                                                                Visibility="{Binding SeBadgeVisibility}">
                                                                                            <TextBlock Text="{Binding SeBadgeText, Mode=OneWay}"
                                                                                                       Style="{StaticResource SnapFs8}"
                                                                                                       FontWeight="Bold"
                                                                                                       Foreground="{Binding SeBadgeForeground}"/>
                                                                                        </Border>
                                                                                    </Grid>
                                                                                </DockPanel>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Border>

                                                        <Border Grid.Row="1"
                                                                Margin="0,8,0,0"
                                                                Padding="8"
