                                                        Padding="8,3"
                                                        Background="#ECFCCB"
                                                        BorderBrush="#BEF264"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Visibility="{Binding BlankDiskSlotVisibility}">
                                                    <TextBlock Text="空白专用" Style="{StaticResource SnapFs11}" FontWeight="SemiBold" Foreground="#3F6212"/>
