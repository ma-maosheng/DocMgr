                                                        CornerRadius="10"
                                                        Visibility="{Binding SpecialRuleVisibility}">
                                                    <TextBlock Text="特例" Style="{StaticResource SnapFs11}" FontWeight="SemiBold" Foreground="#6D28D9"/>
                                                </Border>
                                                <Border Margin="0,6,0,0"
                                                        Padding="8,3"
                                                        Background="#DBEAFE"
                                                        BorderBrush="#93C5FD"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Visibility="{Binding YearlyMaterialsSlotVisibility}">
                                                    <TextBlock Text="年度资料" Style="{StaticResource SnapFs11}" FontWeight="SemiBold" Foreground="#1D4ED8"/>
