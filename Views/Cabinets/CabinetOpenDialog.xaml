                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <StackPanel HorizontalAlignment="Left"
                                                        VerticalAlignment="Top">
                                                <Border Padding="8,3"
                                                        Background="#DBEAFE"
                                                        BorderBrush="#93C5FD"
                                                        BorderThickness="1"
                                                        CornerRadius="10">
                                                    <TextBlock Text="{Binding SlotCode}" Style="{StaticResource SnapFs12}" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                                                </Border>
                                                <TextBlock Margin="2,4,0,0"
                                                           Text="{Binding PurposeDisplayText}"
                                                           Style="{StaticResource SnapFs11}"
                                                           Foreground="#475569"
                                                           Visibility="{Binding ArchiveSlotPurposeVisibility}"/>
                                            </StackPanel>

                                            <StackPanel HorizontalAlignment="Right"
                                                        VerticalAlignment="Top">
                                                <Border Padding="8,3"
                                                        Background="#EDE9FE"
                                                        BorderBrush="#C4B5FD"
