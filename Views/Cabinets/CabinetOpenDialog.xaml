                                                                                              IsEnabled="{Binding PlacementTarget.DataContext.CanShowArchiveInfo, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                                    <Separator Visibility="{Binding PlacementTarget.Tag.InteractiveItemRelocationMenuVisibility, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
