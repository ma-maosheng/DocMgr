                                                                                                           Style="{StaticResource SnapFs8}"
                                                                                                           FontWeight="Bold"
                                                                                                           Foreground="{Binding NeTertiaryBadgeForeground}"/>
                                                                                            </Border>
                                                                                        </StackPanel>
                                                                                    </Grid>
                                                                                    <Grid DockPanel.Dock="Bottom" Margin="0,0,0,0">
