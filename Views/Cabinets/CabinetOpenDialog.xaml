                                                        Padding="8,3"
                                                        Background="#D1FAE5"
                                                        BorderBrush="#6EE7B7"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Visibility="{Binding MixedUseArchiveSlotVisibility}">
                                                    <TextBlock Text="混用档口" Style="{StaticResource SnapFs11}" FontWeight="SemiBold" Foreground="#047857"/>
                                                </Border>
                                                <Border Margin="0,6,0,0"
                                                        Padding="8,3"
                                                        Background="#FEE2E2"
                                                        BorderBrush="#FCA5A5"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Visibility="{Binding DamagedDiskSlotVisibility}">
                                                    <TextBlock Text="损坏硬盘" Style="{StaticResource SnapFs11}" FontWeight="SemiBold" Foreground="#B91C1C"/>
                                                </Border>
