                                                                                        <RowDefinition Height="Auto"/>
                                                                                        <RowDefinition Height="Auto"/>
                                                                                        <RowDefinition Height="Auto"/>
                                                                                    </Grid.RowDefinitions>

                                                                                    <Grid HorizontalAlignment="Center" Width="34" Height="22">
                                                                                        <Border Margin="0,3,0,0"
                                                                                                Background="{Binding IconBodyBrush}"
                                                                                                BorderBrush="{Binding IconAccentBrush}"
                                                                                                BorderThickness="1"
                                                                                                CornerRadius="3"
                                                                                                Visibility="{Binding HardDiskIconVisibility}"/>
                                                                                        <Border HorizontalAlignment="Left"
                                                                                                Width="9"
                                                                                                Height="4"
