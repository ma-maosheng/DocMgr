                                                        Padding="8,3"
                                                        Background="#FFE4E6"
                                                        BorderBrush="#FB7185"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Visibility="{Binding DamagedOpticalDiscSlotVisibility}">
                                                    <TextBlock Text="损坏光盘" Style="{StaticResource SnapFs11}" FontWeight="SemiBold" Foreground="#BE123C"/>
