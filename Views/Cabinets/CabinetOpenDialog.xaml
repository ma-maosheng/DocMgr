                                                                                               TextAlignment="Center"
                                                                                               TextWrapping="Wrap"
                                                                                               Style="{StaticResource SnapFs10}"
                                                                                               Foreground="{Binding DetailForeground}"/>

                                                                                    <TextBlock Margin="0,2,0,0"
