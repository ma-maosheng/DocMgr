                                                                                </Border>
                                                                            </Grid>
                                                                        </DockPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Grid Visibility="{Binding HardDiskMatrixVisibility}">
