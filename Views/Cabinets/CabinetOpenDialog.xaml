                                                        Padding="8,3"
                                                        Background="#DBEAFE"
                                                        BorderBrush="#93C5FD"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Visibility="{Binding DataDiskSlotVisibility}">
                                                    <TextBlock Text="年度硬盘" Style="{StaticResource SnapFs11}" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                                                </Border>
