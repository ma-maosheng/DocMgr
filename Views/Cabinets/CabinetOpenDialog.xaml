<Window x:Class="DocMgr.Views.Cabinets.CabinetOpenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="980"
        Height="760"
        MinWidth="840"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        SizeChanged="Window_SizeChanged"
        Background="#F5F7FA">

    <Window.InputBindings>
        <KeyBinding Key="A"
                    Modifiers="Control"
                    Command="{Binding SelectAllSlotsCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="SnapFs7" TargetType="TextBlock">
            <Setter Property="FontSize" Value="7"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSingleSlotSnapshot, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="FontSize" Value="8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SnapFs8" TargetType="TextBlock">
            <Setter Property="FontSize" Value="8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSingleSlotSnapshot, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="FontSize" Value="9"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SnapFs9" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSingleSlotSnapshot, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="FontSize" Value="10"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SnapFs10" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSingleSlotSnapshot, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="FontSize" Value="11"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SnapFs11" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSingleSlotSnapshot, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="FontSize" Value="12"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SnapFs12" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSingleSlotSnapshot, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="FontSize" Value="13"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SnapFs15" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSingleSlotSnapshot, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="FontSize" Value="16"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="CompactMagneticDiskSlotTemplate">
            <Border Margin="4"
                    Width="{Binding DataContext.EffectiveSlotDisplayWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                    Height="{Binding DataContext.EffectiveSlotDisplayHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                    Padding="6"
                    Background="{Binding CompactSlotBackground}"
                    BorderBrush="{Binding CompactBorderBrush}"
                    BorderThickness="{Binding CompactBorderThickness}"
                    CornerRadius="6"
                    Cursor="Hand"
                    ToolTip="{Binding SlotToolTipText}"
                    MouseLeftButtonDown="Slot_MouseLeftButtonDown"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                <Border.ContextMenu>
                    <ContextMenu Opened="SlotContextMenu_Opened"
                                 Closed="SlotContextMenu_Closed">
                        <MenuItem Header="查看档口详情"
                                  Command="{Binding PlacementTarget.Tag.ShowSlotDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="放大查看此档口"
                                  Visibility="{Binding PlacementTarget.Tag.SlotZoomMenuVisibility, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Command="{Binding PlacementTarget.Tag.ShowSlotZoomCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator Visibility="{Binding PlacementTarget.Tag.CompactBatchPurposeMenuVisibility, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="{Binding PlacementTarget.Tag.BatchApplyPurposeMenuText, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Visibility="{Binding PlacementTarget.Tag.CompactBatchArchivePurposeMenuVisibility, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem Header="未定义（未设置）"
                                      IsCheckable="True"
                                      IsChecked="{Binding PlacementTarget.Tag.IsSelectedSlotsArchiveUnsetCategory, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                      Command="{Binding PlacementTarget.Tag.ApplySelectedSlotsArchiveUnsetCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="年度资料专用档口"
                                      IsCheckable="True"
                                      IsChecked="{Binding PlacementTarget.Tag.IsSelectedSlotsArchiveYearlyCategory, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                      Command="{Binding PlacementTarget.Tag.ApplySelectedSlotsArchiveYearlyCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="历史资料专用档口"
                                      IsCheckable="True"
                                      IsChecked="{Binding PlacementTarget.Tag.IsSelectedSlotsArchiveHistoricalCategory, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                      Command="{Binding PlacementTarget.Tag.ApplySelectedSlotsArchiveHistoricalCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="混用档口"
                                      IsCheckable="True"
                                      IsChecked="{Binding PlacementTarget.Tag.IsSelectedSlotsArchiveMixedCategory, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                      Command="{Binding PlacementTarget.Tag.ApplySelectedSlotsArchiveMixedCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </MenuItem>
                        <MenuItem Header="{Binding PlacementTarget.Tag.BatchApplyPurposeMenuText, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Visibility="{Binding PlacementTarget.Tag.CompactBatchHardDiskPurposeMenuVisibility, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem Header="通用（无专用用途）"
                                      IsCheckable="True"
                                      IsChecked="{Binding PlacementTarget.Tag.IsSelectedSlotsHardDiskGeneralCategory, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                      Command="{Binding PlacementTarget.Tag.ApplySelectedSlotsHardDiskGeneralCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="损坏硬盘专用档口"
                                      IsCheckable="True"
                                      IsChecked="{Binding PlacementTarget.Tag.IsSelectedSlotsHardDiskDamagedCategory, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                      Command="{Binding PlacementTarget.Tag.ApplySelectedSlotsHardDiskDamagedCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="损坏光盘专用档口"
                                      IsCheckable="True"
                                      IsChecked="{Binding PlacementTarget.Tag.IsSelectedSlotsHardDiskDamagedOpticalDiscCategory, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                      Command="{Binding PlacementTarget.Tag.ApplySelectedSlotsHardDiskDamagedOpticalDiscCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="年度数据硬盘专用档口"
                                      IsCheckable="True"
                                      IsChecked="{Binding PlacementTarget.Tag.IsSelectedSlotsHardDiskDataCategory, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                      Command="{Binding PlacementTarget.Tag.ApplySelectedSlotsHardDiskDataCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="年度数据光盘专用档口"
                                      IsCheckable="True"
                                      IsChecked="{Binding PlacementTarget.Tag.IsSelectedSlotsHardDiskDataOpticalDiscCategory, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                      Command="{Binding PlacementTarget.Tag.ApplySelectedSlotsHardDiskDataOpticalDiscCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="历史数据硬盘专用档口"
                                      IsCheckable="True"
                                      IsChecked="{Binding PlacementTarget.Tag.IsSelectedSlotsHardDiskHistoricalDataCategory, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                      Command="{Binding PlacementTarget.Tag.ApplySelectedSlotsHardDiskHistoricalDataCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="历史数据光盘专用档口"
                                      IsCheckable="True"
                                      IsChecked="{Binding PlacementTarget.Tag.IsSelectedSlotsHardDiskHistoricalDataOpticalDiscCategory, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                      Command="{Binding PlacementTarget.Tag.ApplySelectedSlotsHardDiskHistoricalDataOpticalDiscCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="空白硬盘专用档口"
                                      IsCheckable="True"
                                      IsChecked="{Binding PlacementTarget.Tag.IsSelectedSlotsHardDiskBlankCategory, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                      Command="{Binding PlacementTarget.Tag.ApplySelectedSlotsHardDiskBlankCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </MenuItem>
                        <MenuItem Header="设置档口用途"
                                  Visibility="{Binding PlacementTarget.Tag.CompactPerSlotCategoryMenuVisibility, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem Header="通用（无专用用途）"
                                      IsCheckable="True"
                                      IsChecked="{Binding PlacementTarget.DataContext.IsGeneralHardDiskSlotCategory, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                      Command="{Binding PlacementTarget.Tag.SetHardDiskSlotGeneralCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="损坏硬盘专用档口"
                                      IsCheckable="True"
                                      IsChecked="{Binding PlacementTarget.DataContext.IsDamagedDiskDedicatedSlot, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                      Command="{Binding PlacementTarget.Tag.SetHardDiskSlotDamagedCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="损坏光盘专用档口"
                                      IsCheckable="True"
                                      IsChecked="{Binding PlacementTarget.DataContext.IsDamagedOpticalDiscDedicatedSlot, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                      Command="{Binding PlacementTarget.Tag.SetHardDiskSlotDamagedOpticalDiscCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="年度数据硬盘专用档口"
                                      IsCheckable="True"
                                      IsChecked="{Binding PlacementTarget.DataContext.IsDataDiskDedicatedSlot, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                      Command="{Binding PlacementTarget.Tag.SetHardDiskSlotDataCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="年度数据光盘专用档口"
                                      IsCheckable="True"
                                      IsChecked="{Binding PlacementTarget.DataContext.IsDataOpticalDiscDedicatedSlot, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                      Command="{Binding PlacementTarget.Tag.SetHardDiskSlotDataOpticalDiscCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="历史数据硬盘专用档口"
                                      IsCheckable="True"
                                      IsChecked="{Binding PlacementTarget.DataContext.IsHistoricalDataDiskDedicatedSlot, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                      Command="{Binding PlacementTarget.Tag.SetHardDiskSlotHistoricalDataCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="历史数据光盘专用档口"
                                      IsCheckable="True"
                                      IsChecked="{Binding PlacementTarget.DataContext.IsHistoricalDataOpticalDiscDedicatedSlot, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                      Command="{Binding PlacementTarget.Tag.SetHardDiskSlotHistoricalDataOpticalDiscCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="空白硬盘专用档口"
                                      IsCheckable="True"
                                      IsChecked="{Binding PlacementTarget.DataContext.IsBlankDiskDedicatedSlot, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                      Command="{Binding PlacementTarget.Tag.SetHardDiskSlotBlankCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </MenuItem>
                        <MenuItem Header="设置档口用途"
                                  Visibility="{Binding PlacementTarget.Tag.ArchiveSlotCategoryActionVisibility, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem Header="未定义（未设置）"
                                      IsCheckable="True"
                                      IsChecked="{Binding PlacementTarget.DataContext.IsUnsetArchiveSlotCategory, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                      Command="{Binding PlacementTarget.Tag.SetArchiveSlotUnsetCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="年度资料专用档口"
                                      IsCheckable="True"
                                      IsChecked="{Binding PlacementTarget.DataContext.IsYearlyMaterialsDedicatedSlot, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                      Command="{Binding PlacementTarget.Tag.SetArchiveSlotYearlyCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="历史资料专用档口"
                                      IsCheckable="True"
                                      IsChecked="{Binding PlacementTarget.DataContext.IsHistoricalMaterialsDedicatedSlot, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                      Command="{Binding PlacementTarget.Tag.SetArchiveSlotHistoricalCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="混用档口"
                                      IsCheckable="True"
                                      IsChecked="{Binding PlacementTarget.DataContext.IsMixedUseArchiveSlot, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                      Command="{Binding PlacementTarget.Tag.SetArchiveSlotMixedCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </MenuItem>
                        <MenuItem Header="刷新格口"
                                  Command="{Binding PlacementTarget.Tag.RefreshSlotCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator Visibility="{Binding PlacementTarget.Tag.BatchSlotRelocationMenuVisibility, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="设为批量搬迁源"
                                  Visibility="{Binding PlacementTarget.Tag.BatchSlotRelocationMenuVisibility, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Command="{Binding PlacementTarget.Tag.SetBatchRelocationSourceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="搬迁到此档口"
                                  Visibility="{Binding PlacementTarget.Tag.BatchSlotRelocationMenuVisibility, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Command="{Binding PlacementTarget.Tag.RelocateBatchToSlotCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="清除批量搬迁源"
                                  Visibility="{Binding PlacementTarget.Tag.BatchRelocationSourceHintVisibility, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Command="{Binding PlacementTarget.Tag.ClearBatchRelocationSourceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator Visibility="{Binding PlacementTarget.Tag.InteractiveItemRelocationMenuVisibility, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="迁档到此档口"
                                  Visibility="{Binding PlacementTarget.Tag.InteractiveItemRelocationMenuVisibility, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Command="{Binding PlacementTarget.Tag.RelocateInteractiveItemToSlotCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="清除迁档对象"
                                  Visibility="{Binding PlacementTarget.Tag.InteractiveItemRelocationSourceHintVisibility, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Command="{Binding PlacementTarget.Tag.ClearInteractiveItemRelocationSourceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SlotCode}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#1D4ED8"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    <TextBlock Text="{Binding PurposeDisplayText}"
                               Margin="0,4,0,0"
                               FontSize="10"
                               Foreground="#475569"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="{Binding SnapshotRootMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：标题 / 选档与迁档工具 / 展示方式+关闭，合并为左中右三列 -->
        <Border Grid.Row="0"
                Padding="12,10"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="160"/>
                    <ColumnDefinition Width="Auto" MinWidth="280"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding CabinetTitle}" FontSize="20" FontWeight="Bold" Foreground="#1F2937"/>
                    <TextBlock Text="{Binding CabinetSubtitle}" Margin="0,4,0,0" FontSize="13" Foreground="#4B5563"/>
                    <TextBlock Text="{Binding LayoutSummary}" Margin="0,2,0,0" FontSize="12" Foreground="#6B7280"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="8,0,16,0">
                    <DockPanel LastChildFill="False"
                               Visibility="{Binding CompactModeToolbarVisibility}">
                        <TextBlock Text="{Binding SelectedSlotSummaryText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   Foreground="#4B5563"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="全选"
                                    Command="{Binding SelectAllSlotsCommand}"
                                    Style="{StaticResource DialogSecondaryActionButtonStyle}"
                                    Padding="12,5"/>
                            <Button Content="反选"
                                    Margin="8,0,0,0"
                                    Command="{Binding InvertSlotSelectionCommand}"
                                    Style="{StaticResource DialogSecondaryActionButtonStyle}"
                                    Padding="12,5"/>
                            <Button Content="设置用途"
                                    Margin="8,0,0,0"
                                    Command="{Binding ApplySelectedSlotsPurposeCommand}"
                                    Style="{StaticResource DialogPrimaryActionButtonStyle}"
                                    Padding="12,5"
                                    Visibility="{Binding CabinetMaintainActionVisibility}"/>
                            <Button Content="清空选择"
                                    Margin="8,0,0,0"
                                    Command="{Binding ClearSlotSelectionCommand}"
                                    Style="{StaticResource DialogSecondaryActionButtonStyle}"
                                    Padding="12,5"/>
                        </StackPanel>
                    </DockPanel>

                    <DockPanel LastChildFill="False"
                               Margin="0,8,0,0"
                               Visibility="{Binding ContentSelectionToolbarVisibility}">
                        <TextBlock Text="{Binding SelectedContentSummaryText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   Foreground="#4B5563"
                                   TextWrapping="Wrap"
                                   MaxWidth="360"/>
                        <Button DockPanel.Dock="Right"
                                Content="清空选择"
                                Margin="8,0,0,0"
                                Command="{Binding ClearContentSelectionCommand}"
                                Style="{StaticResource DialogSecondaryActionButtonStyle}"
                                Padding="12,5"/>
                        <Button DockPanel.Dock="Right"
                                Content="设为迁档对象"
                                Margin="8,0,0,0"
                                Command="{Binding SetInteractiveItemRelocationFromSelectionCommand}"
                                Style="{StaticResource DialogPrimaryActionButtonStyle}"
                                Padding="12,5"
                                Visibility="{Binding InteractiveItemRelocationMenuVisibility}"/>
                    </DockPanel>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding SlotDisplayModeSwitcherVisibility}">
                        <TextBlock Text="展示方式"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   FontSize="13"
                                   Foreground="#4B5563"/>
                        <RadioButton Content="标准"
                                     GroupName="CabinetSlotDisplayMode"
                                     IsChecked="{Binding IsStandardDisplayMode, Mode=TwoWay}"
                                     VerticalAlignment="Center"
                                     FontSize="13"/>
                        <RadioButton Content="简洁"
                                     GroupName="CabinetSlotDisplayMode"
                                     IsChecked="{Binding IsCompactDisplayMode, Mode=TwoWay}"
                                     Margin="12,0,0,0"
                                     VerticalAlignment="Center"
                                     FontSize="13"/>
                    </StackPanel>
                    <Button Margin="16,0,0,0"
                            Content="关闭"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource DialogSecondaryActionButtonStyle}"
                            VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Border Background="#EEF2F7" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="10" Opacity="0.55"/>

            <Border x:Name="SlotsHost"
                    Margin="18"
                    Padding="18"
                    Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="10"
                    Opacity="0"
                    SizeChanged="SlotsHost_SizeChanged">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="SlotsScaleTransform" ScaleX="0.96" ScaleY="0.96"/>
                        <TranslateTransform x:Name="SlotsTranslateTransform" Y="12"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <ScrollViewer HorizontalScrollBarVisibility="{Binding SlotsHorizontalScrollBarVisibility}"
                              VerticalScrollBarVisibility="{Binding SlotsVerticalScrollBarVisibility}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">
                    <Grid HorizontalAlignment="{Binding SnapshotSlotsHorizontalAlignment}"
                          VerticalAlignment="{Binding SnapshotSlotsVerticalAlignment}">
                    <ItemsControl x:Name="StandardSlotsItemsControl"
                                  ItemsSource="{Binding Slots}"
                                  Visibility="{Binding StandardSlotsVisibility}"
                                  Width="{Binding SlotsSurfaceWidth}"
                                  Height="{Binding SlotsSurfaceHeight}"
                                  HorizontalAlignment="{Binding SnapshotSlotsHorizontalAlignment}"
                                  VerticalAlignment="{Binding SnapshotSlotsVerticalAlignment}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="{Binding DisplayRowCount}" Columns="{Binding DisplayColumnCount}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="8"
                                        Width="{Binding DataContext.EffectiveSlotDisplayWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Height="{Binding DataContext.EffectiveSlotDisplayHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Padding="10"
                                        Background="{Binding SlotBackground}"
                                        BorderBrush="{Binding SlotBorderBrush}"
                                        BorderThickness="{Binding SlotBorderThickness}"
                                        CornerRadius="8"
                                        ToolTip="{Binding SlotToolTipText}"
                                        AllowDrop="True"
                                        MouseLeftButtonDown="Slot_MouseLeftButtonDown"
                                        DragOver="InteractiveItemSlot_DragOver"
                                        DragLeave="InteractiveItemSlot_DragLeave"
                                        Drop="InteractiveItemSlot_Drop"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Border.ContextMenu>
                                        <ContextMenu Opened="SlotContextMenu_Opened"
                                                     Closed="SlotContextMenu_Closed">
                                            <MenuItem Header="查看档口详情"
                                                      Command="{Binding PlacementTarget.Tag.ShowSlotDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="放大查看此档口"
                                                      Visibility="{Binding PlacementTarget.Tag.SlotZoomMenuVisibility, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Command="{Binding PlacementTarget.Tag.ShowSlotZoomCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <Separator Visibility="{Binding PlacementTarget.Tag.CompactBatchPurposeMenuVisibility, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="{Binding PlacementTarget.Tag.BatchApplyPurposeMenuText, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Visibility="{Binding PlacementTarget.Tag.CompactBatchArchivePurposeMenuVisibility, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem Header="未定义（未设置）"
                                                          IsCheckable="True"
