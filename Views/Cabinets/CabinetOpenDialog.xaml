                                                                                    <Border Margin="0,4,0,0"
                                                                                            Padding="3,1"
                                                                                            HorizontalAlignment="Center"
                                                                                            Background="{Binding StatusBadgeBackground}"
                                                                                            CornerRadius="8"
                                                                                            Visibility="{Binding CenterTypeBadgeVisibility}">
                                                                                        <TextBlock Text="{Binding BadgeText}"
                                                                                                   Style="{StaticResource SnapFs10}"
                                                                                                   FontWeight="SemiBold"
                                                                                                   Foreground="{Binding StatusBadgeForeground}"/>
                                                                                    </Border>
                                                                                </StackPanel>
                                                                                </Grid>

                                                                                <!-- 四角叠层：LastChildFill=False，不进内容测量，避免 UniformGrid 布局环 -->
                                                                                <DockPanel LastChildFill="False"
                                                                                           IsHitTestVisible="False"
                                                                                           Panel.ZIndex="2">
                                                                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,0">
