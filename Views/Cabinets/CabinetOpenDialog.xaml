                                   Text="有丢失份数标「失」，有拟销份数标「销」；盘库致空不再标「空」。"/>

                        <TextBlock Text="右下 · 待还　左下 · 预订"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   Margin="0,0,0,2"/>
                        <TextBlock FontSize="10" Foreground="#64748B" TextWrapping="Wrap"
                                   Text="待还可带份数；预订表示占用/征用锁。"/>
                    </StackPanel>
                </Expander>
            </Border>
            </Canvas>
        </Grid>

        <Border Grid.Row="2" Padding="14,10" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Visibility="{Binding SnapshotFooterVisibility}">
            <DockPanel LastChildFill="False">
                <Label Margin="0,0,18,0" Padding="0" VerticalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding CurrentSideLabel, Mode=OneWay}" Foreground="#4B5563"/>
                        <TextBlock Text="{Binding CurrentFaceDisplayName, Mode=OneWay}" FontWeight="SemiBold" Foreground="#4B5563"/>
                    </StackPanel>
                </Label>
                <TextBlock Margin="0,0,18,0" Foreground="#4B5563">
                    <Run Text="格口总数："/>
                    <Run Text="{Binding SlotCount, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
                <TextBlock Margin="0,0,18,0" Foreground="#4B5563" Visibility="{Binding ArchiveFooterVisibility}">
                    <Run Text="档案盒总数："/>
                    <Run Text="{Binding ArchiveBoxCount, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
                <TextBlock Margin="0,0,18,0" Foreground="#B91C1C" Visibility="{Binding ArchiveFooterVisibility}">
                    <Run Text="混放盒："/>
                    <Run Text="{Binding MixedArchiveBoxCount, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
                <TextBlock Margin="0,0,18,0" Foreground="#B91C1C" Visibility="{Binding ArchiveFooterVisibility}">
                    <Run Text="待梳理来源记录："/>
                    <Run Text="{Binding PendingSortingRecordCount, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
                <TextBlock Margin="0,0,18,0" Foreground="#4B5563" Visibility="{Binding MagneticDiskFooterVisibility}">
                    <Run Text="盘位总数："/>
                    <Run Text="{Binding MagneticDiskMediumCount, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text="盘"/>
                </TextBlock>
                <TextBlock Margin="0,0,18,0" Foreground="#B45309" Visibility="{Binding MagneticDiskFooterVisibility}">
                    <Run Text="待归还盘："/>
                    <Run Text="{Binding MagneticDiskPendingReturnCount, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text="盘"/>
                </TextBlock>
                <TextBlock Margin="0,0,18,0" Foreground="#4B5563" Visibility="{Binding MagneticDiskFooterVisibility}">
                    <Run Text="空闲盘位："/>
                    <Run Text="{Binding MagneticDiskFreeCapacityCount, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text="个"/>
                </TextBlock>
                <TextBlock Margin="0,0,18,0" Foreground="#2563EB" Visibility="{Binding MagneticDiskFooterVisibility}">
                    <Run Text="平均利用率："/>
                    <Run Text="{Binding AverageUtilizationText, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
                <TextBlock Margin="0,0,18,0" Foreground="#00695C" FontWeight="SemiBold"
                           Text="{Binding BatchRelocationSourceText, Mode=OneWay}"
                           Visibility="{Binding BatchRelocationSourceHintVisibility}"/>
                <TextBlock Margin="0,0,18,0" Foreground="#7C3AED" FontWeight="SemiBold"
                           Text="{Binding InteractiveItemRelocationSourceText, Mode=OneWay}"
                           Visibility="{Binding InteractiveItemRelocationSourceHintVisibility}"/>
                <TextBlock Foreground="#6B7280" Text="{Binding FooterHintText}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
