                                            </StackPanel>
                                        </Grid>

                                        <Border Grid.Row="1"
                                                Margin="0,12,0,8"
                                                Width="{Binding DataContext.EffectiveRenderSlotCanvasWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Height="{Binding DataContext.EffectiveRenderSlotCanvasHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                ClipToBounds="True">
                                                <Grid>
                                                    <ItemsControl ItemsSource="{Binding ArchiveBoxes}" Visibility="{Binding ArchiveBoxesVisibility}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <Canvas/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemContainerStyle>
                                                            <Style TargetType="ContentPresenter">
                                                                <Setter Property="Canvas.Left" Value="{Binding RenderX}"/>
                                                                <Setter Property="Canvas.Top" Value="{Binding RenderY}"/>
                                                                <Setter Property="Panel.ZIndex" Value="{Binding RenderZIndex}"/>
                                                            </Style>
                                                        </ItemsControl.ItemContainerStyle>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="{Binding RenderWidth}"
                                                                        Height="{Binding RenderHeight}"
                                                                        Padding="0"
                                                                        Background="{Binding BoxBackground}"
                                                                        BorderBrush="{Binding BoxBorderBrush}"
                                                                        BorderThickness="{Binding BoxBorderThickness}"
                                                                        CornerRadius="0.8"
                                                                        Cursor="Hand"
                                                                        ToolTip="{Binding ToolTipText, Mode=OneWay}"
                                                                        MouseLeftButtonDown="ArchiveBox_MouseLeftButtonDown"
                                                                        PreviewMouseLeftButtonDown="InteractiveItemDrag_PreviewMouseLeftButtonDown"
                                                                        PreviewMouseMove="InteractiveItemDrag_PreviewMouseMove"
                                                                        PreviewMouseLeftButtonUp="InteractiveItemDrag_PreviewMouseLeftButtonUp"
                                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                                                    <Border.ContextMenu>
                                                                        <ContextMenu Opened="ArchiveBoxContextMenu_Opened"
                                                                                     Closed="ArchiveBoxContextMenu_Closed">
                                                                            <MenuItem Header="查看档案盒内容"
                                                                                      Command="{Binding PlacementTarget.Tag.ShowArchiveContentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                            <MenuItem Header="设置档案盒现行放置方式"
                                                                                      Visibility="{Binding PlacementTarget.Tag.CabinetMaintainActionVisibility, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                      Command="{Binding PlacementTarget.Tag.EditArchiveBoxPlacementModeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                            <MenuItem Header="重置档案盒规格"
                                                                                      Visibility="{Binding PlacementTarget.Tag.CabinetMaintainActionVisibility, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                      Command="{Binding PlacementTarget.Tag.ResetArchiveBoxSpecificationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                            <Separator Visibility="{Binding PlacementTarget.Tag.InteractiveItemRelocationMenuVisibility, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                            <MenuItem Header="设为迁档对象"
                                                                                      Visibility="{Binding PlacementTarget.Tag.InteractiveItemRelocationMenuVisibility, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                      Command="{Binding PlacementTarget.Tag.SetInteractiveItemRelocationFromArchiveBoxCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                        </ContextMenu>
                                                                    </Border.ContextMenu>

                                                                    <Grid>
                                                                        <Grid Visibility="{Binding SpineOutVisibility}">
                                                                            <Grid>
                                                                                <Grid.Style>
                                                                                    <Style TargetType="Grid">
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding DataContext.IsSingleSlotSnapshot, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Grid.Style>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="1.2"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <Border Background="{Binding AccentBrush}" CornerRadius="0.8,0,0,0.8"/>

                                                                                <Viewbox Grid.Column="1"
                                                                                         Margin="0.6,8.0,0.6,0.6"
                                                                                         Stretch="Fill"
                                                                                         StretchDirection="Both">
                                                                                    <Grid Width="18" Height="36">
                                                                                        <Grid.RowDefinitions>
                                                                                            <RowDefinition Height="Auto"/>
                                                                                            <RowDefinition Height="Auto"/>
                                                                                            <RowDefinition Height="Auto"/>
                                                                                        </Grid.RowDefinitions>

                                                                                        <TextBlock Text="{Binding BoxLabel}"
                                                                                                   Margin="0,2,0,0"
                                                                                                   HorizontalAlignment="Center"
                                                                                                   TextAlignment="Center"
                                                                                                   TextWrapping="Wrap"
                                                                                                   FontSize="2.2"
                                                                                                   FontWeight="Bold"
                                                                                                   Foreground="{Binding TitleForeground}"/>

                                                                                        <TextBlock Grid.Row="1"
                                                                                                   Margin="0,2,0,0"
                                                                                                   Text="{Binding ArchiveIdentifierText}"
                                                                                                   HorizontalAlignment="Center"
                                                                                                   TextAlignment="Center"
                                                                                                   TextWrapping="Wrap"
                                                                                                   FontSize="1.7"
                                                                                                   Foreground="{Binding ArchiveTypeForeground}">
                                                                                            <TextBlock.LayoutTransform>
                                                                                                <ScaleTransform ScaleX="{Binding SpineIdentifierHorizontalScale}" ScaleY="1"/>
                                                                                            </TextBlock.LayoutTransform>
                                                                                        </TextBlock>

                                                                                        <Border Grid.Row="2"
                                                                                                Margin="0,2,0,0"
                                                                                                Padding="0.6,0.2"
                                                                                                Background="{Binding CountBackground}"
                                                                                                BorderBrush="{Binding CountBorderBrush}"
                                                                                                BorderThickness="0.35"
                                                                                                CornerRadius="0.8">
                                                                                            <TextBlock Text="{Binding CountText}"
                                                                                                       HorizontalAlignment="Center"
                                                                                                       TextAlignment="Center"
                                                                                                       TextWrapping="Wrap"
                                                                                                       FontSize="1.5"
                                                                                                       Foreground="{Binding CountForeground}"/>
                                                                                        </Border>
                                                                                    </Grid>
                                                                                </Viewbox>
                                                                            </Grid>

                                                                            <Grid>
                                                                                <Grid.Style>
                                                                                    <Style TargetType="Grid">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
