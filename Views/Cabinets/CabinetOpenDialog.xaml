                                                                                                   FontWeight="SemiBold"
                                                                                                   Foreground="{Binding StatusBadgeForeground}"/>
                                                                                    </Border>
                                                                                </Grid>

                                                                                <StackPanel Visibility="{Binding YearlyArchiveLayoutVisibility}">
                                                                                    <Grid HorizontalAlignment="Center" Width="34" Height="22">
                                                                                        <Border Margin="0,3,0,0"
                                                                                                Background="{Binding IconBodyBrush}"
                                                                                                BorderBrush="{Binding IconAccentBrush}"
                                                                                                BorderThickness="1"
                                                                                                CornerRadius="3"
                                                                                                Visibility="{Binding HardDiskIconVisibility}"/>
                                                                                        <Border HorizontalAlignment="Left"
                                                                                                Width="9"
                                                                                                Height="4"
                                                                                                Margin="2,0,0,0"
                                                                                                Background="{Binding IconAccentBrush}"
                                                                                                CornerRadius="1.5,1.5,0,0"
                                                                                                Visibility="{Binding HardDiskIconVisibility}"/>
                                                                                        <Ellipse HorizontalAlignment="Right"
                                                                                                 VerticalAlignment="Bottom"
                                                                                                 Width="5"
                                                                                                 Height="5"
                                                                                                 Margin="0,0,3,3"
                                                                                                 Fill="#FFFFFF"
                                                                                                 Stroke="{Binding IconAccentBrush}"
