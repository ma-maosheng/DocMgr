                                                        Padding="8,3"
                                                        Background="#EDE9FE"
                                                        BorderBrush="#C4B5FD"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Visibility="{Binding HistoricalMaterialsSlotVisibility}">
