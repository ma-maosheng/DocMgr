<Window x:Class="DocMgr.Views.Cabinets.CabinetSlotDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1080"
        Height="680"
        MinWidth="860"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F5F7FA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="18"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="{Binding HeaderText}"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#1F2937"/>
                <TextBlock Text="{Binding SummaryText}"
                           Margin="0,8,0,0"
                           FontSize="13"
                           Foreground="#6B7280"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ListHintText}"
                           Margin="0,8,0,0"
                           FontSize="12"
                           Foreground="#475569"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,16,0,16"
                Padding="12"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <DataGrid ItemsSource="{Binding ArchiveBoxRows}"
                          Visibility="{Binding ArchiveBoxListVisibility}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          MouseDoubleClick="ArchiveBoxGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="序号" Binding="{Binding SequenceDisplay}" Width="56"/>
                        <DataGridTextColumn Header="档案盒号" Binding="{Binding BoxCode}" Width="110"/>
                        <DataGridTextColumn Header="标签" Binding="{Binding BoxLabel}" Width="90"/>
                        <DataGridTextColumn Header="类别" Binding="{Binding CategoryText}" Width="90"/>
                        <DataGridTextColumn Header="资料类型" Binding="{Binding ArchiveTypeText}" Width="100"/>
                        <DataGridTextColumn Header="资料标识" Binding="{Binding ArchiveIdentifierText}" Width="220"/>
                        <DataGridTextColumn Header="件数" Binding="{Binding CountText}" Width="70"/>
                        <DataGridTextColumn Header="放置方式" Binding="{Binding PlacementModeText}" Width="80"/>
                        <DataGridTextColumn Header="规格" Binding="{Binding BoxSpecification}" Width="80"/>
                        <DataGridTextColumn Header="备注" Binding="{Binding StatusNote}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <DataGrid ItemsSource="{Binding HardDiskRows}"
                          Visibility="{Binding HardDiskListVisibility}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          MouseDoubleClick="HardDiskGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="归属" Binding="{Binding PresenceKind}" Width="70"/>
                        <DataGridTextColumn Header="序号" Binding="{Binding SequenceDisplay}" Width="56"/>
                        <DataGridTextColumn Header="编码" Binding="{Binding DiskCodeText}" Width="120"/>
                        <DataGridTextColumn Header="容量" Binding="{Binding CapacityText}" Width="90"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="90"/>
                        <DataGridTextColumn Header="当前位置" Binding="{Binding CurrentLocationText}" Width="140"/>
                        <DataGridTextColumn Header="袋号" Binding="{Binding ElectronicArchiveNoText}" Width="110"/>
                        <DataGridTextColumn Header="袋位" Binding="{Binding ElectronicArchiveLocationText}" Width="120"/>
                        <DataGridTextColumn Header="类型" Binding="{Binding BadgeText}" Width="80"/>
                        <DataGridTextColumn Header="摘要" Binding="{Binding DetailText}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="{Binding EmptyHintText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="16"
                           Foreground="#94A3B8"
                           Visibility="{Binding EmptyHintVisibility}"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="放大布局"
                    Command="{Binding ShowSlotZoomCommand}"
                    Visibility="{Binding SlotZoomButtonVisibility}"
                    Style="{StaticResource DialogSecondaryActionButtonStyle}"
                    Margin="0,0,10,0"/>
            <Button Content="关闭"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource DialogSecondaryActionButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
