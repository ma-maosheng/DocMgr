<Page x:Class="DocMgr.Views.HistoryArchive.OtherMapPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="OtherMapPage">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCardBorderStyle}" Background="#F5F7FA" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,10">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Content="📥 导入" Command="{Binding ImportCommand}" Width="90" Margin="0,0,10,0" Style="{StaticResource ToolbarActionButtonStyle}"/>
                        <Button Content="🔍 浏览数据" Command="{Binding BrowseCommand}" Width="100" Margin="0,0,10,0" Style="{StaticResource ToolbarActionButtonStyle}"/>

                        <Separator Style="{StaticResource VerticalSeparatorStyle}"/>

                        <Button Content="✏️ 编辑" Command="{Binding EditCommand}" Width="80" Margin="10,0,10,0" Style="{StaticResource ToolbarActionButtonStyle}"/>
                        <TextBox Width="220"
                                 Style="{StaticResource ToolbarFilterTextBoxStyle}"
                                 Margin="0,0,10,0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding SearchKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="🔎 检索" Command="{Binding SearchCommand}" Width="80" Margin="0,0,10,0" Style="{StaticResource ToolbarActionButtonStyle}"/>
                        <Button Content="重置" Command="{Binding ResetSearchCommand}" Width="70" Margin="0,0,10,0" Style="{StaticResource ToolbarActionButtonStyle}"/>
                        <Button Content="📤 导出" Command="{Binding ExportCommand}" Width="80" Margin="0,0,10,0" Style="{StaticResource ToolbarActionButtonStyle}"/>
                    </StackPanel>

                    <Button DockPanel.Dock="Right" Content="🗑️ 删除表" Command="{Binding DeleteTableCommand}" Width="90" Margin="20,0,0,0" HorizontalAlignment="Right" Style="{StaticResource ToolbarDangerButtonStyle}"/>
                </DockPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="1">
            <DataGrid x:Name="DgOtherMaps"
                      ItemsSource="{Binding OtherMaps}"
                      SelectedItem="{Binding SelectedOtherMap, Mode=TwoWay}"
                      LoadingRow="DgOtherMaps_LoadingRow"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="All"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="序号" Binding="{Binding SequenceNumber}" Width="70"/>
                    <DataGridTextColumn Header="比例尺" Binding="{Binding Scale}" Width="110"/>
                    <DataGridTextColumn Header="档案盒编号" Binding="{Binding BoxNumber}" Width="140"/>
                    <DataGridTextColumn Header="档案盒规格" Binding="{Binding BoxSpecification}" Width="110"/>
                    <DataGridTextColumn Header="图名" Binding="{Binding MapName}" Width="*"/>
                    <DataGridTextColumn Header="幅数" Binding="{Binding SheetCount}" Width="70"/>
                    <DataGridTextColumn Header="登记人" Binding="{Binding Registrant}" Width="90"/>
                    <DataGridTextColumn Header="登记日期" Binding="{Binding RegistrationDate}" Width="140"/>
                    <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Visibility="{Binding NoDataHintVisibility}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0.5"
                        IsHitTestVisible="False">
                <TextBlock Text="📭" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="暂无数据，请先导入或浏览存档表。" FontSize="16"/>
            </StackPanel>

            <TextBlock Text="{Binding CurrentTableName, StringFormat='当前： {0}'}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="0,-35,10,0"
                       Foreground="Gray"/>
        </Grid>
    </Grid>
</Page>

