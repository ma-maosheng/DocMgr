<Window x:Class="DocMgr.Views.HistoryArchive.HistoryArchiveDisposalEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DocMgr.Models.Shared"
        xmlns:viewShared="clr-namespace:DocMgr.Views.Shared"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="1200"
        Height="820"
        MinWidth="1040"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F0F2F5">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../YearlyArchive/ArchiveRegisterResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </ResourceDictionary>
  </Window.Resources>

  <viewShared:ApprovalHandoverWorkspaceShell Margin="12"
                                             ShellKind="{x:Static models:ApprovalWorkflowShellKind.DisposalUnlockUpload}">
    <viewShared:ApprovalHandoverWorkspaceShell.HeaderContent>
      <StackPanel>
        <GroupBox Header="1. 基本信息" Style="{StaticResource Level1GroupBoxStyle}" Padding="10" Margin="0,0,0,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="78"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="78"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="处置单号：" Style="{StaticResource FormLabelTextBlockStyle}"/>
            <TextBox Grid.Row="0" Grid.Column="1"
                     Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                     Text="{Binding DisposalNo, Mode=OneWay}"
                     IsReadOnly="True" Background="#F5F5F5"/>
            <TextBlock Grid.Row="0" Grid.Column="3" Text="业务状态：" Style="{StaticResource FormLabelTextBlockStyle}"/>
            <TextBox Grid.Row="0" Grid.Column="4"
                     Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                     Text="{Binding StatusDisplay, Mode=OneWay}"
                     IsReadOnly="True" Background="#F5F5F5"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,0,0" Text="资料类别：" Style="{StaticResource FormLabelTextBlockStyle}"/>
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"
                      Style="{StaticResource ArchiveRegisterFormComboBoxStyle}"
                      ItemsSource="{Binding MaterialKindDisplayOptions}"
                      SelectedItem="{Binding MaterialKindDisplay, UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding CanEditMaterialKind}"/>
            <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,6,0,0" Text="处置方式：" Style="{StaticResource FormLabelTextBlockStyle}"/>
            <ComboBox Grid.Row="1" Grid.Column="4" Margin="0,6,0,0"
                      Style="{StaticResource ArchiveRegisterFormComboBoxStyle}"
                      ItemsSource="{Binding MethodOptions}"
                      SelectedItem="{Binding DispositionMethod, UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding CanEditHeader}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6,0,0" Text="转交对象："
                       Style="{StaticResource FormLabelTextBlockStyle}"
                       Visibility="{Binding ShowTransferTarget, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,6,0,0"
                     Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                     Text="{Binding TransferTarget, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding CanEditHeader}"
                     Visibility="{Binding ShowTransferTarget, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6,0,0" Text="其他说明："
                       Style="{StaticResource FormLabelTextBlockStyle}"
                       Visibility="{Binding ShowOtherRemark, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,6,0,0"
                     Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                     Text="{Binding OtherRemark, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding CanEditHeader}"
                     Visibility="{Binding ShowOtherRemark, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,6,0,0" Text="申请说明：" Style="{StaticResource FormLabelTextBlockStyle}"/>
            <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,6,0,0"
                     Style="{StaticResource ArchiveRegisterFormTextBoxStyle}"
                     Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding CanEditHeader}"/>
          </Grid>
        </GroupBox>

        <GroupBox Header="2. 处置明细" Style="{StaticResource Level1GroupBoxStyle}" Padding="10" Margin="0,0,0,10">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button Content="刷新候选" Command="{Binding RefreshCandidatesCommand}" Padding="12,6" Margin="0,0,8,0"/>
              <Button Content="加入明细" Command="{Binding AddSelectedCommand}" Padding="12,6" Margin="0,0,8,0"
                      ToolTip="将勾选的候选档案盒加入已选明细；混放盒会整组纳入"/>
              <Button Content="全部加入明细" Command="{Binding AddAllCommand}" Padding="12,6" Margin="0,0,8,0"
                      ToolTip="将当前候选在柜档案盒全部加入已选明细；混放盒会整组纳入"/>
              <Button Content="清空明细" Command="{Binding ClearItemsCommand}" Padding="12,6"
                      ToolTip="清空已选明细，档案盒回到候选列表"/>
            </StackPanel>
            <TextBlock Text="{Binding MixedGroupPreview, Mode=OneWay}" Foreground="#B45309" TextWrapping="Wrap" Margin="0,0,0,6"/>

            <TextBlock Text="{Binding AvailableBoxesTitle, Mode=OneWay}" FontWeight="SemiBold" Foreground="#00796B" Margin="0,0,0,4"/>
            <DataGrid ItemsSource="{Binding AvailableBoxes}"
                      SelectedItem="{Binding SelectedCandidate}"
                      Height="180"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      HeadersVisibility="Column" AlternatingRowBackground="#F8FAFC"
                      Margin="0,0,0,10">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="选" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="36"/>
                <DataGridTextColumn Header="盒号" Binding="{Binding BoxCode, Mode=OneWay}" Width="130" IsReadOnly="True"/>
                <DataGridTextColumn Header="规格" Binding="{Binding BoxSpecification, Mode=OneWay}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="盒内摘要" Binding="{Binding ContentSummary, Mode=OneWay}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="混放" Binding="{Binding MixedPlacementText, Mode=OneWay}" Width="50" IsReadOnly="True"/>
                <DataGridTextColumn Header="关联盒数" Binding="{Binding RelatedBoxCount, Mode=OneWay}" Width="70" IsReadOnly="True"/>
              </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="{Binding SelectedItemsTitle, Mode=OneWay}" FontWeight="SemiBold" Foreground="#00796B" Margin="0,0,0,4"/>
            <DataGrid ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      HeadersVisibility="Column" AlternatingRowBackground="#F8FAFC"
                      Height="280"
                      MinHeight="220">
              <DataGrid.Columns>
                <DataGridTextColumn Header="盒号" Binding="{Binding BoxCode, Mode=OneWay}" Width="130"/>
                <DataGridTextColumn Header="规格" Binding="{Binding BoxSpecification, Mode=OneWay}" Width="80"/>
                <DataGridTextColumn Header="盒内摘要" Binding="{Binding ContentSummary, Mode=OneWay}" Width="*"/>
                <DataGridTextColumn Header="混放" Binding="{Binding MixedPlacementText, Mode=OneWay}" Width="50"/>
                <DataGridTemplateColumn Width="70">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Content="移除" Padding="8,2"
                              Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </GroupBox>
      </StackPanel>
    </viewShared:ApprovalHandoverWorkspaceShell.HeaderContent>

    <viewShared:ApprovalHandoverWorkspaceShell.SignatureContent>
      <viewShared:ApprovalSignatureCardsControl ShowApprovalOpinion="False"/>
    </viewShared:ApprovalHandoverWorkspaceShell.SignatureContent>
  </viewShared:ApprovalHandoverWorkspaceShell>
</Window>
