<Window x:Class="DocMgr.Views.HistoryArchive.AerialPhotoEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewShared="clr-namespace:DocMgr.Views.Shared"
        Width="640"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F5F5F5">

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button Grid.ColumnSpan="2"
                Content="关闭"
                Command="{x:Static viewShared:ViewCommands.CloseCurrentView}"
                Style="{StaticResource DialogCloseButtonStyle}"
                HorizontalAlignment="Right"/>

        <TextBlock Grid.ColumnSpan="2"
                   Text="{Binding Title}"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,120,15"
                   Foreground="#333"/>

        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,15">
            <TextBlock Text="档案盒编号 *" Foreground="#666" Margin="0,0,0,5"/>
            <TextBox Height="35" Padding="5,8"
                     Text="{Binding BoxNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding CanEditBoxNumber}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,15">
            <TextBlock Text="测区名称 *" Foreground="#666" Margin="0,0,0,5"/>
            <TextBox Height="35" Padding="5,8" Text="{Binding SurveyArea, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,15">
            <TextBlock Text="比例尺" Foreground="#666" Margin="0,0,0,5"/>
            <TextBox Height="35" Padding="5,8" Text="{Binding Scale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,15">
            <TextBlock Text="档案盒规格" Foreground="#666" Margin="0,0,0,5"/>
            <TextBox Height="35" Padding="5,8" Text="{Binding BoxSpecification, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,10,15">
            <TextBlock Text="航摄日期" Foreground="#666" Margin="0,0,0,5"/>
            <TextBox Height="35" Padding="5,8" Text="{Binding PhotographyDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,10,15">
            <TextBlock Text="相片张数" Foreground="#666" Margin="0,0,0,5"/>
            <TextBox Height="35" Padding="5,8" Text="{Binding PhotoCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.Column="1" Margin="10,0,0,15">
            <TextBlock Text="档案盒内物品" Foreground="#666" Margin="0,0,0,5"/>
            <TextBox Height="35" Padding="5,8" Text="{Binding BoxContents, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,0,0,25">
            <TextBlock Text="备注" Foreground="#666" Margin="0,0,0,5"/>
            <TextBox Height="80" Padding="5" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Text="{Binding Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Margin="0,0,10,0"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource DialogSecondaryActionButtonStyle}"/>
            <Button Content="确定"
                    Command="{Binding ConfirmCommand}"
                    Style="{StaticResource DialogPrimaryActionButtonStyle}"/>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>

