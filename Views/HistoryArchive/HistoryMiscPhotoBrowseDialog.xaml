<Window x:Class="DocMgr.Views.HistoryArchive.HistoryMiscPhotoBrowseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="980"
        Height="640"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#F5F7FA">
  <Window.InputBindings>
    <KeyBinding Key="Left" Command="{Binding PreviousCommand}"/>
    <KeyBinding Key="Right" Command="{Binding NextCommand}"/>
  </Window.InputBindings>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
      <TextBlock DockPanel.Dock="Right"
                 Text="{Binding PositionText, Mode=OneWay}"
                 VerticalAlignment="Center"
                 Foreground="#1F4E79"
                 FontWeight="Bold"/>
      <TextBlock Text="{Binding Caption, Mode=OneWay}"
                 VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis"
                 ToolTip="{Binding Caption}"/>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <DataGrid ItemsSource="{Binding Photos}"
                SelectedItem="{Binding SelectedPhoto}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False"
                SelectionMode="Single"
                HeadersVisibility="Column"
                GridLinesVisibility="Horizontal"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
        <DataGrid.Columns>
          <DataGridTextColumn Header="照片" Binding="{Binding DisplayName, Mode=OneWay}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>
      <Border Grid.Column="2"
              Background="#111827"
              BorderBrush="#D8E2EC"
              BorderThickness="1"
              CornerRadius="4"
              ClipToBounds="True">
        <Grid>
          <Image Source="{Binding PreviewImage, Mode=OneWay}"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 Margin="8"/>
          <TextBlock Text="{Binding PreviewHint, Mode=OneWay}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Margin="16"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     Foreground="#E5E7EB">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding PreviewHint}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Border>
    </Grid>

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,10,0,0">
      <Button Content="上一张"
              Width="72"
              Height="{StaticResource FormControlHeight}"
              Margin="0,0,6,0"
              Style="{StaticResource DialogSecondaryActionButtonStyle}"
              Command="{Binding PreviousCommand}"/>
      <Button Content="下一张"
              Width="72"
              Height="{StaticResource FormControlHeight}"
              Margin="0,0,6,0"
              Style="{StaticResource DialogSecondaryActionButtonStyle}"
              Command="{Binding NextCommand}"/>
      <Button Content="用系统程序打开"
              Width="148"
              Height="{StaticResource FormControlHeight}"
              Margin="0,0,6,0"
              Padding="10,0"
              Style="{StaticResource DialogSecondaryActionButtonStyle}"
              Command="{Binding OpenCommand}"/>
      <Button Content="关闭"
              Width="72"
              Height="{StaticResource FormControlHeight}"
              Style="{StaticResource DialogPrimaryActionButtonStyle}"
              Command="{Binding CloseCommand}"/>
    </StackPanel>
  </Grid>
</Window>
