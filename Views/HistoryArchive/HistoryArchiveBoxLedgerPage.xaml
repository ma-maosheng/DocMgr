<Page x:Class="DocMgr.Views.HistoryArchive.HistoryArchiveBoxLedgerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="历史存档盒台账"
      Background="#F0F2F5">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

    <!-- 资料详情：单行省略，悬停查看全部详情行 -->
    <Style x:Key="HistoryDetailSummaryTextStyle" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="ToolTip" Value="{Binding ContentSummary}"/>
    </Style>

    <!-- 已离库：盒号（位置编码）用褐色，与在库默认色区分，便于追溯识别 -->
    <Style x:Key="DisposedTraceLocationTextStyle" TargetType="TextBlock">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsDisposed}" Value="True">
          <Setter Property="Foreground" Value="#8D6E63"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Page.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource ToolbarCardBorderStyle}" Margin="0" CornerRadius="0" Padding="16,12">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="浏览照片"
                  Command="{Binding BrowsePhotosCommand}"
                  Style="{StaticResource ToolbarActionButtonStyle}"
                  Width="96"
                  Margin="0,0,8,0"
                  ToolTip="浏览当前杂项资料的实物照片"/>
          <Button Content="📤 导出"
                  Command="{Binding ExportCommand}"
                  Style="{StaticResource ToolbarActionButtonStyle}"
                  Width="88"
                  Margin="0,0,8,0"
                  ToolTip="导出当前筛选结果（不受分页限制）"/>
          <Button Content="台账简介"
                  Command="{Binding ShowIntroCommand}"
                  Style="{StaticResource ToolbarActionButtonStyle}"
                  Width="96"
                  ToolTip="查看本台账的业务范围、关联对象与写入逻辑"/>
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="浏览方式：" VerticalAlignment="Center" FontWeight="Bold"/>
            <RadioButton Content="分页浏览"
                         GroupName="HistoryArchiveBoxBrowseMode"
                         IsChecked="{Binding IsPagedBrowse, Mode=TwoWay}"
                         Style="{StaticResource FormRadioButtonStyle}"
                         Margin="0,0,8,0"/>
            <RadioButton Content="全局浏览"
                         GroupName="HistoryArchiveBoxBrowseMode"
                         IsChecked="{Binding IsGlobalBrowse, Mode=TwoWay}"
                         Style="{StaticResource FormRadioButtonStyle}"
                         Margin="0,0,10,0"/>

            <Separator Style="{StaticResource VerticalSeparatorStyle}"/>

            <TextBlock Text="资料类别：" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <ComboBox Width="140"
                      Style="{StaticResource ToolbarFilterComboBoxStyle}"
                      ItemsSource="{Binding MaterialKindOptions}"
                      SelectedItem="{Binding MaterialKindDisplay}"/>
            <TextBlock Text="状态：" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <ComboBox Width="100"
                      Style="{StaticResource ToolbarFilterComboBoxStyle}"
                      ItemsSource="{Binding LifecycleStatusOptions}"
                      SelectedItem="{Binding LifecycleStatus}"
                      ToolTip="在库含办理中的离库锁定；已离库为办结撤柜后的盒"/>
            <TextBlock Text="柜体：" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <ComboBox Width="130"
                      Style="{StaticResource ToolbarFilterComboBoxStyle}"
                      ItemsSource="{Binding CabinetNameOptions}"
                      SelectedItem="{Binding CabinetName}"/>
            <TextBlock Text="关键词：" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <TextBox Width="180"
                     Height="32"
                     Margin="0,0,10,0"
                     VerticalContentAlignment="Center"
                     Text="{Binding BoxKeyword, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="盒号、盒内摘要、关联混放盒号、柜体、资料类别">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
              </TextBox.InputBindings>
            </TextBox>
            <Button Content="查询" Command="{Binding SearchCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="72" Margin="0,0,8,0"/>
            <Button Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="72"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Border Grid.Row="1"
            Margin="0,12,0,8"
            Padding="0"
            Background="#FFFDF7"
            BorderBrush="#E2C98F"
            BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="4"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#B98A2E"/>
        <TextBlock Grid.Row="1"
                   Text="历史存档盒台账"
                   Margin="0,12,0,4"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#6F4A00"
                   HorizontalAlignment="Center"
                   TextDecorations="Underline"/>
        <TextBlock Grid.Row="2"
                   Text="History Archive Box Ledger"
                   Margin="0,0,0,8"
                   FontSize="12"
                   Foreground="#9A7B3F"
                   HorizontalAlignment="Center"/>
        <Border Grid.Row="3"
                Margin="16,0,16,12"
                Padding="12,10"
                Background="#FFFBEB"
                BorderBrush="#E2C98F"
                BorderThickness="1"
                CornerRadius="4">
          <TextBlock Text="展示历史档案盒与杂项容器台账（可按在库/已离库筛选）。选定资料类别后，下列标题随类别切换。杂项资料按存放容器列出；离库销毁/转交请使用「资料台账与资料处置 → 处置」。"
                     Foreground="#6F4A00"
                     TextWrapping="Wrap"
                     HorizontalAlignment="Center"/>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Background="#EEF3F8"
            BorderBrush="#D0D7DE"
            BorderThickness="1"
            CornerRadius="4"
            Padding="12,6"
            Margin="0,0,0,8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left"
                   Text="当前浏览"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="0,0,10,0"/>
        <TextBlock Text="{Binding CurrentBrowseCaption, Mode=OneWay}"
                   VerticalAlignment="Center"
                   FontSize="13"
                   Foreground="#1F4E79"
                   TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>

    <Border Grid.Row="3" Background="White" Padding="10">
      <DataGrid x:Name="LedgerGrid"
                ItemsSource="{Binding Rows}"
                SelectedItem="{Binding SelectedRow}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False"
                SelectionMode="Single"
                RowHeight="36"
                ColumnHeaderHeight="40"
                GridLinesVisibility="Horizontal"
                BorderThickness="0"
                AlternatingRowBackground="#F8FAFC"
                EnableRowVirtualization="True"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                ScrollViewer.CanContentScroll="True"/>
    </Border>

    <Border Grid.Row="4"
            Background="#FAFAFA"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            CornerRadius="4"
            Padding="12,8"
            Margin="0,10,0,0"
            Visibility="{Binding ShowPaginationBar, Converter={StaticResource BooleanToVisibilityConverter}}">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="每页条数：" VerticalAlignment="Center" FontWeight="Bold"/>
          <ComboBox Width="80"
                    Height="28"
                    Margin="8,0,16,0"
                    ItemsSource="{Binding PageSizeOptions}"
                    SelectedItem="{Binding PageSize, Mode=TwoWay}"/>
          <TextBlock VerticalAlignment="Center"
                     Foreground="#546E7A"
                     Text="{Binding PageInfo, Mode=OneWay}"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="首页"
                  Margin="0,0,6,0"
                  Padding="8,2"
                  Style="{StaticResource ToolbarActionButtonStyle}"
                  Command="{Binding FirstPageCommand}"/>
          <Button Content="上一页"
                  Margin="0,0,6,0"
                  Padding="8,2"
                  Style="{StaticResource ToolbarActionButtonStyle}"
                  Command="{Binding PreviousPageCommand}"/>
          <Button Content="下一页"
                  Margin="0,0,6,0"
                  Padding="8,2"
                  Style="{StaticResource ToolbarActionButtonStyle}"
                  Command="{Binding NextPageCommand}"/>
          <Button Content="末页"
                  Padding="8,2"
                  Style="{StaticResource ToolbarActionButtonStyle}"
                  Command="{Binding LastPageCommand}"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Page>
