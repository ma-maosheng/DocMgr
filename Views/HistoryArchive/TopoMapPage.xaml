<Page x:Class="DocMgr.Views.HistoryArchive.TopoMapPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TopoMapPage">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarCardBorderStyle}" Background="#F5F7FA" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,10">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <Button Content="📥 导入Excel表"
                            Command="{Binding ImportCommand}"
                            Margin="0,0,10,0"
                            Style="{StaticResource ToolbarActionButtonStyle}"
                            Visibility="{Binding CanMaintainLedger, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Content="🔍 浏览数据" Command="{Binding BrowseCommand}" Margin="0,0,10,0" Style="{StaticResource ToolbarActionButtonStyle}"/>

                    <Separator Style="{StaticResource VerticalSeparatorStyle}" />

                    <TextBlock Text="浏览方式" VerticalAlignment="Center" Margin="10,0,8,0" FontWeight="Bold"/>
                    <RadioButton Content="分页浏览"
                                 GroupName="TopoMapBrowseMode"
                                 IsChecked="{Binding IsPagedBrowse, Mode=TwoWay}"
                                 Style="{StaticResource FormRadioButtonStyle}"
                                 Margin="0,0,8,0"/>
                    <RadioButton Content="全局浏览"
                                 GroupName="TopoMapBrowseMode"
                                 IsChecked="{Binding IsGlobalBrowse, Mode=TwoWay}"
                                 Style="{StaticResource FormRadioButtonStyle}"
                                 Margin="0,0,10,0"/>

                    <Separator Style="{StaticResource VerticalSeparatorStyle}" />

                    <Button Content="✏️ 编辑"
                            Command="{Binding EditCommand}"
                            Margin="10,0,10,0"
                            Style="{StaticResource ToolbarActionButtonStyle}"
                            Visibility="{Binding CanMaintainLedger, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="关键词" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Width="220"
                             Style="{StaticResource ToolbarFilterTextBoxStyle}"
                             Margin="0,0,10,0"
                             VerticalContentAlignment="Center"
                             ToolTip="按盒号、比例尺、图号、当前图号、图名、日期、坐标系、高程基准、区域、备注检索"
                             Text="{Binding SearchKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="🔎 检索" Command="{Binding SearchCommand}" Margin="0,0,10,0" Style="{StaticResource ToolbarActionButtonStyle}"/>
                    <Button Content="重置" Command="{Binding ResetSearchCommand}" Margin="0,0,10,0" Style="{StaticResource ToolbarActionButtonStyle}"/>
                    <CheckBox Content="含已离库"
                              IsChecked="{Binding IncludeDisposed, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"
                              ToolTip="默认不显示已离库记录"/>
                    <Button Content="📤 导出" Command="{Binding ExportCommand}" Margin="0,0,10,0" Style="{StaticResource ToolbarActionButtonStyle}"/>

                    <!-- 右侧删除按钮 -->
                    <Button Content="🗑️ 删除当前行"
                            Command="{Binding DeleteCurrentRowCommand}"
                            Margin="20,0,10,0"
                            HorizontalAlignment="Right"
                            Style="{StaticResource ToolbarDangerButtonStyle}"
                            Visibility="{Binding CanMaintainLedger, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Content="🗑️ 删除表"
                            Command="{Binding DeleteTableCommand}"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Right"
                            Style="{StaticResource ToolbarDangerButtonStyle}"
                            Visibility="{Binding CanMaintainLedger, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1"
                Background="#EEF3F8"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,6"
                Margin="0,0,0,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="当前浏览"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <TextBlock Text="{Binding CurrentBrowseCaption, Mode=OneWay}"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#1F4E79"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- 数据展示区 -->
        <Grid Grid.Row="2">
            <DataGrid x:Name="DgTopoMaps" 
                      ItemsSource="{Binding TopoMaps}"
                      SelectedItem="{Binding SelectedTopoMap, Mode=TwoWay}"
                      LoadingRow="DgTopoMaps_LoadingRow"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="All"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="False"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Item"
                      ScrollViewer.CanContentScroll="True">
                <DataGrid.Columns>
                    <!-- 序号列由 LoadingRow 事件处理，直接显示Header -->
                    
                    <DataGridTextColumn Header="档案盒编号" Binding="{Binding BoxNumber}" Width="100"/>
                    <DataGridTextColumn Header="比例尺" Binding="{Binding Scale}" Width="80"/>
                    <DataGridTextColumn Header="图号" Binding="{Binding MapNumber}" Width="100"/>
                    <DataGridTextColumn Header="当前图号" Binding="{Binding CurrentMapNumber}" Width="120"/>
                    <DataGridTextColumn Header="图名" Binding="{Binding MapName}" Width="150"/>
                    
                    <!-- 补全缺失的字段 -->
                    <DataGridTextColumn Header="幅数" Binding="{Binding SheetCount}" Width="50"/>
                    <DataGridTextColumn Header="成图日期" Binding="{Binding CreationDate}" Width="100"/>
                    <DataGridTextColumn Header="调绘日期" Binding="{Binding SurveyDate}" Width="100"/>
                    <DataGridTextColumn Header="坐标系统" Binding="{Binding CoordinateSystem}" Width="100"/>
                    <DataGridTextColumn Header="高程基准" Binding="{Binding ElevationDatum}" Width="100"/>
                    <DataGridTextColumn Header="涉及省市县" Binding="{Binding Region}" Width="150"/>
                    
                    <DataGridTextColumn Header="登记人" Binding="{Binding Registrant}" Width="80"/>
                    <DataGridTextColumn Header="登记日期" Binding="{Binding RegistrationDate}" Width="120"/>
                    <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="180"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 无数据提示 -->
            <StackPanel x:Name="TxtNoDataHint" 
                        Visibility="{Binding NoDataHintVisibility}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"
                        IsHitTestVisible="False">
                <TextBlock Text="📭" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="暂无数据，请先导入或选择数据表" FontSize="16"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3"
                Background="#FAFAFA"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,8"
                Margin="0,10,0,0"
                Visibility="{Binding ShowPaginationBar, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="每页条数：" VerticalAlignment="Center" FontWeight="Bold"/>
                    <ComboBox Width="80"
                              Height="28"
                              Margin="8,0,16,0"
                              ItemsSource="{Binding PageSizeOptions}"
                              SelectedItem="{Binding PageSize, Mode=TwoWay}"/>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="#546E7A"
                               Text="{Binding PageInfo, Mode=OneWay}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="首页"
                            Margin="0,0,6,0"
                            Padding="8,2"
                            Style="{StaticResource ToolbarActionButtonStyle}"
                            Command="{Binding FirstPageCommand}"/>
                    <Button Content="上一页"
                            Margin="0,0,6,0"
                            Padding="8,2"
                            Style="{StaticResource ToolbarActionButtonStyle}"
                            Command="{Binding PreviousPageCommand}"/>
                    <Button Content="下一页"
                            Margin="0,0,6,0"
                            Padding="8,2"
                            Style="{StaticResource ToolbarActionButtonStyle}"
                            Command="{Binding NextPageCommand}"/>
                    <Button Content="末页"
                            Padding="8,2"
                            Style="{StaticResource ToolbarActionButtonStyle}"
                            Command="{Binding LastPageCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Page>
