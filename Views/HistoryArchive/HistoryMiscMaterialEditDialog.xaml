<Window x:Class="DocMgr.Views.HistoryArchive.HistoryMiscMaterialEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="880"
        Height="640"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#F5F5F5">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
  </Window.Resources>
  <Grid Margin="16,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="1.4*" MinHeight="128"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="120"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Margin="0,0,0,8"
            Padding="10,8"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,4" LastChildFill="True">
          <TextBlock DockPanel.Dock="Left" Width="96" Text="资料大类 *：" Style="{StaticResource FormLabelTextBlockStyle}"/>
          <ComboBox Style="{StaticResource FormComboBoxStyle}"
                    IsEditable="True"
                    IsEnabled="{Binding CanEdit}"
                    ItemsSource="{Binding MajorCategoryOptions}"
                    Text="{Binding MajorCategory, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>
        <DockPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,4" LastChildFill="True">
          <TextBlock DockPanel.Dock="Left" Width="96" Text="资料子类 *：" Style="{StaticResource FormLabelTextBlockStyle}"/>
          <ComboBox Style="{StaticResource FormComboBoxStyle}"
                    IsEditable="True"
                    IsEnabled="{Binding CanEdit}"
                    ItemsSource="{Binding SubCategoryOptions}"
                    Text="{Binding SubCategory, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>
        <DockPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,4" LastChildFill="True">
          <TextBlock DockPanel.Dock="Left" Width="96" Text="存放容器 *：" Style="{StaticResource FormLabelTextBlockStyle}"/>
          <ComboBox Style="{StaticResource FormComboBoxStyle}"
                    IsEditable="True"
                    IsEnabled="{Binding CanEdit}"
                    ItemsSource="{Binding ContainerKindOptions}"
                    Text="{Binding ContainerKind, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>

        <DockPanel Grid.Row="1" Grid.Column="0" LastChildFill="True">
          <TextBlock DockPanel.Dock="Left" Width="96" Text="容器编号 *：" Style="{StaticResource FormLabelTextBlockStyle}"/>
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   IsEnabled="{Binding CanEdit}"
                   Text="{Binding ContainerCode, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>
        <DockPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" LastChildFill="True">
          <TextBlock DockPanel.Dock="Left" Width="96" Text="存放位置 *：" Style="{StaticResource FormLabelTextBlockStyle}"/>
          <Button DockPanel.Dock="Right"
                  Content="推荐档口"
                  Width="80"
                  Height="{StaticResource FormControlHeight}"
                  Margin="8,0,0,0"
                  Padding="8,0"
                  Style="{StaticResource DialogSecondaryActionButtonStyle}"
                  Command="{Binding SuggestSlotCommand}"/>
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   IsEnabled="{Binding CanEdit}"
                   Text="{Binding StorageLocation, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Margin="0,0,0,8"
            Padding="10,8"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,4">
          <TextBlock HorizontalAlignment="Left"
                     TextAlignment="Left"
                     Text="资料详情 *："
                     Style="{StaticResource FormLabelTextBlockStyle}"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="增行"
                    Width="64"
                    Height="{StaticResource FormControlHeight}"
                    Margin="0,0,6,0"
                    Padding="8,0"
                    Style="{StaticResource DialogSecondaryActionButtonStyle}"
                    Command="{Binding AddLineCommand}"/>
            <Button Content="粘贴多行"
                    Width="80"
                    Height="{StaticResource FormControlHeight}"
                    Padding="8,0"
                    Style="{StaticResource DialogSecondaryActionButtonStyle}"
                    Command="{Binding PasteLinesCommand}"/>
          </StackPanel>
        </Grid>
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="6,4">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding DetailLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="28"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding NumberText, Mode=OneWay}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               TextAlignment="Right"
                               Margin="0,0,4,0"/>
                    <TextBox Grid.Column="1"
                             Style="{StaticResource FormTextBoxStyle}"
                             IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}"
                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                      <Button Content="上移"
                              Width="44"
                              Height="{StaticResource FormControlHeight}"
                              Margin="0,0,4,0"
                              Padding="4,0"
                              Style="{StaticResource DialogSecondaryActionButtonStyle}"
                              Command="{Binding DataContext.MoveLineUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}"/>
                      <Button Content="下移"
                              Width="44"
                              Height="{StaticResource FormControlHeight}"
                              Margin="0,0,4,0"
                              Padding="4,0"
                              Style="{StaticResource DialogSecondaryActionButtonStyle}"
                              Command="{Binding DataContext.MoveLineDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}"/>
                      <Button Content="删除"
                              Width="44"
                              Height="{StaticResource FormControlHeight}"
                              Padding="4,0"
                              Style="{StaticResource DialogSecondaryActionButtonStyle}"
                              Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Margin="0,0,0,8"
            Padding="10,8"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="8">
      <StackPanel>
        <TextBlock Text="备注："
                   HorizontalAlignment="Left"
                   TextAlignment="Left"
                   Style="{StaticResource FormLabelTextBlockStyle}"
                   Margin="0,0,0,4"/>
        <TextBox Height="56"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top"
                 Padding="6,4"
                 IsEnabled="{Binding CanEdit}"
                 Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"/>
      </StackPanel>
    </Border>

    <Border Grid.Row="3"
            Padding="10,8"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,4">
          <TextBlock HorizontalAlignment="Left"
                     TextAlignment="Left"
                     Text="实物照片 *："
                     Style="{StaticResource FormLabelTextBlockStyle}"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="高拍仪"
                    Width="64"
                    Height="{StaticResource FormControlHeight}"
                    Margin="0,0,6,0"
                    Padding="6,0"
                    Style="{StaticResource DialogSecondaryActionButtonStyle}"
                    Command="{Binding CapturePhotoCommand}"/>
            <Button Content="上传"
                    Width="52"
                    Height="{StaticResource FormControlHeight}"
                    Margin="0,0,6,0"
                    Padding="6,0"
                    Style="{StaticResource DialogSecondaryActionButtonStyle}"
                    Command="{Binding UploadPhotoCommand}"/>
            <Button Content="浏览"
                    Width="52"
                    Height="{StaticResource FormControlHeight}"
                    Margin="0,0,6,0"
                    Padding="6,0"
                    Style="{StaticResource DialogSecondaryActionButtonStyle}"
                    Command="{Binding ViewPhotoCommand}"/>
            <Button Content="删除"
                    Width="52"
                    Height="{StaticResource FormControlHeight}"
                    Padding="6,0"
                    Style="{StaticResource DialogSecondaryActionButtonStyle}"
                    Command="{Binding DeletePhotoCommand}"/>
          </StackPanel>
        </Grid>
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Photos}"
                  SelectedItem="{Binding SelectedPhoto}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="#E5E7EB"
                  BorderThickness="1">
          <DataGrid.Columns>
            <DataGridTextColumn Header="文件名" Binding="{Binding FileName, Mode=OneWay}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>

    <Grid Grid.Row="4" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding ReadOnlyHint, Mode=OneWay}"
                 FontSize="12"
                 Foreground="#64748B"
                 TextWrapping="Wrap"
                 VerticalAlignment="Center"
                 Margin="0,0,12,0"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="{Binding CloseButtonText, Mode=OneWay}"
                Style="{StaticResource DialogSecondaryActionButtonStyle}"
                Command="{Binding CancelCommand}"/>
        <Button Content="保存"
                Margin="8,0,0,0"
                Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}}"
                Style="{StaticResource DialogPrimaryActionButtonStyle}"
                Command="{Binding SaveCommand}"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
