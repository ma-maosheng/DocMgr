<Page x:Class="DocMgr.Views.HistoryArchive.AerialPhotoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AerialPhotoPage">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarCardBorderStyle}" Background="#F5F7FA" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,10">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <Button Content="📥 导入影像" Command="{Binding ImportCommand}" Width="100" Margin="0,0,10,0" Style="{StaticResource ToolbarActionButtonStyle}"/>
                    <Button Content="🔍 浏览数据" Command="{Binding BrowseCommand}" Width="100" Margin="0,0,10,0" Style="{StaticResource ToolbarActionButtonStyle}"/>

                    <Separator Style="{StaticResource VerticalSeparatorStyle}" />

                    <TextBlock Text="浏览方式" VerticalAlignment="Center" Margin="10,0,8,0" FontWeight="Bold"/>
                    <RadioButton Content="分页浏览"
                                 GroupName="AerialPhotoBrowseMode"
                                 IsChecked="{Binding IsPagedBrowse, Mode=TwoWay}"
                                 Style="{StaticResource FormRadioButtonStyle}"
                                 Margin="0,0,8,0"/>
                    <RadioButton Content="全局浏览"
                                 GroupName="AerialPhotoBrowseMode"
                                 IsChecked="{Binding IsGlobalBrowse, Mode=TwoWay}"
                                 Style="{StaticResource FormRadioButtonStyle}"
                                 Margin="0,0,10,0"/>

                    <Separator Style="{StaticResource VerticalSeparatorStyle}" />

                    <Button Content="✏️ 编辑" Command="{Binding EditCommand}" Width="80" Margin="10,0,10,0" Style="{StaticResource ToolbarActionButtonStyle}"/>
                    <Button Content="🔎 检索" Command="{Binding SearchCommand}" Width="80" Margin="0,0,10,0" Style="{StaticResource ToolbarActionButtonStyle}"/>
                    <Button Content="📤 导出" Command="{Binding ExportCommand}" Width="80" Margin="0,0,10,0" Style="{StaticResource ToolbarActionButtonStyle}"/>

                    <Button Content="🗑️ 删除表" Command="{Binding DeleteTableCommand}" Width="90" Margin="20,0,0,0" HorizontalAlignment="Right" Style="{StaticResource ToolbarDangerButtonStyle}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1"
                Background="#EEF3F8"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,6"
                Margin="0,0,0,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="当前浏览"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <TextBlock Text="{Binding CurrentBrowseCaption, Mode=OneWay}"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#1F4E79"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <DataGrid x:Name="DgData"
                      ItemsSource="{Binding AerialPhotos}"
                      SelectedItem="{Binding SelectedAerialPhoto, Mode=TwoWay}"
                      LoadingRow="DgData_LoadingRow"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="All"
                      CanUserAddRows="False"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Item"
                      ScrollViewer.CanContentScroll="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="档案盒编号" Binding="{Binding BoxNumber}" Width="100"/>
                    <DataGridTextColumn Header="测区名称" Binding="{Binding SurveyArea}" Width="150"/>
                    <DataGridTextColumn Header="比例尺" Binding="{Binding Scale}" Width="80"/>
                    <DataGridTextColumn Header="航摄日期" Binding="{Binding PhotographyDate}" Width="100"/>
                    <DataGridTextColumn Header="档案盒内物品" Binding="{Binding BoxContents}" Width="*"/>
                    <DataGridTextColumn Header="相片张数" Binding="{Binding PhotoCount}" Width="80"/>
                    <DataGridTextColumn Header="登记人" Binding="{Binding Registrant}" Width="80"/>
                    <DataGridTextColumn Header="登记日期" Binding="{Binding RegistrationDate}" Width="120"/>
                    <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Visibility="{Binding NoDataHintVisibility}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" IsHitTestVisible="False">
                <TextBlock Text="📭" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="暂无数据，请先导入或选择数据表" FontSize="16"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3"
                Background="#FAFAFA"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,8"
                Margin="0,10,0,0"
                Visibility="{Binding ShowPaginationBar, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="每页条数：" VerticalAlignment="Center" FontWeight="Bold"/>
                    <ComboBox Width="80"
                              Height="28"
                              Margin="8,0,16,0"
                              ItemsSource="{Binding PageSizeOptions}"
                              SelectedItem="{Binding PageSize, Mode=TwoWay}"/>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="#546E7A"
                               Text="{Binding PageInfo, Mode=OneWay}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="首页"
                            Width="64"
                            Margin="0,0,6,0"
                            Padding="8,2"
                            Style="{StaticResource ToolbarActionButtonStyle}"
                            Command="{Binding FirstPageCommand}"/>
                    <Button Content="上一页"
                            Width="72"
                            Margin="0,0,6,0"
                            Padding="8,2"
                            Style="{StaticResource ToolbarActionButtonStyle}"
                            Command="{Binding PreviousPageCommand}"/>
                    <Button Content="下一页"
                            Width="72"
                            Margin="0,0,6,0"
                            Padding="8,2"
                            Style="{StaticResource ToolbarActionButtonStyle}"
                            Command="{Binding NextPageCommand}"/>
                    <Button Content="末页"
                            Width="64"
                            Padding="8,2"
                            Style="{StaticResource ToolbarActionButtonStyle}"
                            Command="{Binding LastPageCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Page>
