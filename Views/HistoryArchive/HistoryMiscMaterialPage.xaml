<Page x:Class="DocMgr.Views.HistoryArchive.HistoryMiscMaterialPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="杂项资料"
      Background="#F0F2F5">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource ToolbarCardBorderStyle}" Margin="0" CornerRadius="0" Padding="12,10">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="浏览照片"
                  Command="{Binding BrowsePhotosCommand}"
                  Style="{StaticResource ToolbarActionButtonStyle}"
                  Width="88"
                  Margin="0,0,8,0"
                  ToolTip="浏览当前杂项资料的实物照片"/>
          <Button Content="新建" Command="{Binding NewCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="72" Margin="0,0,8,0"/>
          <Button Content="编辑" Command="{Binding EditCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="72" Margin="0,0,8,0"/>
          <Button Content="删除" Command="{Binding DeleteCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="72"/>
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="大类：" VerticalAlignment="Center"/>
            <ComboBox Width="120" Style="{StaticResource ToolbarFilterComboBoxStyle}"
                      ItemsSource="{Binding MajorCategoryOptions}"
                      SelectedItem="{Binding MajorCategory}"/>
            <TextBlock Text="子类：" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <ComboBox Width="120" Style="{StaticResource ToolbarFilterComboBoxStyle}"
                      ItemsSource="{Binding SubCategoryOptions}"
                      SelectedItem="{Binding SubCategory}"/>
            <TextBlock Text="容器：" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <ComboBox Width="90" Style="{StaticResource ToolbarFilterComboBoxStyle}"
                      ItemsSource="{Binding ContainerKindOptions}"
                      SelectedItem="{Binding ContainerKind}"/>
            <TextBlock Text="状态：" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <ComboBox Width="90" Style="{StaticResource ToolbarFilterComboBoxStyle}"
                      ItemsSource="{Binding LifecycleStatusOptions}"
                      SelectedItem="{Binding LifecycleStatus}"/>
            <TextBlock Text="关键词：" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBox Width="160" Height="{StaticResource FormControlHeight}" VerticalContentAlignment="Center"
                     Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
              </TextBox.InputBindings>
            </TextBox>
            <Button Content="查询" Command="{Binding SearchCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="72" Margin="8,0,0,0"/>
            <Button Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="72" Margin="8,0,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <TextBlock Grid.Row="1" Margin="4,8,4,8" Foreground="#546E7A" Text="{Binding MaintainHint, Mode=OneWay}" TextWrapping="Wrap"/>

    <Border Grid.Row="2" Background="White" Padding="8">
      <DataGrid ItemsSource="{Binding Items}"
                SelectedItem="{Binding SelectedItem}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False"
                SelectionMode="Single"
                RowHeight="34"
                ColumnHeaderHeight="36"
                GridLinesVisibility="Horizontal"
                BorderThickness="0"
                AlternatingRowBackground="#F8FAFC">
        <DataGrid.Columns>
          <DataGridTextColumn Header="资料大类" Binding="{Binding MajorCategory, Mode=OneWay}" Width="110"/>
          <DataGridTextColumn Header="资料子类" Binding="{Binding SubCategory, Mode=OneWay}" Width="110"/>
          <DataGridTextColumn Header="存放容器" Binding="{Binding ContainerKind, Mode=OneWay}" Width="80"/>
          <DataGridTextColumn Header="容器编号" Binding="{Binding ContainerCode, Mode=OneWay}" Width="100"/>
          <DataGridTextColumn Header="存放位置" Binding="{Binding LocationDisplay, Mode=OneWay}" Width="140"/>
          <DataGridTextColumn Header="状态" Binding="{Binding LifecycleStatus, Mode=OneWay}" Width="80"/>
          <DataGridTextColumn Header="资料详情" Binding="{Binding DetailSummary, Mode=OneWay}" Width="2*">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="NoWrap"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="ToolTip" Value="{Binding DetailSummary}"/>
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="照片" Binding="{Binding PhotoCount, Mode=OneWay}" Width="60"/>
          <DataGridTextColumn Header="备注" Binding="{Binding Remark, Mode=OneWay}" Width="160"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>
</Page>
