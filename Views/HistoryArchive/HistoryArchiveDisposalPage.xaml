<Page x:Class="DocMgr.Views.HistoryArchive.HistoryArchiveDisposalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="资料离库处置"
      Background="#F0F2F5">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource ToolbarCardBorderStyle}" Margin="0" CornerRadius="0" Padding="16,12">
      <StackPanel Orientation="Horizontal">
        <Button Content="新增处置" Command="{Binding AddCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="96" Margin="0,0,10,0"/>
        <Button Content="打开办理" Command="{Binding OpenCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="96" Margin="0,0,10,0"/>
        <Button Content="撤回作废" Command="{Binding WithdrawCommand}" Style="{StaticResource ToolbarDangerButtonStyle}" Width="110" Margin="0,0,10,0"/>
        <Button Content="强制作废" Command="{Binding ForceVoidCommand}" Style="{StaticResource ToolbarDangerButtonStyle}" Width="110" Margin="0,0,16,0"/>

        <TextBlock Text="业务状态：" VerticalAlignment="Center"/>
        <ComboBox Width="200"
                  Style="{StaticResource ToolbarFilterComboBoxStyle}"
                  ItemsSource="{Binding StatusOptions}"
                  SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                  ToolTip="可按业务状态筛选；选【全部】列出各状态申请（含未提交）"/>

        <TextBlock Text="年度：" VerticalAlignment="Center" Margin="16,0,0,0"/>
        <ComboBox Width="100"
                  Style="{StaticResource ToolbarFilterComboBoxStyle}"
                  ItemsSource="{Binding ApplyYears}"
                  SelectedItem="{Binding ApplyYear, Mode=TwoWay}"/>

        <TextBlock Text="关键词：" VerticalAlignment="Center" Margin="16,0,0,0"/>
        <TextBox Width="180"
                 Height="32"
                 VerticalContentAlignment="Center"
                 Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="处置单号、申请说明、处置方式、申请人、明细盒号/摘要"/>
        <Button Content="查询" Command="{Binding SearchCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="80" Margin="10,0,0,0"/>
        <Button Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource ToolbarActionButtonStyle}" Width="80" Margin="10,0,0,0"/>
      </StackPanel>
    </Border>

    <Border Grid.Row="1"
            Margin="0,12,0,12"
            Padding="0"
            Background="#FFFDF7"
            BorderBrush="#E2C98F"
            BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="4"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#B98A2E"/>
        <TextBlock Grid.Row="1"
                   Text="历史存档资料离库处置"
                   Margin="0,12,0,4"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#6F4A00"
                   HorizontalAlignment="Center"
                   TextDecorations="Underline"/>
        <TextBlock Grid.Row="2"
                   Text="History Archive Material Disposal Ledger"
                   Margin="0,0,0,8"
                   FontSize="12"
                   Foreground="#9A7B3F"
                   HorizontalAlignment="Center"/>
        <Border Grid.Row="3"
                Margin="16,0,16,12"
                Padding="12,10"
                Background="#FFFBEB"
                BorderBrush="#E2C98F"
                BorderThickness="1"
                CornerRadius="4">
          <TextBlock Text="用于历史存档在柜档案盒和杂项存放容器的离库销毁/转交/其他处置，流程与签批要求对齐在网数据处置。新建时按资料类别选取；杂项按单个容器纳入。查询当前态请使用「资料台账与资料处置 → 台账」。"
                     Foreground="#6F4A00"
                     TextWrapping="Wrap"
                     HorizontalAlignment="Center"/>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="2" Background="White" Padding="10">
      <DataGrid ItemsSource="{Binding Records}"
                SelectedItem="{Binding SelectedRecord}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False"
                SelectionMode="Single"
                RowHeight="36"
                ColumnHeaderHeight="40"
                GridLinesVisibility="Horizontal"
                BorderThickness="0"
                MouseDoubleClick="DgRecords_MouseDoubleClick">
        <DataGrid.Columns>
          <DataGridTextColumn Header="处置单编号" Binding="{Binding DisposalNo, Mode=OneWay}" Width="150"/>
          <DataGridTextColumn Header="资料类别" Binding="{Binding MaterialKindDisplay, Mode=OneWay}" Width="140"/>
          <DataGridTextColumn Header="处置方式" Binding="{Binding DispositionMethod, Mode=OneWay}" Width="110"/>
          <DataGridTextColumn Header="明细数" Binding="{Binding ItemCount, Mode=OneWay}" Width="70"/>
          <DataGridTextColumn Header="业务状态" Binding="{Binding StatusDisplay, Mode=OneWay}" Width="160" ElementStyle="{StaticResource WorkflowStatusColumnTextStyle}"/>
          <DataGridTextColumn Header="申请人" Binding="{Binding ApplicantName, Mode=OneWay}" Width="90"/>
          <DataGridTextColumn Header="申请日期" Binding="{Binding ApplyTime, Mode=OneWay, StringFormat=yyyy-MM-dd}" Width="110"/>
          <DataGridCheckBoxColumn Header="已传签批单" Binding="{Binding SignedAttachmentUploaded, Mode=OneWay}" Width="90"/>
          <DataGridCheckBoxColumn Header="已传照片" Binding="{Binding ScenePhotoUploaded, Mode=OneWay}" Width="80"/>
          <DataGridTextColumn Header="备注" Binding="{Binding Remark, Mode=OneWay}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>
</Page>
