<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- 清除继承的 nuget.org，避免内网/超时导致 C# 语言服务反复报「加载项目失败」 -->
    <clear />
    <add key="huawei" value="https://repo.huaweicloud.com/repository/nuget/v3/index.json" protocolVersion="3" />
    <add key="tencent" value="https://mirrors.cloud.tencent.com/nuget/" />
  </packageSources>
</configuration>
