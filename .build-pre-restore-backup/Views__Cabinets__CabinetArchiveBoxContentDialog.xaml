<Window x:Class="DocMgr.Views.Cabinets.CabinetArchiveBoxContentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1180"
        Height="620"
        MinWidth="860"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F5F7FA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="18" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <TextBlock Text="{Binding HeaderText}" FontSize="22" FontWeight="Bold" Foreground="#1F2937"/>
                <TextBlock Text="{Binding SummaryText}" Margin="0,8,0,0" FontSize="13" Foreground="#6B7280"/>
                <TextBlock Text="{Binding YearlyArchiveHintText}"
                           Margin="0,8,0,0"
                           FontSize="12"
                           Foreground="#475569"
                           TextWrapping="Wrap"/>
                <Border Margin="0,12,0,0"
                        Padding="12,10"
                        Background="#FEF2F2"
                        BorderBrush="#FCA5A5"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{Binding MixedPlacementNoticeVisibility}">
                    <StackPanel>
                        <TextBlock Text="{Binding MixedPlacementNoticeTitle}" FontSize="13" FontWeight="Bold" Foreground="#B91C1C"/>
                        <TextBlock Text="{Binding MixedPlacementNoticeText}" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12" Foreground="#7F1D1D"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="0,16,0,16" Padding="12" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
            <Grid>
                <DataGrid ItemsSource="{Binding Items}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="来源类型" Binding="{Binding SourceType}" Width="90"/>
                        <DataGridTextColumn Header="载体/类别" Binding="{Binding CategoryText}" Width="100"/>
                        <DataGridTextColumn Header="登记单号" Binding="{Binding IdentifierText}" Width="120"/>
                        <DataGridTextColumn Header="资料子项" Binding="{Binding TitleText}" Width="180"/>
                        <DataGridTextColumn Header="立档份数" Binding="{Binding FiledCopyCountDisplay}" Width="80"/>
                        <DataGridTextColumn Header="当前库内份数" Binding="{Binding CurrentInArchiveCopyCountDisplay}" Width="96"/>
                        <DataGridTextColumn Header="出库待还份数" Binding="{Binding PendingReturnCopyCountDisplay}" Width="96"/>
                        <DataGridTextColumn Header="出库不还份数" Binding="{Binding NoReturnCopyCountDisplay}" Width="96"/>
                        <DataGridTextColumn Header="灭失份数" Binding="{Binding LostCopyCountDisplay}" Width="80"/>
                        <DataGridTextColumn Header="电子库存状态" Binding="{Binding ElectronicStatusDisplay}" Width="96"/>
                        <DataGridTextColumn Header="详细信息" Binding="{Binding DetailText}" Width="*"/>
                        <DataGridTextColumn Header="立档日期" Binding="{Binding DateText}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="{Binding EmptyHint}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="16"
                           Foreground="#94A3B8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="关闭"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource DialogSecondaryActionButtonStyle}"
                    Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
