<Window x:Class="DocMgr.Views.YearlyArchive.ArchiveOutboundApplicationViewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1150"
        Height="820"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F7FA">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ArchiveRegisterResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding WindowTitle}" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="{Binding WorkspaceBannerText}"
                       Margin="0,6,0,0" Foreground="#666" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#D8E2EC" BorderThickness="1" CornerRadius="4" Background="White">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="10">
                <StackPanel Margin="12">
                    <GroupBox Header="1. 申请信息" Style="{StaticResource Level1GroupBoxStyle}" Padding="10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,6">
                                    <TextBlock Text="出库单号" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding OutboundNo}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,6">
                                    <TextBlock Text="所属项目" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding ProjectName}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,6">
                                    <TextBlock Text="申请人" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding ApplicantName}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,6">
                                    <TextBlock Text="申请部门" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding ApplicantDept}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="申请日期" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding ApplyDateDisplay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="当前状态" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding StatusDisplay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="资料去向" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding DestinationDisplayText}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="证明材料" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding ProofMaterialDisplay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="预计归还日期" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding ExpectedReturnDateDisplay}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="申请原因" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                            <TextBlock Text="{Binding Reason}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                            <TextBlock Text="资料摘要" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding MaterialSummary}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="2. 审批信息" Style="{StaticResource Level1GroupBoxStyle}" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                                <TextBlock Text="申请部门审核意见" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                <TextBlock Text="{Binding DeptAuditOpinion}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                <TextBlock Margin="0,4,0,0">
                                    <Run Text="审核人：" Foreground="#64748B"/>
                                    <Run Text="{Binding DeptAuditor, Mode=OneWay}"/>
                                    <Run Text="  日期：" Foreground="#64748B"/>
                                    <Run Text="{Binding DeptAuditDateDisplay, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,10">
                                <TextBlock Text="资料室负责人意见" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                <TextBlock Text="{Binding ArchiveRoomHeadOpinion}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                <TextBlock Margin="0,4,0,0">
                                    <Run Text="负责人：" Foreground="#64748B"/>
                                    <Run Text="{Binding ArchiveRoomHead, Mode=OneWay}"/>
                                    <Run Text="  日期：" Foreground="#64748B"/>
                                    <Run Text="{Binding ArchiveRoomHeadDateDisplay, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="生产科负责人意见" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                <TextBlock Text="{Binding ProductionHeadOpinion}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                <TextBlock Margin="0,4,0,0">
                                    <Run Text="负责人：" Foreground="#64748B"/>
                                    <Run Text="{Binding ProductionHead, Mode=OneWay}"/>
                                    <Run Text="  日期：" Foreground="#64748B"/>
                                    <Run Text="{Binding ProductionHeadDateDisplay, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="生产副院长意见" Style="{StaticResource ArchiveRegisterApprovalReadOnlyLabelStyle}"/>
                                <TextBlock Text="{Binding VicePresidentOpinion}" Style="{StaticResource ArchiveRegisterApprovalReadOnlyValueStyle}"/>
                                <TextBlock Margin="0,4,0,0">
                                    <Run Text="签字：" Foreground="#64748B"/>
                                    <Run Text="{Binding VicePresident, Mode=OneWay}"/>
                                    <Run Text="  日期：" Foreground="#64748B"/>
                                    <Run Text="{Binding VicePresidentDateDisplay, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="3. 出库明细" Style="{StaticResource Level1GroupBoxStyle}" Padding="10">
                        <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserResizeRows="False" IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" MaxHeight="260" Background="#FAFBFC"
                                  BorderBrush="#E2E8F0" BorderThickness="1" HorizontalGridLinesBrush="#EEF2F6">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="资料名称" Binding="{Binding MaterialName}" MinWidth="180" Width="*"/>
                                <DataGridTextColumn Header="明细名称" Binding="{Binding ItemName}" Width="160"/>
                                <DataGridTextColumn Header="容器编号" Binding="{Binding ContainerCode}" Width="120"/>
                                <DataGridTextColumn Header="存储位置" Binding="{Binding StorageLocation}" Width="140"/>
                                <DataGridTextColumn Header="密级" Binding="{Binding ConfidentialLevel}" Width="70"/>
                                <DataGridTextColumn Header="领用方式" Binding="{Binding UsageModeDisplay}" Width="80"/>
                                <DataGridTextColumn Header="份数" Binding="{Binding CopyCount}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Header="附件材料" Style="{StaticResource Level1GroupBoxStyle}" Padding="10">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,8"
                                       Foreground="#B45309" FontSize="11" TextWrapping="Wrap"
                                       Visibility="{Binding CanSupplementOtherAttachments, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Text="{Binding SupplementAttachmentHint, Mode=OneWay}"/>
                            <ListView ItemsSource="{Binding Attachments}" Height="120" BorderBrush="#EEE" BorderThickness="1">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="文件名" Width="240" DisplayMemberBinding="{Binding FileName}"/>
                                        <GridViewColumn Header="附件分类" Width="90" DisplayMemberBinding="{Binding FileCategoryDisplay}"/>
                                        <GridViewColumn Header="上传时间" Width="140" DisplayMemberBinding="{Binding UploadTime, StringFormat='yyyy-MM-dd HH:mm'}"/>
                                        <GridViewColumn Header="上传人" Width="90" DisplayMemberBinding="{Binding UploaderName}"/>
                                        <GridViewColumn Header="操作" Width="80">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="查看" Style="{StaticResource ButtonNormalStyle}"
                                                            Command="{Binding DataContext.ViewAttachmentCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,10,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Background="#FAFBFC">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="增补附件"
                        Command="{Binding SupplementOtherAttachmentCommand}"
                        Padding="12,6" Margin="0,0,8,0"
                        ToolTip="仅可增补「其他附件」；请确保文件命名清晰准确"
                        Visibility="{Binding CanSupplementOtherAttachments, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Content="打印" Command="{Binding PrintCommand}" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="关闭" Command="{Binding CloseCommand}" Padding="16,6"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
